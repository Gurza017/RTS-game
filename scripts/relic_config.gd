extends RefCounted
## ═══════════════════════════════════════════════════════════════════════════
## РЕЛИКВИЯ-ШТАНДАРТ И ОБЩАЯ КОПИЛКА ОПЫТА АРМИИ (ТЗ 10.10.2026, блок 5)
## ═══════════════════════════════════════════════════════════════════════════
## Числа механики. Логика — scripts/RelicManager.gd, кнопка — RelicButton.gd.
##
## Копилка: каждое убийство, засчитанное отряду ИГРОКА (тот же источник, что
## опыт отряда — GameManager.credit_kill/credit_kills), кладёт в неё
## POOL_PER_KILL. Полная копилка (POOL_COST) — одна выдача: отряду +1 уровень
## ветеранства и реликвия центральному бойцу (или +1 уровень уже несомой).
##
## Аура: союзникам НОСИТЕЛЯ (его фракции — у подобравшего врага аура работает
## на врага) в радиусе — атака, мораль, ускорение удара. СКОРОСТЬ НЕ МЕНЯЕТСЯ.
## Ауры разных реликвий не складываются: боец берёт лучшую.

## Сколько опыта нужно на одну выдачу
const POOL_COST := 3000.0
## Опыт копилки за одно засчитанное убийство
const POOL_PER_KILL := 1.0

## Радиус ауры: база и прибавка за каждый уровень реликвии сверх первого
const AURA_RADIUS := 15.0
const AURA_RADIUS_PER_LEVEL := 5.0
## Прибавка атаки: база и прибавка за уровень
const AURA_ATTACK := 2.0
const AURA_ATTACK_PER_LEVEL := 2.0
## Мораль бойца (поле Unit.morale — вес в продавливании) и подпитка морали
## ОТРЯДА в ауре, очков в секунду (squad_add_morale)
const AURA_MORALE := 15.0
const AURA_SQUAD_MORALE_PER_SEC := 2.0
## Ускорение удара: доля кулдауна долой (у всех уровней одна)
const AURA_COOLDOWN_FRAC := 0.10

## Такт пересчёта ауры (одним проходом по всем реликвиям) и проверки
## носителя/подбора лежащей
const AURA_TICK_SEC := 0.5
const PICK_TICK_SEC := 0.25
## Радиус подбора лежащей реликвии
const PICK_RADIUS := 1.5

## Высота флага реликвии над землёй у носителя (выше знамени отряда, чтобы
## знаменосец с реликвией не нёс два флага в одной точке) и у лежащей
const CARRY_Y := 2.55
const GROUND_Y := 0.75
## Полотнище — золотой штандарт
const CLOTH := Color(0.93, 0.74, 0.18)

static func aura_radius(level: int) -> float:
	return AURA_RADIUS + AURA_RADIUS_PER_LEVEL * float(maxi(level, 1) - 1)

static func aura_attack(level: int) -> float:
	return AURA_ATTACK + AURA_ATTACK_PER_LEVEL * float(maxi(level, 1) - 1)
