extends Button
class_name QuietTooltipButton

## Кнопка с "немым" стандартным тултипом Godot. tooltip_text у неё ОСТАЁТСЯ
## заполненным строкой (нужна стендам — их поиск идёт по btn.tooltip_text,
## см. qa_guard/qa_squad/qa_upgrade/qa_vet), но движковый пузырь-подсказка
## по ней больше не всплывает. Нужна на любой кнопке, у которой уже есть
## СВОЯ карточка через _show_card (HUD._cmd) — без этого движок рисовал ещё
## один, плоский и никак не позиционируемый пузырь с тем же текстом рядом с
## курсором, поверх соседних кнопок (жалоба владельца со скриншотом:
## "лишний текст «Мечник ×20» на панели Замка").
##
## ── ПОЧЕМУ НЕ _make_custom_tooltip ─────────────────────────────────────────
## Раньше здесь возвращался пустой Control. Пузырь с ТЕКСТОМ он действительно
## убирал, но САМ ПУЗЫРЬ оставался: движок кладёт возвращённый узел внутрь
## TooltipPanel и рисует его фон и рамку по теме. Пустой узел давал пустую
## тёмную плашку — тот самый «чёрный прямоугольник у цифры 10» со скриншота
## владельца, висевший у курсора и наезжавший на соседнюю кнопку.
##
## Правильная точка — _get_tooltip: пустая строка означает «подсказки нет», и
## движок не создаёт НИ узла, ни панели. Поле tooltip_text при этом не
## трогается вовсе, поэтому стенды продолжают находить кнопки по нему
func _get_tooltip(_at_position: Vector2) -> String:
	return ""
