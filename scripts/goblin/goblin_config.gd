## и ради него поднят unit_stats_config.SQUAD_SIZE_HARD_CAP
const SQUAD_SIZE := {
	"goblin_spearman": 100,
	"goblin_rider":    50,
	# Стая гноллов НЕБОЛЬШАЯ намеренно: их сила в подвижности, а не в числе,
	# и три стартовых отряда по двенадцать — это уже тридцать шесть метателей
	"gnoll":           12,
	# Туши ходят пятёрками (заказ 13.09.2026)
	"big_goblin":      5,
}
## Ширина строя при выходе из хижины
const SQUAD_COLS := {
	"goblin_spearman": 10,
	"goblin_rider":    8,
	"gnoll":           4,
	"big_goblin":      3,
}
## Шаг строя при выходе из хижины. Растянут вместе с PIXEL_SIZE (x1.445): шаг
## задаётся в метрах, а боец стал шире — оставь 0.45, и выходящий отряд
## перекрывался бы спрайтами вдвое
const SQUAD_SPACING := 0.65

## ЧЕГО И СКОЛЬКО В ПОЛНОЙ ОРДЕ — ВЫВОДИТСЯ ИЗ СТАРТОВОГО СОСТАВА (см.
## START_SQUADS ниже), а не задаётся вторым списком. По этому составу орда
## ПОПОЛНЯЕТСЯ: вожак смотрит, какого рода войск не хватает до штата, и
## заказывает его в хижине. Два независимых списка неизбежно разъехались бы —
## правка стартовой орды молча меняла бы то, что она потом донанимает
static func army_composition() -> Array:
	var out: Array = []
	for row in START_SQUADS:
		out.append(String((row as Dictionary).get("unit", "")))
	return out

## Полная численность орды в отрядах. Ровно длина START_SQUADS — держится одним
## числом, чтобы «набрать десять отрядов» и «состав орды» не разъехались
static func army_squads() -> int:
	return START_SQUADS.size()

