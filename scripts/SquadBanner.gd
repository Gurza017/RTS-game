extends MeshInstance3D
## ═══════════════════════════════════════════════════════════════════════════
## ЗНАМЯ ВЕТЕРАНСТВА НА КОПЬЕ ЗНАМЕНОСЦА
## ═══════════════════════════════════════════════════════════════════════════
## ЗНАМЯ — ПРЕДМЕТ В РУКАХ КОНКРЕТНОГО БОЙЦА, а не метка над отрядом, и это
## главное, что стоит понимать про этот узел: у знамени есть носитель, и когда
## носитель гибнет, знамя переходит к соседу, а когда гибнет последний —
## падает на землю (см. GameManager).
##
## ── ПОЧЕМУ УЗЕЛ В МИРЕ, А НЕ РЕБЁНОК БОЙЦА ─────────────────────────────────
## Ребёнком было бы дешевле: ездил бы сам, без единой строчки в кадре. Но боец
## ЛОГИЧЕСКИ стоит не там, где НАРИСОВАН: между физическими шагами картинка
## сглаживается (Unit.draw_position), и ребёнок узла ехал бы по логической
## точке, а спрайт — по сглаженной. Ровно на этом уже обжигались жёлтые кольца
## выделения: «кольца отставали от бойцов» (см. CLAUDE.md). Поэтому знамя —
## узел мира, а точку ему каждый кадр даёт draw_position() знаменосца.
##
## ── ЦЕНА ───────────────────────────────────────────────────────────────────
## Один узел на ОТРЯД и один вызов отрисовки: квад с текстурой. Процедурная
## геометрия обошлась бы вдвое дороже — кант и заливка это две поверхности.
##
## Файл намеренно без class_name: подключается через preload.

const _BannerArt := preload("res://scripts/BannerArt.gd")
const _BBUtil    := preload("res://scripts/BillboardUtil.gd")
const _UCfgS     := preload("res://scripts/unit_stats_config.gd")
const _Opt       := preload("res://scripts/perf_config.gd")

## ── МИРОВОЙ РАЗМЕР ОДНОГО ПИКСЕЛЯ КАРТИНКИ ─────────────────────────────────
## Отсюда и только отсюда берётся масштаб знамени: холст BannerArt задаёт
## ПРОПОРЦИИ, это число — РАЗМЕР. При холсте 80×160 знамя выходит 0.73 м в
## ширину и 1.46 м в высоту.
##
## ПОДБИРАЕТСЯ ГЛАЗОМ НА ОКОННОМ СТЕНДЕ (qa_banner), и иначе не выйдет: на
## экране высота домножается ещё и на компенсацию наклона камеры
## (BillboardUtil.V_STRETCH ≈ 1.41), поэтому «сколько метров» и «сколько
## пикселей рядом с копейщиком» — разные вопросы. Первый подбор дал 0.011, и
## знамя вышло на четверть выше копий: пика знаменосца читалась не как пика, а
## как мачта
const PIXEL_SIZE := 0.0091

## Высота ЦЕНТРА квада над грунтом.
##
## ── ПОДНЯТО С 1.34 ПО ЗАКАЗУ ВЛАДЕЛЬЦА ────────────────────────
## Жалоба со скриншотом: «красный флажок отряда утоплен в текстуры
## моделек». Виновата НЕ высота сама по себе, а ГУСТОТА СТРОЯ: число
## подбиралось на оконном стенде (qa_banner), а там стоит редкая шеренга.
## В партии же знаменосец стоит в [ряд 0, колонка 0], то есть ВПЕРЕДИ
## шестидесяти человек, а камера смотрит под 45°: спрайты ЗАДНИХ шеренг
## рисуются НА ЭКРАНЕ выше знаменосца и закрывают его полотнище.
##
## МЕТРЫ ЗДЕСЬ НЕ РАВНЫ ПИКСЕЛЯМ: высота на экране домножается ещё
## и на компенсацию наклона камеры (BillboardUtil.V_STRETCH ≈ 1.41), поэтому
## прибавка в 0.36 м даёт около полуметра на экране — ровно голову
## второй шеренги. ВЫШЕ ПОДНИМАТЬ НЕЛЬЗЯ: знамя оторвётся от древка
## в руке и поплывёт над отрядом отдельной меткой, а это уже другая сущность
const CENTER_Y := 1.70

## ── СМЕЩЕНИЕ ЗНАМЕНИ ОТ ЦЕНТРА БОЙЦА, МЕТРЫ ────────────────────────────────
## Древко нарисовано у левого края холста, а холст многократно шире древка:
## центр КВАДА и центр ДРЕВКА — разные точки, и без сдвига знамя висело бы
## сбоку от знаменосца. Сдвиг ставит древко на бойца, а полотнище уводит вправо,
## как оно и висит на пике.
##
## ЧИСЛО ВЫВОДИТСЯ ИЗ ХОЛСТА, А НЕ ПОДБИРАЕТСЯ. Холст расширялся уже дважды
## (полотнища росли по заказу владельца), и зашитая константа каждый раз
## оставляла знамя висеть мимо бойца
static var POLE_OFFSET_X: float = _BannerArt.pole_offset_px() * PIXEL_SIZE

## ── ШТАНДАРТ ЭЛИТЫ — В ПОЛТОРА РАЗА КРУПНЕЕ (ТЗ 13.10.2026, письмо 7) ──────
## Бордовый штандарт (BannerArt.elite_texture, ТЗ 22.10.2026) выдаётся только
## отряду, которому игрок САМ дал элитный статус (GameManager.squad_elite), и
## рисуется на +50 % к обычному знамени: тот же холст, тот же PIXEL_SIZE,
## квад × 1.5; само полотнище на холсте на 20 % крупнее прежнего штандарта.
## Растёт ВСЁ полотно с древком, поэтому сдвиг древка от центра квада и
## высота центра над землёй считаются от ФАКТИЧЕСКОГО размера (pole_offset,
## _center_y), а не от статических чисел
const ELITE_SCALE := 1.5

## Уровень, под который построено знамя. По нему GameManager видит, что отряд
## подрос, и перестраивает картинку, не создавая узел заново
var shown_level: int = 0

## Построено ли знамя как штандарт элиты (см. ELITE_SCALE). GameManager
## сравнивает с GameManager.squad_elite и перестраивает картинку на смене
var shown_elite: bool = false
## Уровень элиты (римская цифра на штандарте), под который построено знамя
var shown_elite_lvl: int = 0

## Сдвиг древка от центра квада и высота центра — под ТЕКУЩИЙ размер квада
## (у штандарта элиты они в полтора раза больше статических)
var pole_offset: float = POLE_OFFSET_X
var _center_y: float = CENTER_Y

## ── БЕЛЫЙ ФЛАГ — ЭТО СОСТОЯНИЕ ЭТОГО ЖЕ УЗЛА, А НЕ ВТОРОЙ УЗЕЛ ─────────────
## ЖАЛОБА ВЛАДЕЛЬЦА СО СКРИНШОТОМ: у копейщика с красным вымпелом ветерана
## поверх вырастал ВТОРОЙ флагшток с белым полотнищем — «юнит с двумя флагами».
## Так и было по построению: знамя ветеранства висело на знаменосце, а белый
## флаг паники заводился ОТДЕЛЬНЫМ узлом над центром отряда, и оба узла
## сходились на экране в одну точку.
##
## Теперь у отряда РОВНО ОДИН узел флага, а бой это или сдача — вопрос ЛЕНТЫ.
## Признак хранится здесь же, рядом с уровнем, и по той же причине: чтобы
## GameManager мог решить «картинку надо перестроить» одним сравнением, не
## пересобирая квад каждый кадр
var shown_white: bool = false

## Знамя орды — рваные «язычки» (BannerArt.goblin_tongue_texture), а не
## аккуратный вымпел с лычками (ТЗ 20.10.2026, блок 8)
var shown_goblin: bool = false
## Ступень престижа легенды — хвост под золотым флагом (ТЗ 28.10.2026)
var shown_flags: int = 0
## Знамя полководца орды — язычки с цифрой и синим хвостом (ТЗ 28.10.2026)
var shown_boss: bool = false
## Цвет стороны людей (ТЗ 31.10.2026): 1 — красный ИИ, красное поле
var shown_side: int = 0
## Отряд, чьё это знамя (клик по знамени выбирает отряд — ТЗ 31.10.2026)
var squad_id: int = 0

## ── ЗНАМЯ ОРДЫ КРУПНЕЕ (ТЗ 25.10.2026, блок 3) ─────────────────────────────
## Гоблин в SIZE_SCALE раз крупнее человека, а лоскуты висели людского
## размера и терялись над толпой. Квад × GOBLIN_SCALE — как у штандарта элиты
const GOBLIN_SCALE := 1.45
## Золотой квадрат легендарных с хвостом престижа (ТЗ 25.10.2026)
const LEGEND_SCALE := 1.3

## ── КАРТИНКА ЗНАМЕНИ — ОДНО РЕШЕНИЕ ДЛЯ ВСЕХ ПОТРЕБИТЕЛЕЙ ──────────────────
## Живое знамя (build) и упавшее (GameManager._lay_fallen_banner) обязаны
## выглядеть одинаково (шапка BannerArt), поэтому выбор ленты, масштаба и
## сдвига древка — здесь, один раз: [текстура, множитель квада, сдвиг древка
## в метрах при k = 1 (−1 — как у вымпела)].
##   орда            → зелёные язычки × GOBLIN_SCALE (белые — в панике);
##   легендарные     → чистый золотой квадрат × LEGEND_SCALE, под ним хвост
##                     престижа легенды (flags: красный 1-3 → синий 1-3);
##   элита не-легенда → бордовый штандарт × ELITE_SCALE (как было);
##   прочие          → вымпел шкалы
## side — цвет стороны людей (BannerArt.side_of: 0 игрок, 1 красный ИИ)
static func spec(level: int, elite: bool, goblin: bool, elite_lvl: int,
		flags: int = 0, white: bool = false, boss: bool = false, side: int = 0) -> Array:
	var lvl: int = maxi(level, 1)
	# Полководец орды: язычки + цифра + синий хвост (ТЗ 28.10.2026); в
	# панике — тот же белый флаг орды
	# Рваный штандарт орды висит по оси древка, как бордовый (ТЗ 29.10.2026)
	var rag_off: float = _BannerArt.elite_pole_offset_px() * PIXEL_SIZE
	if boss and goblin and not white:
		return [_BannerArt.boss_texture(level), GOBLIN_SCALE * BOSS_SCALE, -1.0]
	if goblin:
		var legend_g: bool = lvl >= _UCfgS.VET_BANNER_TIERS.size()
		return [_BannerArt.goblin_tongue_texture(lvl, white, flags), GOBLIN_SCALE,
			rag_off if legend_g else -1.0]
	if white:
		return [_BannerArt.white_flag_texture(), 1.0, -1.0]
	# ── ШТАНДАРТ СТАРШЕ ЗОЛОТА (ТЗ 29.10.2026) ──────────────────────────────
	# Легендарному отряду выдали штандарт за общий опыт — золотой квадрат
	# сменяется бордовым штандартом. Лычки на жёлтом пятаке — уровень
	# ШТАНДАРТА (1-3 красные, 4-6 синие), а не ранг убийств: общий опыт и
	# личный не смешиваются. Прежде проверка легенды стояла выше, и выдача
	# легенде на картинке не меняла ничего
	if elite and _Opt.standard_squad:
		return [_BannerArt.elite_texture(elite_lvl, level, side), ELITE_SCALE,
			_BannerArt.elite_pole_offset_px() * PIXEL_SIZE]
	if lvl >= _UCfgS.VET_BANNER_TIERS.size():
		# Чистый золотой квадрат; хвост престижа — по flags; бордового
		# мини-флажка штандарта под золотом больше нет (ТЗ 28.10.2026)
		return [_BannerArt.legend_texture(flags, side), LEGEND_SCALE, -1.0]
	if elite:
		return [_BannerArt.elite_texture(elite_lvl, level, side), ELITE_SCALE,
			_BannerArt.elite_pole_offset_px() * PIXEL_SIZE]
	return [_BannerArt.texture_for(lvl, side), 1.0, -1.0]

## Знамя полководца крупнее язычков орды ещё на столько (ТЗ 28.10.2026)
const BOSS_SCALE := 1.2

static func create(level: int, elite: bool = false, goblin: bool = false,
		elite_lvl: int = 1, flags: int = 0, boss: bool = false, side: int = 0) -> MeshInstance3D:
	var root := MeshInstance3D.new()
	root.set_script(load("res://scripts/SquadBanner.gd"))
	root.name = "SquadBanner"
	root.build(level, elite, goblin, elite_lvl, flags, boss, side)
	return root

## elite — индивидуальное звание отряда: красный штандарт × ELITE_SCALE вместо
## вымпела общего ветеранства (ТЗ 13.10.2026, письмо 7)
## elite_lvl — уровень элиты (римская цифра), level — общее ветеранство:
## у штандарта элиты оно рисуется лычками внизу полотнища (ТЗ 22.10.2026)
## flags — ступень престижа легенды, хвост под золотом (ТЗ 28.10.2026)
func build(level: int, elite: bool = false, goblin: bool = false, elite_lvl: int = 1,
		flags: int = 0, boss: bool = false, side: int = 0) -> void:
	shown_side = side
	shown_level = maxi(level, 1)
	shown_white = false
	shown_elite = elite
	shown_elite_lvl = elite_lvl if elite else 0
	shown_flags = flags
	shown_boss = boss
	# Присваивание, а не «только взвести»: орда, подобравшая реликвию, носит
	# штандарт вместо язычков (GameManager.refresh_squad_banner), и признак
	# обязан сниматься
	shown_goblin = goblin
	var sp: Array = spec(shown_level, elite, shown_goblin, elite_lvl, flags, false, boss, side)
	build_texture(sp[0], float(sp[1]), float(sp[2]))

## ── ПОКАЗАТЬ БЕЛОЕ ПОЛОТНИЩЕ ВМЕСТО БОЕВОГО ────────────────────────────────
## `level` запоминается даже у отряда БЕЗ звания (там он ноль): по нему знамя
## вернётся в боевой вид, когда паника спадёт, — а у новобранца «вернуться»
## означает «исчезнуть», и это решает GameManager.
## У ОРДЫ БЕЛЕЕТ ЕЁ ЖЕ ФЛАГ (ТЗ 25.10.2026): те же язычки, белая ткань —
## а не людской белый вымпел
func show_white(level: int, goblin: bool = false) -> void:
	shown_level = level
	if goblin:
		shown_goblin = true
	if shown_white and mesh != null:
		return
	shown_white = true
	var sp: Array = spec(level, false, shown_goblin, 0, 0, true)
	build_texture(sp[0], float(sp[1]), float(sp[2]))

## Собрать квад под ГОТОВУЮ ленту. Вынесено из build() ради белого флага
## паники: у него нет уровня, а всё остальное — размер, ветровой материал,
## отключённая тень — обязано совпадать со знаменем до строчки
## k — множитель размера квада (штандарт элиты: ELITE_SCALE); сдвиг древка и
## высота центра едут за ним: низ древка остаётся на той же высоте над землёй
## pole_off — сдвиг древка от центра холста в метрах при k = 1 (у штандарта
## элиты древко стоит правее, см. BannerArt.ELITE_POLE_X); < 0 — как у вымпела
func build_texture(tex: Texture2D, k: float = 1.0, pole_off: float = -1.0) -> void:
	if tex == null:
		mesh = null
		return
	var sz: Vector2 = tex.get_size()
	var quad := QuadMesh.new()
	quad.size = Vector2(sz.x * PIXEL_SIZE * k, sz.y * PIXEL_SIZE * k)
	pole_offset = (POLE_OFFSET_X if pole_off < 0.0 else pole_off) * k
	# Центр поднимается на половину прибавки высоты: нижний край квада (низ
	# древка в руке знаменосца) стоит там же, где у обычного знамени
	var base_h: float = float(_BannerArt.H) * PIXEL_SIZE
	_center_y = CENTER_Y + (quad.size.y - base_h) * 0.5
	# ── МАТЕРИАЛ ВЕТРА, А НЕ НЕПОДВИЖНЫЙ ───────────────────────────────────
	# Тот же шейдер, что у растительности (cyl_billboard): доворот к камере,
	# компенсация наклона камеры (V_STRETCH) и срез альфы — всё уже есть, и
	# всё нужно знамени ровно в том же виде, что и кусту.
	#
	# ИМЕННО ВЕТРОВОЙ: он гнёт квад у ВЕРХА, оставляя низ на месте, — то есть
	# полотнище колышется, а древко стоит. Для флага это буквально то, что надо,
	# и стоит оно ноль: изгиб считает тот же шейдер, что и так рисует квад.
	# Фаза и темп у каждого знамени свои, поэтому знамёна соседних отрядов не
	# машут в один такт (та же оговорка, что у кустов и у дыма хижин)
	quad.material = _BBUtil.make_wind_material(tex)
	mesh = quad
	# Тени знамя не отбрасывает: тень тут рисует отдельный слой у бойцов, а
	# честная тень от полотнища на траве потребовала бы прохода теней для
	# прозрачного квада — цена, которой этой декорации не полагается
	cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF

## Поставить знамя над знаменосцем. Точка — НАРИСОВАННАЯ (см. шапку)
func place_at(draw_pos: Vector3, ground_y: float) -> void:
	global_position = Vector3(draw_pos.x + pole_offset,
		ground_y + _center_y, draw_pos.z)
