## ОБЗОР (ТУМАН ВОЙНЫ)
## ═══════════════════════════════════════════════════════════════════════════
## Радиус, на котором юнит раскрывает туман, — VISION_MULT дальностей его атаки,
## но не меньше VISION_MIN.
## ── ЧИСЛА СОКРАЩЕНЫ ПО ЗАКАЗУ ВЛАДЕЛЬЦА (авг. 2026) ────────────────────────
## Жалоба со скриншотом: «радиус открытия тумана от отряда слишком огромный,
## открывает почти полкарты за лесом». Так и было по арифметике: у лучника
## дальность 20, множитель 3 — обзор 60 м при полукарте в 130×73. Один отряд
## стрелков раскрывал круг диаметром 120 м, то есть почти всю ширину карты.
##
## Множитель урезан до 1.6. Ниже единицы его опускать НЕЛЬЗЯ ни при каких
## правках баланса: обзор обязан быть больше дальности оружия, иначе стрелок
## бьёт в темноту, а игрок не видит, по кому. 1.6 оставляет лучнику 32 м —
## полторы дистанции выстрела.
const VISION_MULT := 1.6
## Нижний предел, и он обязателен. У пехоты attack_range ≈ 1.6-2.2, то есть по
## голой формуле мечник видел бы на три метра вокруг себя: армия из одних
## мечников шла бы по карте практически вслепую. Предел не спорит с формулой,
## а лишь не даёт ей выродиться на ближнем бое
const VISION_MIN  := 15.0
## Обзор постройки. У зданий нет дальности атаки, поэтому число своё —
## примерно как у стрелка, чтобы база видела свои подступы.
## Сокращён вместе с множителем: с прежними сорока двумя метрами база из шести
## построек раскрывала пятно шире, чем вся армия вместе взятая
const BUILDING_VISION := 34.0
## ── КРЕПОСТЬ ВИДИТ ДАЛЬШЕ ЛЮБОГО ДОМА (заказ владельца 10.09.2026) ────────
## «При постройке Ратуши/Крепости круг тумана вокруг неё расширяется». Число
## выше обзора башни (TOWER_VISION 35): башня — это глаз на рубеже, а крепость
## — центр базы, вокруг которого игрок и должен видеть свою землю
const CASTLE_VISION := 62.0

## Радиус обзора по дальности атаки
static func vision_radius(attack_range: float) -> float:
	return maxf(attack_range * VISION_MULT, VISION_MIN)

## Найти слот улучшения по id (пустой словарь, если нет).
##
## УЗЛЫ ДРЕВА КУЗНИЦЫ — ТОЖЕ СЛОТЫ. forge_config собирает каждый узел в том же
## формате, что и запись UPGRADE_SLOTS (id/name/desc/icon/cost_*/research_time/
## applies_to/bonus_*), поэтому вся машинерия исследований — списание ресурсов,
## очередь кузницы, накопление бонусов, мгновенная добавка HP — работает с ними
## без единой отдельной ветки. Разница только в условии доступа: у старого слота
## это одиночное поле requires, у узла древа — массив prerequisites плюс, для
## колонки D, полный ряд (разбирается в GameManager.can_research).
static func get_upgrade_slot(upgrade_id: String) -> Dictionary:
	for slot in UPGRADE_SLOTS:
		var d: Dictionary = slot
		if String(d.get("id", "")) == upgrade_id:
			return d
	return _Forge.get_node(upgrade_id)

## Стоимость слота в формате ResourceManager.spend(): {тип_ресурса: количество}
static func upgrade_cost(slot: Dictionary) -> Dictionary:
	var cost: Dictionary = {}
	var g: float = slot.get("cost_gold",  0.0)
	var w: float = slot.get("cost_wood",  0.0)
	var s: float = slot.get("cost_stone", 0.0)
	var f: float = slot.get("cost_food", 0.0)
	if g > 0.0: cost[Constants.RESOURCE_GOLD]  = g
	if w > 0.0: cost[Constants.RESOURCE_WOOD]  = w
	if s > 0.0: cost[Constants.RESOURCE_STONE] = s
	if f > 0.0: cost[Constants.RESOURCE_FOOD]  = f
	return cost

## Действует ли слот на юнита данного типа
static func slot_applies_to(slot: Dictionary, unit_id: String) -> bool:
	var lst: Array = slot.get("applies_to", [])
	for e in lst:
		var s: String = String(e)
		if s == "all" or s == unit_id:
			return true
	return false
