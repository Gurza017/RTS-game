extends RefCounted
## ═══════════════════════════════════════════════════════════════════════════
## ЛИМИТЫ АРМИИ ИИ — «AI START ARMY LIMIT»
## ═══════════════════════════════════════════════════════════════════════════
## ЕДИНСТВЕННЫЙ файл, который нужно править, чтобы менять масштаб боя.
## Поднимаете лимиты — ИИ копит больше отрядов и позже идёт в атаку;
## опускаете — атакует раньше и меньшими силами.
##
## Файл намеренно без class_name (как unit_stats_config.gd) — подключается
## через preload, поэтому не зависит от кэша глобальных классов Godot.
## Подключение: const _AICfg := preload("res://scripts/ai_start_army_limit.gd")
##
## РАЗМЕР одного отряда задаётся НЕ здесь, а в unit_stats_config.gd
## (SQUAD_SIZE_SPEARMEN / SQUAD_SIZE_ARCHERS / SQUAD_SIZE_SWORDSMEN):
## тут указывается только СКОЛЬКО ОТРЯДОВ каждого типа нужно ИИ.
##
## Полная армия при значениях ниже: (5 + 5 + 5) отрядов × 30 моделей = 450 бойцов.
## Для стресс-теста «300 на 300» достаточно оставить как есть; для быстрой
## проверки логики поставьте по 1 отряду каждого типа.

# ─────────────────────────────────────────────────────────────────────────────
# 1. ЛИМИТЫ: до чего ИИ копит силы, прежде чем идти в общую атаку
# ─────────────────────────────────────────────────────────────────────────────

## Сколько ОТРЯДОВ каждого типа ИИ доводит до строя.
## Ключи — те же id, что в unit_stats_config.STATS.
const SQUAD_LIMIT := {
	"spearman": 10,   # отрядов копейщиков
	"archer":   5,   # отрядов лучников
	"warrior":  6,   # отрядов мечников (рыцарей)
}

## Сколько рабочих ИИ держит на экономике (потолок).
const WORKER_LIMIT := 40

## С чего ИИ начинает партию — ровно как игрок: замок и горстка рабочих.
## Никаких стартовых войск: армия появляется ТОЛЬКО через очередь найма.
const START_WORKERS := 5

# ─────────────────────────────────────────────────────────────────────────────
# 2. ГАРНИЗОН И ИЗЛИШКИ
# ─────────────────────────────────────────────────────────────────────────────

## Сколько отрядов КАЖДОГО типа остаётся в боевой позиции у замка.
## Эти отряды переводятся в стойку «ЗАЩИТА» и с места не уходят.
## Рабочие в счёт не идут никогда.
const HOME_GUARD_PER_TYPE := 7

## Всё, что сверх гарнизона, ИИ отправляет в бой к озеру (центр карты),
## не дожидаясь полного лимита. Поставьте false, чтобы ИИ копил всё дома
## и выходил единственной большой волной.
const SEND_SURPLUS_TO_LAKE := true

## Точка сбора «в поле». Vector3.INF-подобного значения нет, поэтому
## USE_LAKE_AS_RALLY=true берёт центр озера из Main.LAKE_CENTER,
## а иначе используется RALLY_POINT_OVERRIDE.
const USE_LAKE_AS_RALLY := true
const RALLY_POINT_OVERRIDE := Vector3(0.0, 0.0, 0.0)

## Радиус вокруг точки сбора, внутри которого ИИ считает, что «бой у озера идёт».
const LAKE_CONTEST_RADIUS := 26.0

## Если у озера не осталось боевых юнитов игрока, а свои там есть —
## ИИ считает центр карты взятым и идёт добивать базу игрока.
## В оборонительном режиме (DEFENSIVE_MODE) этот пункт не работает.
const PUSH_BASE_AFTER_LAKE_WIN := true

## ── ВОЛНА ВЫХОДИТ ЦЕЛИКОМ, А НЕ ПО ОДНОМУ ──────────────────────────────────
## Лимит по отрядам (SQUAD_LIMIT) отвечает на вопрос «хватает ли войск», но не
## на вопрос «собрались ли они». Отряды рождаются в бараке по одному и с этого
## момента шли на базу игрока каждый своим ходом — противник встречал их
## поштучно и так же поштучно перемалывал.
## Теперь атака начинается, только когда MUSTER_FRACTION боевых отрядов уже
## стоят на точке сбора. Признак «волна пошла» защёлкивается: собравшаяся волна
## не рассыпается обратно из-за одного отставшего.
const AI_MUSTER_BEFORE_ATTACK := true
## Какая доля отрядов волны должна дойти до точки сбора
const MUSTER_FRACTION := 0.75
## Радиус точки сбора, м
const MUSTER_RADIUS := 26.0

# ─────────────────────────────────────────────────────────────────────────────
# 2b. ОБОРОНИТЕЛЬНЫЙ РЕЖИМ
# ─────────────────────────────────────────────────────────────────────────────

## ИИ НЕ ХОДИТ В ЛОБОВУЮ НА БАЗУ ИГРОКА. Он развивает экономику, набирает
## войска, занимает свою половину карты (вместе с озером), держит там
## оборонительные порядки и патрулирует рубеж. В бой вступает только с тем,
## кто зашёл в его зону. false — прежнее поведение со штурмом базы.
const DEFENSIVE_MODE := true

## Какую долю карты ИИ считает своей: 0.5 — ровно половина, до центра (озера).
## Рубеж обороны проходит по этой доле пути от своего замка к базе игрока.
const MAP_CONTROL_FRACTION := 0.5

## Ширина рубежа обороны, метры: по ней раскладываются отряды-заслоны
const DEFENSE_LINE_WIDTH := 44.0

## Радиус вокруг рубежа, внутри которого ИИ считает противника вторгшимся
## и отвечает контратакой (за пределы радиуса не преследует)
const DEFENSE_ENGAGE_RADIUS := 30.0

## ПАТРУЛИ: сколько отрядов ходит по своей территории вместо стояния на месте
const PATROL_SQUADS := 5
## Радиус патрульного круга вокруг рубежа, метры
const PATROL_RADIUS := 16.0
## Сколько секунд отряд стоит на патрульной точке, прежде чем идти к следующей
const PATROL_DWELL := 12.0

## АВТО-ВЫБОР ВЕТЕРАНСКИХ НАГРАД. Получив звёздочку, отряд ИИ сам берёт бонус
## (игроку такое окно выбора показывает интерфейс). Порядок предпочтений —
## по идентификаторам из unit_stats_config.VETERAN_LEVEL_BONUSES; чего нет
## в списке уровня, берётся первым доступным
## КОНТРАТАКА В ОБОРОНЕ. false — прежнее поведение: заслон и патруль стоят
## столбами, даже когда рядом идёт бой (ровно на это и жаловался игрок).
## true — противник в DEFENSE_ENGAGE_RADIUS снимает секцию с поста, и она
## дерётся всем составом, а не ждёт, пока её обойдут
const AI_COUNTER_ATTACK := true

const AI_AUTO_VETERAN := true
const AI_VETERAN_PREFERENCE := ["attack", "armor", "health", "defense", "speed"]

# ─────────────────────────────────────────────────────────────────────────────
# 3. ТЕМП
# ─────────────────────────────────────────────────────────────────────────────

## Мирная фаза: сколько секунд ИИ вообще не воюет и только строит экономику.
## 0.0 — воевать с первой секунды.
const PEACE_SECONDS := 240.0

## Как часто думает ИИ (сек). Меньше — резвее реакция, дороже по процессору.
const THINK_INTERVAL := 2.0

## Сколько заказов найма ИИ держит в очереди здания одновременно.
## 1 — строго по одному отряду за раз (отряды выходят чередой, а не пачкой).
const MAX_QUEUED_ORDERS := 1

## АВАРИЙНОЕ ВОССТАНОВЛЕНИЕ. Если армия выбита, барак отстраивается
## в приоритете и бесплатно, чтобы ИИ не залипал без войск навсегда.
const REBUILD_BARRACKS_FREE := true
## Ниже какого числа боевых юнитов ИИ считает армию потерянной
const ARMY_LOST_THRESHOLD := 10

# ─────────────────────────────────────────────────────────────────────────────
# 4. ТАКТИКИ ПОСТРОЕНИЯ АТАКУЮЩЕЙ ВОЛНЫ
# ─────────────────────────────────────────────────────────────────────────────
## ИИ выбирает тактику на каждую новую волну (по кругу или случайно).
## Смысл полей: для каждого типа юнита задано смещение относительно центра
## волны в «локальных» осях — depth (вдоль курса атаки: + вперёд, − назад)
## и flank (в стороны: 0 — по центру, 1 — развести по обоим краям).
##
##   "archers_front" — лучники впереди, копейщики за ними, рыцари в тылу
##   "spears_back"   — рыцари впереди, лучники по краям, копейщики сзади
##   "one_mass"      — все идут одной кучей сразу (никакого построения)
## ── БОЕВОЙ ПОРЯДОК ОДИН ДЛЯ ВСЕХ ТАКТИК (заказ владельца, авг. 2026) ────────
## Прежняя таблица меняла местами САМИ РОДА ВОЙСК: «archers_front» выставляла
## лучников перед копейщиками, «spears_back» — рыцарей впереди всех. Требование
## теперь прямое и обратное этому: первая линия — копейщики фронтом к игроку,
## вторая — лучники СТРОГО за их спинами, мечники по краям. Строй, в котором
## стрелки стоят перед стеной копий, — это не тактика, а способ отдать стрелков
## даром, и на большой армии это было хорошо видно.
##
## Тактики остались, но различаются теперь ГЛУБИНОЙ И ШИРИНОЙ, а не порядком
## родов: насколько далеко отстают лучники, насколько широко расходятся фланги.
## Порядок «копья — луки — фланги» во всех трёх одинаков и является инвариантом
## (его проверяет qa_ai #6).
##
## depth > 0 — БЛИЖЕ К ИГРОКУ вдоль курса волны; flank — доля FLANK_SPREAD,
## знак чередуется по отрядам одного рода, то есть «по обоим краям»
const TACTICS := [
	{
		"id": "shield_wall", "name": "Стена щитов",
		"layout": {
			"spearman": {"depth":  0.0, "flank": 0.0},
			"archer":   {"depth": -7.0, "flank": 0.0},
			"warrior":  {"depth": -2.0, "flank": 1.0},
		},
	},
	{
		"id": "wide_front", "name": "Широкий фронт",
		"layout": {
			"spearman": {"depth":  0.0, "flank": 0.0},
			"archer":   {"depth": -9.0, "flank": 0.0},
			"warrior":  {"depth":  0.0, "flank": 1.4},
		},
	},
	{
		"id": "deep_column", "name": "Глубокая колонна",
		"layout": {
			"spearman": {"depth":  0.0, "flank": 0.0},
			"archer":   {"depth": -5.0, "flank": 0.0},
			"warrior":  {"depth": -4.0, "flank": 0.6},
		},
	},
]

## Разнос фланговых отрядов от центра волны, метры (для "flank": 1.0)
const FLANK_SPREAD := 14.0

## ── ФРОНТОМ К АРМИИ, А НЕ К ЗДАНИЮ ──────────────────────────────────────────
## Курс волны считался от своего замка к ЗАМКУ игрока, и строй разворачивался
## по этой линии независимо от того, где стоит армия противника. Пока игрок
## сидит дома, разницы нет; стоит ему встретить волну в поле сбоку — и стена
## копий встречает его боком, а лучники оказываются не за спинами своих, а
## сбоку от них. Требование владельца — строиться ОТНОСИТЕЛЬНО АРМИИ ИГРОКА.
## Если армии поблизости не видно, целью остаётся база: это и есть «идём туда,
## где противник обязан появиться»
const AI_FACE_PLAYER_ARMY := true
## На каком расстоянии от волны ИИ вообще замечает армию игрока, метры
const ARMY_AIM_RADIUS := 100.0

## true — тактики идут по кругу (предсказуемо, удобно тестировать),
## false — выбираются случайно
const TACTICS_IN_ORDER := true

# ─────────────────────────────────────────────────────────────────────────────
# 5. ТАКТИКА НА УРОВНЕ ОТРЯДА
# ─────────────────────────────────────────────────────────────────────────────
# Всё, что ниже, считается РАЗ В THINK_INTERVAL и РАЗ НА ОТРЯД — не на бойца.
# Это принципиально: армия ИИ это десяток отрядов и пара сотен человек, и
# тактика, посчитанная поимённо, стоила бы в двадцать раз дороже, ничего не
# добавляя — решения всё равно принимаются за отряд целиком.

## ── ИССЛЕДОВАНИЯ В КУЗНИЦЕ ──────────────────────────────────────────────────
## ИИ покупал только ПЛОСКИЕ слоты (UPGRADE_SLOTS) — наследство от старой
## кузницы. Древо (forge_config, 4 рода войск × 20 узлов) он не трогал вовсе,
## то есть почти вся наука в игре проходила мимо него, и на длинной партии
## прокачанный игрок встречал ИИ с базовыми характеристиками
const AI_RESEARCH_FORGE := true

## Что ИИ ценит в узле древа, в порядке убывания. Узел оценивается суммой
## своих бонусов с этими весами, берётся лучший из ДОСТУПНЫХ
## Веса подобраны так, чтобы типичный узел любой ветки давал СОПОСТАВИМЫЙ балл:
## боевой «+3 к урону» это 9, экономический «+3 к грузу» — 6, «−0.2 с к циклу» —
## 5. Иначе экономика с её мелкими числами не выигрывала бы у войны никогда, и
## ветка рабочего осталась бы у ИИ такой же мёртвой, какой было всё древо
const AI_FORGE_WEIGHTS := {
	"bonus_attack": 3.0,
	"bonus_armor":  2.5,
	"bonus_health": 1.6,
	"bonus_speed":  1.2,
	"bonus_push":   0.6,
	"bonus_morale": 0.4,
	"bonus_carry":  2.0,
	"bonus_gather": 25.0,
}

## Рода войск, чьи ветки ИИ качает В ДОПОЛНЕНИЕ к тем, что реально нанимает
## (_AICfg.combat_types()). Рабочий в combat_types() отсутствует по определению,
## а ветка у него есть, и она — единственная, которая приносит пользу с первой
## минуты партии: экономика работает и тогда, когда воевать ещё нечем
const AI_FORGE_EXTRA_BRANCHES := ["worker"]

## Сколько золота ИИ держит нетронутым на найм. Без резерва он вкладывал бы
## всё в науку и переставал пополнять выбитые отряды — прокачанная армия из
## трёх человек проигрывает необученной из тридцати
const AI_RESEARCH_GOLD_RESERVE := 300.0

## ── СПОСОБНОСТИ-РЕЖИМЫ ОТРЯДОВ (колонка D древа) ────────────────────────────
## Исследование в кузнице открывает способность фракции, но каждый отряд ещё
## докупает её за золото. Без этого ИИ качал бы «Залповый огонь» и не применял
## его ни разу: у игрока покупку делает клик по панели, а у ИИ — некому.
const AI_BUY_SQUAD_ABILITIES := true
## Резерв золота под докупку. Отдельный от исследовательского: способность
## разовая и дорогая, а найм пополнения важнее любого режима стрельбы
const AI_ABILITY_GOLD_RESERVE := 500.0

## ── ФЛАНГОВЫЙ ОБХОД МЕЧНИКОВ ────────────────────────────────────────────────
## Мечник в лоб на строй копейщиков — это размен, который ИИ всегда проигрывает.
## Его дело — обойти стену по дуге и добраться до стрелков в тылу
const AI_WARRIOR_FLANK := true
## Насколько широко мечники обходят чужой строй, метры (вбок от курса)
const FLANK_ARC_RADIUS := 24.0
## С какой дистанции до цели начинается обход. Ближе — уже поздно обходить
const FLANK_TRIGGER_DIST := 22.0
## В каком радиусе от цели волны ищутся стрелки игрока
const FLANK_REACH := 55.0
## Дальность оружия, выше которой юнит считается СТРЕЛКОМ (метры). Берётся
## порогом, а не списком типов: новый род стрелков подхватится сам
const RANGED_ATTACK_RANGE := 6.0

## ── КАЙТ ЛУЧНИКОВ ───────────────────────────────────────────────────────────
## Лучник в ближнем бою бесполезен и умирает первым. Подошла пехота — отряд
## отходит за спину своих копейщиков и продолжает стрелять оттуда
const AI_ARCHER_KITE := true
## Ближе этого чужая пехота считается угрозой лучникам, метры
const KITE_TRIGGER_DIST := 13.0
## На сколько метров ЗА спину прикрывающего отряда отходят лучники
const KITE_BACK_DIST := 8.0

## ── ОТСТУПЛЕНИЕ ОТРЯДА В КРЕПОСТЬ ───────────────────────────────────────────
## Выбитый отряд, оставленный в поле, доедают бесплатно. Отправленный в замок
## он лечится и пополняется (см. Castle.request_garrison) и возвращается в строй
const AI_SQUAD_RETREAT := true
## Доля от полного отряда (живых бойцов × их здоровье), ниже которой отряд
## уходит на восстановление
const RETREAT_STRENGTH := 0.35
## Отряд не отступает, пока рядом нет противника: уводить с поста целый отряд
## из-за старых ран незачем. Радиус поиска угрозы, метры
const RETREAT_THREAT_RADIUS := 26.0
## ЗАВЯЗАЛСЯ В РУКОПАШНОЙ — ДЕРЁТСЯ ДО КОНЦА. Отряд, развернувшийся спиной
## посреди схватки, не отступает, а гибнет бесплатно: режим отхода глушит и
## авто-агро, и ответный удар. Отходить можно ДО контакта и ПОСЛЕ него, но не
## ИЗ него. Полноценной системы морали и паники в игре пока нет — когда появится,
## этот тумблер станет её частным случаем, а не отдельным правилом
const AI_NO_RETREAT_IN_MELEE := true

## ── ФАЛАНГА ─────────────────────────────────────────────────────────────────
## Сколько шеренг держит отряд копейщиков. Число колонок из него выводится
## (cols = ceil(людей / шеренг)), поэтому ряды получаются РОВНЫМИ при любом
## размере отряда, а не «три полных и один огрызок»
const PHALANX_RANKS := 4
## Копейщики держат стойку ЗАЩИТА и на марше, пока противника нет рядом:
## именно она опускает копья (см. Spearman._spear_leveled). Без этого блок
## шёл щетиной вверх и опускал копья только по приказу атаки
const AI_SPEAR_PHALANX_ON_MARCH := true
## Ближе этого противник считается «контактом»: копейщики переходят в АТАКУ,
## лучники начинают кайт
const CONTACT_RADIUS := 24.0

## ── ЗАСЛОН У БАЗЫ ───────────────────────────────────────────────────────────
## Гарнизон встаёт не кольцом вокруг замка, а строем ЛИЦОМ к противнику:
## копейщики впереди, стрелки за их спинами, мечники по краям
const AI_BASE_SCREEN := true
## Дистанции от замка по родам войск, метры
const SCREEN_SPEAR_DIST := 13.0
const SCREEN_BOW_DIST   := 7.0
const SCREEN_FLANK_DIST := 10.0
const SCREEN_FLANK_SIDE := 12.0
## Ширина заслона по фронту, метры
const SCREEN_WIDTH := 18.0

# ─────────────────────────────────────────────────────────────────────────────
# ХЕЛПЕРЫ
# ─────────────────────────────────────────────────────────────────────────────

## Сколько отрядов данного типа нужно ИИ (0 — тип не нанимается вовсе)
static func squad_limit(unit_id: String) -> int:
	return int(SQUAD_LIMIT.get(unit_id, 0))

## Боевые типы в порядке приоритета найма
static func combat_types() -> Array:
	var out: Array = []
	for key in SQUAD_LIMIT:
		var uid: String = String(key)
		if squad_limit(uid) > 0:
			out.append(uid)
	return out

## Всего отрядов в полной армии — по этому числу ИИ решает, что пора в атаку
static func total_squad_limit() -> int:
	var n := 0
	for key in SQUAD_LIMIT:
		n += squad_limit(String(key))
	return n

## Тактика по индексу волны
static func tactic_for_wave(wave_index: int) -> Dictionary:
	if TACTICS.is_empty():
		return {}
	if TACTICS_IN_ORDER:
		return TACTICS[wave_index % TACTICS.size()]
	return TACTICS[randi() % TACTICS.size()]

## Смещение типа юнита внутри выбранной тактики.
## course — единичный вектор курса атаки в плоскости XZ.
## side: -1 или +1 — на какой край уходит фланговый отряд.
static func tactic_offset(tactic: Dictionary, unit_id: String, course: Vector3, side: float) -> Vector3:
	var layout: Dictionary = tactic.get("layout", {})
	var d: Dictionary = layout.get(unit_id, {})
	var depth: float = d.get("depth", 0.0)
	var flank: float = d.get("flank", 0.0)
	var right := Vector3(-course.z, 0.0, course.x)
	return course * depth + right * (flank * FLANK_SPREAD * side)
