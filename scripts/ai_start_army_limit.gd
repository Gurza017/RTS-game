extends RefCounted
## ═══════════════════════════════════════════════════════════════════════════
## ЛИМИТЫ АРМИИ ИИ — «AI START ARMY LIMIT»
## ═══════════════════════════════════════════════════════════════════════════
## ЕДИНСТВЕННЫЙ файл, который нужно править, чтобы менять масштаб боя.
## Поднимаете лимиты — ИИ копит больше отрядов и позже идёт в атаку;
## опускаете — атакует раньше и меньшими силами.
##
## Файл намеренно без class_name (как unit_stats_config.gd) — подключается
## через preload, поэтому не зависит от кэша глобальных классов Godot.
## Подключение: const _AICfg := preload("res://scripts/ai_start_army_limit.gd")
##
## РАЗМЕР одного отряда задаётся НЕ здесь, а в unit_stats_config.gd
## (SQUAD_SIZE_SPEARMEN / SQUAD_SIZE_ARCHERS / SQUAD_SIZE_SWORDSMEN):
## тут указывается только СКОЛЬКО ОТРЯДОВ каждого типа нужно ИИ.
##
## Полная армия при значениях ниже: (5 + 5 + 5) отрядов × 30 моделей = 450 бойцов.
## Для стресс-теста «300 на 300» достаточно оставить как есть; для быстрой
## проверки логики поставьте по 1 отряду каждого типа.

# ─────────────────────────────────────────────────────────────────────────────
# 1. ЛИМИТЫ: до чего ИИ копит силы, прежде чем идти в общую атаку
# ─────────────────────────────────────────────────────────────────────────────

## Сколько ОТРЯДОВ каждого типа ИИ доводит до строя.
## Ключи — те же id, что в unit_stats_config.STATS.
const SQUAD_LIMIT := {
	"spearman": 7,   # отрядов копейщиков
	"archer":   3,   # отрядов лучников
	"warrior":  4,   # отрядов мечников (рыцарей)
}

## Сколько рабочих ИИ держит на экономике (потолок).
const WORKER_LIMIT := 30

## С чего ИИ начинает партию — ровно как игрок: замок и горстка рабочих.
## Никаких стартовых войск: армия появляется ТОЛЬКО через очередь найма.
const START_WORKERS := 5

# ─────────────────────────────────────────────────────────────────────────────
# 2. ГАРНИЗОН И ИЗЛИШКИ
# ─────────────────────────────────────────────────────────────────────────────

## Сколько отрядов КАЖДОГО типа остаётся в боевой позиции у замка.
## Эти отряды переводятся в стойку «ЗАЩИТА» и с места не уходят.
## Рабочие в счёт не идут никогда.
const HOME_GUARD_PER_TYPE := 1

## Всё, что сверх гарнизона, ИИ отправляет в бой к озеру (центр карты),
## не дожидаясь полного лимита. Поставьте false, чтобы ИИ копил всё дома
## и выходил единственной большой волной.
const SEND_SURPLUS_TO_LAKE := true

## Точка сбора «в поле». Vector3.INF-подобного значения нет, поэтому
## USE_LAKE_AS_RALLY=true берёт центр озера из Main.LAKE_CENTER,
## а иначе используется RALLY_POINT_OVERRIDE.
const USE_LAKE_AS_RALLY := true
const RALLY_POINT_OVERRIDE := Vector3(0.0, 0.0, 0.0)

## Радиус вокруг точки сбора, внутри которого ИИ считает, что «бой у озера идёт».
const LAKE_CONTEST_RADIUS := 26.0

## Если у озера не осталось боевых юнитов игрока, а свои там есть —
## ИИ считает центр карты взятым и идёт добивать базу игрока.
## В оборонительном режиме (DEFENSIVE_MODE) этот пункт не работает.
const PUSH_BASE_AFTER_LAKE_WIN := true

# ─────────────────────────────────────────────────────────────────────────────
# 2b. ОБОРОНИТЕЛЬНЫЙ РЕЖИМ
# ─────────────────────────────────────────────────────────────────────────────

## ИИ НЕ ХОДИТ В ЛОБОВУЮ НА БАЗУ ИГРОКА. Он развивает экономику, набирает
## войска, занимает свою половину карты (вместе с озером), держит там
## оборонительные порядки и патрулирует рубеж. В бой вступает только с тем,
## кто зашёл в его зону. false — прежнее поведение со штурмом базы.
const DEFENSIVE_MODE := true

## Какую долю карты ИИ считает своей: 0.5 — ровно половина, до центра (озера).
## Рубеж обороны проходит по этой доле пути от своего замка к базе игрока.
const MAP_CONTROL_FRACTION := 0.5

## Ширина рубежа обороны, метры: по ней раскладываются отряды-заслоны
const DEFENSE_LINE_WIDTH := 44.0

## Радиус вокруг рубежа, внутри которого ИИ считает противника вторгшимся
## и отвечает контратакой (за пределы радиуса не преследует)
const DEFENSE_ENGAGE_RADIUS := 30.0

## ПАТРУЛИ: сколько отрядов ходит по своей территории вместо стояния на месте
const PATROL_SQUADS := 5
## Радиус патрульного круга вокруг рубежа, метры
const PATROL_RADIUS := 16.0
## Сколько секунд отряд стоит на патрульной точке, прежде чем идти к следующей
const PATROL_DWELL := 12.0

## АВТО-ВЫБОР ВЕТЕРАНСКИХ НАГРАД. Получив звёздочку, отряд ИИ сам берёт бонус
## (игроку такое окно выбора показывает интерфейс). Порядок предпочтений —
## по идентификаторам из unit_stats_config.VETERAN_LEVEL_BONUSES; чего нет
## в списке уровня, берётся первым доступным
## КОНТРАТАКА В ОБОРОНЕ. false — прежнее поведение: заслон и патруль стоят
## столбами, даже когда рядом идёт бой (ровно на это и жаловался игрок).
## true — противник в DEFENSE_ENGAGE_RADIUS снимает секцию с поста, и она
## дерётся всем составом, а не ждёт, пока её обойдут
const AI_COUNTER_ATTACK := true

const AI_AUTO_VETERAN := true
const AI_VETERAN_PREFERENCE := ["attack", "armor", "health", "defense", "speed"]

# ─────────────────────────────────────────────────────────────────────────────
# 3. ТЕМП
# ─────────────────────────────────────────────────────────────────────────────

## Мирная фаза: сколько секунд ИИ вообще не воюет и только строит экономику.
## 0.0 — воевать с первой секунды.
const PEACE_SECONDS := 120.0

## Как часто думает ИИ (сек). Меньше — резвее реакция, дороже по процессору.
const THINK_INTERVAL := 2.0

## Сколько заказов найма ИИ держит в очереди здания одновременно.
## 1 — строго по одному отряду за раз (отряды выходят чередой, а не пачкой).
const MAX_QUEUED_ORDERS := 1

## АВАРИЙНОЕ ВОССТАНОВЛЕНИЕ. Если армия выбита, барак отстраивается
## в приоритете и бесплатно, чтобы ИИ не залипал без войск навсегда.
const REBUILD_BARRACKS_FREE := true
## Ниже какого числа боевых юнитов ИИ считает армию потерянной
const ARMY_LOST_THRESHOLD := 10

# ─────────────────────────────────────────────────────────────────────────────
# 4. ТАКТИКИ ПОСТРОЕНИЯ АТАКУЮЩЕЙ ВОЛНЫ
# ─────────────────────────────────────────────────────────────────────────────
## ИИ выбирает тактику на каждую новую волну (по кругу или случайно).
## Смысл полей: для каждого типа юнита задано смещение относительно центра
## волны в «локальных» осях — depth (вдоль курса атаки: + вперёд, − назад)
## и flank (в стороны: 0 — по центру, 1 — развести по обоим краям).
##
##   "archers_front" — лучники впереди, копейщики за ними, рыцари в тылу
##   "spears_back"   — рыцари впереди, лучники по краям, копейщики сзади
##   "one_mass"      — все идут одной кучей сразу (никакого построения)
const TACTICS := [
	{
		"id": "archers_front", "name": "Лучники впереди",
		"layout": {
			"archer":   {"depth":  6.0, "flank": 0.0},
			"spearman": {"depth":  0.0, "flank": 0.0},
			"warrior":  {"depth": -6.0, "flank": 0.0},
		},
	},
	{
		"id": "spears_back", "name": "Рыцари впереди, лучники по краям",
		"layout": {
			"warrior":  {"depth":  6.0, "flank": 0.0},
			"archer":   {"depth":  0.0, "flank": 1.0},
			"spearman": {"depth": -6.0, "flank": 0.0},
		},
	},
	{
		"id": "one_mass", "name": "Всей кучей",
		"layout": {
			"archer":   {"depth": 0.0, "flank": 0.0},
			"spearman": {"depth": 0.0, "flank": 0.0},
			"warrior":  {"depth": 0.0, "flank": 0.0},
		},
	},
]

## Разнос фланговых отрядов от центра волны, метры (для "flank": 1.0)
const FLANK_SPREAD := 14.0

## true — тактики идут по кругу (предсказуемо, удобно тестировать),
## false — выбираются случайно
const TACTICS_IN_ORDER := true

# ─────────────────────────────────────────────────────────────────────────────
# ХЕЛПЕРЫ
# ─────────────────────────────────────────────────────────────────────────────

## Сколько отрядов данного типа нужно ИИ (0 — тип не нанимается вовсе)
static func squad_limit(unit_id: String) -> int:
	return int(SQUAD_LIMIT.get(unit_id, 0))

## Боевые типы в порядке приоритета найма
static func combat_types() -> Array:
	var out: Array = []
	for key in SQUAD_LIMIT:
		var uid: String = String(key)
		if squad_limit(uid) > 0:
			out.append(uid)
	return out

## Всего отрядов в полной армии — по этому числу ИИ решает, что пора в атаку
static func total_squad_limit() -> int:
	var n := 0
	for key in SQUAD_LIMIT:
		n += squad_limit(String(key))
	return n

## Тактика по индексу волны
static func tactic_for_wave(wave_index: int) -> Dictionary:
	if TACTICS.is_empty():
		return {}
	if TACTICS_IN_ORDER:
		return TACTICS[wave_index % TACTICS.size()]
	return TACTICS[randi() % TACTICS.size()]

## Смещение типа юнита внутри выбранной тактики.
## course — единичный вектор курса атаки в плоскости XZ.
## side: -1 или +1 — на какой край уходит фланговый отряд.
static func tactic_offset(tactic: Dictionary, unit_id: String, course: Vector3, side: float) -> Vector3:
	var layout: Dictionary = tactic.get("layout", {})
	var d: Dictionary = layout.get(unit_id, {})
	var depth: float = d.get("depth", 0.0)
	var flank: float = d.get("flank", 0.0)
	var right := Vector3(-course.z, 0.0, course.x)
	return course * depth + right * (flank * FLANK_SPREAD * side)
