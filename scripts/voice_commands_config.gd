## ── ЕДИНЫЙ ШАГ КРЕСТОВИНЫ (ТЗ 19.09.2026, блок 4) ─────────────────────────
## Одна константа на все четыре направления и на отход. Было: «вперёд» 20 м,
## «в атаку» 40 м, «отступать» 20 м по умолчанию. Названное голосом число
## («отступать на тридцать метров») по-прежнему перебивает шаг — это явная
## воля игрока, а не умолчание
const VOICE_STEP_M := 20.0
## Прежние имена оставлены ссылками — их читают стенды
const RETREAT_DEFAULT_M := VOICE_STEP_M
const FORWARD_M := VOICE_STEP_M
## «В атаку» — радиус поиска ближайшего врага и марш, если врага нет (как было)
const ATTACK_M := 40.0

## Намерения-направления: у них общий шаг и общий разбор дистанции
const DIRECTION_INTENTS := ["forward", "back", "up", "down", "retreat"]

## Слова грамматики Vosk: все словоформы плюс числа плюс [unk]
static func grammar_words() -> Array:
	var seen: Dictionary = {}
	var out: Array = []
	for g in GROUPS.values():
		for w in g["words"]:
			if not seen.has(w):
				seen[w] = true
				out.append(w)
	for it in INTENTS:
		for w in it["words"]:
			if not seen.has(w):
				seen[w] = true
				out.append(w)
	for num in NUMBER_WORDS:
		for part in String(num).split(" "):
			if not seen.has(part):
				seen[part] = true
				out.append(part)
	out.append("[unk]")
	return out

## Приведение текста: строчные, ё → е, только буквы и пробелы
static func normalize(text: String) -> String:
	var t: String = text.to_lower().replace("ё", "е")
	var out := ""
	for ch in t:
		var c: String = ch
		if (c >= "а" and c <= "я") or (c >= "a" and c <= "z") or c == " ":
			out += c
		else:
			out += " "
	return out.strip_edges()

## Разбор фразы → {"intent": id или "", "groups": [типы отрядов] или ["all"],
## "distance": м, "text": нормализованный текст}. Групп может быть несколько
## («копейщики и лучники в атаку»); ни одной названо — "all".
## distance — названное число, иначе VOICE_STEP_M (единый шаг крестовины)
static func match(text: String) -> Dictionary:
	var norm: String = normalize(text)
	var tokens: PackedStringArray = norm.split(" ", false)
	var groups: Array = []
	for gid in GROUPS:
		for tok in tokens:
			if _has_stem(String(tok), GROUPS[gid]["stems"], GROUPS[gid].get("exact", [])):
				if not groups.has(gid):
					groups.append(gid)
				break
	if groups.has("all") or groups.is_empty():
		groups = ["all"]
	var best := ""
	var best_score := 0
	for it in INTENTS:
		var score := 0
		for tok in tokens:
			if _has_stem(String(tok), it["stems"], it.get("exact", [])):
				score += 1
		if score > best_score:
			best_score = score
			best = String(it["id"])
	var dist: float = VOICE_STEP_M
	for num in NUMBER_WORDS:
		if norm.find(String(num)) >= 0:
			dist = float(NUMBER_WORDS[num])
	if tokens.is_empty():
		groups = []
	return {"intent": best, "groups": groups, "distance": dist, "text": norm}

static func _has_stem(tok: String, stems: Array, exact: Array) -> bool:
	for e in exact:
		if tok == String(e):
			return true
	for s in stems:
		if tok.begins_with(String(s)):
			return true
	return false
