	# «фаланга», но НЕ знает «копейщикам», «пикинеры», «копьеносцы»
	"spearman": {
		"words": ["копейщики", "фаланга"],
		"stems": ["копейщик", "фаланг", "пикинер"],
		"exact": [],
	},
	"archer": {
