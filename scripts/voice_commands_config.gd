	# «мечники», «мечникам», «меченосцы», «латники» модель НЕ знает и молча
	# выбрасывает; знает «мечников», «мечи», «рыцари», «воины», «пехота»,
	# «гвардия», «дружина», «щиты». Говорить: «мечников в атаку», «мечи вперёд»,
	# «рыцари стоять», «пехота держать строй»
	"warrior": {
		"words": ["мечников", "мечника", "мечи", "меч", "мечом", "рыцари", "рыцарям",
			"воины", "воинам", "пехота", "пехоте", "пехотинцы", "гвардия", "дружина", "щиты"],
		"stems": ["мечник", "мечи", "мечом", "рыцар", "воин", "пехот", "гвард", "дружин", "щиты"],
		"exact": ["меч"],
	},
	"goblin_rider": {
		"words": ["конница", "всадники", "кавалерия", "кабаны"],
		"stems": ["конниц", "всадник", "кавалер", "кабан"],
		"exact": [],
