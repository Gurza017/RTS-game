extends Node3D
class_name Unit

# ─────────────────────────────────────────────────────────────────────────────
# БОЕЦ — ОБЫЧНЫЙ Node3D, А НЕ ФИЗИЧЕСКОЕ ТЕЛО
#
# Был CharacterBody3D. Замер (qa_node_cost, холодные процессы по группам)
# показал, что ОДИН ФАКТ существования тела в PhysicsServer3D стоит 5.7 мкс на
# бойца в кадр — 900 тел с ПУСТЫМ тиком дают 5.72 мс/кадр, те же 900 как Node3D
# с той же логикой — 0.66 мс. Логика внутри роли не играла вовсе (+0.03 мс).
# На 5000 моделях это 28 мс/кадр при всём бюджете кадра 16.6 мс, то есть цель
# «60 FPS на 90 отрядах» была недостижима в принципе, пока боец — тело.
#
# Платить было НЕ ЗА ЧТО: collision_mask везде нулевой (см. README — включённые
# маски давали дрожание на грунте), move_and_slide/move_and_collide не звались
# ни разу за весь проект, движение и так интегрируется напрямую в
# global_position, а столкновения (чужой строй, стволы, берег) считаются
# геометрией по своим сеткам. Единственным потребителем тела был ОДИН клик
# мышью — и тот сравнивал кандидатов по расстоянию до точки земли, а не по
# геометрии коллайдера (см. SelectionManager._pick_at, теперь берёт бойцов из
# пространственной сетки).
#
# `velocity` был полем CharacterBody3D и объявлен ниже своим: обращений к нему
# в проекте десятки, семантика та же — вектор шага, который сам по себе ничего
# не двигает.
# ─────────────────────────────────────────────────────────────────────────────

const _UStats   := preload("res://scripts/unit_stats_config.gd")
const _Opt      := preload("res://scripts/perf_config.gd")
const _BBUtil   := preload("res://scripts/BillboardUtil.gd")
const _UIAssets := preload("res://scripts/UIAssets.gd")
## Общие меши/материалы всех бойцов — см. scripts/units/UnitVisuals.gd
const _Vis      := preload("res://scripts/units/UnitVisuals.gd")

# BUILDING добавлено В КОНЕЦ намеренно: номера остальных состояний не сдвинулись,
# сравнения вида state == State.DEAD в других скриптах остались верными
enum State { IDLE, MOVING, ATTACKING, GATHERING, RETURNING, DEAD, BUILDING }

const GROUND_OFFSET := 0.8

# ── ПРОСТАЯ ОСТАНОВКА, СВОБОДНОЕ ПЕРЕКРЫТИЕ СОЮЗНИКОВ ────────────────────────
# ОТКУДА БРАЛИСЬ МИКРО-ФРИЗЫ И КАК ЭТО ВЫЛЕЧЕНО.
#
# Дошедший боец продолжал жить полной жизнью: расталкивание сдвигало его с
# точки, возврат в слот тянул обратно, и он бесконечно ходил туда-сюда в
# пределах сантиметров. Пока такой один — не видно; когда в одну точку
# приходят полсотни, весь клубок пересчитывает толчки друг друга каждый кадр
# и не сходится НИКОГДА. Это и есть «дёргаются и подвисают».
#
# Пробовал лечить это умно — допуском прибытия пошире, «смирением» по занятости
# точки, якорями с исключениями, коридорами и смыканием рядов. Каждая добавка
# чинила своё и ломала соседнее: рабочий переставал дотягиваться до жилы, отряд
# не доходил до ворот замка, первая шеренга вставала не там. Сложность и была
# болезнью, поэтому вся она СНЯТА, а не настроена.
#
# Осталось простое правило: СОЮЗНИКИ ДРУГ ДРУГА НЕ ТОЛКАЮТ ВООБЩЕ (они
# свободно перекрываются и проходят насквозь), а дошедший встаёт намертво и
# больше не двигается никем и ничем. Толкаться стало нечем — дрожать тоже.
#
# ЧТО СОЗНАТЕЛЬНО ОСТАЛОСЬ и почему это не противоречит правилу:
#   • ВРАЖЕСКИЙ строй непроходим (_move_blocked / SpatialGrid.enemy_block) —
#     это про бой, а не про толкотню своих;
#   • толчок в ближнем бою (_apply_push) — механика «стенка на стенку», она
#     работает только по ПРОТИВНИКУ и только по ударам;
#   • стволы деревьев обходятся — это геометрия карты;
#   • разметка строя разводит бойцов по РАЗНЫМ точкам, поэтому отряд, которому
#     дали строй, в кучу не сваливается и без всякого расталкивания.

## Радиус прибытия: подошёл ближе — встал
## ── ДОПУСК ПРИБЫТИЯ ────────────────────────────────────────────────────────
## Связан с SEP_MIN_DIST жёстко и в одну сторону: допуск обязан быть БОЛЬШЕ
## личного круга, иначе боец, идущий в точку, где уже стоит союзник, будет
## остановлен разбором наложения ЗА пределами допуска — то есть никогда не
## отчитается о прибытии и будет топтаться вечно (см. разбор у SEP_MIN_DIST и
## проверку qa_crowd A0). Личный круг поднят до 0.4167, поэтому и допуск поехал
## следом: 0.48 — тот же запас над ним, что был у прежней пары 0.2917 / 0.3
const ARRIVE_RADIUS := 0.48

## Боец дошёл и стоит. Флаг оставлен как признак состояния для стендов и
## интерфейса; никакой логики поверх него больше нет
var _settled: bool = false

## Сбросить признак «стою» (боец снова тронулся)
func unsettle() -> void:
	_settled = false

# Единый масштаб всех юнитов (+35% к исходному размеру спрайтов)
const UNIT_SCALE := 1.35
# Базовая высота ЦЕНТРА спрайта, при которой ноги стоят на земле y=0.
# Замерено по альфа-каналу кадров (низ ног ~55-57px от низа кадра 192px,
# ~122px для 320px у копейщика) при pixel_size = 0.008 * UNIT_SCALE.
const SPRITE_BASE_Y := 0.42
# Центр fallback-квада 1.35x2.7 (низ квада на земле)
const QUAD_BASE_Y   := 1.35

# ── Бой «стенка на стенку» ───────────────────────────────────────────────────
# Ближе этого расстояния к ЧУЖОМУ юниту шагнуть нельзя — строй непроходим
const BLOCK_RADIUS  := 0.55
# ── ЖЁСТКОЕ ЯДРО ТЕЛА ДЛЯ БИЛЕТОВ ПРОХОДА ────────────────────────────────────
# Билет на выход из свалки (_forced_move_pass) и билет отхода (_retreat_pass)
# раньше СНИМАЛИ проверку чужих тел целиком, и «выход» длиной в 2.5 м
# пересекал фалангу в контакте насквозь (её глубина в бою — 1.2 м, qa_clash).
# Теперь билет только сужает тело до ядра: сквозь щель между двумя телами
# шеренги (0.17-0.28 м до ближайшего центра) не пройти ни с каким билетом, а
# из окружения на 0.5 м — выйти можно. Дубль ArmyCore.PassCoreFrac: горячий
# путь шага пакетный, а здесь запасная дорога, и правило обязано совпадать
const PASS_CORE_FRAC := 0.55
# Доля шага наружу от тела при скольжении под билетом (дубль
# ArmyCore.PassSlideOut): касательная по нормали в новой точке лежит на
# миллиметры ближе к телу, чем текущая точка, и без сдвига наружу правило
# «прочь» её отвергает (qa_spear C9)
const PASS_SLIDE_OUT := 0.25

# ─────────────────────────────────────────────────────────────────────────────
# ЛИЧНЫЙ ОБЪЁМ БОЙЦА (мягкая коллизия своих)
#
# «Союзники не расталкивают друг друга» осталось в силе: НИКАКИХ сил, скоростей
# и возврата в слот здесь нет и не будет — именно они давали вечное дрожание.
# Появилось другое и гораздо более скромное: РАЗБОР НАЛОЖЕНИЯ. Раз в
# SEP_INTERVAL боец, у которого сосед-союзник залез внутрь личного круга,
# сдвигается на несколько сантиметров вбок — и на этом всё.
#
# Три свойства, из-за которых это НЕ прежнее расталкивание:
#   • расходится ТОЛЬКО ОДИН из пары — с большим instance_id (см.
#     SpatialGrid.ally_overlap). Взаимных, гасящих друг друга поправок нет;
#   • поправка МОНОТОННА: она только увеличивает расстояние и исчезает, как
#     только оно набрано. Ничто не тянет бойца обратно;
#   • SEP_MIN_DIST МЕНЬШЕ, ЧЕМ ARRIVE_RADIUS. Это гарантия от той самой
#     незавершаемой пляски: даже если боец идёт ровно в точку, где уже стоит
#     союзник, разбор остановит его на SEP_MIN_DIST — а это всё ещё внутри
#     допуска прибытия, значит приказ считается выполненным и боец замирает.
#
# Числа выведены, а не подобраны: диаметр личного круга равен САМОМУ ПЛОТНОМУ
# строевому интервалу в проекте (Building.squad_spacing = 0.35 — «плечом к
# плечу»), поэтому разбор наложения физически не может спорить ни с одним
# построением. Допустимое перекрытие — треть радиуса, как и просили: круги
# радиуса r сходятся до 2r - r/3.
## ── РАДИУС ЛИЧНОГО КРУГА ───────────────────────────────────────────────────
## Правило вывода прежнее и единственное: диаметр личного круга равен САМОМУ
## ПЛОТНОМУ СТРОЕВОМУ ИНТЕРВАЛУ В ПРОЕКТЕ — тогда разбор наложения физически не
## может спорить ни с одним построением.
##
## ЧИСЛО ОТСТАЛО ОТ ЭТОГО ПРАВИЛА. Оно выведено из Building.squad_spacing = 0.35
## («плечом к плечу»), а сам интервал с тех пор поднят до 0.55: при 0.35 силуэты
## соседей налезали друг на друга и свежий отряд читался слипшимся комком. Радиус
## за ним не поехал, и личный круг остался вдвое теснее строя.
##
## Ровно это и есть «мягкий радиус отталкивания» из заказа владельца: тысяча
## бойцов обязана ФИЗИЧЕСКИ удерживать ширину строя, а не сминаться в пятно
## вдвое уже собственной разметки. 0.25 — половина плотного интервала с
## небольшим запасом вниз (0.5 против 0.55), то есть строй по-прежнему встаёт
## по разметке, а не растаскивается разбором наложения.
##
## ARRIVE_RADIUS поднят вместе с ним и по той же причине: между ними есть
## жёсткое соотношение, см. разбор выше и qa_crowd A0
const PERSONAL_RADIUS := 0.25
## Какую долю СВОЕГО радиуса боец готов отдать соседу внахлёст
const OVERLAP_ALLOWED := 1.0 / 3.0
## Минимальное расстояние между центрами: 2r - r/3 = 0.4167 м (< ARRIVE_RADIUS)
const SEP_MIN_DIST := PERSONAL_RADIUS * (2.0 - OVERLAP_ALLOWED)

## ── НАСКОЛЬКО ШИРЕ ДЕРЖАТСЯ ДРУГ ОТ ДРУГА РАЗНЫЕ ОТРЯДЫ ────────────────────
## Заказ владельца: «запретить 10 отрядам спрессовываться в единый комок
## размером в 2 отряда». Внутри отряда шеренга обязана стоять плотно — это
## строй; между отрядами плотность такая же означает, что отряды перестали быть
## отрядами и стали толпой.
##
## Множитель, а не отдельная константа в метрах: личная норма у бойца бывает
## своя (крупный гоблин, работающий рабочий — см. sep_radius и WorkOverlap), и
## расширение обязано ехать за ней, а не подменять её фиксированным числом.
##
## 1.6 при SEP_MIN_DIST 0.4167 — это 0.67 м между бойцами разных отрядов против
## 0.42 внутри своего. Меньше просвета между блоками в групповом приказе
## (SelectionManager.GROUP_CELL_GAP = 1.0 м), то есть штатному построению
## группы отрядов это не мешает, а слипнуться в один комок уже не даёт.
## Считает разведение в солвере (ArmyCore.BatchSeparation), не GDScript
const SEP_CROSS_SQUAD := 1.6

## ── ПРОХОД СКВОЗЬ СОЮЗНЫЙ СТРОЙ ────────────────────────────────────────────
## Во сколько раз ОСЛАБЛЯЕТСЯ разбор наложения между ИДУЩИМ и СТОЯЩИМ бойцами
## из РАЗНЫХ отрядов. Единица — прежнее поведение, оно же прежнее заклинивание:
## союзные отряды расталкиваются в SEP_CROSS_SQUAD раз сильнее своих, и
## проходящий отряд упирался в стоящий намертво (замер qa_mass_siege: дошло 18
## из 35 за 6.8 с).
##
## 0.45 — «тела всё ещё не слипаются, но дорогу уступают»: личная норма
## остаётся, просто вдвое мягче. Ноль ставить нельзя — отряды прошли бы друг
## сквозь друга как призраки, слившись в одну кашу спрайтов.
## Действует ТОЛЬКО в паре «один идёт, другой стоит»: два идущих навстречу
## отряда обязаны разойтись как прежде
const SEP_PASS_RELIEF := 0.45

## ── ПОДХОД К ЗДАНИЮ ПО СЕКТОРАМ ────────────────────────────────────────────
## ПОРОГ БЫЛ `rng + RING_LEAD`, И ЭТО НЕ РАБОТАЛО. Кольцо секторов лежит на
## `полугабарит + RING_STANDOFF` (≈6.6 м у замка), а «уже подошёл» считалось от
## `attack_range + _target_pad` — у здания это ≈5.8 м плюс запас, то есть БОЛЬШЕ
## радиуса кольца. Боец объявлялся подошедшим раньше, чем добирался до своего
## сектора, и шёл в центр — куча возвращалась. Теперь сектор действует ровно до
## входа в дистанцию удара.
## Насколько близко к точке сектора считать, что боец в него пришёл
const RING_ARRIVE := 1.5
## Максимальный сдвиг за одну проверку: из свалки боец выбирается за несколько
## тактов, а не выпрыгивает рывком
const SEP_MAX_STEP := 0.05
## Как часто разбирать наложение, секунды (~15 раз в секунду). Не каждый кадр:
## это единственный вызов наружу во всей механике, и он ни разу не срочный
const SEP_INTERVAL := 0.067
## ── МЁРТВАЯ ЗОНА: МЕЛКОЕ НАЛОЖЕНИЕ НЕ РАЗБИРАЕТСЯ ВОВСЕ ─────────────────────
## Поправка считалась при ЛЮБОМ перекрытии, вплоть до долей миллиметра, и в
## плотном строю это давало вечное шевеление: у каждого бойца всегда найдётся
## сосед чуть ближе положенного, суммарная поправка никогда не обнуляется, и
## пятнадцать раз в секунду весь строй мелко перетаптывается. Видно это и по
## жёлтым кольцам выделения — они ездят вместе с бойцами.
## Треть радиуса личного круга (та же доля, что и допустимое перекрытие
## OVERLAP_ALLOWED) — это уже не «наложение», а нормальная теснота строя.
## Ниже неё поправка не применяется, и строй ВСТАЁТ НАСМЕРТЬ.
## Проверяется СЫРАЯ поправка, до ограничения по SEP_MAX_STEP: сам шаг (0.05 м)
## меньше этого порога, и сравнивать надо с тем, что нужно, а не с тем, что
## успевает примениться за один такт
const SEP_DEADZONE := PERSONAL_RADIUS / 3.0

## ── ЛИЧНЫЙ РАДИУС РАСТАЛКИВАНИЯ ─────────────────────────────────────────────
## Ноль означает «как у всех»: солвер возьмёт общую SEP_MIN_DIST. Переопределяют
## его те, у кого спрайт заметно крупнее людского — иначе выбор был бы из двух
## плохих: либо орда слипается в ковёр, либо ради неё раздвигается вся пехота.
## Читается ОДИН РАЗ при рождении строки, в покадровом пути его нет
func sep_radius() -> float:
	return 0.0

## ── ГАБАРИТ ДЛЯ КЛИКА И КОЛЬЦО ПОД НОГАМИ (10.09.2026) ──────────────────────
## Ноль — общие числа пехоты (SelectionManager.UNIT_BODY_H / 0.35). Крупный
## боец (тролль) отдаёт ПОЛОВИНУ ВЫСОТЫ своего рисунка и круг у ног: клик
## считается по всему спрайту, а не по коробке пехотинца в его ногах
## ── МЕТКА ПОД НОГАМИ: ТЕНЬ И ОВАЛЬНОСТЬ КОЛЬЦА (заказ 10.09.2026) ──────────
## shadow_scale — множитель ТЕНИ; ноль означает «тени нет вовсе» (так у
## тролля: сплошное тёмное пятно вчетверо шире пехотинца читалось как
## приклеенный к траве зелёный круг). ring_oval — растяжение кольца по X и Z
## поверх ring_scale: круг под огромным спрайтом выглядит уже его туши, а овал
## ложится по ней
func shadow_scale() -> float:
	return ring_scale()

## ── ТОНКИЙ ОБВОД ДЛЯ КРУПНОГО БОЙЦА (заказ спринта 14) ────────────────────
## Ноль — «рисовать обычным кольцом бойца». Больше нуля — РАДИУС В МЕТРАХ для
## 64-сегментного меша обвода (UnitVisuals.building_ring_mesh), того же, каким
## обводится здание.
##
## ЗАЧЕМ ОТДЕЛЬНЫЙ МЕШ, А НЕ МАСШТАБ. Кольцо бойца — тор в 35 см о ДВЕНАДЦАТИ
## сегментах: под ладонью углов не видно. Тролль требует масштаба ×4.2, и
## масштаб тянет ВСЁ — и толщину трубки, и грубость обвода; на экране это дало
## «толстые кривые красные дуги» со скриншота владельца. Ровно эта же ошибка
## однажды уже ловилась на замке (см. UnitVisuals.building_ring_mesh), и
## лечение у неё то же самое.
##
## Пехота платит за виртуал ОДНО сравнение с нулём в момент выдачи кольца —
## покадрового пути здесь нет вовсе
func fine_ring_radius() -> float:
	return 0.0

## ── ДИСПЕРСИЯ ПО КРУПНОЙ ЦЕЛИ ─────────────────────────────────────────────
## Доля выстрелов, намеренно уходящих В ЗЕМЛЮ рядом с целью, и радиус их
## разброса. У пехоты ноль: по фигуре в человеческий рост промах и так
## означает «мимо», а вот по шестиметровой туше КАЖДАЯ стрела кончалась на
## высоте живота — промахов на экране не возникало вовсе, и щетина стрел в
## траве вокруг тролля не появлялась никогда
func aim_miss_chance() -> float:
	return 0.0

func aim_miss_spread() -> float:
	return 0.0

