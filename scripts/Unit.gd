## Косинус половины лобового сектора. 0.34 — те же ~70°, по которым фаланга
## считает, что противник перед фронтом (PHALANX_FRONT_COS): «в лоб» обязано
## означать одно и то же в обеих механиках, иначе копейщик, отбивший навал,
## по другому правилу считался бы стоящим боком
const CHARGE_FRONT_COS := 0.34

## СТЕНКА КОПИЙ. База — нет; переопределяют копейщики обеих фракций.
## Это свойство РОДА ВОЙСК, а не стойки: копья опущены навстречу коннице и в
## «атаке», иначе фаланга была бы уязвима ровно в тот момент, когда идёт вперёд
func repels_charge() -> bool:
	return false

## Смотрю ли я НАВСТРЕЧУ навалу, пришедшему по направлению dirn (от всадника
## ко мне). Стенка копий работает только лбом — с фланга и с тыла копья
## бесполезны, и это ровно то, ради чего конницу и заводят
func _faces_charge(dirn: Vector3) -> bool:
	var f: Vector3 = _facing
	if f.length_squared() < 1e-6:
		return false
	return (f.x * dirn.x + f.z * dirn.z) < -CHARGE_FRONT_COS

