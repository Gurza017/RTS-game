## Строка пишется СКВОЗНЬ — в тех же местах, где боец и так менял величину, —
## и читается только пакетными обходами, которым иначе пришлось бы трогать
## тысячи объектов подряд. -1 — строка не выдана
var _soa: int = -1
## Состояние, с которым строка была записана в последний раз. По нему тик
## решает, надо ли писать её вообще: стоящий боец не двигается и состояния не
## меняет, значит и записи ему не нужно
var _soa_state: int = -1

## Отряд ведёт этого бойца матрицей — свой шаг он не считает (см. tick_physics
## и GameManager._advance_matrices). Ставит и снимает ТОЛЬКО тот проход
var _matrix_driven: bool = false
## Тыловой напор (этап D1): шаг считает ядро (ArmyCore.RearPressPass), тик
## пропускается. АРЕНДА из GameManager._recalc_melee — гаснет там же, а также
## по удару, смене цели и упору в чужое тело (пробуждение из ядра)
var _rear_press: bool = false
## Автопилот подхода (этап D1): дальняя дорога к цели, шаг считает ядро
## (ArmyCore.AutopilotPass). Взводится в ветке подхода, гаснет событиями
var _auto_pilot: bool = false
## Ближе этого запаса сверх дистанции остановки автопилот не взводится:
## финальное сближение и перехваты — дело полного автомата
const AUTOPILOT_ARM_SLACK := 2.0

## ── МОЖНО ЛИ ПИСАТЬ ЛОКАЛЬНЫЙ ТРАНСФОРМ ВМЕСТО МИРОВОГО ────────────────────
## true, когда родитель стоит в начале мира без поворота и масштаба: тогда
## position и global_position — одно и то же число, а стоит первое вдвое
## дешевле (замер qa_soa_floor F3/F4). В игре так и есть всегда — бойцов
## добавляет Main.world_add в узел World с неизменной единичной трансформацией,
## и никто их не перевешивает (Castle.absorb_unit только прячет). Но проверить
## дешевле, чем полагаться: стенд может поставить бойца куда угодно
var _local_xform: bool = false

## Проверка отложена: родитель известен только ПОСЛЕ add_child (тот же порядок,
## из-за которого отложены регистрация ствола и посадка дерева)
func _check_local_xform() -> void:
	if not is_inside_tree():
		return
	var p := get_parent() as Node3D
	_local_xform = p != null and p.global_transform.is_equal_approx(Transform3D.IDENTITY)
	# Тот же ответ — признаком в строке: пакетные проходы пишут координату сами
	# и читать поле объекта на каждого сдвинутого не должны
	if _soa >= 0:
		GameManager.army.set_flag(_soa, 1 << 13, _local_xform)

## Лёгкая запись строки из текущего положения узла — для подклассов, которые
## переопределяют tick_physics и в своих ветках не доходят до super()
## (см. Worker: добыча, стройка, возврат груза). Без проверки трансформа: она
## разовая и делается при рождении
func _sync_soa_row() -> void:
	# СМЕНА СОСТОЯНИЯ ТРЕБУЕТ НЕМЕДЛЕННОГО ПЕРЕСЧЁТА ПОЗЫ. У рабочего это
	# единственная дорога записи строки в состояниях добычи/стройки/возврата
	# (базовый tick_physics туда не доходит), и без этой строки он менял
	# анимацию только на общем такте — топор в руках по дороге к замку
	var st_changed: bool = state != _sent_st
	if st_changed:
		_wake_process()
	if _soa < 0:
		# Зеркало состояния ведём в любом случае: без строки в ядре армии
		# публиковать нечего, но «уже разбудили» помнить надо
		_sent_st = state
		return
	# ── ЗАПИСЬ ИДЁТ, ТОЛЬКО ЕСЛИ ЕСТЬ ЧТО ПИСАТЬ ───────────────────────────
	# Здесь стоял безусловный write_pose на КАЖДЫЙ тик рабочего. Это чтение
	# свойства global_position (пересборка мировой матрицы) плюс переход
	# границы GDScript↔C# (~2.4 мкс) — и всё это ради чисел, которые в
	# половине случаев не менялись вовсе: рубящий дерево и строящий стоят
	# на месте пять секунд подряд, а тик у них идёт шестьдесят раз в секунду.
	# Сравнение — те же шесть операций и те же поля-зеркала, что и в
	# основном пути (см. tick_physics, блок «ПОЗА ПУБЛИКУЕТСЯ, ТОЛЬКО ЕСЛИ
	# ОНА ИЗМЕНИЛАСЬ»), поэтому «сдвинули в обход тика» ловится и тут:
	# в условии стоит САМА КООРДИНАТА, а не метка
	var gp: Vector3 = position if _local_xform else global_position
	if not _pose_force and not st_changed \
			and absf(gp.x - _sent_x) <= POSE_EPS and absf(gp.z - _sent_z) <= POSE_EPS \
			and absf(velocity.x - _sent_vx) <= POSE_EPS \
			and absf(velocity.z - _sent_vz) <= POSE_EPS:
		return
	_pose_force = false
	_sent_x = gp.x
	_sent_z = gp.z
	_sent_vx = velocity.x
	_sent_vz = velocity.z
	_sent_st = state
	GameManager.army.write_pose(_soa, gp, velocity, state)

## Переписать строку ядра армии по текущему положению узла. Нужен тем, кто
## двигает бойца В ОБХОД тика — выпуск из гарнизона, отладочный перенос
## Ниже какого изменения поза считается прежней и в строку не пишется.
## Полмиллиметра: сетка соседей имеет ячейку в метр, а порог разведения — 29 см
const POSE_EPS := 0.0005
var _sent_x: float = INF
var _sent_z: float = INF
var _sent_vx: float = INF
var _sent_vz: float = INF
var _sent_st: int = -1
## Следующую запись позы сделать безусловно. Взводится там, где строка могла
## разойтись с узлом помимо обычного тика: рождение, телепорт, выход из
## гарнизона (там же гасится и возвращается признак «координата настоящая»)
var _pose_force: bool = true

func sync_row() -> void:
	if _soa < 0:
		return
	_check_local_xform()
	_pose_force = true
	GameManager.army.write_pose(_soa, global_position, velocity, state)

## Записать в строку боевые характеристики и здоровье. Зовётся там, где они
## реально меняются: рождение, урон, улучшения отряда и кузницы
func _soa_push_stats() -> void:
	if _soa < 0:
		return
	var a = GameManager.army
	a.set_hp(_soa, current_health, max_health)
	a.set_combat(_soa, attack_damage, attack_range, move_speed)
	a.set_target_weight(_soa, target_weight())

## ── ПРИОРИТЕТ ЦЕЛЕЙ У СТРЕЛКОВ (ТЗ 14.09.2026, п. 10) ─────────────────────
## target_weight — свойство ЦЕЛИ (большой гоблин 2.0), едет в колонку ядра;
## target_prio_scan — читает ли ЭТОТ боец вес при выборе цели (стрелки — да,
## рукопашная — нет: ей ближайший, кем бы он ни был)
func target_weight() -> float:
	return 1.0

func target_prio_scan() -> bool:
	return false

var _anim_time: float = 0.0
var _aggro_timer: float = 0.0
# Последнее направление движения/атаки (спрайты — билборды, вращать узел не нужно;
# Spearman использует это для выбора направленного спрайта)
var _facing: Vector3 = Vector3.FORWARD
# Фаза чередования сепарации: каждый юнит толкается раз в 2 физ. кадра
var _sep_phase: int = 0
# true — _process отключён (юнит стоит, анимация затухла)
var _proc_sleeping: bool = false

# ── ДИНАМИЧЕСКАЯ ФАЛАНГА (только в стойке ЗАЩИТА) ────────────────────────────
# Ряд бойца НЕ фиксирован приказом на построение, а пересчитывается вживую по
# тому, сколько своих стоит прямо перед ним (см. SpatialGrid.allies_ahead).
# Отсюда сразу два требуемых поведения:
#   • погиб боец первой шеренги — у стоящего сзади счётчик упал, он стал
#     передовым, опустил копьё горизонтально и шагнул в просвет;
#   • строй рассыпался в свалку — «передовыми» автоматически считаются те,
#     перед кем никого нет, то есть ближайшие к врагу.
const PHALANX_FRONT_RANKS := 2      # ряды 0 и 1 держат копья горизонтально
const RANK_RECHECK        := 0.25   # сек между пересчётами ряда
const FILE_HALF_WIDTH     := 0.45   # половина ширины «своей колонны», м
# Как далеко вперёд ищем своих, м.
#
# БЫЛО 1.5 — ровно 2×PHALANX_GAP + 0.1. Запас в десять сантиметров оказался
# фиктивным: реальный интервал в строю живёт не на номинале, а гуляет от
# разметки строя и смыкания после потерь. Стоило шагу вырасти до 0.78, и
# ВТОРАЯ шеренга впереди выпадала за 1.5 м — боец видел перед собой одного,
# считал себя первым рядом и опускал копьё. Копья оказывались наперевес по всей
# глубине отряда вместо двух передних шеренг (замер qa_ph2, 1.2: 24 из 24).
#
# 1.9 = 2×PHALANX_GAP + полшага. Две шеренги укладываются при интервале вплоть
# до 0.95, а ТРЕТЬЯ (2.1 м при номинале) по-прежнему остаётся снаружи, поэтому
# смысл «ряд = сколько своих закрывает меня спереди» не меняется
const FILE_LOOK_AHEAD     := 1.9
# Смыкание рядов: свободно впереди больше этого — шагаем в просвет
const PHALANX_GAP         := 0.7
## Дыра в строю начинается ОТСЮДА, а не сразу за PHALANX_GAP. Между 0.7 и 0.9
## лежит мёртвая зона: боец там уже не «вплотную», но ещё и не в бреши, и
## поэтому просто стоит.
##
## Зона нужна по двум причинам. Во-первых, без неё строй с шагом ровно 0.7
## висит на границе сравнения и медленно сминается сам собой. Во-вторых —
## и это важнее — сомкнутый интервал ОБЯЗАН остаться меньше половины
## FILE_LOOK_AHEAD (1.5 м): ряд считается тем же конусом, и при интервале 0.8
## вторая шеренга впереди выпадает за 1.5 м, боец видит перед собой лишь одного
## и считает себя вторым рядом — копьё опускала вся глубина отряда
const PHALANX_HOLE_GAP    := 0.9
# Доля обычной скорости при смыкании: фаланга подтягивается, а не бежит
const PHALANX_FILL_SPEED  := 0.45

var _live_rank:  int   = 0          # фактический ряд, 0 — передовой

# ── ЛИНИЯ СОПРИКОСНОВЕНИЯ: ФРОНТ ДЕРЁТСЯ, ТЫЛ ЖДЁТ СВОЕЙ ОЧЕРЕДИ ─────────────
# Замер (qa_mass_battle, затяжной бой): в свалке на 15000 бойцов до цели
# ДОСТАЮТ 52 %, а на 5000 — всего 35 %. Остальные каждый тик считали полный
# честный шаг к цели: проверку чужого строя (mb_enemyblock, 19 % кадра),
# стволы (10 %), обход свалки с фланга и всю логику подхода (~42 %). При этом
# бить им некого — впереди спины своих.
#
# Разметку делает ОТРЯД один раз в BATTLE_LINE_TTL_MS (GameManager._sweep_battle_lines):
# он проецирует бойцов на направление к врагу, находит фронт и раздаёт каждому
# его глубину и ряд. Боец сам ничего не сканирует — он получает готовый ответ,
# ровно как с коридором (_clear_trunk / _clear_enemy).
#
# ПРИЗНАК ПО УМОЛЧАНИЮ ЛОЖЕН — «не знаю, считай сам»: боец без отряда и любой
# до первой разметки идут прежним полным путём.
var _rear_line: bool = false        # я в тылу: впереди свои, доставать некого
var _line_course: Vector3 = Vector3.ZERO   # направление на врага, общее на отряд
var _line_gap: float = 0.0          # насколько я позади передового бойца, метры
## Отряд разметил меня в этом цикле. Отдельный признак от _rear_line, потому что
## «я во фронте» и «меня никто не размечал» — это разные ответы: в первом случае
## ряд уже известен и сканировать соседей незачем, во втором сканировать надо
var _line_valid: bool = false

## ── ЗЕРКАЛО ДВИЖКОВЫХ ТУМБЛЕРОВ ТИКА ───────────────────────────────────────
## GameManager обходит всю армию дважды за кадр и перед каждым вызовом
## спрашивал у движка is_physics_processing() / is_processing(). Это НЕ чтение
## поля, а обращение в движок через Variant — на четырёх тысячах бойцов около
## двух с половиной тысяч таких обращений в каждом кадре, на ровном месте.
##
## Поля-зеркала держатся в согласии с движком тем, что оба переключателя
## ПЕРЕОПРЕДЕЛЕНЫ ниже: кто бы ни звал set_process/set_physics_process — замок,
## спячка гоблинов, стенд, — он попадает в переопределение и обновляет зеркало.
## Начальные значения совпадают с умолчанием Node (оба выключены)
var tick_on: bool = false
var draw_on: bool = false

## Переключатели названы СВОИМИ именами, а не переопределяют движковые:
## GDScript считает переопределение нативного метода ошибкой (движок звал бы
## всё равно родительский). Значит, зеркало обязаны обновлять вызывающие —
## поэтому во всём проекте юниту тик переключают ТОЛЬКО этими двумя методами
func set_tick(enable: bool) -> void:
	tick_on = enable
	set_physics_process(enable)

func set_draw(enable: bool) -> void:
	draw_on = enable
	set_process(enable)

## РЯД УЖЕ ПОСЧИТАН ОТРЯДОМ В ЭТОМ ТАКТЕ (GameManager._push_squad_ranks).
## Ставится пакетным проходом раз в 200 мс, снимается первым же личным
## пересчётом: такт отряда чаще личного (200 против 250 мс), поэтому в общем
## случае личный скан не выполняется ни разу
var _rank_fresh: bool = false
## Мой файл уже упёрся во врага — держу строй и жду очереди. Пока ложен, тыл
## идёт вместе с фронтом полным ходом (см. GameManager._recalc_battle_line)
var _rear_hold: bool = false
## Защёлка смыкания: боец начал закрывать брешь и идёт до упора
## (см. _phalanx_advance — пороги начала и конца намеренно разные)
var _closing_gap: bool = false
var _rank_timer: float = 0.0
# Последний замеченный враг: направление и дистанция (обновляет _check_auto_aggro)
var _enemy_seen_dir:  Vector3 = Vector3.ZERO
var _enemy_seen_dist: float   = INF

# ── СТОЙКА ОТРЯДА (см. unit_stats_config.gd STANCES) ─────────────────────────
# "attack" — стандартные параметры, пуш включён, юнит продвигается вперёд.
# "defense" — стоит намертво: пуш 0, +25% скорости атаки, +30% морали, +5 защиты
