## ── ПРОБИВАЕТ ОКРУЖЕНИЕ ТЕЛОМ (заказ 10.09.2026, тролль) ──────────────────
## ПОЛЕ, А НЕ ВИРТУАЛЬНЫЙ МЕТОД: признак читается в горячем пути шага
## (_commit_step) у КАЖДОГО шагающего, а вызов метода там стоил бы полмили-
## секунды кадра на четырёх тысячах. Ставит его тот, кому положено пробивать:
## тролль — когда вокруг него смыкается кольцо копейщиков (Troll.tick_physics)
var breaks_bodies: bool = false

## Боец вне карты (в гарнизоне): строка ядра живёт, но координата
## «ненастоящая» — в сетку соседей он не попадает, цели и стрелы его не
## находят, источником обзора не служит. Возврат — sync_row (WritePose снова
## ставит признак). Без этого вошедший в башню оставался в сетке на точке у
## ворот и получал стрелы, будучи невидимым (09.09.2026)
func set_off_map(on: bool) -> void:
	if _soa < 0:
		return
	if on:
		GameManager.army.set_off_map(_soa, true)
	else:
		sync_row()
## СПЯЩИЙ ПО РАСПИСАНИЮ (деревня гоблинов до подъёма). Отдельное поле, а не
## «не тикает физикой»: тик выключают и гарнизон, и стенды, и путать эти
## случаи нельзя — по этому признаку считается число ходящих бойцов, из
## которого выводится количество шардов (GameManager.active_units)
var dormant: bool = false

## УЛОЖИТЬ СПАТЬ / РАЗБУДИТЬ — ОДИН ПУТЬ НА ВСЕ ФРАКЦИИ (15.09.2026).
## Раньше тело жило в GoblinAI._set_dormant; охрана крепости красного ИИ
## (scripts/ai/HomeGuard.gd) спит тем же способом, и второй копии этих
## строк быть не должно. Гасится ТОЛЬКО физический тик и бит F_DORMANT в
## ядре: визуальный тик остаётся — боец прячется от чужих глаз сам, веткой
## внутри tick_visual (см. разбор у GoblinAI._set_dormant)
func set_dormant(on: bool) -> void:
	if dormant != on:
		dormant = on
		GameManager.note_dormant(on)
	set_tick(not on)
	if not on:
		set_draw(true)
	if _soa >= 0:
		GameManager.army.set_dormant(_soa, on)

# ── ОТСТУПЛЕНИЕ В ЗАМОК ──────────────────────────────────────────────────────
# Отдельный режим, а не «просто приказ идти к замку». Отходящий отряд обязан
# ДОЙТИ, а не увязнуть по дороге в очередной стычке, поэтому на время отхода
# сняты все зацепки, которые в норме останавливают марш:
#   • не перехватывает встречного врага (см. _process_move);
#   • не отвечает на удар и не поднимает отряд в контратаку (см. take_damage);
#   • не агрится сам, стоя без дела (см. _update_aggro);
#   • проходит СКВОЗЬ чужой строй (см. _move_blocked) — иначе отряд, которому
#     перекрыли дорогу, вечно тёрся бы о вражескую шеренгу вместо отхода.
# Урон при этом проходит как обычно: «игнорирует» здесь означает «не
# отвлекается», а не «неуязвим» — бессмертный отряд ломал бы всю экономику боя.
#
# Снимается в Castle.absorb_unit() (дошёл) и в любом новом приказе игрока.
var retreating: bool = false

# ── БЕГ (SPRINT) ─────────────────────────────────────────────────────────────
# Включается ДВОЙНЫМ ПКМ в точку земли (SelectionManager). Пока флаг стоит:
#   • скорость ×SPRINT_SPEED_FACTOR (+35% к ходьбе);
#   • копейщики ПОДНИМАЮТ копья и не строят фалангу (Spearman._spear_leveled,
#     _phalanx_advance) — бежать щетиной пик нельзя;
#   • отряд НЕ ОТВЛЕКАЕТСЯ НА БОЙ: ни авто-агро, ни перехвата на марше, ни
#     ответного удара — ровно те же гейты, на которых сидит retreating.
#   • ВХОДЯЩИЙ УРОН ×SPRINT_DAMAGE_MULT (+35%): бегущий не прикрыт, и это
#     прямая цена скорости (заказ владельца). Раньше цена была только
#     косвенной, и бегать имело смысл всегда.
#
# Гаснет САМ по прибытии в точку (_arrive_at_target) и при любом новом приказе,
# который не просил бега, — отряд возвращается в обычный режим и снова
# опускает копья.
var sprinting: bool = false

## ПРИКАЗ ДВИЖЕНИЯ ПОСРЕДИ БОЯ. Игрок кликнул «идти сюда», пока у бойца была
## живая цель атаки — значит, это ПРЯМОЙ приказ выйти из боя, а не рядовой
## марш. Пока флаг снят, march-перехват (_process_move) и ответный удар на
## месте (take_damage) молчат: раньше боец делал полшага, натыкался на того же
## врага, что и до приказа, и снова открывал огонь/бой — приказ игрока
## оказывался невыполним, пока противник стоял рядом.
## Ставится ТОЛЬКО в command_move(), и только если attack_target ещё не пуст
## (см. там же) — внутренний _resume_march() обнуляет цель ДО своего вызова
## command_move(), так что продолженный после боя марш снова ловит новых
## врагов на пути как обычно. Снимается по приходу в точку (_process_move) и
## любым приказом атаковать (command_attack).
var _disengaging: bool = false

## ── ОХОТА НА ОВЦУ (спринт 19, письмо 10) ─────────────────────────────────
## ПКМ бойцом по живой овце — подойти и зарубить одним ударом; туша остаётся
## лежать (Sheep.kill_by), мясо с неё выносят рабочие. Овца — не Unit и не
## цель боя: это ПРИКАЗ НА ДВИЖЕНИЕ с проверкой в момент прибытия
## (_hunt_arrival): дошёл — ударил; овца отскочила — приказ переиздаётся на
## её новую точку, не больше HUNT_TRIES раз. Любой другой приказ охоту снимает
var _hunt_sheep: Node3D = null
var _hunt_tries: int = 0
const HUNT_REACH := 1.9
const HUNT_TRIES := 10

func command_hunt_sheep(s: Node3D) -> void:
	if s == null or not is_instance_valid(s):
		return
	if bool(s.get("dead")) or bool(s.get("eaten")) or bool(s.call("is_carried")):
		return
	command_move(GameManager.land_target(s.global_position), false, Vector3.ZERO, false, true)
	if state != State.MOVING:
		return
	_hunt_sheep = s
	_hunt_tries = 0

func is_hunting_sheep() -> bool:
	return _hunt_sheep != null

## Пришли в точку приказа. true — охота продолжается (овца ушла, идём за ней)
func _hunt_arrival() -> bool:
	var s: Node3D = _hunt_sheep
	_hunt_sheep = null
	if s == null or not is_instance_valid(s):
		return false
	if bool(s.get("dead")) or bool(s.get("eaten")) or bool(s.call("is_carried")):
		return false
	var mp: Vector3 = position if _local_xform else global_position
	var sp: Vector3 = s.global_position
	var dx: float = sp.x - mp.x
	var dz: float = sp.z - mp.z
	var d: float = sqrt(dx * dx + dz * dz)
	if d <= HUNT_REACH:
		if d > 0.01:
			_facing = Vector3(dx / d, 0.0, dz / d)
			_pose_dirty = true
		_hunt_strike_anim()
		AudioManager.play_3d(_sfx_swing(), global_position)
		if s.has_method("kill_by"):
			s.call("kill_by", self)
		return false
	if _hunt_tries >= HUNT_TRIES:
		return false
	_hunt_tries += 1
	_hunt_sheep = s
	move_target = GameManager.land_target(sp)
	_march_target = move_target
	post_pos = move_target
	_wake_process()
	return true

## Замах по овце: у кого какая лента удара есть. Копейщик переопределяет
## (направленные листы attack_*), рабочий — топор
func _hunt_strike_anim() -> void:
	if _has_anim("attack1"):
		_play_attack_anim("attack1", 450)
	elif _has_anim("attack"):
		_play_attack_anim("attack", 450)
## ═══════════════════════════════════════════════════════════════════════════
## ПАНИКА: ОТРЯД ПОД БЕЛЫМ ФЛАГОМ
## ═══════════════════════════════════════════════════════════════════════════
## Решение о срыве принимает ОТРЯД (GameManager._sweep_morale) — здесь только
## исполнение. Пока признак стоит, боец:
##   • не принимает приказов игрока (ни движения, ни атаки);
##   • не ищет целей сам и бросает ту, что была;
##   • получает срезанную защиту (см. take_damage).
## Бежать при этом он ПРОДОЛЖАЕТ: приказ на бегство отдаётся ОДИН раз, в
## момент срыва, и обычным command_move — иначе паникующий строй остался бы
## стоять на месте с флагом над головой.
##
## ПОЧЕМУ ПРИЗНАК НА БОЙЦЕ, ЕСЛИ РЕШЕНИЕ ОТРЯДНОЕ. Его спрашивают три самые
## горячие ветки — приём приказа, авто-агро и урон, — и каждая на бойца. Ходить
## за ним в словарь автозагрузки из каждой значило бы платить за словарный
## поиск в тике; здесь это чтение поля
var _panicked: bool = false

## Паникует ли боец. Публичный: спрашивают HUD и стенды
func is_panicked() -> bool:
	return _panicked

## Взвести/снять признак. Снятие ПРОБУЖДАЕТ бойца: пока он паниковал, поза
## могла уснуть, а приказы он снова принимает с этого мгновения
func set_panicked(on: bool) -> void:
	if _panicked == on:
		return
	_panicked = on
	if on:
		set_attack_target(null)
		_atk_pending = false
		release_target_lock()
	else:
		_wake_process()

## ── ПРИКАЗ БЕЖАТЬ ──────────────────────────────────────────────────────────
## Единственный приказ, который паникующий исполняет, и отдаётся он РОВНО ОДИН
## РАЗ — в момент срыва. Порядок важен: сначала обычный command_move (он снимает
## цель, замки и разметку), и только потом взводится признак; иначе приказ
## отбился бы о собственный запрет
func panic_flee(point: Vector3) -> void:
	# Паника рвёт аренды ядра НЕМЕДЛЕННО (этап D1): между пересчётами melee
	# арендованная строка продолжала бы получать шаги напора ПРОТИВ бегства
	if _rear_press or _auto_pilot:
		_rear_press = false
		_auto_pilot = false
		if _soa >= 0:
			GameManager.army.rear_press_clear(_soa)
			GameManager.army.autopilot_clear(_soa)
	_panicked = false
	command_move(point, false, Vector3.ZERO, false, false, true)
	set_panicked(true)

## ── СРОКА У «ВЫХОДА ИЗ БОЯ» НЕТ, И ЭТО ПРОВЕРЕНО ЗАМЕРОМ ────────────────────
## Пробовали дать признаку срок (шесть секунд) — чтобы упёршийся в чужой строй
## боец, который в точку приказа не придёт НИКОГДА, всё-таки начал отвечать.
## Стенд qa_disengage сразу покраснел: лучнику, ради которого признак и
## заводился, надо пройти двадцать пять метров, а это пятнадцать секунд. Срок
## истекал на полпути, перехват марша оживал, и отряд разворачивался стрелять —
## ровно та беда, от которой признак и лечит («ушло 2-3 из 6 вместо шести»).
##
## Правильный разделитель — не время, а ФАКТ УПОРА: боец, идущий прочь, идёт и
## отвечать не обязан; боец, чей шаг упёрся в чужое тело, никуда не идёт и
## отвечать обязан. Оба места, где это нужно, спрашивают именно упор:
## перехват марша — признак `wall` (см. _process_move), ответный удар —
## _may_answer_blow

# ── ЗАМОК НА ПРИКАЗ ИГРОКА (forced move / retreat lock) ──────────────────────
# _disengaging лечит только один случай: в момент клика у бойца БЫЛА живая цель.
# Отходящему лучнику этого мало. Он стреляет на 20 м, цель у него гибнет часто,
# и приказ «отойди» приходит ровно в тот кадр, когда attack_target уже пуст —
# флаг не ставится, и на первом же тике марша перехват (_process_move) находит
# врага в attack_range + INTERCEPT_MARGIN, то есть в тех же двадцати метрах, из
# которых лучник и отходит. Он вставал, стрелял, шёл дальше полсекунды — и
# снова вставал: отряд «отходит на треть пути и разворачивается стрелять».
#
# Замок отмеряется ВРЕМЕНЕМ и держит приказ игрока непрерываемым: пока он тикает,
# молчат и перехват на марше, и ответная агрессия на месте (take_damage).
# Не неуязвимость: урон проходит как обычно, боец просто не отвлекается.
#
# Секунды, а не расстояние: отряду надо успеть ВЫЙТИ из зоны обстрела, а сколько
# он за это время пройдёт — дело его скорости.
## Сколько приказ игрока на движение непрерываем, секунды
const FORCED_MOVE_SEC := 3.0

## ── ПРИКАЗ ИГРОКА ВЫВОДИТ БОЙЦА ИЗ СВАЛКИ ТЕЛОМ, А НЕ ТОЛЬКО ВНИМАНИЕМ ──────
## ЖАЛОБА ВЛАДЕЛЬЦА: «отряд в плотной рубке не идёт с первого правого клика,
## приходится кликать второй раз, чтобы он вышел из боя».
##
## Замок FORCED_MOVE_SEC уже глушил ПЕРЕХВАТ марша и ответный удар — то есть
## внимание бойца. Но шаг у него всё равно упирался в чужой строй
## (_move_blocked → enemy_block): в свалке враги стоят СО ВСЕХ СТОРОН, лобовая
## составляющая шага съедается целиком, боковая упирается на втором проходе, и
## функция выходит, НЕ СДВИНУВ БОЙЦА НИ НА САНТИМЕТР. Приказ при этом принят
## честно — состояние MOVING, цель записана, — просто исполнить его нечем.
## Со стороны это и выглядит как «клик не сработал».
##
## Второй клик «помогал» случайно: к тому моменту свалка успевала разойтись, и
## боец находил щель. Лечение — не третий клик, а ТЕЛО: пока тикает замок
## приказа игрока, чужие тела бойцу не преграда, ровно как отходящему в замок
## (retreating). Это ТА ЖЕ механика и то же обоснование — «отряду, которого
## уводят, перекрытая дорога означает вечное трение боком о чужую шеренгу», —
## и та же цена: три секунды, за которые из первой шеренги выходят, но пройти
## сквозь оборону насквозь не успевают.
##
## ОКНО КОРОЧЕ САМОГО ЗАМКА, И ЭТО НЕ ПОЛОВИНЧАТОСТЬ. Замок молчания длится
## три секунды — столько отряду надо, чтобы выйти из-под обстрела. А чтобы
## ВЫБРАТЬСЯ ИЗ ТЕЛ, хватает полутора: при обычной скорости это около трёх
## метров, то есть две шеренги. Выдай сюда все три — и приказом «идти туда»
## можно было бы ПРОХОДИТЬ СКВОЗЬ чужую оборону насквозь, а сквозной проход в
## этой игре есть ровно у одного режима, отхода в замок.
##
## СВОЕГО ФЛАГА НЕ ЗАВОДИМ. _move_lock уже означает ровно «это приказ игрока и
## он непрерываем»; второй флаг про то же самое неминуемо разошёлся бы с ним
const FORCED_MOVE_PASS_SEC := 1.5

## ── БИЛЕТ ДЕЙСТВУЕТ, ПОКА БОЕЦ НЕ ВЫШЕЛ, А НЕ ПОЛТОРЫ СЕКУНДЫ ──────────────
## ЖАЛОБА ВЛАДЕЛЬЦА: «в долгом бою при клике ПКМ на отход войска остаются на
## месте». Воспроизведено на мега-стенде: приказ ПРИНИМАЮТ все (102 из 102
## переходят в MOVING), а физически уходят меньше половины — 46, остальные 56
## заперты телами и своих, и чужих.
##
## Срок был ВРЕМЕННОЙ: полторы секунды, то есть около трёх метров хода. Из
## мелкой стычки этого хватает, а из настоящей свалки — нет: впереди свой же
## второй эшелон, позади чужая первая шеренга, и за полторы секунды боец
## продавливается на полшага. Дальше билет сгорал, и он застревал уже до конца
## приказа.
##
## Теперь срок задаёт НЕ ЧАСЫ, А ФАКТ ВЫХОДА: билет жив, пока боец не отошёл от
## точки, где его застал приказ, на PASS_CLEAR_DIST — то есть пока он реально не
## выбрался из тел. Потолком остаётся сам замок приказа (FORCED_MOVE_SEC), и
## поэтому прежняя опасность не возвращается: «идти туда» по-прежнему не даёт
## проходить сквозь оборону насквозь — три секунды это предел, а выбравшийся
## теряет билет РАНЬШЕ, а не позже прежнего.
func _forced_move_pass() -> bool:
	if not _pass_earned or _move_lock <= 0.0:
		return false
	var p: Vector3 = position if _local_xform else global_position
	var dx: float = p.x - _pass_from.x
	var dz: float = p.z - _pass_from.z
	return dx * dx + dz * dz < PASS_CLEAR_DIST * PASS_CLEAR_DIST

## Насколько надо отойти, чтобы считаться выбравшимся из свалки. Две шеренги:
## меньше — и билет сгорал бы, не выведя бойца из тел; больше — и он начал бы
## работать пропуском вглубь чужого строя
const PASS_CLEAR_DIST := 2.5

## ── БИЛЕТ ОТХОДА: ВЫБРАТЬСЯ ИЗ ТЕЛ, НО НЕ ПЕРЕЙТИ ЛИНИЮ ───────────────────
## У отхода сквозной проход БЫЛ безусловным, и это была жалоба владельца
## «рыцари проходят сквозь фалангу, как призраки»: отряд ИИ, уходящий в замок,
## пересекал чужой строй насквозь (замер qa_mega_battle B2-3: 141 из 151).
##
## НО СНЯТЬ ЕГО ЦЕЛИКОМ ТОЖЕ НЕЛЬЗЯ, и это тоже замерено: qa_spear C9 сразу
## показал «внутрь замка зашли 3 из 6» — половина отряда, отозванного в
## гарнизон, застревала о противника прямо на месте боя. Ровно та помеха, ради
## которой послабление и заводилось.
##
## Мирит их та же мысль, что уже применена к приказу игрока: билет даётся НА
## ВЫХОД из тел, в которых боец УЖЕ стоит, и гаснет, едва он выбрался. Двух с
## половиной метров хватает разорвать контакт и не хватает пересечь строй: у
## фаланги четыре шеренги, это добрых два метра только в глубину, плюс подход
func _retreat_pass() -> bool:
	if not retreating:
		return false
	var p: Vector3 = position if _local_xform else global_position
	var dx: float = p.x - _retreat_from.x
	var dz: float = p.z - _retreat_from.z
	return dx * dx + dz * dz < PASS_CLEAR_DIST * PASS_CLEAR_DIST

## Откуда боец начал отход. Пишется в begin_retreat
var _retreat_from: Vector3 = Vector3.ZERO

## ── ИСПОЛНЯЕТ ЛИ БОЕЦ ПРЯМО СЕЙЧАС ПРИКАЗ ИГРОКА ──────────────────────────
## ЗАКАЗ ВЛАДЕЛЬЦА: «команда игрока имеет 100 % приоритет». Спрашивают это
## АВТОМАТИЧЕСКИЕ подзывы — сплочённость и смыкание рядов: оба шлют
## `command_move`, и оба честно перетирали только что отданный приказ точкой
## В ДВУХ ШАГАХ от бойца.
##
## Замер qa_mega_battle B4-3 (103 копейщика, приказ на отход из свалки): приказ
## приняли ВСЕ, а через шесть секунд у 49 из 50 оставшихся на месте точка
## приказа лежала РЯДОМ С НИМИ — то есть приказ игрока был уже не его. На
## экране это и есть «войска игнорируют приказ и остаются на месте»
func player_order_active() -> bool:
	return _move_lock > 0.0

## Заработано ли послабление на проход (разбор — в command_move).
## Ставится ровно в одном месте, вместе с самим замком приказа
var _pass_earned: bool = false
## Откуда боец начал выбираться. Пишется вместе с _pass_earned
var _pass_from: Vector3 = Vector3.ZERO
## Остаток замка. Обычный float со счётом вниз, а не отметка времени: сравнение
## с Time.get_ticks_msec() стоило бы вызова в движок на каждого идущего в кадр
var _move_lock: float = 0.0

# ═════════════════════════════════════════════════════════════════════════════
# ЗАМОК ЦЕЛИ (PLAYER TARGET LOCK) — ПРИОРИТЕТ №1 В ИЕРАРХИИ ПРИКАЗОВ
#
# Игрок ткнул ПКМ во вражеский отряд. С этого момента и до его полного
# истребления (или до нового приказа) выделенные отряды воюют ИМЕННО С НИМ:
#
#   №1 ЗАМОК ЦЕЛИ    — держится за назначенный ВРАЖЕСКИЙ ОТРЯД (_lock_squad),
#                      а не за конкретную модель: когда его жертва падает,
#                      замена берётся из того же отряда (см. _process_attack).
#                      Идёт при этом СВОЕЙ БАЗОВОЙ скоростью — никакого
#                      «подтягивания рядов» на 55% (см. _should_pull_up);
#   №2 ЗАСЛОН        — вражеский строй ВПЛОТНУЮ на пути перебивает подход:
#                      сквозь врага не проходят (см. LOCK_BLOCKER_RANGE).
#                      Приказ при этом не забыт — он в _atk_pending и
#                      возобновляется после драки (_resume_attack);
#   №3 АВТО-АГРО     — включается, только когда замка нет: приказа не было
#                      либо назначенный отряд выбит целиком.
#
# ЧТО ИМЕННО ЛЕЧИТ ЗАМОК. Раньше приказ атаки жил ровно до гибели первой
# жертвы: дальше _process_attack искал замену через _find_nearest_enemy_in_range,
# то есть КАЖДЫЙ боец сам выбирал себе ближайшего противника на карте. Отряд
# рассыпался по всем окрестным целям, а SelectionManager вдобавок раздавал
# каждому бойцу СВОЮ ближайшую цель из общего списка врагов ещё в момент клика.
# Итог — «отряд делится и разбегается» вместо одного удара по указанной точке.
#
# СНИМАЕТСЯ: любым приказом движения (command_move), отходом (begin_retreat) и
# самим собой, когда в назначенном отряде не осталось живых. НЕ снимается
# перехватом заслона и ответом на удар — это приоритет №2, а не новый приказ.
var target_lock: bool = false
## Вражеский ОТРЯД, на который навешен замок. 0 — цель вне реестра отрядов
## (здание, одиночка): тогда держимся за _lock_target
var _lock_squad: int = 0
## Конкретная цель замка для случая _lock_squad == 0 (здание, одиночка)
var _lock_target: Node3D = null

## РАДИУС ЗАСЛОНА (приоритет №2) ДЛЯ БОЙЦА ПОД ЗАМКОМ.
##
## Обычный перехват ищет помеху в attack_range + INTERCEPT_MARGIN. Для пехоты
## это ~2.6 м — честное «уперся вплотную». Для ЛУЧНИКА attack_range равен 18-20 м,
## и тот же код превращался в «стоп, стреляю по любому, кто ближе указанной цели»:
## отряд, посланный на конкретного врага, замирал на полпути и распылял залп по
## случайным мишеням. Под замком помеха обязана быть ФИЗИЧЕСКОЙ — телом на пути,
## а не силуэтом в дальности оружия
const LOCK_BLOCKER_RANGE := BLOCK_RADIUS * 2.0 + 0.5   # ≈1.6 м, длина руки с оружием

## Взвести замок на цель приказа игрока
func _arm_target_lock(target: Node3D) -> void:
	target_lock  = true
	_lock_target = target
	var tu := target as Unit
	_lock_squad  = tu.squad_id if tu != null else 0
	# ГДЕ СТОЯЛА ЦЕЛЬ. Нужно ровно одному месту — поиску СЛЕДУЮЩЕЙ постройки
	# после сноса этой (см. _lock_next_victim): к тому моменту узла уже нет, и
	# спросить его точку будет не у кого
	_lock_pos = target.global_position if target != null else Vector3.ZERO
	_lock_is_building = target is Building

## Снять замок: приказ отменён или назначенный отряд выбит целиком
func release_target_lock() -> void:
	target_lock  = false
	_lock_squad  = 0
	_lock_target = null
	_lock_is_building = false

## Точка запертой цели и был ли это дом — см. _arm_target_lock
var _lock_pos: Vector3 = Vector3.ZERO
var _lock_is_building: bool = false

## ── СНЕСЛИ ОДИН ДОМ — ПЕРЕХОДИМ К СОСЕДНЕМУ ───────────────────────────────
## Жалоба владельца: «при приказе уничтожить бунгало орков отряды сносят одно
## здание, после чего приказ слетает, и они разбегаются в разные стороны».
##
## Так и было. Замок на постройке держится за КОНКРЕТНЫЙ узел (`_lock_target`),
## и когда тот падает, следующей жертвы у замка нет: он снимается, боец
## возвращается к авто-агро, а оно у каждого своё — отсюда и «разбегаются».
## У замка на ОТРЯДЕ такой беды нет, там следующего выдаёт squad_pick_member;
## постройки же в отряды не собраны, и «соседний дом» надо искать по карте.
##
## Радиус узкий и намеренно: это «тот же лагерь», а не «любая постройка на
## карте». Приказ через полкарты игрок не отдавал.
const BUILDING_CHAIN_RANGE := 26.0

## Вправе ли боец бить эту постройку. База: орда не трогает крепость ИИ
## (GameManager.goblin_may_raze); тролль переопределяет — ему нельзя ни одну
func may_attack_building(b: Building) -> bool:
	if faction != Constants.FACTION_GOBLIN:
		return true
	return GameManager.goblin_may_raze(b)

func _next_enemy_building() -> Node3D:
	if not _lock_is_building or _lock_pos == Vector3.ZERO:
		return null
	var best: Node3D = null
	var bd: float = BUILDING_CHAIN_RANGE * BUILDING_CHAIN_RANGE
	for grp in Constants.enemy_building_groups(faction):
		for b in get_tree().get_nodes_in_group(String(grp)):
			if not is_instance_valid(b):
				continue
			var bb := b as Building
			if bb == null or bb.is_dead() or not may_attack_building(bb):
				continue
			var dx: float = bb.global_position.x - _lock_pos.x
			var dz: float = bb.global_position.z - _lock_pos.z
			var d: float = dx * dx + dz * dz
			if d < bd:
				bd = d
				best = bb
	return best

## ── ЦЕЛЕЙ БОЛЬШЕ НЕТ: ВСТАЁМ ЗДЕСЬ, А НЕ ИДЁМ КУДА-ТО ─────────────────────
## Приказ исчерпан. Пост бойца при этом остался там, откуда отряд ВЫШЕЛ, —
## иногда за полкарты, — и авто-агро с возвратом на пост уводили его обратно.
## На экране это и есть «бойцы бегут в противоположную сторону, на базу».
## Пост переносится СЮДА: приказ выполнен там, где боец стоит
func _hold_where_i_stand() -> void:
	post_pos = global_position
	_post_valid = true
	_settled = false

## СЛЕДУЮЩАЯ ЖЕРТВА ИЗ ЗАПЕРТОГО ОТРЯДА. null — там больше никого нет, замок
## пора снимать. Раздачей по бойцам занимается squad_pick_member: она берёт
## того, по кому бьёт меньше всех, поэтому отряд разбирает чужой строй сообща,
## а не сваливается всей толпой на одну модель
func _lock_next_victim() -> Node3D:
	# ПОСТРОЙКИ: пала — берём соседнюю из того же лагеря (см. _next_enemy_building)
	if _lock_is_building:
		if _lock_target != null and is_instance_valid(_lock_target) \
				and not (_lock_target as Building).is_dead():
			return _lock_target
		var nb := _next_enemy_building()
		if nb != null:
			# Замок переезжает на новую цель целиком: и узел, и точка, иначе
			# следующая сцепка искала бы соседа вокруг СНЕСЁННОГО дома
			_lock_target = nb
			_lock_pos = nb.global_position
			# И ЯКОРЬ ПОГОНИ СНИМАЕТСЯ. Новый дом — это новый подход, и мерить
			# поводок от точки касания ПРЕДЫДУЩЕГО было бы то же самое, что
			# запретить отряду перейти улицу
			_pursuit_anchored = false
			GameManager.squad_pursuit_release(squad_id)
			return nb
		return null
	if _lock_squad != 0:
		# Та же поправка, что и при выдаче приказа: стрелок добивает того, до
		# кого достаёт, а не идёт через полстроя к «наименее обстрелянному»
		return _prefer_in_range(
			GameManager.squad_pick_member(_lock_squad, global_position, null))
	if _lock_target != null and is_instance_valid(_lock_target) \
			and not (_lock_target.has_method("is_dead") and _lock_target.is_dead()):
		return _lock_target
	return null

## Включить режим отхода: сбрасываются стойка, цель, разметка строя и
## отложенный марш — всё, что могло бы вернуть бойца в бой
## Секунд, в течение которых отход не отменяется обычным приказом.
## Держится ТА ЖЕ величина, что и у роли отряда в ИИ: два замка на одно решение
## обязаны кончаться вместе, иначе один отпустит раньше другого
const RETREAT_LOCK_SEC := 12.0

func begin_retreat() -> void:
	retreating     = true
	# ОТКУДА ВЫБИРАЕТСЯ. По этой точке гаснет билет отхода: он даётся на
	# РАЗРЫВ КОНТАКТА, а не на переход чужой линии (см. _retreat_pass)
	_retreat_from  = position if _local_xform else global_position
	lock_retreat(RETREAT_LOCK_SEC)
	_march_pending = false
	set_attack_target(null)
	_attack_is_forced = false
	_charge_order     = false
	is_charging       = false
	_hold_goal_set    = false     # и точка приказа стены (см. _phalanx_march)
	# Отход — это отмена приказа атаки, а не пауза в нём: замок цели снимается,
	# иначе отряд, отправленный лечиться в замок, по дороге снова полез бы драться
	_atk_pending = false
	release_target_lock()
	if stance != "attack":
		set_stance("attack")

## Выключить режим отхода (дошёл до замка либо получил новый приказ)
## ── ОТХОД ДЕРЖИТСЯ, ПОКА НЕ ВЫШЕЛ СРОК ────────────────────────────────────
## Отметка в миллисекундах: до неё обычный приказ на движение отход НЕ снимает.
## Ставит её begin_retreat, снимает — только прибытие в замок (end_retreat(true))
## и полное истечение срока.
##
## ЗАЧЕМ ЭТО ЗДЕСЬ, ЕСЛИ РОЛЬ УЖЕ ЗАФИКСИРОВАНА У ИИ. Роль держит РЕШЕНИЕ, а
## этот замок держит ИСПОЛНЕНИЕ: до бойца доходят приказы не только от ИИ
## (смыкание рядов, сплочённость, возврат на пост), и любой из них зовёт
## command_move без keep_retreat — то есть гасит отход. Ровно так отряд и
## разворачивался посреди дороги
var _retreat_until_ms: int = 0

func retreat_locked() -> bool:
	return retreating and now_ms < _retreat_until_ms

## secs <= 0 — без замка (прежнее поведение, отход снимается любым приказом)
func lock_retreat(secs: float) -> void:
	_retreat_until_ms = Time.get_ticks_msec() + int(maxf(secs, 0.0) * 1000.0)

## force — снять отход НЕЗАВИСИМО от замка. Так его снимает только прибытие
## в замок и отмена похода самим замком: там отход кончился по факту
func end_retreat(force: bool = false) -> void:
	if not force and retreat_locked():
		return
	_retreat_until_ms = 0
	_end_retreat_now()

func _end_retreat_now() -> void:
	retreating = false

## ПЕРЕКЛЮЧИТЬ БЕГ. Переключение обязано ДОЙТИ ДО КАРТИНКИ: у копейщика от
## этого флага зависит поза (копьё вверх/наперевес), а поза пересчитывается
## только в визуальном тике. Спящий боец (set_process(false) у осевшего юнита)
## иначе так и остался бы стоять со старой позой
func _set_sprinting(on: bool) -> void:
	if sprinting == on:
		return
	sprinting = on
	if on:
		_wall_struck = false     # новый забег — новая встреча со стеной копий
	_pose_dirty = true
	_wake_process()

# ── ВЕТЕРАНСКИЕ БОНУСЫ ОТРЯДА ────────────────────────────────────────────────
# Выбранные игроком улучшения (см. unit_stats_config.VET_CONFIG)
# раздаются КАЖДОЙ модели отряда и лежат тут плоскими числами.
# Намеренно не словарь и не запрос в GameManager: эти поля читаются в горячих
# путях (скорость каждый кадр, броня на каждый удар), и словарный поиск на
# 450 бойцах обошёлся бы дороже самой механики.
var vet_attack:  float = 0.0
var vet_armor:   float = 0.0
var vet_defense: float = 0.0
var vet_speed:   float = 0.0
## Кучность стрельбы и темп добычи от наград за ветеранство. У них, в отличие
## от урона и брони, нет собственного поля в характеристиках — прибавлять
## некуда, поэтому они живут здесь (см. GameManager._apply_bonus_to_unit)
var vet_spread:  float = 0.0
var vet_gather:  float = 0.0
# true — марш строем шагом: скорость вдвое ниже, строй держится плотно
var march_slow: bool = false
# ── НАПРАВЛЕНИЕ ВЗГЛЯДА ПОСЛЕ ПРИБЫТИЯ ───────────────────────────────────────
# Vector3.ZERO — направление не задано, боец смотрит туда, откуда пришёл.
# Ненулевой вектор ставится при построении (SelectionManager): ВСЯ фаланга
# доворачивается в одну сторону — по вектору, который игрок протянул ПКМ.
# Без этого передние шеренги смотрели вперёд, а задние — назад или вбок:
# каждый боец останавливался лицом к СВОЕМУ слоту, а слоты у задних рядов
# лежат позади них
var face_on_arrive: Vector3 = Vector3.ZERO
var _leg_l: MeshInstance3D = null
var _leg_r: MeshInstance3D = null
var _glb_model: Node3D = null
var _sprite_node: MeshInstance3D = null
# Полоска HP над головой (создаётся лениво при первом уроне)
## Оставлены как пустышки: на них ссылаются старые стенды, а сама полоска
## давно рисуется общим MultiMesh (см. HpBarRenderer). Всегда null
var _hp_bar_root: Node3D          = null
var _hp_bar_fill: MeshInstance3D  = null
## Полоску погасил ТУМАН (а не тумблер Alt и не смерть). По этому признаку она
## возвращается сама, когда боец снова попадает в зону видимости
var _hp_fog_hidden: bool = false

## ── ЗАДЕРЖКА ГАШЕНИЯ В ТУМАНЕ ───────────────────────────────────────────────
## Сколько секунд чужой боец остаётся нарисованным после того, как перестал
## просматриваться. Три пересчёта маски (FogOfWar.UPDATE_INTERVAL = 0.15):
## меньше — дребезг на кромке возвращается, больше — начинает читаться как
## «вижу сквозь туман»
const FOG_HIDE_GRACE := 0.45
## Момент, когда бойца в последний раз было видно, по часам движка
var _fog_lit_ms: int = 0
# Текущее состояние зеркала спрайта (см. _update_sprite_flip): хранится
# отдельно, чтобы гистерезис пережил кадры, когда flip не пересчитывается
var _flip_h_state: bool = false
# Разовый запрос пересчёта зеркала у СТОЯЩЕГО юнита (доворот в строй)
var _flip_dirty: bool = false

# Subclasses set this to a Sprite3D / AnimatedSprite3D so it gets the Y-bobbing too
var _active_sprite: Node3D = null
# Базовая высота ЦЕНТРА активного спрайта. Обычно = SPRITE_BASE_Y, но подклассы
# с направленными листами правят её под каждый лист: у разных поз копейщика
# фигурка нарисована на разной высоте внутри кадра (см. Spearman)
var _sprite_base_y: float = SPRITE_BASE_Y
## Высота центра ЭТАЛОННОЙ ленты (той, на которую подкласс посадил узел) и её
## нижний прозрачный отступ в пикселях. По ним выравниваются все прочие позы
var _look_base_y: float = SPRITE_BASE_Y
var _look_base_bottom: int = 0
## Доля 0..1 — с какого места ленты боец начинает зацикленную анимацию.
## Заполняется в _ready() от номера узла: «случайность», одинаковая от запуска
## к запуску, — стенд обязан получать те же кадры
var _anim_offset: float = 0.0
## Потолок поправки привязки, метры
const BASE_Y_FIX_MAX := 0.45
## Пиксель, под который подобран BASE_Y_FIX_MAX (пехота); крупнее — зажим шире
const BASE_Y_FIX_PX := 0.0108
# До этого момента (мс) _update_sprite_anim не трогает анимацию — атака доигрывает
var _anim_lock_until_ms: int = 0

## ── ВИД БОЙЦА — ЧИСТЫЕ ЧИСЛА, А НЕ СВОЙСТВА УЗЛА ────────────────────────────
## В общей отрисовке (perf_config.mm_render_all) картинку рисует MultiMesh, а
## собственный узел спрайта у бойца НЕВИДИМ. Пока состояние анимации жило в
## этом узле, за каждый кадр анимации платили дважды и оба раза зря:
##   • запись Sprite3D.frame / SpriteBase3D.flip_h — не присваивание числа, а
##     пересборка прямоугольника кадра и AABB с постановкой узла в очередь на
##     обновление в RenderingServer;
##   • AnimatedSprite3D к тому же крутит свою анимацию внутренним процессом
##     движка — на каждый узел, независимо от видимости.
## Теперь ЕДИНСТВЕННЫЙ владелец вида — эти поля. Узел трогается только в
## запасном режиме (mm_render_all = false), когда он действительно на экране;
## в общей отрисовке он выключается из анимации (_look_detach_node) и живёт
## дальше лишь как хранилище ресурсов (SpriteFrames / текстуры).
var _look_tex: Texture2D = null     ## лента кадров (атлас), которую режет шейдер
var _look_frames: int = 1           ## сколько кадров в ленте
var _look_frame: int = 0            ## текущий кадр
var _look_px: float = 0.0108        ## pixel_size спрайта
var _look_fps: float = 8.0          ## темп листания текущей ленты
var _look_loop: bool = true         ## лента зациклена (иначе замирает на последнем)
var _look_ok: bool = false          ## числовое состояние заполнено из узла
var _anim_name: StringName = &""    ## имя текущей анимации (для AnimatedSprite3D)
var _anim_phase: float = 0.0        ## фаза листания в кадрах ленты
var _look_detached: bool = false    ## узел уже выведен из анимации
var _look_table: Dictionary = {}    ## разобранный набор: анимация → лента/кадры/темп

signal died(unit)

# Применяет блок характеристик из unit_stats_config.gd.
# Вызывать в _ready() подкласса ДО super._ready() (max_health читается там).
func _apply_config_stats(unit_id: String) -> void:
	stat_id = unit_id
	var s: Dictionary = _UStats.get_stats(unit_id)
	if s.is_empty():
		return
	max_health      = s.get("health", max_health)
	move_speed      = s.get("movement_speed", move_speed)
	attack_damage   = s.get("attack_1", attack_damage)
	attack_range    = s.get("attack_range", attack_range)
	attack_cooldown = s.get("attack_cooldown", attack_cooldown)
	defense         = s.get("defense", defense)
	armor           = s.get("armor", armor)
	morale          = s.get("morale", morale)
	push_force      = s.get("push_force", push_force)
	charge_push_mult = s.get("charge_push_mult", charge_push_mult)
	push_every       = int(s.get("push_every", push_every))
	# ── НАТИСК С РАЗГОНА ───────────────────────────────────────────────────
	# Отсутствие charge_range в конфиге означает «не конница»: ноль отключает
	# всю ветку разгона одним сравнением, поэтому пехоте она не стоит ничего
	charge_range        = s.get("charge_range", charge_range)
	charge_min_runup    = s.get("charge_min_runup", charge_min_runup)
	charge_speed_mult   = s.get("charge_speed_mult", charge_speed_mult)
	charge_impact_frac  = s.get("charge_impact_frac", charge_impact_frac)
	charge_splash       = s.get("charge_splash", charge_splash)
	charge_knockback    = s.get("charge_knockback", charge_knockback)
	charge_breakthrough = s.get("charge_breakthrough", charge_breakthrough)
	charge_counter_frac = s.get("charge_counter_frac", charge_counter_frac)
	charge_row_kill     = int(s.get("charge_row_kill", charge_row_kill))
	charge_row2_frac    = s.get("charge_row2_frac", charge_row2_frac)
	charge_row_depth    = s.get("charge_row_depth", charge_row_depth)

func _ready() -> void:
	current_health = max_health + GameManager.get_upgrade(faction, "health")
	max_health     = current_health
	# ── ДАЛЬНОСТЬ ИЗ КУЗНИЦЫ ВПИСЫВАЕТСЯ В ПОЛЕ, А НЕ ЧИТАЕТСЯ ВЖИВУЮ ────────
	# attack_range читается в горячих ветках десятки раз за тик (перехват,
	# подтягивание, скан целей, обзор в тумане), и межобъектный вызов в каждой
	# из них стоил бы дороже самого бонуса. Поэтому здесь тот же приём, что у
	# запаса HP: прибавка вписывается в поле при рождении, а уже стоящим на
	# карте её раздаёт GameManager._apply_range_bonus_now в момент исследования
	if stat_id != "":
		attack_range += GameManager.unit_bonus(faction, stat_id, "bonus_range")
		attack_range = clamp_attack_range(attack_range)

	_sep_phase      = get_instance_id() & 7
	# ── СТОРОНА ОБХОДА СЧИТАЕТСЯ ОДИН РАЗ ──────────────────────────────────
	# get_instance_id() — вызов в движок, а спрашивали его в трёх горячих
	# ветках (фланговый обход, объезд ствола, разлёт по оси удара) на каждом
	# срабатывании. Значение при этом ПОСТОЯННО за всю жизнь узла
	_side_sign      = 1.0 if (get_instance_id() & 1) == 0 else -1.0
	# Сдвиг фазы анимации: 251 — простое, соседние по спавну бойцы получают
	# заметно разные доли, а не соседние сотые
	_anim_offset    = float(get_instance_id() % 251) / 251.0
	# Разводим первый опрос агро по времени: иначе весь отряд, вышедший из
	# барака одним заказом, сканирует округу в один и тот же кадр
	_aggro_timer    = float(_sep_phase) * 0.12
	# Фаза разбора наложения: восемь групп бойцов проверяются в разные кадры
	_sep_timer      = float(_sep_phase) * (SEP_INTERVAL / 8.0)
	_build_visual()
	# ВАЖНО: движок сам включает is_physics_processing() ТОЛЬКО когда скрипт
	# определяет метод _physics_process(). Теперь юнит его не определяет
	# (см. tick_physics ниже) — автовключение больше не срабатывает, и без
	# явного set_physics_process(true) GameManager.is_physics_processing()
	# был бы false у КАЖДОГО юнита с рождения (проверено: без этой строки
	# 900 маршрующих юнитов давали 0 мс физики и 0 дошедших)
	set_tick(true)
	# То же самое и для кадрового тика: юнит больше не определяет _process()
	# (см. tick_visual), поэтому автовключение движка не срабатывает, а
	# GameManager проверяет именно is_processing() — без этой строки визуал
	# не обновлялся бы вовсе. Сам тумблер работает как прежде: Castle.absorb_unit
	# и «сон» стоящего бойца по-прежнему гасят его через set_process(false)
	set_draw(true)
	# СТРОКА В ЯДРЕ АРМИИ. Координату сюда НЕ пишем: её узлу задают уже ПОСЛЕ
	# add_child (тот же порядок, из-за которого отложены регистрация ствола и
	# посадка дерева), и в _ready она ещё нулевая. Признак F_POS_VALID снят,
	# поэтому пакетные обходы эту строку пропустят до первого тика — а тик
	# поставит настоящую точку (см. tick_physics)
	call_deferred("_check_local_xform")
	_soa = GameManager.army.alloc_for(self)
	GameManager.army.set_faction(_soa, faction)
	GameManager.army.set_state(_soa, state)
	# ЛИЧНЫЙ ГАБАРИТ. У людей ноль — солвер берёт общую SEP_MIN_DIST; крупный
	# боец (гоблин) возвращает своё число. Один вызов на рождение, не на кадр
	var sr: float = sep_radius()
	if sr > 0.0:
		GameManager.army.set_sep_radius(_soa, sr)
	_soa_push_stats()
	GameManager.register_unit(self)
	add_to_group("all_units")
	# Группа по номеру фракции, а не развилкой «свой/чужой»: гоблины не имеют
	# права попасть в enemy_units, иначе красный ИИ запишет их в свою армию
	add_to_group(Constants.unit_group(faction))
	# НАСЛЕДОВАНИЕ РЕЖИМА ПОЛОСОК. Если игрок держит тумблер Alt поднятым, свежее
	# подкрепление должно выйти из ворот уже с полоской, а не ждать первой раны
	if GameManager.hp_bars_forced:
		_update_hp_bar()

# ─────────────────────────────────────────────────────────────────────────────
# ВИЗУАЛ БОЙЦА: ТОЛЬКО ТО, ЧТО НУЖНО ПРЯМО СЕЙЧАС
#
# Раньше здесь строился полный комплект: коллайдер, запасное «тело»-квад,
# мягкая тень с собственной градиентной текстурой и кольцо выделения с
# собственным тором на 2 тыс. треугольников. Три из четырёх узлов при этом
# были не нужны: подкласс со спрайтом тут же прятал квад, а тень с кольцом
# видно только у ВЫДЕЛЕННОГО бойца — то есть у горстки из шести сотен.
#
# На отряде в 50 человек это давало полсотни растеризаций GradientTexture2D
# подряд, и найм отряда читался как рывок кадра.
#
# Теперь: коллайдер — общей формой на всех (маски нулевые, форма нужна лишь
# как мишень для луча выбора), остальное — ЛЕНИВО:
#   • кольцо и тень строятся в set_selected(true) при первом выделении;
#   • запасной квад — только если подкласс не нашёл ни одного спрайта;
#   • полоска HP — при первом уроне (как и было).
# Общие меши и материалы лежат в scripts/units/UnitVisuals.gd.
# ─────────────────────────────────────────────────────────────────────────────
## КОЛЛАЙДЕРА БОЛЬШЕ НЕТ. Он был единственным содержимым этого метода и нужен
## был только как мишень для луча выбора; выбор бойца теперь идёт по
## пространственной сетке (см. SelectionManager._pick_at). Сам метод оставлен:
## подклассы зовут super() и строят поверх него свой спрайт
func _build_visual() -> void:
	pass

## Запасное «тело» — билборд-квад цвета фракции. Создаётся ТОЛЬКО по требованию:
## подкласс со спрайтом сюда не заходит вовсе
func _ensure_body_quad() -> MeshInstance3D:
	if _sprite_node != null and is_instance_valid(_sprite_node):
		return _sprite_node
	_sprite_node = MeshInstance3D.new()
	_sprite_node.name = "UnitSprite"
	var quad := QuadMesh.new()
	quad.size = Vector2(1.0, 2.0) * UNIT_SCALE
	var mat := StandardMaterial3D.new()
	mat.albedo_color    = _faction_color()
	# FIXED_Y: каждый спрайт вращается вокруг СВОЕЙ вертикальной оси.
	# Полный BILLBOARD_ENABLED при виде сверху укладывает спрайты плашмя —
	# при орбите камеры весь отряд крутится как «пропеллер на столе».
	mat.billboard_mode  = BaseMaterial3D.BILLBOARD_FIXED_Y
	mat.shading_mode    = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat.cull_mode       = BaseMaterial3D.CULL_DISABLED
	quad.material = mat
	_sprite_node.mesh = quad
	_sprite_node.position.y = QUAD_BASE_Y
	add_child(_sprite_node)
	body_mesh = _sprite_node
	return _sprite_node

func _faction_color() -> Color:
	return Color(0.2, 0.4, 0.9) if faction == Constants.FACTION_PLAYER else Color(0.85, 0.18, 0.18)

func set_sprite_texture(tex: Texture2D) -> void:
	_ensure_body_quad()
	if _sprite_node == null:
		return
	# Многие PNG юнитов — горизонтальные спрайт-шиты (Idle из 6-12 кадров).
	# На статичный квад кладём ТОЛЬКО первый кадр, иначе юнит рисуется
	# «лентой» из нескольких фигур (выглядело как строй-фантом)
	var fc: int = _BBUtil.frame_count(tex)
	if fc > 1:
		var img := tex.get_image()
		if img != null:
			var fw: int = img.get_width() / fc
			tex = ImageTexture.create_from_image(img.get_region(Rect2i(0, 0, fw, img.get_height())))
	var mat := _sprite_node.get_active_material(0) as StandardMaterial3D
	if mat == null:
		mat = StandardMaterial3D.new()
		mat.shading_mode   = BaseMaterial3D.SHADING_MODE_UNSHADED
		mat.cull_mode      = BaseMaterial3D.CULL_DISABLED
	mat.billboard_mode = BaseMaterial3D.BILLBOARD_FIXED_Y
	# Scissor вместо alpha-блендинга: пишет глубину, нет мерцания сортировки
	# при перекрытии десятков спрайтов в плотном строю ("фантомные дубли")
	mat.transparency            = BaseMaterial3D.TRANSPARENCY_ALPHA_SCISSOR
	mat.alpha_scissor_threshold = 0.5
	mat.albedo_texture = tex
	mat.albedo_color   = Color.WHITE
	_sprite_node.set_surface_override_material(0, mat)

## ЛЕНИВАЯ ПОДСВЕТКА. Кольцо и тень строятся при ПЕРВОМ выделении бойца и
## дальше просто прячутся/показываются. Выделено обычно два-три отряда из
## тридцати — остальные шесть сотен этих узлов не заводят вовсе
## ── МЕТКИ ВЫДЕЛЕНИЯ ЖИВУТ НЕ ЗДЕСЬ ──────────────────────────────────────────
## Кольцо и мини-тень раньше были ДВУМЯ узлами-детьми каждого выделенного
## бойца. На выделенных 15 отрядах это 1620 лишних объектов отрисовки: замер
## qa_march_perf поймал скачок вызовов отрисовки 1124 → 2744 ровно в момент
## выделения, а войска игрок отправляет именно выделенными.
##
## Теперь обе метки рисует общий MultiMesh на всю армию
## (GameManager.sel_decals, см. SelectionDecalRenderer.gd) — картинка та же,
## меши и материалы и раньше были общими синглтонами UnitVisuals.
##
## Поле selection_ring оставлено (всегда null): подклассы сравнивают с ним
## детей при поиске своего визуального меша (`child != selection_ring`), и
## сравнение остаётся верным — просто теперь такого ребёнка не существует
var _selected: bool = false

func is_selected() -> bool:
	return _selected

func set_selected(value: bool) -> void:
	if _selected == value:
		return
	_selected = value
	GameManager.set_unit_selected_decal(self, value)

# slow_march = true — отряд идёт ШАГОМ (50% скорости), сохраняя строй.
# Так двигается горячая группа по обычному ПКМ; растянутая линия формации
# отдаёт приказ бегом (slow_march = false)
# ── НЕЗАКОНЧЕННЫЙ МАРШ ───────────────────────────────────────────────────────
# Приказ на движение переживает бой. Раньше перехват вражеской шеренгой
# (см. _process_move) переводил бойца в атаку, и приказ идти дальше пропадал
# бесследно: снеся заслон, отряд оставался стоять на месте побоища.
# Здесь приказ хранится целиком — точка, режим шага и направление фронта —
# и подхватывается снова, когда драться уже не с кем.
var _march_pending: bool    = false
var _march_target:  Vector3 = Vector3.ZERO
var _march_slow:    bool    = false
var _march_face:    Vector3 = Vector3.ZERO
## Бежал ли отряд, когда марш прервали: возобновляем тем же темпом
var _march_run:     bool    = false

## Насколько близко к цели марш считается выполненным и возобновлять его не надо
const MARCH_DONE_DIST := 1.2

## Вернуться к прерванному маршу. false — идти уже некуда
func _resume_march() -> bool:
	if not _march_pending:
		return false
	var d := _march_target - global_position
	d.y = 0.0
	if d.length() < MARCH_DONE_DIST:
		_march_pending = false
		return false
	# Через command_move: он же переставит пост, стойку взгляда и разбудит _process.
	# Флаг _march_pending при этом выставится заново — приказ всё ещё в силе
	command_move(_march_target, _march_slow, _march_face, false, false, _march_run)
	return true

## ── НЕЗАКОНЧЕННЫЙ ПРИКАЗ АТАКИ ───────────────────────────────────────────────
## Тот же принцип, что и _march_pending выше, но для ПРЯМОГО приказа атаки
## (command_attack(forced=true)). Раньше approach к forced-цели шёл только
## через _process_attack (ветка dist > attack_range) и вообще не читал
## _enemy_contact: отряд, посланный ПКМ на дальнюю цель, проходил СКВОЗЬ любой
## другой вражеский отряд на пути, не нанеся и не получив ни царапины — тот же
## "ghost through", который когда-то чинили для обычного марша (_process_move),
## но только для него (см. qa_approach_intercept, было НЕ ПРОШЛО). Хранится
## именно squad_id, а не ссылка на конкретного бойца: пока дрались с помехой,
## исходная жертва вполне могла умереть от чужой руки
var _atk_pending:        bool   = false
var _atk_pending_target: Node3D = null
var _atk_pending_squad:  int    = 0
var _atk_pending_charge: bool   = false
## Был ли прерванный приказ приказом ИГРОКА (см. target_lock). Возобновлять его
## надо с тем же замком: иначе снос заслона по дороге незаметно превращал приказ
## игрока в обычную стычку, и дальше отряд разбредался по ближайшим целям
var _atk_pending_lock:   bool   = false

## Вернуться к прерванному приказу атаки. false — атаковать уже некого
func _resume_attack() -> bool:
	if not _atk_pending:
		return false
	_atk_pending = false
	# ПРОВЕРКА НА СЫРОЙ ССЫЛКЕ. Присваивание освобождённого объекта в
	# ТИПИЗИРОВАННУЮ переменную бросает исключение само по себе — страховка
	# строкой ниже до выполнения не доходила. А поле держится через весь бой,
	# и цель за это время гибнет регулярно
	var tgt: Node3D = null
	if is_instance_valid(_atk_pending_target):
		tgt = _atk_pending_target
	if tgt == null or tgt.is_dead():
		tgt = GameManager.squad_pick_member(_atk_pending_squad, global_position, null)
	if tgt == null:
		# Исходная жертва и весь её отряд выбиты — приказ выполнен, замок больше
		# не за что держать. Дальше решает авто-агро (приоритет №3)
		if target_lock:
			release_target_lock()
		return false
	command_attack(tgt, true, _atk_pending_charge, _atk_pending_lock)
	return true

## player_order — приказ отдал ИГРОК, а не внутренняя механика (_resume_march,
## смыкание рядов, ИИ). Только он взводит замок FORCED_MOVE_SEC: продолженный
## после стычки марш обязан ловить новых врагов по дороге как раньше, иначе
## отряд пройдёт сквозь поле боя не заметив его
## run — БЕГ. Ставится только двойным ПКМ игрока; любой приказ БЕЗ него бег
## снимает (в том числе продолжение марша и смыкание рядов — прибежали, дальше
## идём шагом). Именно поэтому флаг не «липкий», а переписывается каждый раз
## ── ЭТАП ПЕРЕХОДА РЕКИ ────────────────────────────────────────────────────
## 0 — реки на пути нет; 1 — идём ко входу в брод; 2 — переходим к выходу.
## Дальше боец идёт в саму точку приказа. Своего состояния автомату это не
## добавляет: боец всё время в State.MOVING, меняется только move_target
## ── МАРШРУТ ПРИКАЗА (спринт 19, письмо 11) ────────────────────────────────
## Прежние два этапа брода (_ford_stage) стали общим списком точек: брод со
## своей полосой плюс обходы скал и воды по сетке ядра (GameManager.build_route).
## move_target — ТЕКУЩАЯ точка маршрута, _route_goal — конечная (она же пост).
## Промежуточная точка считается пройденной с ROUTE_WP_RADIUS (в толпе точно в
## неё не встать), и раз в ROUTE_LOS_SEC проверяется, не видна ли уже
## СЛЕДУЮЩАЯ, — тогда текущая пропускается (вытолкнутый не возвращается назад)
var _route: PackedVector3Array = PackedVector3Array()
var _route_i: int = 0
var _route_goal: Vector3 = Vector3.ZERO
var _route_los_t: float = 0.0
const ROUTE_WP_RADIUS := 1.6
const ROUTE_LOS_SEC := 0.5
## Подход к цели атаки в обход (см. _atk_waypoint)
var _atk_route: PackedVector3Array = PackedVector3Array()
var _atk_route_i: int = 0
var _nav_t: float = 0.0
const NAV_RECHECK_SEC := 0.4

func route_size() -> int:
	return _route.size()

func route_index() -> int:
	return _route_i

## Смещение бойца от центра отряда в плане — его полоса в колонне обхода
func _lat_offset() -> Vector2:
	if squad_id <= 0:
		return Vector2.ZERO
	var c: Vector2 = GameManager.squad_centre_xz(squad_id)
	if c.x == INF:
		return Vector2.ZERO
	var here: Vector3 = position if _local_xform else global_position
	return Vector2(here.x - c.x, here.z - c.y)

## Следующая точка маршрута (или конечная), когда текущая пройдена
func _route_advance() -> void:
	_route_i += 1
	move_target = _route[_route_i] if _route_i < _route.size() else _route_goal
	_reset_stuck()
	_wake_process()

## Точка обхода на подходе к цели атаки; Vector3.INF — идти прямо.
## Раз в NAV_RECHECK_SEC спрашивается, упирается ли прямая в скалу/воду;
## упирается — маршрут от ядра (кэш на физкадр по ячейкам, см. GameManager)
func _atk_waypoint(mp: Vector3, tp: Vector3, delta: float) -> Vector3:
	_nav_t -= delta
	if _nav_t <= 0.0:
		_nav_t = NAV_RECHECK_SEC + float(get_instance_id() % 7) * 0.03
		if GameManager.nav_blocked(mp, tp):
			_atk_route = GameManager.nav_route(mp, tp)
			_atk_route_i = 0
		elif not _atk_route.is_empty():
			_atk_route = PackedVector3Array()
	while _atk_route_i < _atk_route.size():
		var w: Vector3 = _atk_route[_atk_route_i]
		var dx: float = w.x - mp.x
		var dz: float = w.z - mp.z
		if dx * dx + dz * dz < ROUTE_WP_RADIUS * ROUTE_WP_RADIUS:
			_atk_route_i += 1
			continue
		return w
	return Vector3.INF

## Смещение бойца от центра своего отряда ВДОЛЬ РУСЛА — его полоса на броде.
## Без отряда (рабочий, одиночка) полоса нулевая: он и есть свой центр
func _ford_lane() -> float:
	if squad_id <= 0:
		return 0.0
	var c: Vector2 = GameManager.squad_centre_xz(squad_id)
	if c.x == INF:
		return 0.0
	var here: Vector3 = position if _local_xform else global_position
	# Групповой приказ смещает полосу отряда от центра ГРУППЫ (ТЗ 14.09.2026,
	# п. 7): см. GameManager.squad_ford_lane
	return GameManager.squad_ford_lane(squad_id, here.z - c.y)

func command_move(target_pos: Vector3, slow_march: bool = false, face_dir: Vector3 = Vector3.ZERO,
		keep_retreat: bool = false, player_order: bool = false, run: bool = false) -> void:
	# Зонд BigStand: кто, кому и из какого состояния шлёт приказ (одно
	# сравнение bool на приказ, покадрового пути здесь нет)
	if _Opt.cmd_meter:
		_Opt.cmd_hit(stat_id, state, squad_id)
	# ── ЗАЛОЧЕННЫЙ СТОЙКОЙ НЕ ИДЁТ НИКУДА, ТОЛЬКО ПОВОРАЧИВАЕТСЯ ───────────
	# Заказ владельца: в обороне перемещение запрещено на уровне 0.0, разрешён
	# только разворот строя. Приказ не «откладывается», а НЕ ИСПОЛНЯЕТСЯ вовсе:
	# отложенный он выстрелил бы при первом же переключении стойки и увёл бы
	# отряд туда, куда игрок показывал минуту назад.
	#
	# Скоростью (move_speed_mult = 0) это делать НЕЛЬЗЯ: боец ушёл бы в
	# State.MOVING навсегда, никогда не доложил о прибытии и никогда не заснул
	# бы по картинке — то есть замок позиции стоил бы кадра на каждого
	# копейщика фаланги
	# ── ПАНИКУЮЩИЙ ПРИКАЗОВ НЕ ПРИНИМАЕТ ───────────────────────────────────
	# Двадцать секунд ступора — это ПОТЕРЯ УПРАВЛЕНИЯ, а не замедление: отряд
	# под белым флагом бежит и не слушает никого. Сам приказ на бегство сюда
	# приходит ДО взвода признака (см. panic_flee), поэтому запрет его не задевает
	if _panicked:
		return
	if _stance_locks_position():
		if face_dir.length_squared() > 1e-6:
			_facing = face_dir.normalized()
			_pose_dirty = true
		_wake_process()
		return
	# РАЗМЕТКА ЛИНИИ УСТАРЕЛА. Она описывает, где был фронт ПРЕЖНЕГО боя; после
	# нового приказа и курс, и глубина уже ничего не значат. Срок разметки 120 мс,
	# и без сброса боец успел бы полметра пройти не туда (см. _sweep_battle_lines)
	_rear_line = false
	_line_valid = false
	_melee_grip = false          # новый приказ на движение снимает сцепку
	_ring_done = false           # и сектор у здания: новый приказ — новый подход
	# ── И ПРИЗНАК УПОРА В ЧУЖОЕ ТЕЛО ТОЖЕ ──────────────────────────────────
	# _enemy_contact ставит солвер в тот кадр, когда шаг РЕАЛЬНО не прошёл, и
	# гасят его те же ветки, что его читают. Но приказ на движение приходит
	# бойцу, который может стоять в контакте прямо сейчас, — и старая отметка
	# доживала до первого же тика нового марша, где новая ветка «упор перебивает
	# замок приказа» честно принимала её за упор ЭТОГО марша и разворачивала
	# бойца в бой. На стенде это выглядело как «отряд, выведенный из боя, никуда
	# не уходит» (qa_disengage A4: ушло 0-3 из 6 вместо шести).
	# Упор — это свойство ТЕКУЩЕГО шага, и новый приказ обязан его обнулять.
	# СНИМОК ДО ОБНУЛЕНИЯ нужен ниже: по нему решается, заработал ли боец
	# послабление на проход сквозь тела (см. _pass_earned)
	var was_stuck: bool = _enemy_contact
	_enemy_contact = false
	# Любой новый приказ движения отменяет отход — кроме самого приказа «в замок»,
	# который отдаётся с keep_retreat = true (см. Castle.request_garrison)
	if retreating and not keep_retreat:
		end_retreat()
	# Бег живёт ровно один приказ: новый приказ либо снова просит бежать,
	# либо возвращает отряд к обычному шагу (и копейщикам — фалангу)
	_set_sprinting(run)
	_charge_order = false        # просто идём — копья вверх
	# И РАЗГОН ТОЖЕ. Приказ на движение отменяет натиск: всадник, которого
	# игрок увёл в сторону, не должен «донести» накопленный удар до первого
	# встречного на новом маршруте
	is_charging = false
	# Новый приказ снимает признак «стою»: боец снова в пути
	_settled = false
	# И запрет погони тоже: игрок переставил отряд — новый подход разрешён
	_engaged_once = false
	_pursuit_anchored = false
	GameManager.squad_pursuit_release(squad_id)
	# Точка, куда шла стена по приказу атаки, тоже отменена: приказ «идти туда»
	# перебивает приказ «идти на них» (см. _phalanx_march)
	_hold_goal_set = false
	# НОВЫЙ ПРИКАЗ ДВИЖЕНИЯ ОТМЕНЯЕТ НЕЗАКОНЧЕННЫЙ ПРИКАЗ АТАКИ — симметрично
	# тому, как command_attack(forced=true) отменяет _march_pending
	_atk_pending = false
	# И ЗАМОК ЦЕЛИ ТОЖЕ: приказ «идти туда» отменяет приказ «бить их».
	# Это единственный штатный способ снять замок вручную (см. target_lock)
	release_target_lock()
	# ПРИКАЗ ИГРОКА ПЕРЕНАЗНАЧАЕТ ПОСТ, а значит и «исходную позицию», куда
	# отряд возвращается после боя: метка «ушёл помогать» снимается
	if player_order and squad_id > 0:
		GameManager.squad_clear_helped(squad_id)
		# ── И ВСЮ ОТРЯДНУЮ ПАМЯТЬ О БОЕ ТОЖЕ ───────────────────────────
		# Личную боец чистит строками выше, а отрядная (сектор у стены,
		# «держать позицию», общий ответ о ближайшем враге) переживала
		# приказ и возвращала его обратно в бой первым же тиком авто-агро.
		# Разбор — в GameManager.squad_forget_combat
		GameManager.squad_forget_combat(squad_id)
	# ЖИВАЯ ЦЕЛЬ ПРЯМО СЕЙЧАС = это приказ выйти из боя (см. _disengaging выше)
	_disengaging = attack_target != null
	set_attack_target(null)
	_hunt_sheep = null           # новый приказ снимает охоту на овцу
	# ЦЕЛЬ В ОЗЕРЕ ПЕРЕНОСИТСЯ НА БЕРЕГ. Точка в воде недостижима в принципе:
	# юнит упирается в кромку, дистанция до цели не падает ниже порога прибытия,
	# и он вечно топчется у берега вместо того, чтобы встать. Это же спасает
	# слоты строя, часть которых легла в воду при построении у самого берега
	move_target   = GameManager.land_target(target_pos)
	# ПОСТ = КУДА ПОСТАВИЛИ. От него считается поводок авто-агро: боец сам, без
	# приказа, не уходит дальше AGGRO_LEASH. Приказ игрока пост переназначает,
	# поэтому отправить отряд через всю карту по-прежнему можно
	post_pos    = move_target
	_post_valid = true
	# ── РЕКА И СКАЛЫ НА ПУТИ: МАРШРУТ, ПОТОМ ЦЕЛЬ (спринт 19) ──────────────
	# ПОСТ ОСТАЁТСЯ КОНЕЧНОЙ ТОЧКОЙ, а не бродом и не углом обхода: пост
	# означает «куда меня поставили», от него считается поводок авто-агро.
	# Маршрут взводится ПОСЛЕ поста и переписывает одну лишь move_target
	_route = GameManager.build_route(
		position if _local_xform else global_position, move_target, _ford_lane(), _lat_offset())
	_route_i = 0
	_route_los_t = ROUTE_LOS_SEC
	_atk_route = PackedVector3Array()
	if not _route.is_empty():
		_route_goal = move_target
		move_target = _route[0]
	march_slow    = slow_march
	state         = State.MOVING
	face_on_arrive = face_dir
	# Приказ запоминается целиком: если по дороге завяжется бой, после него
	# боец продолжит путь, а не останется стоять на месте стычки
	_march_pending = true
	# ── ВОЗОБНОВЛЯЕТСЯ КОНЕЧНАЯ ТОЧКА, А НЕ ОТРЕЗОК ПУТИ ───────────────────
	# Приказ запоминается на случай стычки по дороге, и запомнить надо ЦЕЛЬ:
	# бой посреди переправы иначе кончался бы тем, что боец доходит до выхода
	# из брода и встаёт там навсегда. Дорога через реку считается заново от
	# того места, где бойца отпустил бой, — это дешевле и честнее, чем хранить
	# недопройденные этапы
	_march_target  = post_pos
	_march_slow    = slow_march
	_march_face    = face_dir
	_march_run     = run
	if player_order:
		_move_lock = FORCED_MOVE_SEC
		# ── ПОСЛАБЛЕНИЕ НА ПРОХОД — БИЛЕТ НА ВЫХОД, А НЕ НА ВХОД ───────
		# Жалоба владельца со скриншотом: «рыцари при клике протекают
		# сквозь строй стоящих копейщиков, получают урон на ходу, но не
		# останавливаются и прорываются к стрелкам». Это было НЕ багом
		# расталкивания, а ровно тем, что здесь написано: замок приказа
		# выдавал ЛЮБОМУ бойцу полторы секунды прохода сквозь чужие
		# тела — а всаднику этого хватает на четыре метра, то есть на
		# весь строй в глубину.
		#
		# Послабление заводилось ради одного случая — «отряд В ПЛОТНОЙ
		# РУБКЕ не идёт с первого правого клика», где шаг упирается в
		# тела СО ВСЕХ СТОРОН. То есть это билет НА ВЫХОД из свалки,
		# а выдавался он и тем, кто в свалке не стоит вовсе, — то есть работал
		# билетом НА ВХОД. Теперь он ЗАРАБОТАННЫЙ: его получает только
		# тот, чей шаг УЖЕ упёрся в чужое тело к моменту приказа
		# (_enemy_contact ставит солвер в тот же кадр, когда шаг не
		# прошёл). Не стоишь в телах — выходить неоткуда, и чужой строй
		# тебе преграда, как и всем остальным
		# ПРИЗНАК «Я В СВАЛКЕ» — ЧУЖОЕ ТЕЛО ВПЛОТНУЮ, А НЕ ТОЛЬКО УПЁРШИЙСЯ ШАГ.
		# Одного _enemy_contact мало и это замерено (qa_disengage D2: окружённый
		# боец прошёл 0.00 м). Солвер взводит его в тот кадр, когда ШАГ не прошёл,
		# а боец, стоящий в рубке, никуда не шагает вовсе — шагать он начнёт
		# только от этого самого приказа. Поэтому спрашиваем ГЕОМЕТРИЮ:
		# есть ли чужое тело на длине руки. Скан здесь бесплатен — это
		# ПРИКАЗ, а не покадровый путь: игрок щёлкает разы в секунду,
		# а не шестьдесят раз в неё
		_pass_earned = was_stuck or _find_nearest_enemy_in_range(LOCK_BLOCKER_RANGE, "pass_earned") != null
		# ОТКУДА ВЫБИРАЕТСЯ. По этой точке билет и гаснет — по факту выхода из
		# тел, а не по часам (см. _forced_move_pass)
		_pass_from = position if _local_xform else global_position
	# ── ПРИКАЗУ ДАЁТСЯ ФОРА НА «ПОЕХАТЬ» ───────────────────────────────────
	# Признак «иду» считается по ФАКТИЧЕСКОМУ смещению за окно замера
	# (moved_recently), и сразу после приказа он ещё ЛОЖЕН: боец только что
	# стоял в свалке, и первая выборка появится через MOVE_ANIM_SAMPLE_MS.
	# А на этом признаке стоит разбор «иду прочь или упёрся»: без форы отряд,
	# которому велели ВЫЙТИ из боя, успевал получить удар, счесться упёршимся и
	# ответить — то есть отменить приказ игрока сам себе (поймал qa_melee F2:
	# одиннадцать из двенадцати остались с целью, и десять из них при этом
	# честно ехали).
	# Окно замера начинается заново от этой точки, а признак взводится на одну
	# выдержку вперёд: этого хватает сделать первый шаг и попасть в замер.
	# Побочно это лечит и картинку — поза ходьбы включается в кадр приказа, а
	# не через две десятых секунды
	_mv_prev = position
	_mv_prev_set = true
	_mv_sample_ms = now_ms
	_mv_until_ms = now_ms + MOVE_ANIM_HOLD_MS
	_mv_moving = true
	# Новая цель — новый отсчёт продвижения (см. STUCK_CHECK_SEC)
	_reset_stuck()
	_trunk_ignore  = 0.0
	if face_on_arrive.length_squared() > 1e-6:
		face_on_arrive.y = 0.0
		face_on_arrive = face_on_arrive.normalized()
	_wake_process()

# ── СТОЙКА ───────────────────────────────────────────────────────────────────

func set_stance(new_stance: String) -> void:
	stance = new_stance
	# ПЕРЕКЛЮЧЕНИЕ В ОБОРОНУ = «СТОЙ ГДЕ СТОИШЬ». Незаконченный приказ атаки
	# гаснет вместе с точкой, куда шла стена: игрок нажал щит — значит хочет,
	# чтобы отряд встал здесь, а не дошёл сначала туда, куда его послали минуту
	# назад. Новый клик по врагу заведёт новую точку (см. _phalanx_march)
	if _stance_holds_ground():
		_attack_is_forced = false
		_hold_goal_set = false
	# ── СТОЙКА МЕНЯЕТСЯ С ПЕРВОГО КЛИКА, А НЕ СО ВТОРОГО ────────────────────
	# Жалоба владельца: «нажал ЗАЩИТУ — копья выставили один-два человека;
	# чтобы выставили все, приходится нажимать кнопку дважды».
	#
	# Второе нажатие ничего не «чинило» — оно просто давало время. Копьё
	# опускается по ЖИВОМУ ряду (Unit._live_rank), а ряд у копейщика вне
	# обороны не считается вовсе: он приходит либо пачкой от отряда, либо
	# личным сканом, и оба идут ПО ТАЙМЕРУ RANK_RECHECK. Пока таймер не истёк,
	# весь отряд стоит с рядом от прошлой жизни — и щетина вылезала кусками.
	# Взводим таймер в ноль: ряд пересчитается в ближайшем же тике
	_rank_timer = 0.0
	_wake_process()

## ЗАПОМНЕННЫЙ ОТВЕТ ПО ТЕКУЩЕЙ СТОЙКЕ. Сам разбор — обращение в таблицу стоек
## плюс два поиска по словарю, а зовётся он до ЧЕТЫРЁХ раз на бойца в кадре
## (тик, скорость, фаланга, выбор цели) при том, что стойка меняется по приказу
## игрока, то есть считанные разы за бой. Ключ — сама строка стойки, поэтому
## кэш переживает и прямое присваивание stance в обход set_stance
var _stance_key: String = ""
var _stance_hold: bool = false
var _stance_lock: bool = false

func _stance_holds_ground() -> bool:
	if stance != _stance_key:
		_refresh_stance_cache()
	return _stance_hold

## ── ПОЗИЦИЯ ЗАЛОЧЕНА СТОЙКОЙ ──────────────────────────────────────────────
## Строже, чем holds_ground: тот запрещает ПОГОНЮ, а этот — любое перемещение
## вообще. Разрешён только разворот и удар по тому, кто сам вошёл в дальность
## (см. STANCES.defense.lock_position).
##
## ЕДИНСТВЕННОЕ ИСКЛЮЧЕНИЕ — СМЫКАНИЕ РЯДОВ. Без него потери и проход союзников
## сквозь строй оставляли бы в фаланге вечные дыры, а заказ на смыкание стоит
## тут же, рядом (см. allow_reform_move)
func _stance_locks_position() -> bool:
	if stance != _stance_key:
		_refresh_stance_cache()
	if not _stance_lock:
		return false
	return _reform_permit <= 0.0

func _refresh_stance_cache() -> void:
	_stance_key  = stance
	var d: Dictionary = _UStats.get_stance(stance)
	_stance_hold = bool(d.get("holds_ground", false))
	_stance_lock = bool(d.get("lock_position", false))

## ── РАЗРЕШЕНИЕ НА ПЕРЕСТРОЕНИЕ ────────────────────────────────────────────
## Окно, в котором залоченный стойкой боец всё же вправе дойти до своего места
## в разметке. Выдаёт ТОЛЬКО смыкание рядов (SquadFormation.close_ranks).
##
## Секунды, а не флаг «пока не дойдёт»: боец может не дойти никогда (место
## занято деревом, его добили по дороге), и вечное разрешение превратило бы
## замок позиции в фикцию
const REFORM_PERMIT_SEC := 6.0
var _reform_permit: float = 0.0

func allow_reform_move(secs: float = REFORM_PERMIT_SEC) -> void:
	_reform_permit = maxf(_reform_permit, secs)

# Кулдаун удара с учётом стойки: в обороне бьют на 25% чаще
func _effective_cooldown() -> float:
	var mult: float = _UStats.stance_stat(stance, "attack_speed_mult", 1.0)
	# СКОРОСТЬ АТАКИ ИЗ КУЗНИЦЫ. Ключ хранится положительным (см. MODIFIERS) и
	# вычитается здесь; пол — MIN_COOLDOWN, иначе достаточно длинная ветка
	# исследований обнулила бы перезарядку. Чтение вживую здесь ничего не стоит:
	# ветка выполняется один раз на удар, а не на кадр
	var cut: float = GameManager.unit_bonus(faction, stat_id, "bonus_cooldown")
	var cd: float = attack_cooldown / maxf(mult, 0.01) - cut
	# ДОЛЕВОЕ УСКОРЕНИЕ ИЗ КУЗНИЦЫ (ТЗ 14.09.2026, ветка лучника 1b-3b):
	# 0.1 = −10 % к перезарядке, копится по рядам до 0.3
	var pct: float = GameManager.unit_bonus(faction, stat_id, "bonus_cooldown_pct")
	if pct > 0.0:
		cd *= (1.0 - minf(pct, 0.8))
	# «Аура скорострельности» монаха — стрелкам (письмо 12)
	if attack_range > 3.0 and now_ms < _aura_until_ms and _aura_rate > 0.0:
		cd *= (1.0 - minf(_aura_rate, 0.6))
	return maxf(cd, _UStats.MIN_COOLDOWN)

# forced = true  — прямой приказ (ПКМ игрока / ИИ): юнит преследует цель.
# forced = false — оборонительная атака (авто-агро, ответ на урон): юнит
#                  ДЕРЖИТ ПОЗИЦИЮ — бьёт только цели в радиусе атаки,
#                  за ушедшей целью не бегает (Hold Position по умолчанию).
#
# ПРЯМОЙ ПРИКАЗ СИЛЬНЕЕ СТОЙКИ. Отряд в ЗАЩИТЕ не сходит с места сам, но если
# игрок кликнул по врагу — приказ обязан выполняться. Раньше _process_attack
# видел holds_ground и в тот же кадр отменял цель: выделив несколько отрядов и
# кликнув по врагу, игрок видел, что часть отрядов просто стоит. Поэтому явный
# приказ переводит бойца в стойку АТАКА — это же видно и на кнопках панели.
## lock = true — ПРИКАЗ ИГРОКА, приоритет №1 (см. target_lock в шапке полей).
## Отряд запирается на ВРАЖЕСКОМ ОТРЯДЕ указанной модели и держится за него до
## полного истребления: не делится по окрестным целям, не отвлекается на
## обстрел, идёт базовой скоростью. Ставит только SelectionManager (ПКМ по
## врагу) и возобновление того же приказа (_resume_attack); ни авто-агро, ни
## перехват заслона, ни контратака отряда замка не взводят
func command_attack(target: Node3D, forced: bool = true, charge: bool = false,
		lock: bool = false) -> void:
	# ПАНИКУЮЩИЙ НЕ ДЕРЁТСЯ ВОВСЕ (см. _panicked): ни по приказу игрока, ни по
	# авто-агро, ни в ответ на удар. Это и есть «враг может безнаказанно их
	# добивать» из заказа
	if _panicked:
		return
	# Постройка, которую этому бойцу бить нельзя (крепость ИИ — орде, любая
	# крепость — троллю): приказ не принимается, цель не берётся
	if target != null and is_instance_valid(target) and target is Building \
			and not may_attack_building(target as Building):
		return
	# Разметка прежнего боя устарела — см. ту же оговорку в command_move.
	# До ближайшего прохода отряда (120 мс) боец идёт полным путём: это дороже,
	# но верно, а «дёшево и не туда» здесь недопустимо
	_rear_line = false
	_line_valid = false
	_ring_done = false           # новый приказ атаки — новый подход по сектору
	_hunt_sheep = null           # и охоту на овцу тоже
	# ПРИЗНАК БОЕВОГО НАВАЛА. Только он опускает копья на марше (см.
	# Spearman._charging): «идём в атаку на указанного врага» — это ПКМ игрока
	# или решение ИИ, а не то, что боец сам подобрал цель по дороге. Авто-агро
	# тоже бывает forced (когда враг дальше удара), поэтому одного forced мало.
	#
	# ФЛАГ ТОЛЬКО ВЗВОДИТСЯ ЗДЕСЬ, НО НИКОГДА НЕ ГАСНЕТ. Снимают его приказ на
	# движение и отход (command_move / begin_retreat) да конец боя.
	#
	# Так сделано потому, что признак «это приказ» по одному forced не отличить:
	# авто-агро тоже зовёт command_attack с forced = true, когда замеченный враг
	# дальше дистанции удара. Пока флаг переписывался каждым вызовом, отряд,
	# бегущий на указанную цель, по дороге ловил такой вызов — флаг гас, и копья
	# поднимались ровно в момент столкновения, то есть когда они и нужны
	if charge:
		_charge_order = true
	_settled     = false         # пошёл в бой — якорь снят
	_disengaging = false         # приказ атаковать перекрывает недавний отход
	_move_lock   = 0.0           # и замок на движение тоже: игрок передумал
	if forced:
		# ПРЯМОЙ ПРИКАЗ ОТМЕНЯЕТ НЕЗАКОНЧЕННЫЙ МАРШ. Игрок передумал и указал
		# цель — после боя отряд не должен самовольно уходить туда, куда его
		# посылали до этого. Перехват по дороге (forced = false) марш сохраняет
		_march_pending = false
		# ЗАПОМНИТЬ ЭТОТ ПРИКАЗ ЦЕЛИКОМ (см. _atk_pending) — на случай, если по
		# дороге к цели встретится ДРУГОЙ вражеский отряд. Перехват по дороге
		# (forced = false, дальше по функции) в этот if не заходит и флаг не трогает
		_atk_pending        = true
		_atk_pending_target = target
		var _atk_orig_unit := target as Unit
		_atk_pending_squad  = _atk_orig_unit.squad_id if _atk_orig_unit != null else 0
		_atk_pending_charge = charge
		# Замок переживает перехват заслона: возобновлённый приказ (_resume_attack)
		# обязан быть таким же приказом игрока, каким был исходный
		_atk_pending_lock   = lock or target_lock
		# ── СТОЙКА «ЗАЩИТА» СИЛЬНЕЕ ПРИКАЗА (заказ владельца, авг. 2026) ─────
		# Здесь стояло set_stance(STANCE_ATTACK): прямой приказ молча выводил
		# отряд из обороны, и «железобетон» существовал ровно до первого клика
		# по врагу — после него фаланга бежала за целью, как обычная пехота.
		# Требование теперь прямое: «при включённом щите преследование ПОЛНОСТЬЮ
		# отключается». Отряд в обороне исполняет приказ тем, что достаёт
		# копьём, и с места не сходит; хочешь навала — переключи стойку
		# кнопкой, она для того и есть (активная подсвечена жёлтой рамкой).
	# ЗАМОК ВЗВОДИТСЯ ТОЛЬКО ЯВНЫМ lock И НИКОГДА НЕ ГАСНЕТ ЗДЕСЬ. Ровно как
	# _charge_order выше: перехват заслона зовёт command_attack(blocker, false) —
	# если бы этот вызов сбрасывал замок, приоритет №2 отменял бы приоритет №1,
	# и первый же случайный копейщик на пути отменял бы приказ игрока
	if lock:
		_arm_target_lock(target)
	# ПРИКАЗ ПО ОТРЯДУ, А НЕ ПО ПИКСЕЛЮ. Игрок ткнул в одну модель — воюем со
	# всем её отрядом: каждый боец берёт СВОЮ жертву из вражеского строя.
	# Только по прямому приказу: авто-агро и ответ на удар должны держаться за
	# того, кто реально рядом, иначе строй разбредётся за случайными целями
	if forced:
		var tu := target as Unit
		if tu != null and tu.squad_id != 0:
			target = GameManager.squad_pick_member(tu.squad_id, global_position, target)
			# СТРЕЛОК БЕРЁТ ТОГО, ДО КОГО УЖЕ ДОСТРЕЛИТ (см. _prefer_in_range)
			target = _prefer_in_range(target)
	# ── ФАЛАНГА ЗАПОМИНАЕТ ТОЧКУ, А НЕ ЦЕЛЬ (см. _phalanx_march) ─────────────
	# Только по ПРЯМОМУ приказу и только в обороне: авто-агро и ответ на удар
	# строй с места не сдвигают, это и есть «в покое — намертво».
	#
	# ── ПЕРЕНОС СТЕНЫ НА АТАКУ ПРОБОВАЛИ ЧЕТВЁРТЫЙ РАЗ И ОТКАТИЛИ ───────────
	# Заказ «сохраняй геометрию отряда при приказе атаки». Механизм для этого
	# выглядит готовым: _wall_goal смещает точку КАЖДОГО на один и тот же
	# вектор. В этот заход он был доведён до конца — отступ перед чужим строем
	# вместо самой цели, выдача точки только под замком приказа, конец хода на
	# первом контакте — и всё равно снят. ПРИЧИНА НОВАЯ И ОНА ГЛАВНАЯ:
	# выигрыш формации давало НЕ построение, а ОСТАНОВКА БОЯ. Полный разбор с
	# числами — в docs/ENGINEERING_LOG.md, раздел про перенос стены.
	# Коротко: с переносом сдвиг формы 0.90, но схватка 60 на 60 ломается на
	# 148-й секунде вместо 32-й, а замок цели перестаёт работать вовсе; убери
	# остановку — и сдвиг формы возвращается к 1.08, то есть к базовому.
	if forced and _stance_holds_ground() and target != null:
		_hold_goal = _wall_goal(target.global_position)
		_hold_goal_set = true
	# НОВАЯ ЦЕЛЬ — НОВЫЙ ПОДХОД. Запрет погони (см. pursues_target) снимается
	# только сменой противника: пока это тот же самый, отбежавший враг,
	# стрелок за ним не идёт, сколько бы раз авто-агро его ни подсунуло
	if target != attack_target:
		_engaged_once = false
		# Новый противник — новая погоня: поводок отсчитывается от первого
		# касания ИМЕННО ЭТОЙ цели (см. PURSUIT_LIMIT)
		_pursuit_anchored = false
		# ПРИКАЗ ИГРОКА НА НОВУЮ ЦЕЛЬ СНИМАЕТ И ОТРЯДНУЮ ОТМЕТКУ «ВСТАЛИ»
		# (15.09.2026): её снимал только приказ на движение, и второй ПКМ по
		# другому противнику вне дальности оставлял стрелков стоять — «тупят»
		if lock and squad_id > 0:
			GameManager.squad_pursuit_release(squad_id)
	set_attack_target(target)
	_attack_is_forced = forced
	state             = State.ATTACKING
	_wake_process()
	_reset_stuck()
	# ── МГНОВЕННЫЙ ОТКЛИК СТРЕЛКА НА ПРИКАЗ (спринт 20, модуль 3.2) ────────
	# Явный клик игрока: лучник разворачивается на цель тем же кадром (поза
	# грязная — картинка обновится сразу), окно авто-агро обнуляется, а отряд
	# в режиме залпа получает открытое окно — готовые стреляют на своём же
	# тике, не дожидаясь такта залпов. Это и есть визуальный фидбек «приказ
	# принят» вместо «зависания мозгов» у стоящих рядом стрелков
	if lock and _is_ranged() and target != null and is_instance_valid(target):
		var tv: Vector3 = target.global_position - global_position
		tv.y = 0.0
		if tv.length_squared() > 1e-4:
			_facing = tv.normalized()
			_pose_dirty = true
		_aggro_timer = 0.0
		if squad_id > 0:
			GameManager.squad_volley_prime(squad_id)
			# ── СБРОС ПО КЛИКУ (заказ: «таймер 0.5 с мгновенно обнуляется») ──
			# Центровой нод отряда берёт цель игрока СЛЕДУЮЩИМ ЖЕ тактом, а не
			# через полсекунды: ждать своего такта после явного приказа —
			# это ровно то «зависание мозгов», ради которого правка и делалась
			GameManager.squad_radar_kick(squad_id, target)

## ── ПОТОЛОК ДАЛЬНОСТИ ─────────────────────────────────────────────────────
## Зажимает СУММУ «база + всё, что дала кузница» (см. STATS.attack_range_cap).
## Публичный и статический по смыслу: применять его обязаны ВСЕ места, где
## дальность растёт, — и рождение бойца, и выдача исследования уже стоящим на
## карте (GameManager._apply_range_bonus_now). Нет потолка в конфиге — ответ
## равен входу, и ближний бой ничего не платит
func clamp_attack_range(r: float) -> float:
	if stat_id == "":
		return r
	var cap: float = _UStats.stat(stat_id, "attack_range_cap", 0.0)
	if cap <= 0.0:
		return r
	return minf(r, cap)

## ── СТРЕЛОК НЕ ИДЁТ В РУКОПАШНУЮ ПО КЛИКУ ─────────────────────────────────
## Жалоба владельца: кликаешь по вражескому отряду, который подошёл вплотную, —
## и лучники бегут во врага, как пехота.
##
## Разбор. Приказ атаки назначается ПО ОТРЯДУ, а конкретную жертву выбирает
## squad_pick_member — «наименее обстрелянный», то есть чаще всего НЕ ближайший.
## Стрелку доставалась модель с дальнего края чужого строя, до неё было больше
## дальности выстрела, и он честно шёл к ней — прямо сквозь тех, кто стоял в
## двух метрах. Со стороны это неотличимо от «побежал в рукопашную».
##
## Лечение: тому, кто НЕ ПРЕСЛЕДУЕТ (стрелок, фаланга), назначенная цель
## подменяется на любого бойца ТОГО ЖЕ отряда, до которого уже дострелить. Не
## на ближайшего вообще — именно из назначенного отряда: приказ игрока остаётся
## приказом по этому отряду, меняется только, с кого начать.
##
## Пехоты это не касается вовсе: pursues_target() у неё true, и первая же
## строка возвращает вход без единого лишнего действия
func _prefer_in_range(target: Node3D) -> Node3D:
	if target == null or pursues_target():
		return target
	var tu := target as Unit
	if tu == null or tu.squad_id == 0:
		return target
	var mp: Vector3 = global_position
	var rng: float = attack_range
	if Vector2(tu.global_position.x - mp.x, tu.global_position.z - mp.z).length() <= rng:
		return target        # и так достаём — менять нечего
	var best: Unit = null
	var best_d := INF
	for m in GameManager.squad_members(tu.squad_id):
		var mu := m as Unit
		if mu == null or not is_instance_valid(mu) or mu.is_dead():
			continue
		var d: float = Vector2(mu.global_position.x - mp.x,
			mu.global_position.z - mp.z).length()
		if d <= rng and d < best_d:
			best_d = d
			best = mu
	return best if best != null else target

## ── КУДА ИДЁТ БОЕЦ СТЕНЫ, КОГДА СТЕНЕ ПРИКАЗАЛИ ИДТИ ──────────────────────
## ЗДЕСЬ БЫЛА ТОЧКА ВРАГА, И ЭТО И ЕСТЬ «КРАЙНИЕ КОПЕЙЩИКИ ВЫБЕГАЮТ».
##
## Приказ атаки раздаётся каждому бойцу отдельно, и каждый получал ОДНУ И ТУ ЖЕ
## цель — координату вражеской модели. Дальше вся шеренга честно шла в одну
## точку, то есть СХЛОПЫВАЛАСЬ в неё. На экране это читается именно так, как
## описал владелец: фланги срываются со своих мест и уходят вперёд-внутрь, а
## строй перестаёт быть строем.
##
## Теперь стена ПЕРЕНОСИТСЯ ЦЕЛИКОМ: каждому достаётся своя точка, смещённая
## ровно на тот же вектор, на который сдвигается центр отряда. Взаимное
## расположение бойцов не меняется вовсе — забор идёт забором.
##
## Отряда нет (одиночка) — идти можно только в саму точку: переносить нечего
func _wall_goal(target_pos: Vector3) -> Vector3:
	if squad_id <= 0:
		return target_pos
	var c: Vector3 = GameManager.squad_centroid(squad_id)
	if c == Vector3.ZERO:
		return target_pos
	var shift := Vector3(target_pos.x - c.x, 0.0, target_pos.z - c.z)
	return Vector3(global_position.x + shift.x, 0.0, global_position.z + shift.z)



## На сколько метров сверх дальности боец готов подтянуться к цели
const PULL_UP_MAX := 14.0
## Доля скорости на подтягивании: ряды подходят шагом, строй не рассыпается
const PULL_UP_SPEED := 0.55
## ═════════════════════════════════════════════════════════════════════════════
## ПОЧЕМУ PULL_UP_SPEED НЕЛЬЗЯ ПРОСТО ПОДНЯТЬ ДО 1.0 — ЗАМЕР, НЕ ДОГАДКА.
##
## «Ползание лучников» лечится ЗАМКОМ ЦЕЛИ (target_lock), а не этой константой:
## приказ игрока обходит подтягивание целиком и идёт базовой скоростью (см.
## ветку выше в _process_attack). Само подтягивание остаётся медленным, и это
## НЕ недосмотр.
##
## Пробовали разрешить полную скорость на дальнем участке подхода (замедление
## только в полосе 3 м у дистанции удара). Скомпилировалось, выглядело логично и
## сломало отход: qa_disengage B3 «отряд реально ушёл» упал с 6/6 до 0/6, C1 —
## с 4/4 до 0/4. Причина в том, что подтягивание работает и у ПРЕСЛЕДОВАТЕЛЯ.
## Погоня идёт через ту же ветку (авто-агро зовёт command_attack(forced) на
## врага дальше дистанции удара), и на 55% скорости преследователь заведомо
## медленнее убегающего. Разреши ему полную — скорости уравниваются, погоня
## висит на хвосте вплотную всю дорогу и вырубает отходящий отряд ещё до того,
## как тот отойдёт на 25 м. То есть 0.55 здесь — не «медленный подход», а
## правило «своим ходом за целью не догоняют».
##
## Единственное штатное замедление, которое видит игрок при СВОЁМ приказе, —
## щит мечника под обстрелом (Warrior.GUARD_SPEED_FACTOR).
## ═════════════════════════════════════════════════════════════════════════════

## Надо ли делать шаг вперёд, чтобы дотянуться до цели.
## Условия намеренно узкие: только по ПРИКАЗУ отряду (есть цель и есть отряд),
## только если враг рядом — в пределах PULL_UP_MAX сверх дальности оружия.
## Бойцу без отряда и бойцу, которому никто не приказывал, подтягиваться незачем
func _should_pull_up(dist: float) -> bool:
	if squad_id == 0 or attack_target == null:
		return false
	return dist <= reach() + PULL_UP_MAX

## ═════════════════════════════════════════════════════════════════════════════
## ДАЛЬНОСТЬ ДО ЦЕЛИ МЕРЯЕТСЯ ДО ЕЁ ХИТБОКСА, А НЕ ДО ТОЧКИ
## ═════════════════════════════════════════════════════════════════════════════
## У бойца точка и хитбокс — почти одно и то же (полметра), и разницей всегда
## пренебрегали. У ЗДАНИЯ это не так: global_position постройки лежит в ЦЕНТРЕ
## её коробки, а коробка бывает восемь метров в поперечнике. Пока дистанция
## считалась до центра, «дойти на дистанцию удара» означало для копейщика
## ВОЙТИ ВНУТРЬ ЗДАНИЯ (масок столкновений в проекте нет, и он туда честно
## заходил), а для лучника — встать вплотную к стене вместо того, чтобы
## расстреливать её с двадцати метров.
##
## Поправка держится ПОЛЕМ, а не считается по месту. Дистанцию до цели читают
## четыре горячие ветки в каждом физическом кадре, и проверять там тип цели
## (`target is Building`) значило бы платить приведением типа за бойца, у
## которого поправка всегда ноль. Считается она один раз при смене цели — а
## смена цели событие редкое (см. set_attack_target).
var _target_pad: float = 0.0

## Дальность оружия с поправкой на габарит цели (см. _target_pad)
func reach() -> float:
	return attack_range + _target_pad

## Насколько «толстая» цель: половина наибольшего габарита её коробки в плане.
## У бойца ноль — его собственный радиус уже заложен в дальность оружия
## ── СТЕНА — ЭТО КРАЙ РИСУНКА, А НЕ КОРОБКИ ИЗ КОНФИГА ──────────────────────
## Жалоба владельца по скриншоту: «копейщики останавливаются далеко от стен и
## тыкают копьями в пустой воздух».
##
## Поправка бралась из `build_size`, а коробка почти всегда КРУПНЕЕ рисунка: у
## хижины гоблинов коробка 4×3.5×4 (полугабарит 2.00 м), а нарисована она на
## 3.28 м в ширину, то есть её стена стоит на 1.64 м. Боец честно
## останавливался в 3.50 м от центра — в 1.86 м от НАРИСОВАННОЙ стены при копье
## в 2.00 м (замер зондом qa_cmd). До цели он при этом дотягивался, но на экране
## между остриём и стеной оставался просвет.
##
## Берём ТУ ЖЕ величину, по которой игра рисует кольцо под зданием и выносит
## ворота (`Building.ring_radius`): что игрок видит — до того и достаёт. У
## постройки без спрайта ring_radius сам отвечает по коробке, поэтому запасного
## пути здесь заводить не нужно
static func _pad_of(target: Node3D) -> float:
	var b := target as Building
	if b == null:
		return 0.0
	return b.ring_radius()

## Цель уже в зоне поражения? По этому же признаку подклассы решают, можно ли
## включать анимацию удара: махать оружием на бегу запрещено
func target_in_range() -> bool:
	if attack_target == null or not is_instance_valid(attack_target):
		return false
	# ── ТОЧКИ ПО ДЕШЁВОМУ ПУТИ (см. _local_xform) ───────────────────────────
	# Это ГОРЯЧАЯ функция: её зовёт выбор позы копейщика на каждом обновлении
	# ракурса, то есть сотни раз в кадр. Стояли два чтения global_position — а
	# это не поле, а свойство: после записи трансформа оно пересобирает мировую
	# матрицу по цепочке родителей. Пересобирать есть что — пакетный шаг только
	# что записал координаты обоим
	# ── ТОЧКИ ПО ДЕШЁВОМУ ПУТИ, ВСТРОЕННО (см. _local_xform) ────────────────
	# Это ГОРЯЧАЯ функция: её зовёт выбор позы копейщика на каждом обновлении
	# ракурса, то есть сотни раз в кадр. Стояли два чтения global_position — а
	# это не поле, а свойство: после записи трансформа оно пересобирает мировую
	# матрицу по цепочке родителей, и пересобирать есть что — пакетный шаг
	# только что записал координаты обоим.
	# ВСТРОЕНО, А НЕ ВЫНЕСЕНО В ХЕЛПЕР: вызов функции здесь стоил бы столько же,
	# сколько экономит (проверено — вынесенный вариант дал нулевую разницу)
	var tu := attack_target as Unit
	var tp: Vector3 = tu.position if (tu != null and tu._local_xform) 		else attack_target.global_position
	var mp: Vector3 = position if _local_xform else global_position
	var d := tp - mp
	d.y = 0.0
	return d.length() <= reach()


# Все присвоения attack_target — только через этот сеттер: подписка на died
# позволяет не вызывать target.is_dead() каждый физ. кадр в _process_attack().
# Здесь же ведётся счётчик атакующих на цели — по нему бой распределяется
# «стенка на стенку», а не 10 бойцов на одного беднягу (см. _find_nearest_enemy_in_range)
func set_attack_target(target: Node3D) -> void:
	if attack_target == target:
		return
	if attack_target != null and is_instance_valid(attack_target):
		if attack_target.died.is_connected(_on_attack_target_died):
			attack_target.died.disconnect(_on_attack_target_died)
		var prev := attack_target as Unit
		if prev != null:
			prev.attackers = maxi(0, prev.attackers - 1)
			# Зеркало в колонку: выбор цели (best_enemy) считает штраф за
			# занятость ВНУТРИ солвера, и чтение поля объекта оттуда стоило бы
			# обращения через Variant на каждого кандидата скана
			GameManager.army.set_attackers(prev._soa, prev.attackers)
	attack_target = target
	# Смена цели — смена направления и рода позы (атака/оборона): событие
	_pose_dirty = true
	# Дрёма перезарядки живёт ровно один контакт с одной целью: новая цель —
	# новый полный тик (см. _atk_snooze в _process_attack). Таймер на время
	# дрёмы вело ядро — забираем остаток себе, иначе удар по новой цели
	# пришёл бы раньше срока (поле заморожено на арм-значении)
	if _atk_snooze:
		_atk_snooze = false
		if _soa >= 0:
			_attack_timer = GameManager.army.atk_snooze_clear(_soa)
	# Напор тоже живёт ровно один контакт: новая цель — полный автомат
	if _rear_press:
		_rear_press = false
		if _soa >= 0:
			GameManager.army.rear_press_clear(_soa)
	if _auto_pilot:
		_auto_pilot = false
		if _soa >= 0:
			GameManager.army.autopilot_clear(_soa)
	# Габарит цели — сюда же, по тому же поводу: смена цели редка, а читают
	# поправку каждый кадр (см. _target_pad)
	_target_pad = _pad_of(target)
	# Строка цели — в колонку: по ней пакетный бой считает дистанцию, не
	# заглядывая в объект. Пишется ПО СОБЫТИЮ, смена цели редка
	if _soa >= 0:
		var trow := -1
		var tu2 := target as Unit
		if tu2 != null:
			trow = tu2._soa
		GameManager.army.set_target(_soa, trow)
	if target != null:
		target.died.connect(_on_attack_target_died)
		# ВЗЯЛ ЦЕЛЬ — ОТРЯД С ЭТОГО МГНОВЕНИЯ В БОЮ. Ответ запоминается на
		# физический кадр (GameManager.squad_in_combat), и без сброса тот, кто
		# спросит следом в этом же кадре, получил бы «не в бою». Событие
		# редкое — смена цели, а не кадр
		if squad_id > 0:
			GameManager.squad_combat_invalidate(squad_id)
		var nu := target as Unit
		if nu != null:
			nu.attackers += 1
			GameManager.army.set_attackers(nu._soa, nu.attackers)

func _on_attack_target_died(who: Node) -> void:
	var u := who as Unit
	if u != null:
		u.attackers = maxi(0, u.attackers - 1)
		GameManager.army.set_attackers(u._soa, u.attackers)
	attack_target = null
	# ── СТРОКУ ЦЕЛИ В КОЛОНКЕ ТОЖЕ ОБЯЗАНЫ ОБНУЛИТЬ ────────────────────────
	# Здесь стояло голое `attack_target = null`, минуя set_attack_target, — и
	# колонка `_tgt` в ядре армии продолжала указывать на СТРОКУ ПАВШЕГО. Строки
	# переиспользуются (ArmyCore держит список свободных и выдаёт их новым
	# бойцам), поэтому через несколько секунд по этому номеру стоит уже ЧУЖОЙ,
	# ни в чём не повинный боец — и пакетный проход боя считает дистанцию до
	# него. Сейчас беда спит, потому что batch_combat выключен по замеру
	# (perf_config), но включение флага молча вернуло бы её: обнуляем в тот же
	# кадр, ценой одного вызова на СОБЫТИЕ гибели цели.
	# Поправку на габарит сбрасываем там же — иначе следующая цель-боец
	# унаследовала бы «стену» погибшего здания (см. _target_pad)
	_target_pad = 0.0
	if _soa >= 0:
		GameManager.army.set_target(_soa, -1)
	# ── ВОЗВРАТ ИЗ ТЫЛА ПО СОБЫТИЮ, А НЕ ПО СРОКУ ────────────────────────────
	# Аренда признака и так истечёт на ближайшей разметке отряда, но здесь
	# ждать нельзя: без цели тыловому бойцу нечего подпирать, а полный автомат
	# он не проходит — значит, не переберёт цель и не подхватит отложенный
	# приказ. Это и есть та самая дыра, из-за которой отряд «не уходил»
	# (qa_disengage). Снимаем в тот же кадр, ценой одного присваивания
	_rear_line = false

## ── ОТСЕЧЕНИЕ ДАЛЬНИХ ПО КАДРУ ──────────────────────────────────────────────
## Всё, что делает _process, — это КАРТИНКА: покачивание при ходьбе, выбор
## анимации, зеркало спрайта. Бойцу за пределами видимой области ничего из
## этого не нужно, а стоит оно на 1200 моделях дороже всей боевой логики:
## каждое покачивание — это запись position.y, то есть пересчёт трансформа
## узла и его пометка «грязным» для рендера.
##
## Логика боя, движение и строй живут в _physics_process и отсечению НЕ
## подлежат: дальний отряд продолжает идти и драться полноценно.
## Ответ прошлого кадра — им пользуются подклассы (см. Spearman._process),
## чтобы не спрашивать то же самое вторым вызовом
var _seen: bool = true

func _lod_visible() -> bool:
	return not _Opt.sprite_lod or GameManager.near_view(global_position)

## ── РАСКЛАДКА РАБОТЫ ПО КАДРАМ ──────────────────────────────────────────────
## Выбор анимации и зеркало спрайта пересчитывались КАЖДЫЙ кадр у КАЖДОГО
## бойца. Обе величины меняются в разы медленнее кадра: анимация переключается
## на смене состояния, зеркало — при развороте бойца (да ещё и через жёсткий
## гистерезис в ±15°, см. FLIP_DEADZONE). Считать их 60 раз в секунду на 1200
## моделях — чистая переплата.
##
## Теперь каждый боец пересчитывает их раз в ANIM_EVERY кадров, а фаза сдвига
## взята из _sep_phase (младшие биты instance_id) — нагрузка размазывается
## ровным слоем, а не собирается в один «тяжёлый» кадр из четырёх.
## Разовые срочные пересчёты (доворот в строй) идут через _flip_dirty и
## отрабатывают в тот же кадр.
const ANIM_EVERY := 3

## СРОЧНЫЙ ПЕРЕСЧЁТ ПОЗЫ, вне очереди по кадрам. Ставится там, где поза должна
## смениться НЕМЕДЛЕННО и задержка была бы заметна: поднятый щит, начало удара,
## пробуждение из сна. Ждать своей очереди в такие моменты нельзя — «щит встал
## через три кадра после выстрела» игрок читает как «щит не работает»
var _pose_dirty: bool = false

func mark_pose_dirty() -> void:
	_pose_dirty = true

## ── РАЗБОР SpriteFrames В ЧИСЛА, ОДИН РАЗ НА РЕСУРС ─────────────────────────
## SpriteFrames общий у всех бойцов одного вида (SpriteSheetParser его кэширует),
## поэтому разбирать его по AtlasTexture-регионам каждому бойцу — чистая
## переплата. Таблица: имя анимации → [лента, кадров, темп, зациклена].
## Ключ — instance_id ресурса: сам ресурс в ключ класть нельзя, словарь
## удерживал бы его от освобождения.
static var _sheet_tables: Dictionary = {}

static func _sheet_table(sf: SpriteFrames) -> Dictionary:
	var key: int = sf.get_instance_id()
	var cached = _sheet_tables.get(key)
	if cached != null:
		return cached
	var table := {}
	for a in sf.get_animation_names():
		var n: int = sf.get_frame_count(a)
		if n <= 0:
			continue
		var first: Texture2D = sf.get_frame_texture(a, 0)
		var at := first as AtlasTexture
		var tex: Texture2D = first
		var total: int = n
		if at != null and at.atlas != null:
			tex = at.atlas
			var fw: float = maxf(at.region.size.x, 1.0)
			total = maxi(1, int(round(at.atlas.get_size().x / fw)))
		table[StringName(a)] = [tex, total, sf.get_animation_speed(a),
			sf.get_animation_loop(a), _anim_bottom_px(first)]
	_sheet_tables[key] = table
	return table

## ── ПРИВЯЗКА ЛЕНТЫ К ЗЕМЛЕ ──────────────────────────────────────────────────
## Сколько ПРОЗРАЧНЫХ строк пикселей внизу первого кадра. Разные ленты одного
## набора нарисованы с разным запасом снизу (щит мечника, замах, переноска
## бревна у рабочего), и спрайт, посаженный на одну и ту же высоту центра,
## встаёт то выше, то ниже земли. Жёлтое кольцо выделения при этом лежит ровно
## на земле — отсюда и жалоба «кружочки сползают при смене стоек».
##
## Ровно тот же приём, что копейщик давно применяет к своим направленным листам
## (Spearman._bottom_margin); здесь он поднят в базу, чтобы работал у всех.
## Считается ОДИН РАЗ на ресурс SpriteFrames (таблица кэшируется статически).
## `min_alpha` — что считать краской: по умолчанию любой след (0.02), тогда
## впечатанная в арт полупрозрачная тень входит в рисунок и ЕЁ нижняя кромка
## ложится на точку земли. У пехоты тень в пару пикселей, и разница не видна;
## у тролля (×4) тень под ступнями — 15 строк, то есть 0.8 м по земле: кольцо
## под ним лежало на шаг впереди ног (спринт 16, TROLL_FOOT_ALPHA)
static func _anim_bottom_px(first: Texture2D, min_alpha: float = 0.02) -> int:
	if first == null:
		return 0
	var img: Image = null
	var x0 := 0
	var y0 := 0
	var w := 0
	var h := 0
	var at := first as AtlasTexture
	if at != null and at.atlas != null:
		img = at.atlas.get_image()
		x0 = int(at.region.position.x)
		y0 = int(at.region.position.y)
		w  = int(at.region.size.x)
		h  = int(at.region.size.y)
	else:
		img = first.get_image()
		if img != null:
			w = img.get_width()
			h = img.get_height()
	if img == null or w <= 0 or h <= 0:
		return 0
	if img.is_compressed():
		img.decompress()
	var iw: int = img.get_width()
	var ih: int = img.get_height()
	var margin := 0
	var y: int = mini(y0 + h, ih) - 1
	while y >= y0:
		var opaque := false
		var x: int = x0
		var xend: int = mini(x0 + w, iw)
		while x < xend:
			if img.get_pixel(x, y).a > min_alpha:
				opaque = true
				break
			x += 2
		if opaque:
			break
		margin += 1
		y -= 1
	return margin

## Снять вид с узла ОДИН раз и дальше вести его числами.
## Вызывается лениво из _process: подкласс ставит _active_sprite внутри своего
## _ready(), и порядок относительно super._ready() у подклассов разный
func _look_bind() -> void:
	_look_ok = true            # даже промах фиксируем: не пробовать каждый кадр
	var spr = _active_sprite
	if spr == null or not is_instance_valid(spr):
		return
	var asp := spr as AnimatedSprite3D
	if asp != null:
		if asp.sprite_frames == null:
			return
		_look_px = asp.pixel_size
		_look_base_y = asp.position.y
		_sprite_base_y = _look_base_y
		# Разобранный набор кладём В ПОЛЕ: дальше смена анимации не обращается
		# к узлу вообще, даже за списком доступных лент
		_look_table = _sheet_table(asp.sprite_frames)
		# ЭТАЛОН ПРИВЯЗКИ — лента, на которую посажен узел в _ready() подкласса
		# (как правило "idle"). Все прочие позы выравниваются по ней
		var ref_row: Variant = _look_table.get(asp.animation)
		_look_base_bottom = int((ref_row as Array)[4]) if ref_row != null else 0
		_set_anim(asp.animation)
		return
	var s3 := spr as Sprite3D
	if s3 != null:
		# Направленные листы (Spearman) заполняют поля сами в _apply_dir_tex
		_look_px = s3.pixel_size
		if _look_tex == null:
			_look_tex = s3.texture
			_look_frames = maxi(s3.hframes, 1)

## Вывести узел спрайта из анимации: в общей отрисовке он невидим, а
## AnimatedSprite3D всё равно крутил бы свою ленту внутренним процессом движка
func _look_detach_node() -> void:
	if _look_detached:
		return
	_look_detached = true
	var asp := _active_sprite as AnimatedSprite3D
	if asp != null:
		asp.pause()

## Переключение анимации ПО ИМЕНИ — единственная точка входа для подклассов.
## Возвращает false, если такой анимации в наборе нет (вызов не состоялся)
func _set_anim(want: StringName) -> bool:
	if want == _anim_name and _look_tex != null:
		return true
	if not _look_table.has(want):
		return false
	var row: Array = _look_table[want]
	_anim_name   = want
	_look_tex    = row[0]
	_look_frames = row[1]
	_look_fps    = row[2]
	_look_loop   = row[3]
	_look_frame  = 0
	# ── ФАЗА АНИМАЦИИ У КАЖДОГО СВОЯ ───────────────────────────────────────
	# Сотня бойцов, вставших в строй одним заказом, начинала ленту с нулевого
	# кадра в один и тот же миг и дальше дышала СИНХРОННО — отряд читается как
	# один многократно скопированный спрайт, а не как толпа. Сдвиг берётся от
	# номера узла (одинаков в двух прогонах стенда) и применяется ТОЛЬКО к
	# зацикленным лентам: удар обязан начинаться с замаха, то есть с кадра ноль
	_anim_phase = (_anim_offset * float(_look_frames)) if _look_loop else 0.0
	# ── НОГИ ОСТАЮТСЯ НА ЗЕМЛЕ ПРИ ЛЮБОЙ ПОЗЕ (см. _anim_bottom_px) ─────────
	# Низ рисунка новой ленты приводится туда же, где он у эталонной. Зажим
	# нужен на случай ленты с диким запасом снизу: лучше не выровнять, чем
	# отправить бойца под землю
	var shift: float = float(_look_base_bottom - int(row[4])) * _look_px
	# ── ЗАЖИМ МАСШТАБИРУЕТСЯ С ПИКСЕЛЕМ ЛЕНТЫ (спринт 16) ─────────────────
	# BASE_Y_FIX_MAX — метры, подобранные под пехотный пиксель 0.0108: это
	# ~42 px запаса снизу. У тролля пиксель 0.0261, и тот же метровый зажим —
	# всего 17 px: ленте ходьбы с бóльшим полем под ступнями выравнивания не
	# хватало, и на марше тролль всплывал над своим кольцом почти на метр
	# (qa_troll_ring/Shot, снимок владельца «смещённый тонкий овал»). Зажим
	# в ПИКСЕЛЯХ одинаков для всех, в метрах — растёт вместе с пикселем
	var cap: float = BASE_Y_FIX_MAX * maxf(_look_px / BASE_Y_FIX_PX, 1.0)
	_sprite_base_y = _look_base_y + clampf(shift, -cap, cap)
	if not _mm_only and _active_sprite != null:
		(_active_sprite as Node3D).position.y = _sprite_base_y
	# Узел ведём синхронно ТОЛЬКО пока он на экране (запасной режим отрисовки)
	if not _mm_only:
		var asp := _active_sprite as AnimatedSprite3D
		if asp != null:
			asp.play(want)
	_push_row_anim()
	return true

## Лента — в строку ядра (этап E1). БЕЗУСЛОВНО, а не по ручке anim_core:
## ручку переключают на живой сцене (qa_visab), и колонки обязаны быть
## свежими в любой момент — кто листает кадр, решает BatchVisual
func _push_row_anim() -> void:
	if _rb_bound and _soa >= 0:
		GameManager.army.row_anim(_soa, _look_frames, _look_fps, _look_loop, _anim_phase)

## Проверка «есть ли такая анимация» без её включения
func _has_anim(want: StringName) -> bool:
	return _look_table.has(want)

## ЛИСТАНИЕ КАДРОВ ЧИСЛОМ. Раньше этим занимался сам AnimatedSprite3D (движок,
## на каждый узел) либо ручная запись Sprite3D.frame; теперь это два умножения
## и остаток от деления, а результат уезжает в MultiMesh ближайшим refresh()
## Возвращает true, если номер кадра РЕАЛЬНО сменился. Ответ нужен вызывающему
## (tick_visual): в общей отрисовке новый кадр обязан тут же уехать в буфер,
## иначе он пролежит в поле до следующего пересчёта внешности — а тот идёт раз
## в anim_every визуальных тактов, то есть на большой армии раз в двадцать
## кадров отрисовки. Ровно это и выглядит как «ноги замерли, а боец едет»
func _advance_look_frame(delta: float) -> bool:
	_anim_phase += delta * _look_fps
	var f: int
	if _look_loop:
		f = int(_anim_phase) % _look_frames
	else:
		f = mini(int(_anim_phase), _look_frames - 1)
	if f == _look_frame:
		return false
	_look_frame = f
	# В запасном режиме кадр ещё нужен и узлу — но только при РЕАЛЬНОЙ смене
	if not _mm_only:
		var s3 := _active_sprite as Sprite3D
		if s3 != null and s3.frame != f:
			s3.frame = f
	return true

## ── ЧТО ИМЕННО СЕЙЧАС НАРИСОВАНО НА БОЙЦЕ ───────────────────────────────────
## Возвращает [лист кадров, номер кадра, всего кадров в ленте, размер пикселя,
## высота центра спрайта над ногами] — или пустой массив, если рисовать нечего.
##
## Нужно общей отрисовке (FarUnitRenderer). ЧИТАЕТ ТОЛЬКО ПОЛЯ: узлы спрайтов
## здесь больше не участвуют — ни приведений типов, ни разбора AtlasTexture,
## ни обращений в движок. На 5000 бойцов это была самая частая дорога наружу
func sheet_frame() -> Array:
	# Снимок с узла делается один раз и обычно ещё в _process, но общая отрисовка
	# может спросить раньше первого кадра юнита (так делают стенды и постановка
	# в MultiMesh сразу при спавне) — тогда снимаем прямо здесь
	if not _look_ok:
		_look_bind()
	if _look_tex == null:
		return []
	return [_look_tex, _look_frame, _look_frames, _look_px, _sprite_base_y]

## ── ДАЛЬНЯЯ ОТРИСОВКА ЧЕРЕЗ ОБЩИЙ MultiMesh (см. FarUnitRenderer.gd) ────────
## Пока juнит виден (seen), он рисуется своим обычным узлом (_active_sprite),
## как и раньше. Как только он уходит за near_view(), свой узел прячется, а
## юнит ставится слотом в общий MultiMesh — так 1000+ дальних бойцов не тянут
## за собой 1000+ узлов дерева сцены. Обратный переход возвращает свой узел.
var _far_registered: bool = false

## ── СОБЫТИЙНАЯ ПОЗА (этап E3): что было при последнем разборе ────────────
## Сравнивается в каждом визуальном такте ДЕШЕВО (три int и одно скалярное
## произведение), а полный разбор идёт только на смену. Взгляд сравнивается
## с порогом POSE_TURN_COS2 — квадрат косинуса 20°, без sqrt
const POSE_TURN_COS2 := 0.883
var _pose_look: Vector3 = Vector3.ZERO
var _pose_state: int = -1
var _pose_rank: int = -1
var _pose_cam: int = -1
## Замок удара взведён и ещё не истёк: по истечении поза обязана вернуться
## к покою/ходьбе тем же тактом, а не по расписанию
var _lock_pending: bool = false

## Боец рисуется ТОЛЬКО общим MultiMesh: его собственный узел спрайта невидим,
## и трогать трансформ этого узла незачем — запись position.y помечает узел
## грязным и гонит новый трансформ в RenderingServer совершенно впустую
## (см. _update_walk_anim)
var _mm_only: bool = false

## ПРЯМАЯ ССЫЛКА НА СВОЙ СЛОТ в общей отрисовке (FarUnitRenderer.Slot).
## Без неё каждое обновление позиции начиналось с поиска бойца по словарю
## реестра — на 810 моделях это 810 поисков в кадр ради трёх чисел.
## Ссылка обновляется при регистрации и при каждом полном обновлении: смена
## ленты переселяет бойца в другой бакет, и прежний слот становится чужим
var _far_slot = null
## Строка бойца привязана к слоту в ЯДРЕ (ArmyCore.RowBind): покадровый догон
## картинки и запись позиции ведёт BatchVisual, а не этот тик. Ставит и снимает
## FarUnitRenderer при регистрации/переезде/снятии
var _rb_bound: bool = false

# ── ВИЗУАЛИЗАЦИЯ УРОНА: ВСПЫШКА И ОКРОВАВЛЕННОСТЬ ───────────────────────────
# Оба состояния уезжают в СВОБОДНЫЕ каналы instance-цвета (b и a), где их
# читает shaders/mm_unit_sprite.gdshader. Ни нового узла, ни нового вызова
# отрисовки, ни нового листа спрайтов: раненого бойца никто не рисовал, и
# «подбитость» делается подкраской той же текстуры.
#
# ПОЧЕМУ ВСПЫШКА — ТАЙМЕР, А НЕ СОБЫТИЕ. Урон приходит в физическом кадре,
# рисуется боец в кадре отрисовки, и такты эти не совпадают вовсе (а при
# шардировании визуального прохода боец получает тик раз в несколько кадров).
# Событие «мигни один кадр» на такой развязке терялось бы у большинства армии
const HIT_FLASH_SEC := 0.07
## Пик подмеса белого. Не единица намеренно: полностью белый силуэт стирает
## рисунок, и в свалке это читается как дыра в строю, а не как попадание
const HIT_FLASH_PEAK := 0.85

var _hit_flash: float = 0.0
## Здоровье, УЖЕ отданное в отрисовку. Сравнение с ним — одно сравнение float
## на бойца в визуальном тике, и оно ловит и урон, и лечение, и ветеранскую
## прибавку к запасу, не требуя дёргать отрисовку из каждого такого места
var _dmg_hp_seen: float = -1.0
var _dmg_dirty: bool = true

## Пик вспышки ЭТОГО бойца. База — общий HIT_FLASH_PEAK; тролль отвечает
## меньше (goblin_config.TROLL_FLASH_PEAK): по нему бьют десятками стрел в
## секунду, и общий пик держал его засвеченным без перерыва
func hit_flash_peak() -> float:
	return HIT_FLASH_PEAK

## Плотность пятен крови поверх подкраски (uniform blood_spots у бакета).
## Ноль — пятен нет, подкраска по доле жизни как у всех. Ставится бакету при
## регистрации: бакет заведён ПО ЛЕНТЕ, а у тролля лента своя
func blood_spots() -> float:
	return 0.0

## Цвет вспышки удара (uniform flash_color у бакета). База — белый, как было
## всегда; тролль — красный (goblin_config.TROLL_FLASH_COLOR). Свойство ленты
func hit_flash_color() -> Color:
	return Color.WHITE

## Сила вспышки для шейдера, 0..1
func hit_flash_level() -> float:
	if _hit_flash <= 0.0:
		return 0.0
	return hit_flash_peak() * minf(_hit_flash / HIT_FLASH_SEC, 1.0)

## Доля жизни для шейдера, 0..1. Единица — «цел», и на ней шейдер вообще не
## заходит в ветку подкраски
func health_shade() -> float:
	if max_health <= 0.0:
		return 1.0
	return clampf(current_health / max_health, 0.0, 1.0)

## Отдать состояние урона в общую отрисовку. Отдельный быстрый путь: два float
## в теневой буфер бакета, без разбора спрайта (см. FarUnitRenderer.Slot)
func _push_damage_shade() -> void:
	_dmg_dirty = false
	_dmg_hp_seen = current_health
	if _far_registered and _far_slot != null:
		_far_slot.set_damage(hit_flash_level(), health_shade())

## `gp` — мировая точка, уже прочитанная вызывающим (см. tick_visual): свойство
## global_position тут читалось ещё три раза подряд
## Убрать бойца с экрана, пока он стоит в тумане. Снимается и слот в общей
## отрисовке, и видимость узла-спрайта (на случай запасного режима
## mm_render_all = false). Идемпотентно: вызывается каждый визуальный тик,
## пока боец в тумане, и после первого раза не делает ничего
func _hide_in_fog() -> void:
	if _far_registered:
		GameManager.unregister_far(self)
		_far_registered = false
		_far_slot = null
	if _active_sprite != null and is_instance_valid(_active_sprite):
		_active_sprite.visible = false
	# ── ВСЁ, ЧТО ВИСИТ НАД ГОЛОВОЙ, ГАСНЕТ ВМЕСТЕ С БОЙЦОМ ──────────────────
	# Полоска здоровья живёт НЕ под узлом бойца, а слотом в общем слое
	# (HpBarRenderer) — ровно как его картинка. Скрытие спрайта её не трогало, и
	# раненый чужой боец под пеленой оставлял в черноте висящую красную
	# чёрточку. Та же утечка, что со знамёнами ветеранства
	# (GameManager._update_squad_banners): любая метка над отрядом обязана
	# подчиняться той же проверке видимости, что и он сам.
	# Обратно полоску вернёт tick_visual, когда боец снова окажется на свету
	GameManager.hp_bars.unregister(self)
	_hp_fog_hidden = true
	# Признак «меня видно» обязан быть снят: по нему подклассы решают, считать
	# ли позу, и оставленный true заставлял бы их работать на невидимого
	_seen = false

func _sync_far_render(seen: bool, look_changed: bool, gp := Vector3.INF,
		mm_all: bool = true) -> void:
	if gp.x == INF:
		gp = global_position
	# ── ВСЯ АРМИЯ В ОБЩЕЙ ОТРИСОВКЕ (см. perf_config.mm_render_all) ──────────
	# Ближнего бойца тоже рисует MultiMesh, поэтому регистрация не снимается
	# при возврате в кадр. Разница только в ЧАСТОТЕ обновления: того, кого
	# видно, надо двигать каждый кадр (иначе шаг рвётся), дальнего — раз в
	# ANIM_EVERY кадров, как и раньше
	if mm_all:
		if not _far_registered:
			if _active_sprite != null and is_instance_valid(_active_sprite):
				_active_sprite.visible = false
			_mm_only = true
			_look_detach_node()
			_far_slot = GameManager.register_far(self, _flip_h_state)
			# ── ПРИЗНАК СЛЕДУЕТ ЗА РЕЗУЛЬТАТОМ, А НЕ ЗА НАМЕРЕНИЕМ ───────────
			# Здесь стояло безусловное `true`. Но register() имеет право вернуть
			# null (спрайт ещё не собран — sheet_frame() пуст), и тогда боец
			# числился зарегистрированным, НЕ ИМЕЯ слота: ни одна ветка ниже его
			# больше не рисовала и заново не регистрировала. На экране боец
			# просто пропадал — а в свалке, где внешность меняется постоянно,
			# это и читается как мерцание армии
			_far_registered = _far_slot != null
			return
		# ── ДВА РАЗНЫХ ПУТИ, А НЕ ОДИН ──────────────────────────────────────
		# ПОЛНЫЙ (refresh) разбирает спрайт: лента, номер кадра, зеркало. Он и
		# стоит дорого — sheet_frame() с приведениями типов и разбором
		# AtlasTexture. Но всё, что он читает, меняется в РАЗЫ медленнее кадра:
		# анимация идёт на 6-10 fps, ракурс — на поворотах. Поэтому полный путь
		# идёт на том же такте, что и выбор анимации (раз в ANIM_EVERY кадров
		# со сдвигом фазы), плюс по срочному признаку.
		# БЫСТРЫЙ (update_pos) в остальные кадры кладёт в буфер три float
		# позиции — и ничего больше. Неподвижного он отсекает сам
		var p := Vector3(gp.x, gp.y + _bob, gp.z)
		if look_changed or _far_slot == null:
			# Слот передаётся ЯВНО: у нас он и так под рукой, а искать его по
			# словарю с объектом-ключом на каждом обновлении незачем
			_far_slot = GameManager.far_units.refresh(self, p, _flip_h_state, _far_slot)
			# ── ПОТЕРЯННЫЙ СЛОТ ВОССТАНАВЛИВАЕТСЯ, А НЕ ЗАБЫВАЕТСЯ ──────────
			# refresh() при смене ленты СНИМАЕТ слот и берёт новый; если взять
			# новый не удалось (мир не найден, спрайт ещё не собран), она честно
			# возвращает null. Признак регистрации при этом оставался взведённым,
			# и боец выпадал из отрисовки НАВСЕГДА: ветка выше регистрирует
			# только `если не зарегистрирован`. Сбрасывая признак, мы превращаем
			# это в пропуск одного кадра с самовосстановлением на следующем
			if _far_slot == null:
				_far_registered = false
		else:
			# ── ПОЗИЦИЯ ПИШЕТСЯ ВСЕГДА, БЕЗ ОГЛЯДКИ НА LOD ──────────────────
			# Здесь стояло `elif seen`. LOD-признак означает «стоит ли считать
			# ему позу», а вовсе не «рисуется ли он»: общий MultiMesh рисует
			# ВСЕХ зарегистрированных (extra_cull_margin у бакета — 16384 м).
			# Не-«видимому» бойцу переставали переносить слот, и он застывал
			# на месте, продолжая идти логически: раз в anim_every визуальных
			# тактов полный путь выше дёргал его вперёд рывком. Кольцо
			# выделения при этом ехало гладко — оно берёт нарисованную точку,
			# которую сглаживание двигает каждый кадр, — и уезжало от спрайта.
			# Перенос стоит трёх записей во float и сам отсекает неподвижного
			# (см. FarUnitRenderer.Slot.move_to), экономить на нём нечего
			_far_slot.move_to(p)
		return
	if seen:
		if _far_registered:
			GameManager.unregister_far(self)
			_far_registered = false
			_far_slot = null
			if _active_sprite != null and is_instance_valid(_active_sprite):
				_active_sprite.visible = true
		return
	if not _far_registered:
		if _active_sprite != null and is_instance_valid(_active_sprite):
			_active_sprite.visible = false
		_far_slot = GameManager.register_far(self, _flip_h_state)
		_far_registered = true
	elif (Engine.get_process_frames() + _sep_phase) % ANIM_EVERY == 0:
		GameManager.update_far_transform(self, gp, _flip_h_state)

## ── КАДРОВЫЙ (ВИЗУАЛЬНЫЙ) ТИК ────────────────────────────────────────────────
## Раньше это был движковый _process(). Теперь юнит его НЕ определяет, а
## GameManager обходит тот же плоский реестр _live_units и зовёт этот метод сам
## — ровно так же, как он уже делает с tick_physics, и по тем же причинам:
##   • обход можно ЧЕРЕДОВАТЬ по кадрам (см. perf_config.shards_for). Симуляция
##     на пяти тысячах и так идёт через кадр, то есть в промежуточных кадрах
##     позиция бойца НЕ МЕНЯЕТСЯ — перебирать ради неё всю визуальную цепочку
##     (LOD, походка, ракурс, слот в общей отрисовке) было чистой переплатой;
##   • пять тысяч движковых нотификаций в кадр заменяются одним циклом.
## Тумблер set_process(false) сохраняет прежний смысл «выключить визуал этому
## бойцу» — GameManager проверяет is_processing() перед вызовом. Логика внутри
## метода не изменилась ни на строку.
## `frame` — номер кадра отрисовки, посчитанный ОДИН раз на всю армию в
## GameManager._process. Раньше каждый боец сам звал Engine.get_process_frames()
## — пять тысяч обращений в движок в кадр ради одного и того же числа
## `anim_every` — такт пересчёта позы, посчитанный ОДИН раз на всю армию в
## GameManager._process (см. perf_config.anim_every_for). Передаётся аргументом,
## а не читается из статики: чтение чужого скрипта в цикле по армии — это
## лишний поиск на бойца в каждом кадре, а число одно на всех
## ── ВСЁ ОБЩЕЕ НА АРМИЮ ПРИХОДИТ АРГУМЕНТАМИ, А НЕ ЧИТАЕТСЯ ОТСЮДА ──────────
## В прологе этой функции стояло СЕМЬ обращений к чужим объектам на каждого
## бойца в каждом кадре отрисовки: три поля точки обзора у автозагрузки
## (_view_x/_view_z/_view_r2) и четыре статических поля настроек (sprite_lod,
## profile_physics, visual_smoothing, mm_render_all). Все семь одинаковы для
## ВСЕЙ армии и меняются не чаще раза в кадр.
##
## Замер (qa_fx, 3000, фаза контакта) показал, что пролог до первой ветки стоит
## ~1.4 мкс на вызов при ~900 вызовах в кадр — то есть больше миллисекунды
## уходило на повторное чтение одних и тех же восьми чисел. Это ровно та цена,
## которую проект уже оплатил трижды («валюта проекта — межобъектный вызов»);
## здесь она просто пряталась в визуальном тике, где профиля до сих пор не было.
##
## Теперь их читает GameManager ОДИН раз на кадр и раздаёт аргументами — тем же
## приёмом, каким туда уже переехали frame и anim_every.
func tick_visual(delta: float, frame: int = -1, anim_every: int = ANIM_EVERY,
		view_x: float = 0.0, view_z: float = 0.0, view_r2: float = INF,
		lerp_k: float = 1.0, mm_all: bool = true, prof: bool = false,
		fog_on: bool = true, cam_epoch: int = 0) -> void:
	# Ответ «видно ли меня» кладём в поле: подклассы с направленными спрайтами
	# (Spearman) спрашивали GameManager.near_view ЕЩЁ РАЗ, каждый своим вызовом.
	# Замер: одна такая пара вызовов на бойца в кадре стоила ~5 кадров в секунду
	# на 810 моделях (фаза «идут, sprite_lod ВЫКЛ» отличалась ровно этим)
	if not _look_ok:
		_look_bind()
	if frame < 0:
		frame = Engine.get_process_frames()
	# ── LOD СЧИТАЕМ ЗДЕСЬ, БЕЗ ВЫЗОВА НАРУЖУ ────────────────────────────────
	# _lod_visible() — это чтение свойства global_position плюс межобъектный
	# вызов GameManager.near_view ради двух умножений. Точка обзора живёт в
	# GameManager полями и меняется раз в кадр на всю армию; читаем их прямо
	# и сравниваем сами. Та же точка потом уходит в общую отрисовку — берём её
	# одним чтением на весь метод
	# ── ТОЧКА БЕРЁТСЯ ИЗ СТРОКИ ЯДРА АРМИИ, А НЕ У УЗЛА ─────────────────────
	# global_position — свойство: после записи трансформа мировая матрица
	# помечена грязной, и первое же чтение оплачивает её пересборку по цепочке
	# родителей. А читается она здесь на КАЖДОГО бойца в КАЖДОМ кадре
	# отрисовки, и дальше уходит и в туман, и в LOD, и в общую отрисовку.
	# Строку пишет физический тик того же кадра (write_pose) и пакетный разбор
	# наложения, то есть число тут ровно то же самое.
	# Признак F_POS_VALID снят у тех, кого нет на поле (гарнизон) и у ещё ни
	# разу не тикавших — для них честнее спросить узел
	# ── РАЗБИВКА ВИЗУАЛЬНОГО ПРОХОДА ────────────────────────────────────────
	# Его цена (7-9 мс на 3000 бойцах) до сих пор была ОДНИМ числом без единого
	# внутреннего замера, и оптимизировать его можно было только вслепую.
	# Ветки те же по смыслу, что у физического профиля, и включаются тем же
	# флагом; при выключенном это одна проверка bool
	var _vprof: bool = prof
	var _vt: int
	if _vprof: _vt = Time.get_ticks_usec()
	# ── ТОЧКА БЕРЁТСЯ У УЗЛА, И ЭТО САМЫЙ ДЕШЁВЫЙ ИЗ ТРЁХ ВАРИАНТОВ ─────────
	# История этой строки стоит того, чтобы её знать, — здесь перепробованы все
	# три способа и все три замерены:
	#   1) global_position — свойство, а не поле: после записи трансформа мировая
	#      матрица помечена грязной, и первое чтение оплачивает её пересборку по
	#      цепочке родителей. На каждого бойца в каждом кадре отрисовки;
	#   2) четыре чтения КОЛОНОК (flags, px, py, pz) — так было, пока колонки
	#      жили в GDScript: 0.80 мкс на бойца;
	#   3) один вызов солвера pos_or() — казался очевидным улучшением и оказался
	#      ХУЖЕ: 2.30 мкс, потому что каждый переход границы GDScript↔C# стоит
	#      дороже, чем всё, что он экономит.
	# Правильный ответ — не спрашивать никого: локальная position это ПОЛЕ
	# трансформа без пересборки матрицы, а под неподвижным World она равна
	# мировой (см. _local_xform, предпосылка проверяется). Узел и колонка всегда
	# синхронны: их ведут пакетный шаг, разбор наложения и _move_blocked
	var gp: Vector3 = position if _local_xform else global_position
	if _vprof: _Opt.prof_add("vis_row", Time.get_ticks_usec() - _vt)
	# ── ТУМАН ВОЙНЫ ГАСИТ ЧУЖИХ ЦЕЛИКОМ ─────────────────────────────────────
	# Не «рисовать потусклее», а не рисовать вовсе: боец снимается с общей
	# отрисовки, и его слот освобождается. Это и требование по игре (в тумане
	# не видно, кто там), и та самая экономия — армия противника за пеленой
	# не стоит ни одной матрицы в буфере MultiMesh.
	# Спрашиваем ТОЛЬКО за чужих: свои сами и есть источники обзора, они
	# всегда освещены, и вызов наружу за каждого своего бойца был бы платой
	# за заведомо известный ответ
	if _vprof: _vt = Time.get_ticks_usec()
	# ── ПРИЗНАК «ТУМАН ВКЛЮЧЁН» ПРИХОДИТ АРГУМЕНТОМ ────────────────────────
	# Вопрос «а есть ли туман вообще» одинаков для всей армии, а задавался он
	# ДВУМЯ обращениями к чужим объектам (GameManager.fog_lit_at → FogOfWar)
	# на каждого ЧУЖОГО бойца в каждом кадре. При выключенном тумане — а он
	# выключен во всех перф-стендах и во всех стендах, меряющих звук и тряску, —
	# это была чистая переплата за заведомо известный ответ
	if fog_on and faction != Constants.FACTION_PLAYER and state != State.DEAD:
		if not GameManager.fog_lit_at(gp.x, gp.z):
			# ── ГАСНЕТ НЕ МГНОВЕННО, А ЧЕРЕЗ ЗАДЕРЖКУ ───────────────────────
			# Маска тумана пересчитывается раз в FogOfWar.UPDATE_INTERVAL
			# (0.15 с), а бойцы на кромке видимости всё время переступают туда
			# и обратно: без задержки они гаснут и загораются семь раз в
			# секунду. В крупном бою таких на кромке сотни — это и есть
			# «армия мерцает». Задержка в три пересчёта маски убирает дребезг и
			# не превращается в подсказку: полсекунды — это «последнее, что ты
			# видел», а не разведка
			# ── ЗАДЕРЖКА СЧИТАЕТСЯ ПО ЧАСАМ, А НЕ ПО ТИКАМ ──────────────────
			# Первая версия вычитала delta и была неверной: боец без дела
			# засыпает (set_process(false)), а будит его редкий обход
			# GameManager._wake_returned_far_units — раз в четверть секунды и
			# ровно на ОДИН кадр. Полсекунды задержки набирались бы двадцать семь
			# таких пробуждений, то есть почти семь секунд (стенд qa_fog D2 это и
			# показал). Часы от частоты тика не зависят
			if now_ms - _fog_lit_ms > int(FOG_HIDE_GRACE * 1000.0):
				_hide_in_fog()
				return
		else:
			_fog_lit_ms = now_ms
		# Вышел обратно на свет — вернуть полоску, которую погасил туман.
		# Признак, а не безусловный вызов: _update_hp_bar лезет наружу, а этот
		# путь проходят все чужие бойцы каждый кадр
		if _hp_fog_hidden:
			_hp_fog_hidden = false
			_update_hp_bar()
	if _vprof: _Opt.prof_add("vis_fog", Time.get_ticks_usec() - _vt)
	# Радиус приходит уже готовым: выключенный LOD — это просто бесконечность
	# (см. GameManager._process), поэтому здесь нет ни ветки, ни чтения настройки
	var vdx: float = gp.x - view_x
	var vdz: float = gp.z - view_z
	var seen: bool = vdx * vdx + vdz * vdz <= view_r2
	var seen_now: bool = seen and not _seen
	_seen = seen
	# ── СОСТОЯНИЕ УРОНА: ДВА СРАВНЕНИЯ НА ЦЕЛОГО БОЙЦА ──────────────────────
	# Целый и не задетый не платит здесь ничего, кроме двух сравнений float:
	# вспышка потушена, здоровье то же, что уже лежит в буфере. Заводить ради
	# этого отдельный обход или подписку было бы дороже самого дела.
	# Здоровье сравниваем СЫРОЕ, без деления: делить придётся только в тот
	# редкий кадр, когда оно действительно изменилось
	if _hit_flash > 0.0:
		_hit_flash -= delta
		if _hit_flash < 0.0:
			_hit_flash = 0.0
		_dmg_dirty = true
	elif current_health != _dmg_hp_seen:
		_dmg_dirty = true
	# ── ТАКТ РАЗЛЁТА ОТ ТАРАНА (см. FLING_SEC) ──────────────────────────────
	# Здесь же, где и такт вспышки попадания, и по той же причине: это
	# КОРОТКИЙ ВИЗУАЛЬНЫЙ таймер, и жить он обязан в визуальном тике.
	# delta тут уже поправлена на шардирование, поэтому суммарная длительность
	# не зависит от того, через сколько кадров бойца опрашивают
	if _fling_left > 0.0:
		_fling_left -= delta
		if _fling_left <= 0.0:
			_fling_left = 0.0
			# Разлёт кончился — вернуть строку пакетному догону, продолжив с
			# той точки, куда картинку довёл сам боец
			if _rb_bound and _soa >= 0:
				GameManager.army.set_flag(_soa, 1 << 19, false)  # F_VIS_SELF
				GameManager.army.row_sync_draw(_soa, _draw_pos)

	if _vprof: _vt = Time.get_ticks_usec()
	_update_walk_anim(delta, seen)
	if _vprof: _Opt.prof_add("vis_walk", Time.get_ticks_usec() - _vt)
	# Признак «внешность могла смениться» считается ОДИН раз и передаётся
	# дальше: по нему же общая отрисовка решает, разбирать ли спрайт заново
	# (см. _sync_far_render). _flip_dirty сбрасывает _update_sprite_flip, а
	# _pose_dirty — строка ниже, поэтому запоминаем до вызовов
	var look_changed: bool = _pose_dirty or _flip_dirty 		or (frame + _sep_phase) % anim_every == 0
	# ── СОБЫТИЯ ВМЕСТО РАСПИСАНИЯ (этап E3) ─────────────────────────────────
	# anim_every здесь уже растянут в pose_safety_mult раз (GameManager);
	# настоящие поводы для разбора считаются тут, по полям, без вызовов
	if not look_changed and _Opt.pose_events:
		if state != _pose_state or _live_rank != _pose_rank \
				or cam_epoch != _pose_cam or seen_now:
			look_changed = true
		elif _lock_pending and now_ms >= _anim_lock_until_ms:
			look_changed = true
		else:
			var lk: Vector3 = _mv_dir if _mv_moving else _facing
			var dd: float = lk.x * _pose_look.x + lk.z * _pose_look.z
			if dd <= 0.0 or dd * dd < POSE_TURN_COS2 \
					* (lk.x * lk.x + lk.z * lk.z) \
					* (_pose_look.x * _pose_look.x + _pose_look.z * _pose_look.z):
				look_changed = true
	if seen and look_changed:
		if _vprof: _vt = Time.get_ticks_usec()
		_pose_dirty = false
		_update_sprite_anim()
		_update_sprite_flip()
		_pose_state = state
		_pose_rank = _live_rank
		_pose_cam = cam_epoch
		_pose_look = _mv_dir if _mv_moving else _facing
		if now_ms >= _anim_lock_until_ms:
			_lock_pending = false
		if _vprof: _Opt.prof_add("vis_pose", Time.get_ticks_usec() - _vt)
	# Кадр листаем САМИ и ЧИСЛОМ — узел спрайта в общей отрисовке невидим,
	# а его собственная анимация выключена (см. _look_detach_node)
	var frame_moved: bool = false
	if seen and _look_frames > 1 and not (_Opt.anim_core and _rb_bound):
		frame_moved = _advance_look_frame(delta)
	if state != State.DEAD:
		if _vprof: _vt = Time.get_ticks_usec()
		# ── САМЫЙ ЧАСТЫЙ СЛУЧАЙ СОБРАН ЗДЕСЬ, БЕЗ ДВУХ ВЫЗОВОВ ──────────────
		# Обычный кадр обычного бойца — это «внешность та же, надо лишь
		# подвинуть слот». Он проходил через ДВА вызова GDScript подряд
		# (_smoothed и _sync_far_render), а по замеру сам перенос позиции стоит
		# 1.22 мкс, из которых заметная часть — это и есть цена вызовов.
		# Здесь та же арифметика развёрнута на месте; всё остальное
		# (регистрация, смена ленты, запасной режим отрисовки) уходит в
		# _sync_far_render, как и раньше
		# `seen` в условии НЕТ намеренно: перенос слота положен и тому, кого LOD
		# не считает «видимым» (разбор — в _sync_far_render, ветка move_to)
		if mm_all and _far_registered and _far_slot != null 				and not look_changed:
			# ── ПОЗИЦИЮ ВЕДЁТ ЯДРО (BatchVisual, этап C.1) ──────────────────
			# Догон нарисованной точки, покачивание шага и запись трёх float
			# идут одним C#-проходом по всем привязанным строкам каждый кадр
			# отрисовки. Здесь остаётся только листание ленты (ниже) и
			# состояние урона. Сам ведёт картинку лишь разлёт от тарана
			# (F_VIS_SELF) и боец без строки в ядре — прежним путём
			if not (_Opt.vis_core_path and _rb_bound and _fling_left <= 0.0):
				var sx: float = gp.x
				var sz: float = gp.z
				if lerp_k < 1.0 and _draw_init:
					var ddx: float = gp.x - _draw_pos.x
					var ddz: float = gp.z - _draw_pos.z
					if ddx * ddx + ddz * ddz <= VIS_SNAP_SQ:
						sx = _draw_pos.x + ddx * lerp_k
						sz = _draw_pos.z + ddz * lerp_k
				_draw_pos = Vector3(sx, gp.y, sz)
				_draw_init = true
				_far_slot.move_to(Vector3(sx, gp.y + _bob, sz))
			# ── НОВЫЙ КАДР ЛЕНТЫ УЕЗЖАЕТ В БУФЕР СРАЗУ ──────────────────────
			# Быстрый путь берётся, когда внешность «та же» — но кадр походки
			# в этот момент уже мог смениться (_advance_look_frame выше). Пока
			# его писал только полный пересчёт (раз в anim_every визуальных
			# тактов), картинка листалась на большой армии раз в двадцать
			# кадров отрисовки: ноги замирали, а боец продолжал ехать.
			# Здесь в буфер уходит ОДИН float — это не «ещё один полный путь»
			if frame_moved:
				_far_slot.set_frame(_look_frame)
		else:
			# Опора полной записи у привязанной строки — нарисованная точка
			# ЯДРА: GDScript-копию на быстром пути больше никто не ведёт, и
			# опора на неё рвала бы картинку при каждом пересчёте позы
			var spos: Vector3
			if _Opt.vis_core_path and _rb_bound and _fling_left <= 0.0 and _soa >= 0:
				spos = GameManager.army.draw_pos(_soa)
				_draw_pos = spos
				_draw_init = true
			else:
				spos = _smoothed(gp, lerp_k)
			_sync_far_render(seen, look_changed, spos, mm_all)
		# ПОСЛЕ обеих веток: слот мог смениться прямо сейчас (переезд в другой
		# бакет при смене ленты), и писать надо в тот, что стал текущим
		if _dmg_dirty:
			_push_damage_shade()
		if _vprof: _Opt.prof_add("vis_far", Time.get_ticks_usec() - _vt)
	# Сон: стоящему юниту с затухшей анимацией _process не нужен вовсе.
	# Пробуждение — _wake_process() в командах/уроне.
	# ── С НЕПОГАСШЕЙ ВСПЫШКОЙ СПАТЬ НЕЛЬЗЯ ──────────────────────────────────
	# Уснувший перестаёт тикать, а значит и гасить вспышку: в буфере навсегда
	# осталось бы подмешанное белое, и обстрелянный неподвижный строй стоял бы
	# засвеченным до следующего случайного пробуждения. Задержка тут — четыре
	# кадра на бойца, и только после попадания
	# ЛЕТЯЩИЙ НЕ ЗАСЫПАЕТ — по той же причине, что и непогасшая вспышка:
	# уснувший перестаёт тикать, а значит и догонять телом свою картинку, и
	# спрайт остался бы лежать там, откуда бойца сбило
	if state == State.IDLE and _anim_time == 0.0 and _hit_flash <= 0.0 \
			and _fling_left <= 0.0 \
			and not _dmg_dirty and _process_can_sleep():
		_proc_sleeping = true
		# Зеркало в колонку: разбор наложения будит только тех, у кого стоит
		# этот бит (см. ArmyCore.FSleepDraw). Событие редкое — платить нечем
		if _soa >= 0:
			GameManager.army.set_flag(_soa, 1 << 16, true)
		set_draw(false)

# ── СГЛАЖИВАНИЕ КАРТИНКИ ─────────────────────────────────────────────────────
# Логика двигает бойца рывками: раз в его физический тик, а при шардировании —
# раз в несколько тиков, шагом соответственно длиннее. Рисуется же он в каждом
# кадре отрисовки. Отсюда и дёрганье: частоты не совпадают, и на тысяче бойцов
# (два шарда, 30 обновлений в секунду) это отлично видно глазом.
#
# Сглаживается ТОЛЬКО ТО, ЧТО РИСУЕТСЯ. Логическая координата (строка ядра
# армии, узел, сетка соседей, туман, выбор мышью) остаётся честной и точной —
# иначе поехали бы и попадания, и клики, и блокировка строем.
#
# Догон, а не интерполяция по двум снимкам: интерполяция требует хранить
# предыдущее положение и знать долю между тиками, то есть ещё одну запись на
# бойца в каждом шаге — ровно та цена, которую Фаза 1 замерила как +2.2 мс на
# пятнадцати тысячах. Догон стоит одного вычитания и одного умножения и не
# требует хранить ничего, кроме самой нарисованной точки.
## Дальше этого — не сглаживаем, а прыгаем: выход из гарнизона, спавн, перенос
## стендом. Скользящий через полкарты спрайт хуже любого дёрганья
const VIS_SNAP_SQ := 4.0

## ═════════════════════════════════════════════════════════════════════════════
## РАЗЛЁТ ОТ ТАРАНА ВИДНО ГЛАЗОМ, А НЕ ТОЛЬКО В ЧИСЛАХ
## ═════════════════════════════════════════════════════════════════════════════
## Жалоба владельца: «при таране пехотинцы мгновенно телепортируются». Разбор
## показал, что виноват НЕ сам удар, а порог привязки картинки.
##
## Картинка бойца и так догоняет его логическую точку плавно (_smoothed), но у
## сглаживания есть предохранитель: прыжок дальше VIS_SNAP_SQ (2 м) считается
## «телепортом» — гарнизон, выход из замка, постановка стенда — и картинка
## переставляется мгновенно, иначе спрайт полз бы через полкарты. Отбрасывание
## при таране равно charge_knockback = 2.2 м, то есть ровно ЗА этим порогом:
## удар честно двигал бойца, и картинка честно телепортировалась следом.
##
## Лечение: на короткое окно после удара боец помечается «летящим». Пока метка
## жива, предохранитель не срабатывает, а доля догона берётся своя, помедленнее
## обычной — тогда разлёт читается как полёт, а не как подмена кадра.
##
## ЦЕНА: одно сравнение float в _smoothed на бойца в кадр отрисовки, и только у
## тех, у кого метка вообще взведена (у остальных она в нуле и гаснет первой же
## веткой). Новых полей в строке ядра, новых проходов и новых узлов — ноль.
const FLING_SEC := 0.45
## Доля догона за кадр на разлёте. Меньше обычной (та считается от такта
## обновления и близка к единице): именно она и растягивает бросок на глаз
const FLING_LERP := 0.14

## ── ФИЗИКА РАЗЛЁТА ────────────────────────────────────────────────────────
## Постоянная времени затухания: за FLING_TAU скорость падает в e раз. Вместе с
## FLING_SEC она задаёт, какую долю заказанного пути боец успеет пройти, —
## связка считается в apply_knockback, поэтому дальность удара от этих чисел не
## зависит, зависит только ФОРМА кривой: меньше τ — резче старт и короче хвост
const FLING_TAU := 0.16
## Во сколько раз скорость падает за секунду (тот же τ, выраженный на секунду)
const FLING_DECAY_PER_SEC := 0.0019
## Ниже этой скорости (м/с, в квадрате) разлёт считается кончившимся
const FLING_STOP_SQ := 0.04

## ── КУДА ЛЕТИТ НАКРЫТЫЙ НАТИСКОМ ──────────────────────────────────────────
## Заказ владельца: «строго назад / по вектору удара». Доли нормируются, поэтому
## важно только их отношение: назад в два с половиной раза сильнее, чем вбок.
const CHARGE_FLING_BACK := 0.92
## Малая боковая доля — не половинчатость, а необходимость: без неё весь
## накрытый ряд едет строго параллельно и остаётся такой же плотной стенкой
## метром позади, то есть проход не открывается (разбор — в apply_knockback)
const CHARGE_FLING_SIDE := 0.36

## Скорость разлёта, м/с. ЕДИНСТВЕННОЕ поле скорости в проекте: у бойцов нет
## физтел, и всё остальное движение — прямое интегрирование в position
var _fling_vel: Vector3 = Vector3.ZERO

## Сколько секунд ещё длится разлёт. Тикает в визуальном тике
var _fling_left: float = 0.0

## Пометить бойца летящим: следующие FLING_SEC его картинка догоняет тело
## плавно и не перескакивает. Зовёт apply_knockback
func fling_visual() -> void:
	_fling_left = FLING_SEC
	# На время разлёта картинку ведёт сам боец (свой обход предохранителя
	# телепорта): строка выходит из пакетного догона ядра, а нарисованная
	# точка забирается оттуда, чтобы полёт начался с места
	if _rb_bound and _soa >= 0:
		_draw_pos = GameManager.army.draw_pos(_soa)
		_draw_init = true
		GameManager.army.set_flag(_soa, 1 << 19, true)   # F_VIS_SELF
	# Разлёт обязан быть виден и у того, кто спал по картинке: стоящий боец
	# гасит свой визуальный тик сам (_proc_sleeping)
	_wake_process()

## Летит ли прямо сейчас (нужно стенду)
func is_flinging() -> bool:
	return _fling_left > 0.0

var _draw_pos: Vector3 = Vector3.ZERO
var _draw_init: bool = false

## `k` — доля сближения за кадр; её считает GameManager один раз на всю армию.
## Единица означает «сглаживания нет», поэтому отдельного чтения настройки
## visual_smoothing здесь больше не нужно
func _smoothed(gp: Vector3, k: float = -1.0) -> Vector3:
	if k < 0.0:
		k = GameManager.vis_lerp_k if _Opt.visual_smoothing else 1.0
	if k >= 1.0:
		return gp
	if not _draw_init:
		_draw_pos = gp
		_draw_init = true
		return gp
	var dx: float = gp.x - _draw_pos.x
	var dz: float = gp.z - _draw_pos.z
	# ── РАЗЛЁТ ОТ ТАРАНА ПРОХОДИТ МИМО ПРЕДОХРАНИТЕЛЯ (см. FLING_SEC) ───────
	# Порядок важен: проверка метки стоит ДО порога, иначе отброшенный на 2.2 м
	# боец перескакивал бы ровно так, как и жаловались
	# ── ДОГОН ТЕПЕРЬ ОБЫЧНЫЙ, А НЕ ЗАМЕДЛЕННЫЙ ─────────────────────────────
	# FLING_LERP (0.14) растягивал на глаз МГНОВЕННЫЙ прыжок тела — другого
	# способа показать телепорт не было. Теперь тело само едет плавно
	# (см. _tick_fling), и замедленный догон стал вредом: картинка отставала бы
	# от бойца на всё время полёта. Метка оставлена ровно ради одного —
	# обойти предохранитель телепорта: разбор наложения может в этот момент
	# добавить свой рывок, и он не должен рвать картинку
	if _fling_left > 0.0:
		_draw_pos = Vector3(
			_draw_pos.x + dx * k,
			gp.y,
			_draw_pos.z + dz * k)
		return _draw_pos
	if dx * dx + dz * dz > VIS_SNAP_SQ:
		_draw_pos = gp
		return gp
	_draw_pos = Vector3(
		_draw_pos.x + dx * k,
		gp.y,                      # высота идёт как есть: рельеф не дёргается
		_draw_pos.z + dz * k)
	return _draw_pos

## ── ДОВЕДЕНИЕ КАРТИНКИ, КАЖДЫЙ КАДР ────────────────────────────────────────
## Сглаживание жило внутри tick_visual, а тот ШАРДИРОВАН — то есть догон
## случался ровно тогда же, когда и сам шаг, и между шагами не происходило
## ничего. При трёх шардах спрайт двигался двадцать раз в секунду прыжками
## тройной длины и рисовался в этих же двадцати кадрах из шестидесяти: именно
## это и видно как «армия дёргается спрайтами». Считать это сглаживанием было
## нельзя — оно только добавляло постоянное отставание.
##
## Метод нарочно КРОШЕЧНЫЙ: чтение строки ядра армии, одно вычитание с
## умножением и запись трёх float в общий буфер. Ни ракурса, ни анимации, ни
## LOD, ни тумана здесь нет — всё это по-прежнему считается раз в несколько
## кадров в tick_visual. Зовётся только при шардировании (при одном шарде
## tick_visual и так идёт каждый кадр) — см. GameManager._process
## ── ДОЛЯ СБЛИЖЕНИЯ ПРИХОДИТ АРГУМЕНТОМ, А АРИФМЕТИКА РАЗВЁРНУТА НА МЕСТЕ ────
## Этот проход — ЕДИНСТВЕННЫЙ в кадре, который идёт по ВСЕЙ армии без
## шардирования: три с половиной тысячи вызовов, шестьдесят раз в секунду.
## Здесь была пара лишних действий на каждый из них, и обе стоили заметно:
##   • GameManager.vis_lerp_k — чтение поля ЧУЖОГО объекта (автозагрузки), а
##     величина одна на всю армию и считается ею же раз в кадр (правило 3
##     проекта: общее на армию читать раз в кадр и передавать аргументом);
##   • _smoothed() — второй вызов GDScript-функции на бойца, с проверкой
##     умолчания аргумента и веткой про метку разлёта.
## Теперь доля приходит сверху, а сглаживание развёрнуто прямо здесь: ветка
## разлёта (_fling_left) и предохранитель телепорта (VIS_SNAP_SQ) сохранены
## слово в слово, поведение не меняется ни на пиксель.
##
## _smoothed остаётся: его зовёт полный визуальный тик, там он не горячий
func tick_draw(k: float) -> void:
	if not _mm_only or _far_slot == null or not _seen or state == State.DEAD:
		return
	var gp: Vector3 = position if _local_xform else global_position
	if k >= 1.0 or not _draw_init:
		_draw_pos = gp
		_draw_init = true
		_far_slot.move_to(Vector3(gp.x, gp.y + _bob, gp.z))
		return
	var dx: float = gp.x - _draw_pos.x
	var dz: float = gp.z - _draw_pos.z
	# Порядок тот же, что в _smoothed: метка разлёта проверяется ДО порога
	# телепорта, иначе отброшенный тараном боец перескакивал бы
	if _fling_left <= 0.0 and dx * dx + dz * dz > VIS_SNAP_SQ:
		_draw_pos = gp
		_far_slot.move_to(Vector3(gp.x, gp.y + _bob, gp.z))
		return
	var nx: float = _draw_pos.x + dx * k
	var nz: float = _draw_pos.z + dz * k
	_draw_pos = Vector3(nx, gp.y, nz)
	_far_slot.move_to(Vector3(nx, gp.y + _bob, nz))

## ТОЧКА, В КОТОРОЙ БОЕЦ НАРИСОВАН, а не в которой он логически стоит.
##
## Всё, что лежит на земле ПОД бойцом — кольцо выделения, тень, красное кольцо
## прицела, полоска здоровья — обязано браться отсюда, а не из global_position.
## Иначе получается ровно то, на что пришла жалоба: метки уезжают от ног.
## Причина не в метках — они как раз честно стоят в логической точке. Уезжает
## САМ СПРАЙТ: картинка сглаживается между физическими шагами (_smoothed), а на
## трёх шардах боец шагает раз в три кадра, и догон отстаёт от логики на
## РАССТОЯНИЕ ШАГА. Замер qa_ring: на одном шарде отставание 5-7 см и глазу
## незаметно, на трёх — 0.28 м по X и 0.28 по Z, то есть почти полметра по
## диагонали марша. Логическая точка при этом остаётся честной: попадания,
## клики и блокировка строем считаются по ней.
func draw_position() -> Vector3:
	# У привязанной строки нарисованную точку ведёт ядро (BatchVisual)
	if _Opt.vis_core_path and _rb_bound and _fling_left <= 0.0 and _soa >= 0:
		return GameManager.army.draw_pos(_soa)
	return _draw_pos if _draw_init else global_position

## ── РИСУЮТ ЛИ БОЙЦА ПРЯМО СЕЙЧАС ───────────────────────────────────────────
## Вопрос задают МЕТКИ НАД ГОЛОВОЙ (знамя ветеранства), и им нужен именно этот
## ответ, а не «жив ли» и не «освещён ли».
##
## Причина. Боец, ушедший под пелену, снимается с общей отрисовки
## (_hide_in_fog) и выходит из tick_visual РАНЬШЕ, чем обновит свою
## НАРИСОВАННУЮ точку. Значит draw_position() у него ЗАМИРАЕТ на месте, где его
## видели в последний раз, — и метка, которая едет по этой точке и по ней же
## спрашивает туман, остаётся стоять на кромке. Стоит армии игрока подойти и
## осветить то место — метка загорается над пустой травой, а её хозяин в это
## время в сорока метрах под пеленой. Ровно это владелец и снял: синий флажок
## на копье, а под ним ничего.
##
## Поэтому спрашивать надо не туман, а ФАКТ отрисовки: он один разом покрывает
## и туман, и гарнизон, и уход бойца с карты, и запасной режим без общего
## MultiMesh (mm_render_all = false), где картинку держит собственный спрайт.
func is_drawn() -> bool:
	if _far_registered:
		return true
	return _active_sprite != null and is_instance_valid(_active_sprite) \
		and _active_sprite.visible

# Подклассы с направленными спрайтами добавляют свои условия (см. Spearman)
func _process_can_sleep() -> bool:
	if _anim_name != &"" and _anim_name != &"idle":
		return false
	# МНОГОКАДРОВЫЙ ПОКОЙ НЕ УСЫПЛЯЕМ. В общей отрисовке узел спрайта стоит на
	# паузе (_look_detach_node), и ленту листает ТОЛЬКО визуальный тик
	# (_advance_look_frame): уснувший боец замирает на случайном кадре idle.
	# Копейщик это правило держит давно (Spearman._process_can_sleep, «застывал
	# статуей»), а лучник и мечник засыпали и «еле дышали». Правило то же, что
	# у него: спать можно, только когда листать нечего
	# Зацикленный покой не даёт спать ТОЛЬКО когда листать его должен сам
	# боец; ведомую ядром ленту (этап E1) листает BatchVisual и у спящего
	if _look_loop and _look_frames > 1 and not (_Opt.anim_core and _rb_bound):
		return false
	return now_ms >= _anim_lock_until_ms

# Базовое переключение walk/idle для AnimatedSprite3D; Worker переопределяет
# (инструменты/переноска), Spearman использует направленные текстуры отдельно
## ═══════════════════════════════════════════════════════════════════════════
## ПОЗА ХОДЬБЫ — ОТ ФАКТИЧЕСКОГО СМЕЩЕНИЯ, А НЕ ОТ НАМЕРЕНИЯ
## ═══════════════════════════════════════════════════════════════════════════
## Жалоба владельца: «юниты во второй линии стоят на месте, но у них бесконечно
## крутится анимация бега».
##
## Так и было, причём в двух местах сразу и по одной причине: поза выбиралась по
## НАМЕРЕНИЮ. Здесь — по `velocity`, то есть по ЖЕЛАЕМОЙ скорости; у копейщика
## (Spearman._update_dir_sprite) — прямо по `state`. Боец второй шеренги в
## свалке находится в State.ATTACKING, до цели не дотягивается, а шагнуть не
## может: впереди свои. Оба признака говорят «идёт», а он стоит.
##
## Физтел в проекте нет вовсе, и спрашивать физику не у кого — но и не нужно:
## правда о том, сдвинулся ли боец, есть в его собственной точке. Разность
## позиций между его тиками и есть ответ, и в неё входит ВСЁ, что его двигало.
##
## Порог задан СКОРОСТЬЮ, а не путём: тик шардирован, и путь за тик зависит от
## того, через сколько кадров бойца опросили.
const MOVE_ANIM_MIN_SPEED := 0.6
## ── СКОРОСТЬ МЕРИТСЯ ОКНОМ, А НЕ ОДНИМ ТИКОМ ───────────────────────────────
## Жалоба владельца: «отряд стоит на месте — играет анимация бега; отряд идёт —
## половина бежит, половина замерла в покое».
##
## Обе половины жалобы — про ОДНО место и про способ мерить.
##
## МЕРИЛИ РАЗНОСТЬ МЕЖДУ ДВУМЯ СОСЕДНИМИ ТИКАМИ, а в неё входит не только шаг.
## Разбор наложения двигает бойца на SEP_MAX_STEP (5 см) раз в SEP_INTERVAL, и
## в пересчёте на длительность одного тика это около метра в секунду — БОЛЬШЕ
## порога. То есть в любой тесноте стоящий боец числился идущим просто потому,
## что его подпихивали соседи: «бег на месте». Замер по ОКНУ этим не обмануть —
## подталкивания знакопеременны и за две десятых секунды взаимно гасятся, а
## настоящий шаг за то же окно даёт полметра в одну сторону.
##
## ВТОРАЯ ПОЛОВИНА — ЧАСТОТЫ. Полный разбор позы идёт раз в anim_every
## ВИЗУАЛЬНЫХ тактов, а сам такт шардирован: на большой армии это до двадцати
## пяти кадров отрисовки, то есть больше 0.4 с. Выдержка признака была 0.18 с,
## КОРОЧЕ периода опроса: признак успевал погаснуть и загореться между двумя
## опросами, и каждый боец ловил его в своей случайной фазе — половина отряда
## шла в позе покоя. Лечится двумя способами разом, и нужны оба: выдержка
## перекрывает окно замера, а СМЕНА признака сама метит позу грязной — то есть
## расписание опроса перестаёт участвовать в ответе вовсе
const MOVE_ANIM_SAMPLE_MS := 200
## Сколько миллисекунд поза держится после последнего заметного смещения.
## ОБЯЗАНА ПЕРЕКРЫВАТЬ ОКНО ЗАМЕРА: между двумя замерами признак «идёт» должен
## дожить до следующего, иначе он гаснет в промежутке
const MOVE_ANIM_HOLD_MS := MOVE_ANIM_SAMPLE_MS + 120

var _mv_prev: Vector3 = Vector3.ZERO
var _mv_prev_set: bool = false
var _mv_until_ms: int = 0
## Когда снят опорный отсчёт окна
var _mv_sample_ms: int = 0
## Ответ, отданный наружу в прошлый раз. Держится ПОЛЕМ, а не считается из
## времени: по СМЕНЕ этого признака поза метится грязной, а без поля момент
## смены был бы неизвестен
var _mv_moving: bool = false
## ── ЧАСЫ АРМИИ: ОДНО ЧТЕНИЕ НА КАДР ВМЕСТО ОДНОГО НА БОЙЦА ─────────────────
## Time.get_ticks_msec() — вызов в движок, а не чтение поля. В горячем пути он
## стоял в шести местах, и каждое звалось НА БОЙЦА: замер смещения в
## tick_physics, туман и такт позы в tick_visual, срок опускания копья у
## копейщика. На трёх тысячах это больше тысячи вызовов в кадр только за то,
## чтобы узнать одно и то же число.
##
## Значение обновляет GameManager один раз в начале _physics_process и один раз
## в начале _process (см. там же). Статическое поле СВОЕГО класса читается как
## обычная переменная — межобъектного обращения здесь нет, в отличие от чтения
## чужой автозагрузки.
##
## Точность не страдает: внутри одного кадра время и так одно, а все сроки в
## проекте — десятки и сотни миллисекунд
static var now_ms: int = 0
## ── НОМЕР ФИЗИЧЕСКОГО КАДРА — ТОЖЕ ОДИН НА АРМИЮ ───────────────────────────
## Engine.get_physics_frames() — такой же вызов в движок, как и часы, и стоял
## он в САМОМ горячем месте: во фланговом обходе (_flank_step), который
## считается у каждого бойца, подошедшего к своей цели ближе трёх с половиной
## метров, то есть почти у всей свалки в каждом её тике.
## Обновляет GameManager в начале _physics_process, рядом с часами
static var phys_frame: int = 0
## ── ФАКТИЧЕСКОЕ НАПРАВЛЕНИЕ ХОДА ЗА ОКНО ЗАМЕРА ────────────────────────────
## Не «куда я хочу» (_facing) и не «куда меня толкнули в этом кадре», а куда
## боец РЕАЛЬНО уехал за MOVE_ANIM_SAMPLE_MS. Заводится ровно ради зеркала
## спрайта — разбор у _update_sprite_flip
var _mv_dir: Vector3 = Vector3.ZERO

## Двигался ли боец ПО-НАСТОЯЩЕМУ в последнее окно замера
## ── ОКНО ЗАМЕРА ФАКТИЧЕСКОГО СМЕЩЕНИЯ ───────────────────────────
## Отсюда берутся СРАЗУ ДВА ответа: «идёт ли боец» (moved_recently, из
## него живёт анимация ходьбы) и «куда именно» (_mv_dir, из него живёт
## зеркало спрайта). Оба считаются по ФАКТУ перемещения, а не по
## velocity: velocity — это НАМЕРЕНИЕ.
##
## ПОЧЕМУ ЭТО ОТДЕЛЬНЫЙ МЕТОД, А НЕ СТРОКИ В tick_physics. Жалобы
## владельца было две — «рабочие несут ресурсы спиной вперёд» и
## «на стройке бегут на месте вместо анимации молотка», — а причина
## у них ОДНА и она здесь: Worker ПЕРЕОПРЕДЕЛЯЕТ tick_physics и в своих
## трёх состояниях (BUILDING / GATHERING / RETURNING) до базового тика НЕ
## ДОХОДИТ вовсе. Значит, окно замера у такого рабочего не тикало ни
## разу: _mv_dir оставался тем, что был до начала работы (то есть
## направлением К дереву, пока рабочий едет ОТ него к замку — вот и
## «спиной вперёд»), а moved_recently врал на стройке.
## Вынесено в метод ровно затем, чтобы Worker звал его из своих веток
func _sample_movement() -> int:
	var _mv_now: int = now_ms
	if _mv_prev_set:
		var win: int = _mv_now - _mv_sample_ms
		if win >= MOVE_ANIM_SAMPLE_MS:
			var mdx: float = position.x - _mv_prev.x
			var mdz: float = position.z - _mv_prev.z
			# Скорость, а не путь: окно замера плавает на длину одного тика
			var wsec: float = float(win) * 0.001
			var lim2: float = MOVE_ANIM_MIN_SPEED * MOVE_ANIM_MIN_SPEED * wsec * wsec
			if mdx * mdx + mdz * mdz > lim2:
				_mv_until_ms = _mv_now + MOVE_ANIM_HOLD_MS
				# Направление хода — из ТОГО ЖЕ замера: делить нечего, вектор
				# уже посчитан. Разворот больше чем на 90 градусов метит позу
				# грязной, чтобы зеркало не ждало своей очереди в расписании
				var mlen: float = sqrt(mdx * mdx + mdz * mdz)
				var ndx: float = mdx / mlen
				var ndz: float = mdz / mlen
				if _mv_dir.x * ndx + _mv_dir.z * ndz < 0.0:
					_pose_dirty = true
				_mv_dir = Vector3(ndx, 0.0, ndz)
			_mv_prev = position
			_mv_sample_ms = _mv_now
	else:
		_mv_prev = position
		_mv_sample_ms = _mv_now
		_mv_prev_set = true
	return _mv_now

func moved_recently() -> bool:
	return _mv_moving

func _update_sprite_anim() -> void:
	if now_ms < _anim_lock_until_ms:
		return
	# ── В ПОКОЕ НОГАМИ НЕ ПЕРЕБИРАЮТ (заказ спринта 15) ────────────────────
	# Признак ходьбы считается по ФАКТУ смещения, и это правильно: намерение
	# (velocity) у упёршегося в строй остаётся ненулевым, и когда-то ровно оно
	# и давало «бег на месте». Но у смещения есть второй источник — РАЗБОР
	# НАЛОЖЕНИЯ: в плотной куче он толкает бойца каждые SEP_INTERVAL, и этого
	# хватает, чтобы окно замера считало его идущим. Стая гноллов у пня стояла
	# и «перебирала ногами» именно поэтому (жалоба владельца со скриншота).
	# Боец в ПОКОЕ никуда не идёт по определению: приказ на движение переводит
	# его в MOVING, подход к цели — в ATTACKING, паника и отход тоже. Значит
	# любое его смещение — это чужая сила, а не шаг, и ленту шага она не
	# заслуживает
	var want: StringName = &"walk" if (moved_recently()
		and state != State.IDLE) else &"idle"
	if want != _anim_name:
		_set_anim(want)

# Разворот спрайта ЛИЦОМ по ходу движения.
# Спрайты — билборды, поэтому «влево/вправо» считаются не в мировых осях,
# а относительно КАМЕРЫ: проекция направления движения на её ось X. Без этого
# рабочий, несущий ресурсы обратно в замок, бежал спиной вперёд.
#
# ЖЁСТКИЙ ГИСТЕРЕЗИС: зеркало переключается, только когда проекция уверенно
# ушла за ±sin(15°). Возле нуля (движение почти «на камеру») знак дрожит, и
# без запаса устойчивости отряд мерцал право-лево при вращении камеры.
# СТОЯЩИЙ юнит направление вообще не меняет — микро-повороты камеры его
# ракурс не трогают.
const FLIP_DEADZONE := 0.259   # sin(15°)

func _update_sprite_flip() -> void:
	# Стоим — ракурс заморожен. ИСКЛЮЧЕНИЕ: _flip_dirty — разовый доворот
	# в направление строя после прибытия на своё место в шеренге
	# Условие «стою» считается по ФАКТУ (см. _mv_moving), а не только по
	# velocity: velocity — это НАМЕРЕНИЕ, и у бойца, упёршегося в чужой строй,
	# оно остаётся ненулевым; наоборот, едущего по разлёту от тарана velocity
	# не описывает вовсе
	if (state == State.IDLE or velocity.length_squared() < 0.01) 			and not _flip_dirty and not _mv_moving:
		_apply_flip_to_node()
		return
	_flip_dirty = false
	# ── ЗЕРКАЛО БЕРЁТ ФАКТИЧЕСКОЕ НАПРАВЛЕНИЕ ХОДА, А НЕ ВЗГЛЯД ─────────────
	# Жалоба владельца: «при резкой смене направления часть спрайтов
	# разворачивается, а часть бежит спиной вперёд».
	#
	# Причина в источнике. _facing — это КУДА БОЕЦ СМОТРИТ, а смотрит он на
	# свою цель: половина отряда на марше успевает подобрать противника
	# (State.ATTACKING) и держит взгляд на нём, пока тело едет вместе с отрядом
	# совсем в другую сторону. Зеркало честно считалось по взгляду — и боец
	# ехал спиной. Вторая половина, оставшаяся в State.MOVING, смотрела по
	# маршруту и разворачивалась правильно; отсюда и «часть так, часть эдак».
	#
	# _mv_dir — это куда боец РЕАЛЬНО уехал за окно замера (см. там же). Оно
	# усреднено по двум десятым секунды, поэтому в него не попадает ни
	# расталкивание соседей, ни толчок в свалке — ровно то, что просил владелец
	# («опираться на направление движения, а не на локальное расталкивание»).
	# Стоящему бойцу двигаться некуда, и для него остаётся прежний взгляд
	var look: Vector3 = _mv_dir if (_mv_moving and _mv_dir.length_squared() > 1e-6) else _facing
	if look.length_squared() < 1e-6:
		return
	# Ось камеры берётся из общего кэша (см. GameManager.camera_right):
	# поиск камеры по дереву на каждого бойца в каждом кадре стоил дороже,
	# чем всё остальное в этой функции вместе взятое
	if not GameManager.camera_axes_valid():
		return
	var side := GameManager.camera_right().dot(look.normalized())
	# Переключаем ТОЛЬКО при выходе за мёртвую зону в противоположную сторону
	if _flip_h_state and side > FLIP_DEADZONE:
		_flip_h_state = false
	elif not _flip_h_state and side < -FLIP_DEADZONE:
		_flip_h_state = true
	_apply_flip_to_node()

## ЗЕРКАЛО — ЧИСЛО (_flip_h_state), а в общей отрисовке оно уезжает в MultiMesh
## каналом цвета. Узел трогаем только в запасном режиме и только при РЕАЛЬНОЙ
## смене: SpriteBase3D.set_flip_h не сравнивает со старым значением — любое
## присваивание ставит узел в очередь на перестроение геометрии
func _apply_flip_to_node() -> void:
	if _mm_only:
		return
	var spr := _active_sprite as SpriteBase3D
	if spr != null and spr.flip_h != _flip_h_state:
		spr.flip_h = _flip_h_state

# Проиграть атакующую анимацию, заблокировав walk/idle на dur_ms
func _play_attack_anim(anim: String, dur_ms: int = 500) -> void:
	if not _has_anim(anim):
		return
	_anim_lock_until_ms = Time.get_ticks_msec() + dur_ms
	# По истечении замка поза обязана вернуться сама (этап E3)
	_lock_pending = true
	_set_anim(anim)

## Единственная внешняя точка пробуждения (см. GameManager._wake_returned_far_units
## и ArmyCore.BatchSeparation).
##
## ── ПОЗУ ЗДЕСЬ НЕ ПАЧКАЕМ, И ЭТО ГЛАВНОЕ ОТЛИЧИЕ ОТ _wake_process ──────────
## Смыслов у пробуждения два, и раньше они были склеены в один:
##   • «я сдвинулся или вернулся в кадр» — нужно снова крутить визуальный тик,
##     чтобы перерисовалась ПОЗИЦИЯ;
##   • «моя внешность изменилась» — нужно пересчитать позу и ракурс.
## Отсюда будят только по первому поводу: расталкивание толкает сотни бойцов за
## кадр, и каждый такой толчок помечал позу грязной, хотя вид не менялся.
##
## Замер счётчиками (не зависит от загрузки машины): за 90 кадров в фазе
## контакта было 34 788 ПОЛНЫХ обновлений слота отрисовки и НОЛЬ быстрых, то
## есть дорогой путь шёл всегда; 23 301 из них взводились именно этим признаком
## против 16 568 по штатному такту анимации.
##
## Поза от этого не застаивается: она пересчитывается по такту (anim_every), то
## есть не позже пяти тиков бойца, а настоящие смены внешности (приказ, стойка,
## начало удара, пробуждение из сна) метят её явно — см. _wake_process ниже
func wake_for_lod() -> void:
	if _proc_sleeping:
		# Из СНА выходим с пересчётом позы: пока боец спал, поза могла устареть
		_pose_dirty = true
		_proc_sleeping = false
		if _soa >= 0:
			GameManager.army.set_flag(_soa, 1 << 16, false)
		set_draw(true)

# ─────────────────────────────────────────────────────────────────────────────
# УБРАТЬ БОЙЦА С ПОЛЯ, НЕ УБИВАЯ ЕГО (гарнизон замка)
#
# `u.visible = false` бойца больше НЕ ПРЯЧЕТ. Его картинка — слот в общем
# MultiMesh (см. FarUnitRenderer), а тот живёт не под узлом бойца, а в отдельном
# MultiMeshInstance3D в мире: скрытый узел продолжал рисоваться слотом на том
# месте, где вошёл в замок. Это и были «призраки гарнизона».
#
# Слот надо ВЕРНУТЬ явно — ровно так же, как _exit_tree возвращает его у
# погибшего. Обе функции идемпотентны: повторный вызов ничего не делает.
# ─────────────────────────────────────────────────────────────────────────────

## Снять бойца с общей отрисовки (ушёл в гарнизон и т.п.)
func leave_render() -> void:
	if not _far_registered:
		return
	GameManager.unregister_far(self)
	_far_registered = false
	_far_slot = null

## Вернуть на поле: слот выдаётся заново ближайшим визуальным тиком
## (_sync_far_render сам увидит, что регистрации нет), надо лишь разбудить
func enter_render() -> void:
	_pose_dirty = true
	_wake_process()

func _wake_process() -> void:
	# Разбудили — значит, что-то изменилось: поза пересчитывается сразу
	_pose_dirty = true
	if _proc_sleeping:
		_proc_sleeping = false
		if _soa >= 0:
			GameManager.army.set_flag(_soa, 1 << 16, false)
		set_draw(true)

## seen = false — боец вне поля зрения: фазу шага крутим (она копеечная и нужна,
## чтобы при возврате в кадр анимация не дёрнулась), а вот трансформы спрайта
## не трогаем вовсе
## ── ПОКАЧИВАНИЕ ШАГА ТЕПЕРЬ ЧИСЛО, А НЕ ЗАПИСЬ В УЗЕЛ ───────────────────────
## Пока боец рисовался своим узлом, боббинг писался прямо в position.y спрайта.
## В общей отрисовке (mm_render_all) этот узел НЕВИДИМ, а запись всё равно
## помечала его трансформ грязным и гнала обновление в RenderingServer — два
## лишних обновления узла на бойца в кадр ни за чем. Теперь высота живёт здесь
## и уезжает в MultiMesh вместе с позицией (см. _sync_far_render); узел трогаем
## только в запасном режиме, когда он действительно на экране
var _bob: float = 0.0

func _update_walk_anim(delta: float, seen: bool = true) -> void:
	if state == State.DEAD:
		return
	var speed := velocity.length()
	if speed > 0.1:
		_anim_time += delta * speed * 3.0
		if not seen:
			return
	elif _anim_time == 0.0:
		return  # стоим, боббинг уже обнулён — нечего обновлять
	else:
		# СТОЯЩИЙ ЮНИТ НЕ ПОДПРЫГИВАЕТ ВООБЩЕ: раньше боббинг плавно затухал
		# и юнит ещё несколько кадров после остановки заметно приседал.
		# Теперь высота сбрасывается в тот же кадр, когда движение прекратилось
		_anim_time = 0.0
		_bob = 0.0
		if not _mm_only:
			if _sprite_node:
				_sprite_node.position.y = QUAD_BASE_Y
			if _active_sprite and is_instance_valid(_active_sprite):
				_active_sprite.position.y = _sprite_base_y
		return

	# Боббинг — добавка к базовой высоте; базы у квада и кастомного спрайта
	# разные (кастомные спрайты посажены ногами на землю, см. SPRITE_BASE_Y)
	# 0.035 — ещё вдвое меньше прежних 0.07: шаг едва заметен, подскоков нет
	var amp: float = BOB_AMPLITUDE * UNIT_SCALE
	if sprinting:
		amp *= BOB_SPRINT_MULT
	var bob := sin(_anim_time) * sin(_anim_time) * amp
	_bob = bob
	if _mm_only:
		return
	# База берётся из поля, а не из константы: подклассы с направленными
	# спрайтами двигают её под конкретный лист (см. Spearman._apply_dir_tex)
	if _sprite_node:
		_sprite_node.position.y = QUAD_BASE_Y + bob
	# Боббинг на кастомном спрайте (Sprite3D / AnimatedSprite3D), задаётся подклассом
	if _active_sprite and is_instance_valid(_active_sprite):
		_active_sprite.position.y = _sprite_base_y + bob

## Позиция, с которой юнит последний раз попал в пространственную сетку

## Снятый на весь тик признак «идёт профилирование» (см. perf_config).
## Обращение к статике чужого скрипта в горячем пути стоит заметно дороже
## чтения собственного поля, а раньше оно шло по разу на каждую ветку шага
var _prof_on: bool = false

# ─────────────────────────────────────────────────────────────────────────────
# ЦЕНТРАЛИЗОВАННЫЙ ФИЗ. ТИК (см. GameManager._physics_process / register_unit)
#
# Было: движок дёргал Unit._physics_process у каждого бойца ОТДЕЛЬНО — на
# тысяче юнитов это тысяча проходов через notification-машинерию Node/
# SceneTree, притом что внутри почти всегда происходит одно и то же (простой
# throttled-опрос агро). Замер (qa_node_cost, см. план) показал, что сам факт
# наличия физ.тела в PhysicsServer3D и раздельная диспетчеризация ощутимая —
# на 900 бойцах счёт идёт на десятки мс.
#
# Теперь `_ready()` больше НЕ является точкой входа движка для этого метода:
# юнит регистрируется в `GameManager._live_units`, и ОДИН узел (GameManager)
# обходит их в своём `_physics_process` и зовёт `tick_physics()` напрямую —
# обычным вызовом метода, а не через движковую нотификацию. Логика ВНУТРИ
# метода не изменилась НИ НА СТРОКУ.
#
# `set_physics_process(false/true)` по-прежнему работает как «выключить тик
# этому бойцу» (Castle.absorb_unit/release_unit, стенды qa_guard/qa_formation
# и т.п.) — сам движковый флаг никуда не делся, GameManager проверяет его
# через `is_physics_processing()` перед вызовом. Меняется только КТО и КАК
# зовёт метод, а не семантика тумблера.
func tick_physics(delta: float, prof: bool = false, bm: bool = true,
		bonus_ver: int = -1) -> void:
	# РАЗБИВКА ПО ВЕТКАМ — только когда _Opt.profile_physics включён (qa_perf).
	# При выключенном флаге это одна проверка bool на вызов, без единого
	# обращения к Time.get_ticks_usec()
	# Флаг профиля — общий на всю армию и приходит аргументом: статическое поле
	# чужого скрипта, прочитанное на каждого бойца в каждом тике, стоит дороже
	# самой проверки (та же оговорка, что и у аргументов tick_visual)
	var _prof: bool = prof
	_prof_on = _prof
	# ── ОБЩИЕ НА АРМИЮ ВЕЛИЧИНЫ СНИМАЮТСЯ ОДИН РАЗ ЗА ТИК ──────────────────
	# Оба читались из ГОРЯЧИХ мест по нескольку раз на бойца: выключатель
	# пакетного шага — в _commit_step, версия бонусов — в кэше базовой скорости.
	# Оба одинаковы для всей армии и меняются реже кадра, а стоили обращения к
	# чужому объекту на каждое чтение
	_bm_on = bm
	if bonus_ver >= 0:
		_bonus_ver = bonus_ver
	# ── ТАКТ РАЗРЕШЕНИЯ НА ПЕРЕСТРОЕНИЕ (см. allow_reform_move) ────────────
	# В ФИЗИЧЕСКОМ тике, а не в визуальном: разрешение управляет ДВИЖЕНИЕМ, а
	# движение живёт здесь. Вдобавок стоящий в обороне боец гасит свой
	# визуальный тик сам (_proc_sleeping) — там таймер просто не тикал бы
	if _reform_permit > 0.0:
		_reform_permit -= delta
		if _reform_permit < 0.0:
			_reform_permit = 0.0
	# ── РАЗЛЁТ ОТ НАТИСКА ЕДЕТ ЗДЕСЬ ────────────────────────────────────────
	# В ФИЗИЧЕСКОМ тике и ДО всей прочей логики: отброшенный боец обязан
	# двигаться, что бы он ни делал — стоял, шёл или дрался. Раньше отброс был
	# мгновенным переносом и такта не требовал вовсе (см. apply_knockback)
	if _fling_vel.x != 0.0 or _fling_vel.z != 0.0:
		_tick_fling(delta)
	# ── ФАКТИЧЕСКОЕ СМЕЩЕНИЕ ЗА ТИК (см. moved_recently) ────────────────────
	# Считается ПЕРВЫМ делом, до всей логики движения: сравниваем, где боец
	# оказался, с тем, где он был на прошлом своём тике. Сюда попадает ВСЁ, что
	# его двигало, — и шаг, и расталкивание, и толчок конницы
	var _mv_now: int = _sample_movement()
	# СМЕНА ОТВЕТА — ЭТО СОБЫТИЕ, А НЕ РАСПИСАНИЕ. Пока поза догоняла признак
	# своим тактом (раз в anim_every визуальных тиков), боец до полусекунды шёл
	# в позе покоя или стоял в позе бега
	var _mv_want: bool = _mv_now < _mv_until_ms
	if _mv_want != _mv_moving:
		_mv_moving = _mv_want
		_pose_dirty = true
		if _proc_sleeping:
			_wake_process()
	# ── ЛЕЖАЩИЙ НЕ ДЕЛАЕТ НИЧЕГО (см. knock_down) ──────────────────────────
	# Ворота стоят ПОСЛЕ такта разлёта и окна смещения: сбитый ещё летит, и
	# лететь он обязан. Всё, что ниже — шаг, агро, удар, — ему недоступно
	if _down_until_ms > 0:
		if _mv_now < _down_until_ms:
			# Тело едет за бойцом, пока его несёт
			if _down_prop != null and (_fling_vel.x != 0.0 or _fling_vel.z != 0.0):
				GameManager.corpses.move_now(_down_prop, global_position)
			return
		_stand_up()
	var _t0: int
	# СЕТКУ ТРОГАЕМ, ТОЛЬКО ЕСЛИ СДВИНУЛИСЬ. Ячейка 1 м, поэтому смещение на
	# сантиметры ячейку сменить не может, а вызов update() всё равно считал
	# ключ и лез в два словаря. На тысяче бойцов, половина которых стоит в
	# строю или бьётся на месте, это тысяча лишних словарных операций в кадр
	if _prof: _t0 = Time.get_ticks_usec()
	# ТОЧКА ЧИТАЕТСЯ ОДИН РАЗ И ПО ДЕШЁВОМУ ПУТИ. global_position у Node3D —
	# не поле, а свойство: каждое чтение проверяет актуальность мировой матрицы
	# и при нужде пересобирает её ПО ЦЕПОЧКЕ РОДИТЕЛЕЙ. А пересобирать её есть
	# что: пакетный шаг только что записал координату. Локальная position —
	# обычное поле трансформа, и под неподвижным World она равна мировой
	# (см. _local_xform, предпосылка проверяется, а не принимается на веру)
	var gp: Vector3 = position if _local_xform else global_position
	# ── СТРОКА ПИШЕТСЯ КАЖДЫЙ ТИК, И ЭТО ДЕШЕВЛЕ ПРЕЖНЕГО ──────────────────
	# Здесь стояла проверка «сдвинулся больше 20 см» и вызов
	# unit_grid.update(self) — а тот собирал ключ Vector2i и лез в два словаря.
	# Плоская сетка (Фаза 2) собирается из строк ЦЕЛИКОМ раз в кадр
	# (GameManager._physics_process → army.rebuild_grid), поэтому поштучный учёт
	# не нужен вовсе: бойцу достаточно положить свою точку в столбцы.
	#
	# Один вызов наружу вместо одного вызова наружу — но без сборки ключа,
	# без словарей и без условия. Проверку «а сдвинулся ли я» убрали намеренно:
	# в Фазе 1 замерено, что даже пара чтений своих полей с одним сравнением
	# стоит +2.2 мс в кадре на пятнадцати тысячах, то есть условие здесь дороже
	# безусловной записи трёх чисел.
	#
	# Редкие величины (здоровье, характеристики, отряд) по-прежнему пишутся по
	# событию из тех мест, где они и меняются.
	# ── ПОЗА ПУБЛИКУЕТСЯ, ТОЛЬКО ЕСЛИ ОНА ИЗМЕНИЛАСЬ ───────────────────────
	# Прежний комментарий (он выше и оставлен как история) утверждал обратное:
	# «условие здесь дороже безусловной записи трёх чисел», и на чистом GDScript
	# это было ВЕРНО — запись стоила доли микросекунды. С переездом колонок в
	# C#-солвер цена изменилась на порядок: каждый вызов через границу языков
	# стоит ~2.4 мкс, и ветка grid_update стала второй по величине статьёй тика
	# (2.1 мс кадра на трёх тысячах).
	#
	# А писать почти всегда нечего. В плотном бою сотни бойцов стоят в
	# ATTACKING с нулевой скоростью: их точка, скорость и состояние не меняются
	# тиками подряд. Шесть сравнений своих же полей стоят около 0.1 мкс —
	# против 2.4 мкс перехода границы.
	#
	# Позицию при этом ведёт САМ СОЛВЕР (пакетный шаг и разбор наложения пишут
	# колонку напрямую), так что пропуск записи ничего не теряет: сравнение
	# ловит ровно те случаи, когда бойца сдвинуло что-то ДРУГОЕ — поштучный
	# _move_blocked, выход из гарнизона, телепорт стенда
	# ── ПОЗИЦИЯ УЧАСТВУЕТ В УСЛОВИИ, И УБИРАТЬ ЕЁ ОТТУДА НЕЛЬЗЯ ────────────
	# Пробовали: точка отправлялась только по метке _pose_force (её ставят все
	# места, где бойца двигает сам GDScript), а сравнение координат из условия
	# убиралось — в свалке оно срабатывает почти у всех, потому что
	# расталкивание двигает бойца каждый кадр, и координата уходила обратно
	# ТОМУ САМОМУ солверу, который её и записал.
	#
	# ЭТО СОЗДАЛО ЦЕЛЫЙ КЛАСС ОШИБОК. Позицию бойцу присваивают не только пять
	# помеченных мест: так делают стенды, спавн, сценарии — любой код, который
	# ставит `global_position` и не зовёт sync_row(). Раньше такая точка
	# доезжала до колонки сама, ближайшим тиком. Без сравнения она не доезжала
	# ВОВСЕ до истечения страховочного срока, а разбор наложения тем временем
	# читал колонку и утаскивал бойца обратно — в место, где его давно нет.
	# Поймал qa_squad (проверка 4): шесть врагов, поставленных стендом,
	# оказывались не там, куда их поставили, и приказ атаки не находил цели.
	#
	# Выигрыш при этом был в пределах разброса прогонов (0.2 мкс на вызов).
	# Размен «класс молчаливых ошибок за полмиллисекунды» — плохой размен
	if _pose_force or state != _sent_st 			or absf(gp.x - _sent_x) > POSE_EPS or absf(gp.z - _sent_z) > POSE_EPS 			or absf(velocity.x - _sent_vx) > POSE_EPS 			or absf(velocity.z - _sent_vz) > POSE_EPS:
		_pose_force = false
		# ── СМЕНА СОСТОЯНИЯ = СМЕНА ВНЕШНОСТИ, И ОНА СРОЧНАЯ ────────────────
		# Позы пересчитываются раз в ANIM_EVERY кадров визуального такта, а тот
		# ещё и шардирован: на большой армии между сменой состояния и сменой
		# картинки проходило до дюжины кадров. У бойца это незаметно (walk/idle
		# похожи), а у рабочего заметно в упор: он уже идёт от дерева к замку, а
		# нарисован всё ещё машущим топором, и бревно на спине появляется
		# позже. Признак состояния — единственное, что тут сравнивается, и оно
		# уже сравнивается строкой ниже: стоимость проверки нулевая
		if state != _sent_st:
			_wake_process()
		_sent_x = gp.x
		_sent_z = gp.z
		_sent_vx = velocity.x
		_sent_vz = velocity.z
		_sent_st = state
		# ПОЗА КЛАДЁТСЯ В ОЧЕРЕДЬ АВТОЗАГРУЗКИ, А НЕ УХОДИТ ЗА ГРАНИЦУ ЯЗЫКОВ:
		# весь список отдаётся солверу одним вызовом после обхода армии
		# (см. GameManager.queue_pose)
		# ── ВОРОТА ПАКЕТНОГО БОЯ ЕДУТ ВМЕСТЕ С ПОЗОЙ ───────────────────────
		# «Простой бой» — это отсутствие всего особенного: замка приказа игрока,
		# стойки, держащей место, бега, отхода, выхода из боя и одиночества вне
		# отряда (подтягивание рядов — механика ОТРЯДА, см. _should_pull_up).
		# Все эти условия боец и так проверяет в своём автомате; собрать из них
		# слово и положить в тот же массив, что и позу, стоит нескольких
		# сравнений и НИ ОДНОГО перехода границы
		# ── ВОРОТА СЧИТАЮТСЯ, ТОЛЬКО ЕСЛИ ИХ КТО-ТО ЧИТАЕТ ──────────────────
		# Их единственный потребитель — пакетный проход боя, а он выключен по
		# замеру (см. perf_config.batch_combat). Пока он выключен, это шесть
		# сравнений и ВЫЗОВ _effective_speed() на каждого бойца в каждом тике
		# ради двух чисел, которые никто не прочтёт
		var gate := 0
		var eff := 0.0
		if _Opt.batch_combat:
			if not target_lock and not _stance_holds_ground() and not sprinting 					and not retreating and not _disengaging and squad_id != 0 					and not _hold_goal_set:
				gate |= 1 << 14                 # F_ATK_SIMPLE
			if retreating: gate |= 1 << 1
			if sprinting:  gate |= 1 << 2
			eff = _effective_speed()
		GameManager.queue_pose(_soa, gp, velocity, state, gate, eff)
	if _prof: _Opt.prof_add("grid_update", Time.get_ticks_usec() - _t0)
	# Фактический ряд пересчитывается ТОЛЬКО у фаланги: вне обороны эта
	# механика не работает и лишнего скана сетки не делает
	if state != State.DEAD and _stance_holds_ground():
		if _prof: _t0 = Time.get_ticks_usec()
		_rank_timer -= delta
		if _rank_timer <= 0.0:
			_rank_timer = RANK_RECHECK
			_update_live_rank()
		if _prof: _Opt.prof_add("rank_recompute", Time.get_ticks_usec() - _t0)
	# ── ОТРЯД ВЕДЁТ МЕНЯ МАТРИЦЕЙ: СВОЕГО ШАГА НЕ ДЕЛАЮ ────────────────────
	# Пока признак стоит, положение бойцу считает GameManager._advance_matrices
	# одним шагом якоря на весь отряд (см. ArmySoA.advance_matrix). Здесь не
	# нужно ничего: ни направления, ни скорости, ни воды, ни ствола, ни чужого
	# строя, ни рельефа, ни записи координаты. Признак снимает тот же проход,
	# как только отряд перестаёт годиться для матрицы (враг рядом, ствол на
	# пути, кто-то ввязался в бой) — и боец в тот же кадр возвращается к
	# обычному пути, ничего не теряя: состояние и цель у него на месте
	if _matrix_driven:
		if _prof: _Opt.prof_add("matrix_skip", Time.get_ticks_usec() - _t0)
		return
	# ── ТЫЛОВОЙ НАПОР: ШАГ СЧИТАЕТ ЯДРО (этап D1) ───────────────────────────
	# Ранг >= 2 в дерущемся отряде: решений нет, есть давление к точке боя.
	# Заявку на шаг кладёт RearPressPass той же геометрией пакетного шага
	# (вода, стволы, чужой строй), пробуждение — событиями (упор, удар, смена
	# цели, аренда не продлена). Состояние и цель на месте — как у матрицы
	if (_rear_press or _auto_pilot) and state == State.ATTACKING:
		if _prof: _Opt.prof_add("rear_press_skip", Time.get_ticks_usec() - _t0)
		return
	# ── Я В ТЫЛУ СВАЛКИ: ПОДПИРАЮ ФРОНТ, А НЕ ПРОБИВАЮСЬ САМ ────────────────
	# Признак раздаёт отряд (GameManager._sweep_battle_lines). Состояние и цель
	# при этом сохраняются: как только передо мной освободится место, разметка
	# переведёт меня во фронт, и _process_attack подхватит бой с той же целью
	if _rear_line and state == State.ATTACKING:
		if _prof: _t0 = Time.get_ticks_usec()
		_rear_step(delta)
		if _prof: _Opt.prof_add("rear_step", Time.get_ticks_usec() - _t0)
		return
	if _prof: _t0 = Time.get_ticks_usec()
	match state:
		State.MOVING:
			_process_move(delta)
			if _prof: _Opt.prof_add("process_move", Time.get_ticks_usec() - _t0)
		State.ATTACKING:
			# ── ПАКЕТ МОГ ЗАКРЫТЬ ЭТОТ КАДР ЗА МЕНЯ ─────────────────────────
			# BatchCombat уже посчитал шаг подтягивания по колонкам и отметил
			# кадром только тех, кому нужен полный автомат (замер: пятая часть
			# состава в фазе контакта). Направление берётся из колонки — оно
			# нужно спрайту, а посчитано уже там
			if _atk_snooze:
				# Дремлет — таймер и стражу цели ведёт ядро (TickSnooze),
				# в интерпретаторный автомат не заходим вовсе
				pass
			elif _Opt.batch_combat and _soa >= 0 					and _soa < GameManager.atk_need.size() 					and GameManager.atk_need[_soa] == 0:
				var A2 = GameManager.army
				_facing = Vector3(A2.facing_x(_soa), 0.0, A2.facing_z(_soa))
			else:
				_process_attack(delta)
			if _prof: _Opt.prof_add("process_attack", Time.get_ticks_usec() - _t0)
		State.IDLE:
			velocity = Vector3.ZERO
			# ГЕЙТ ЗДЕСЬ, А НЕ ВНУТРИ ФУНКЦИИ (см. _check_auto_aggro): сам вызов
			# GDScript-функции стоит дороже, чем decrement+сравнение, а таймер
			# истекает раз в 0.5-2 с — почти все кадры вообще не должны заходить
			# внутрь. Безоружный (рабочий) или отходящий боец сюда не заходит
			# вовсе, ровно как раньше делали ранние return внутри функции
			if attack_damage > 0.0 and not retreating and not sprinting:
				_aggro_timer -= delta
				if _aggro_timer <= 0.0:
					# ОТРЯД УЖЕ ПОСМОТРЕЛ ЗА ВСЕХ (см. GameManager корид.):
					# в габаритах отряда плюс дальность его внимания чужих нет,
					# значит их нет и у каждого бойца. Таймер взводим сами —
					# иначе ветка входила бы каждый кадр
					if _clear_enemy:
						_aggro_timer = AGGRO_INTERVAL_CALM
					else:
						_check_auto_aggro()
			if _prof: _Opt.prof_add("check_auto_aggro", Time.get_ticks_usec() - _t0)
			# Смыкание рядов: передовой без соседа впереди подтягивается.
			# На бегу строй распущен — подтягивать нечего (страховка: бегущий
			# боец в норме в State.MOVING и сюда не заходит)
			if not sprinting and _stance_holds_ground():
				if _prof: _t0 = Time.get_ticks_usec()
				_phalanx_advance(delta)
				if _prof: _Opt.prof_add("phalanx_advance", Time.get_ticks_usec() - _t0)
		State.DEAD:
			velocity = Vector3.ZERO
	# ── РАЗБОР НАЛОЖЕНИЯ ЗДЕСЬ БОЛЬШЕ НЕ ЖИВЁТ ──────────────────────────────
	# Он стал ПАКЕТНЫМ (ArmySoA.batch_separation, зовётся из
	# GameManager._physics_process после обхода армии). Правило не изменилось
	# ни на йоту — изменилось место: вместо 2500 вызовов в кадр, каждый из
	# которых выходил в сетку через фасад и обратно, идёт один проход по
	# строкам с развёрнутым на месте сканом соседей. Замер: 3.71 мкс на вызов
	# против доли микросекунды на строку.
	#
	# Таймер тоже переехал в столбец (ArmySoA.sep_t): держать его на бойце
	# означало бы читать поле объекта из пакетного цикла
	# ЗДЕСЬ БОЛЬШЕ НЕТ НИЧЕГО СВЕРХ ЭТОГО. Раньше после match шли силовое
	# расталкивание союзников (с радиусами, коридорами и уступанием дороги) и
	# возврат на своё место в строю; вдвоём они и давали вечное дрожание (см.
	# «ПРОСТАЯ ОСТАНОВКА» в шапке файла). Обе механики удалены целиком, а не
	# отключены флагом: включать их обратно нечем и незачем.

## РАЗВЕСТИ СЕБЯ С СОЮЗНИКАМИ, залезшими в личный круг.
## Двигает ТОЛЬКО себя и только наружу; см. шапку у SEP_MIN_DIST
func _resolve_overlap() -> void:
	var gp := global_position
	var push: Vector3 = GameManager.unit_grid.ally_overlap(
		self, gp, SEP_MIN_DIST, SEP_MAX_STEP)
	if push.x == 0.0 and push.z == 0.0:
		return
	# ── ИДУЩЕГО ПО ПРИКАЗУ РАССТАЛКИВАНИЕ НЕ ОТБРАСЫВАЕТ НАЗАД ──────────────
	# Жалоба владельца: отряд, которому приказали сменить позицию, «застревает,
	# упершись в строй своих же копейщиков», и до точки не доходит.
	#
	# Союзники и так не блокируют шаг (_move_blocked проверяет только чужой строй
	# и стволы) — мешает именно эта поправка. В плотном строю боец получает её от
	# НЕСКОЛЬКИХ соседей сразу, и суммарный откат сопоставим с самим шагом:
	# идущий отталкивается от впереди стоящих ровно против своего курса, топчется
	# на месте и цели не достигает.
	#
	# Поэтому у бойца С ЖИВЫМ ПРИКАЗОМ из поправки вырезается составляющая
	# ПРОТИВ курса. Боковая остаётся целиком — это и есть «огибает коллизию»:
	# он расходится с соседями вбок и продолжает идти. Приход при этом
	# гарантирован по построению: продольная скорость больше не может стать
	# отрицательной, значит расстояние до цели монотонно убывает.
	#
	# Стоящих (IDLE, _settled) правило не касается вовсе: им расталкивание нужно
	# целиком, иначе плотный строй перестанет разбираться
	# ATTACKING сюда тоже входит: на подходе к цели боец идёт сквозь свои шеренги
	# ровно так же. Стоящий в контакте имеет velocity = 0, ветка его не заденет
	if state == State.MOVING or state == State.ATTACKING:
		var vx: float = velocity.x
		var vz: float = velocity.z
		var vlen: float = sqrt(vx * vx + vz * vz)
		if vlen > 0.001:
			var nx0: float = vx / vlen
			var nz0: float = vz / vlen
			var along: float = push.x * nx0 + push.z * nz0
			if along < 0.0:      # поправка тянет НАЗАД по курсу — срезаем её
				push.x -= nx0 * along
				push.z -= nz0 * along
				if absf(push.x) < 1e-5 and absf(push.z) < 1e-5:
					return
	# КРАЙ КАРТЫ. Зажим РАСШИРЕН текущей точкой: поправка вправе только не пускать
	# бойца ЗА край, но не вправе затаскивать внутрь того, кто уже стоит снаружи.
	# Простой clampf по пределам телепортировал такого бойца к борту одним кадром
	# (стенды qa_settle/qa_formation работают на площадках в 300-500 м от центра
	# карты — там это давало прыжки на сотни метров)
	var lx: float = GameManager.map_lim_x
	var lz: float = GameManager.map_lim_z
	var nx: float = clampf(gp.x + push.x, minf(-lx, gp.x), maxf(lx, gp.x))
	var nz: float = clampf(gp.z + push.z, minf(-lz, gp.z), maxf(lz, gp.z))
	# В воду не выдавливаем: оттуда боец сам не выйдет (см. slide_around_water)
	if GameManager.water_active and GameManager.is_water(nx, nz):
		return
	global_position = Vector3(nx, GameManager.get_terrain_height(nx, nz), nz)
	# Точку сдвинул GDScript — отправляем её в колонку немедленно
	_pose_force = true
	# Стоящий боец спит по картинке (set_process(false)) и своего нового места
	# сам не перерисует — общая отрисовка узнала бы о сдвиге только со следующим
	# приказом. Будим, но БЕЗ пометки позы: сдвинулась точка, а не внешность
	# (см. wake_for_lod)
	wake_for_lod()

func _exit_tree() -> void:
	_drop_down_prop()
	GameManager.unit_grid.remove(self)
	GameManager.unregister_unit(self)
	# Строку возвращаем в оборот. Признаки при этом гасятся, поэтому даже если
	# кто-то сохранил старый номер, строка честно ответит «координаты нет»
	if _soa >= 0:
		GameManager.army.release(_soa)
		_soa = -1
	if _far_registered:
		GameManager.unregister_far(self)
	# Полоска здоровья — тоже слот в общем слое, а не ребёнок бойца: без явного
	# снятия она осталась бы висеть над пустым местом (тот же случай, что и с
	# метками выделения строкой ниже)
	GameManager.hp_bars.unregister(self)
	# Метки выделения теперь не дети юнита и сами с ним не исчезнут: слот надо
	# вернуть явно, иначе кольцо останется висеть над пустым местом.
	# Снимаем БЕЗУСЛОВНО, а не `if _selected`: снятие идемпотентно, а флаг —
	# всего лишь второе описание того же факта, и разойтись эти два описания
	# уже могут (гарнизон, перевыделение в кадре гибели). Цена ошибки —
	# висящий слот и ссылка на освобождённый объект в словаре рендерера
	GameManager.sel_decals.unregister(self)
	# ПРИЦЕЛЬНАЯ ПОДСВЕТКА — ТРЕТИЙ СЛОЙ, И ЕГО ЗДЕСЬ НЕ ЧИСТИЛИ ВОВСЕ.
	# Набор красных колец задаётся опросом курсора раз в CURSOR_POLL, а вырезают
	# подсвеченный отряд куда быстрее: между двумя опросами в _hover_slot
	# накапливались освобождённые объекты, и покадровый обход колец падал на них
	# с «Trying to assign invalid previously freed instance» (отчётный стек
	# SelectionDecalRenderer.gd:280)
	GameManager.sel_decals.drop_hover(self)
	# Выбывшего бойца сразу вычёркиваем из отряда: пустой отряд расформируется
	# сам, и в реестре не копятся ссылки на удалённые узлы
	GameManager.remove_from_squad(self)

# ─────────────────────────────────────────────────────────────────────────────
# ЗДЕСЬ БЫЛИ ВОЗВРАТ В СТРОЙ (_reform_step) И РАСТАЛКИВАНИЕ (_apply_separation)
#
# Обе механики удалены вместе со всей своей обвязкой: коридором для проходящих
# союзников, поводком от точки приказа, броском обратно в слот. Они лечили
# последствия друг друга и в сумме давали ровно ту болезнь, ради которой были
# написаны, — вечное подрагивание стоящего отряда.
#
# СКВОЗНОЙ ПРОХОД СОЮЗНИКОВ ТЕПЕРЬ БЕСПЛАТЕН: раздвигать шеренгу не нужно,
# проходящий просто идёт СКВОЗЬ неё, и строй остаётся ровно таким, каким стоял.
# Смыкать после этого тоже нечего.
#
# Строй после ПОТЕРЬ по-прежнему подравнивается — но не здесь, а разом на весь
# отряд и по событию: GameManager.squad_close_ranks() выдаёт бойцам новые точки
# обычным приказом движения. Это редкая перестановка с остывом, а не сила,
# действующая каждый кадр.
# ─────────────────────────────────────────────────────────────────────────────
# ── СКОРОСТИ: ОДНА ХОДЬБА + БЕГ ──────────────────────────────────────────────
# ЗДЕСЬ БЫЛ MARCH_SPEED_FACTOR (0.5) — «марш строем идёт вполовину скорости».
# Промежуточный режим убран по заказу владельца: стандартная скорость ровно
# одна — walk_speed из конфига (move_speed юнита). Флаг march_slow сохранён,
# он по-прежнему означает «держать строй жёстко» и переносится в разметку
# отряда, но НА СКОРОСТЬ БОЛЬШЕ НЕ ВЛИЯЕТ.
#
# Единственный нестандартный темп — БЕГ по двойному ПКМ (см. sprinting).
## Множитель бега: +40% к базовой ходьбе
## Заказ владельца — ровно +35%. Было 1.4; число уменьшено вместе с введением
## SPRINT_DAMAGE_MULT: бег стал не только быстрым, но и дорогим, и цена обязана
## соответствовать выигрышу
const SPRINT_SPEED_FACTOR := 1.35

## ── ЦЕНА БЕГА: ПО БЕГУЩЕМУ БЬЮТ БОЛЬНЕЕ ────────────────────────────────────
## Заказ владельца: +35% входящего урона, пока боец бежит. Раньше цена бега
## была только косвенной («не ввязывается в бой, копья подняты»), и двойной ПКМ
## оставался ходом без единого минуса — им имело смысл двигаться ВСЕГДА.
##
## Множитель применяется ПОСЛЕ вычета защиты и после долевых снижений (щит):
## это не пробитие брони, а открытость бегущего — он не прикрыт и не смотрит
## по сторонам. Порядок важен, иначе множитель съедала бы плоская защита
const SPRINT_DAMAGE_MULT := 1.35
## Прибавка отстающим, когда первые ряды уже встали на места (см.
## GameManager.squad_note_arrival). +15%: хвост подтягивается заметно быстрее,
## но не срывается в спринт и не проскакивает свой слот
const CATCH_UP_FACTOR := 1.15
## ИСТОРИЧЕСКОЕ ЧИСЛО, ОСТАВЛЕНО ТОЛЬКО ДЛЯ СТЕНДОВ. Живой множитель скорости
## стойки теперь лежит в балансной таблице: unit_stats_config.STANCES
## [stance]["move_speed_mult"] (у обороны 0.65 — заказ владельца, −35%)
const PHALANX_ATTACK_FACTOR := 0.75

# Эффективная скорость с учётом бонусов кузницы (сапоги/броня) и марша строем
## БАЗОВАЯ скорость (собственная + кузница + выслуга), без множителей шага.
## Кэшируется по номеру версии таблицы бонусов: слагаемое от кузницы стоит трёх
## словарных поисков в автозагрузке, а меняется считанные разы за партию, тогда
## как читалось на каждого идущего бойца в каждом кадре (замер: ветка mv_speed —
## 2.4 мкс на юнита). vet_speed меняется при повышении отряда, поэтому входит
## в ключ кэша наравне с версией
## В ключ кэша входят ВСЕ три слагаемых, а не только версия таблицы бонусов:
## move_speed рабочий меняет на ходу (пустой/гружёный, см. Worker), vet_speed —
## при повышении отряда. Кэшировать по одной лишь версии значило бы заморозить
## рабочего на той скорости, с которой он вышел из замка
var _spd_cache: float = -1.0
var _spd_version: int = -1
var _spd_vet: float   = -1.0
var _spd_own: float   = -1.0

## Снимок общих величин тика (см. tick_physics): чтение полей автозагрузки шло
## на каждый расчёт скорости и на каждый шаг каждого идущего бойца
var _bm_on: bool = true
var _bonus_ver: int = -1

func _base_speed() -> float:
	var ver: int = _bonus_ver if _bonus_ver >= 0 else GameManager.bonus_version
	if _spd_version == ver and _spd_vet == vet_speed and _spd_own == move_speed:
		return _spd_cache
	_spd_cache = maxf(0.5, move_speed
		+ GameManager.unit_bonus(faction, stat_id, "bonus_speed") + vet_speed)
	_spd_version = ver
	_spd_vet     = vet_speed
	_spd_own     = move_speed
	return _spd_cache

## ОТРЯД ПОДТЯГИВАЕТ ХВОСТ. Флаг РАЗДАЁТ отряд в момент переключения
## (GameManager._push_catch_up), а не опрашивает каждый боец каждый кадр:
## переключается он ровно дважды за марш, а опрашивался 60 раз в секунду
## каждым идущим — межобъектный вызов со словарным поиском на ровном месте
var _catch_up: bool = false

## ЗДЕСЬ БЫЛ КЭШ ГОТОВОЙ СКОРОСТИ (множители свёрнуты в целочисленный ключ).
## Замер на 5000 бойцов: ветка mv_speed 0.73 → 0.70 мкс, то есть в пределах
## разброса. Множителей всего три, и сложить их дешевле, чем собрать и сверить
## ключ, — кэш убран, чтобы не тащить лишнюю точку рассинхронизации
func _effective_speed() -> float:
	# Проверка кэша базовой скорости — здесь же, без отдельного вызова:
	# в горячем пути сам вызов GDScript-функции стоит дороже трёх сравнений
	var s: float = _spd_cache
	if _spd_version != GameManager.bonus_version or _spd_vet != vet_speed \
			or _spd_own != move_speed:
		s = _base_speed()
	# БЕГ. Единственный нестандартный темп; включается двойным ПКМ и гаснет
	# по прибытии (см. sprinting / _arrive_at_target)
	if sprinting and state == State.MOVING:
		s *= SPRINT_SPEED_FACTOR
	# ── РАЗГОН КОННИЦЫ ─────────────────────────────────────────────────────
	# Только в подходе к цели (State.ATTACKING): на марше по пустому полю
	# разгоняться не на кого, а флаг там и не взводится (см. _process_attack).
	# Штраф стойки ниже применяется ПОСЛЕ и к разгону тоже — фаланга с копьями
	# наперевес не может «разогнаться», даже если ей выдать эти числа
	if is_charging and state == State.ATTACKING:
		s *= charge_speed_mult
	# ЗАМЕДЛЕНИЕ ОТ СТЕНЫ КОПИЙ (спринт 18): −30 % на SPEAR_WALL_SLOW_SEC
	if _slow_until_ms > now_ms:
		s *= _slow_mult
	# ── ШТРАФ СТОЙКИ. ПРИМЕНЯЕТСЯ ВСЕГДА, В ТОМ ЧИСЛЕ НА БЕГУ ───────────────
	# Множитель берётся из конфига (STANCES.move_speed_mult), а не из константы:
	# это балансное число, и место ему в балансной таблице.
	#
	# Было `not sprinting and ...` — то есть бегущий боец штраф стойки не платил
	# вовсе и разгонялся до 1.4 базовой. Со щитом наизготовку это давало
	# скорость ВЫШЕ обычной ходьбы: строй с опущенными копьями обгонял налегке
	# идущую пехоту, а лучники, считающие упреждение по скорости цели, стреляли
	# мимо. Теперь стойка режет скорость до всех прочих множителей: 1.4 × 0.65 =
	# 0.91, то есть бегущая фаланга всё равно медленнее обычного шага.
	if state != State.IDLE:
		var stance_mult: float = _UStats.stance_stat(stance, "move_speed_mult", 1.0)
		if stance_mult != 1.0:
			s *= stance_mult
	# ПОДТЯГИВАНИЕ ХВОСТА: первые ряды уже на местах — отстающим прибавка
	if _catch_up and state == State.MOVING:
		s *= CATCH_UP_FACTOR
	return s


## ── ЗАЯВИТЬ ШАГ, А НЕ ПРОВОДИТЬ ЕГО ─────────────────────────────────────────
## Единая точка для всех горячих путей движения: марш, подход к цели и ход
## стены. Боец кладёт желаемое смещение в строку, а геометрию (вода, ствол,
## чужой строй, край карты, рельеф, запись координаты) делает один пакетный
## проход по колонкам после обхода армии.
##
## Запасной путь обязателен: строки может не быть (боец вне ядра армии — так
## бывает в стендах и до первого тика), и тогда шаг проводится по-старому.
func _commit_step(step: Vector3) -> void:
	if _soa >= 0 and _bm_on:
		# Слово признаков складывается ЛИТЕРАЛЬНЫМИ СДВИГАМИ, а не через
		# ArmySoA.F_*: обращение к константе чужого скрипта в горячем месте
		# стоит дороже самой арифметики. Сходимость номеров сторожит qa_army A1
		var sfl := 0
		if retreating:          sfl |= 1 << 1     # F_RETREATING
		if sprinting:           sfl |= 1 << 2     # F_SPRINTING
		if _clear_trunk:        sfl |= 1 << 7     # F_CLEAR_TRUNK
		if _clear_enemy:        sfl |= 1 << 8     # F_CLEAR_ENEMY
		if _trunk_ignore > 0.0: sfl |= 1 << 12    # F_TRUNK_IGNORE
		# ПОСЛАБЛЕНИЕ ПРИКАЗА ИГРОКА ЕДЕТ ЗДЕСЬ, А НЕ ТОЛЬКО В _move_blocked.
		# Горячий путь шага — ПАКЕТНЫЙ (очередь → ArmyCore.BatchStep), и
		# поштучный _move_blocked ниже это лишь запасная дорога для бойца без
		# строки. Правка, сделанная только там, на живой армии не работает
		# вовсе: замерено стендом qa_disengage D2 — окружённый боец проходил
		# 0.00 м за секунду после приказа
		# ── ТЕМ ЖЕ БИТОМ ЕДЕТ И БИЛЕТ ОТХОДА (см. _retreat_pass) ───────────
		# Отдельного признака заводить не нужно: смысл у обоих один — «этому
		# бойцу разрешено выбраться из тел, в которых он уже стоит». Разные
		# поводы, одно правило и один бит в колонке
		if _forced_move_pass() or _retreat_pass() or breaks_bodies:
			sfl |= 1 << 17                        # F_ORDER_PASS
		# ЗАЯВКА КЛАДЁТСЯ В ОЧЕРЕДЬ АВТОЗАГРУЗКИ, А НЕ УХОДИТ ЗА ГРАНИЦУ ЯЗЫКОВ.
		# Прямой вызов солвера — это переход границы на КАЖДОГО шагающего
		# (~2.2 мкс); очередь стоит одну запись в массив, а весь список уходит
		# в солвер одним вызовом за кадр (см. GameManager.queue_step)
		GameManager.queue_step(_soa, step.x, step.z, sfl)
	else:
		_move_blocked(step)

# Шаг с УЧЁТОМ ЧУЖОГО СТРОЯ: сквозь вражескую шеренгу пройти нельзя.
# Физические маски намеренно остаются нулевыми (см. README — включённые
# маски давали дрожание на грунте); блокировка считается по той же
# пространственной сетке, что и расталкивание.
func _move_blocked(step: Vector3) -> void:
	if step.length_squared() < 1e-8:
		return
	# ПОДРОБНЫЙ ПРОФИЛЬ ШАГА (см. perf_config.profile_physics). Ветка process_move
	# в общей разбивке — один сплошной блок на ~14 мкс, и он ничего не говорит о
	# том, что именно столько стоит: вода, ствол дерева, чужой строй или сама
	# запись global_position. Здесь тот же приём, что и в tick_physics, — при
	# выключенном флаге это одна проверка bool
	# Флаг профиля снят один раз на весь тик (см. tick_physics): чтение поля
	# дешевле обращения к статике другого скрипта, а тут оно было дважды за шаг
	var _prof: bool = _prof_on
	var _t: int
	if _prof: _t = Time.get_ticks_usec()
	# ТЕКУЩАЯ ТОЧКА ЧИТАЕТСЯ ОДИН РАЗ. global_position у Node3D — не поле, а
	# свойство с проверкой актуальности мировой матрицы; в этой функции оно
	# читалось до четырёх раз за шаг, хотя между чтениями ничего не менялось
	var cur := global_position
	var np := cur + step
	# ВОДА НЕПРОХОДИМА: идём ВДОЛЬ берега по касательной, а не упираемся в него.
	# ОЗЕРА НА КАРТЕ МОЖЕТ НЕ БЫТЬ ВОВСЕ (GameManager.water_active): сейчас так и
	# есть, и два вызова наружу ради ответа «нет» — чистая переплата
	if GameManager.water_active and GameManager.is_water(np.x, np.z):
		if _prof: _Opt.prof_add("mb_water", Time.get_ticks_usec() - _t)
		step = GameManager.slide_around_water(cur, step)
		if step.length_squared() < 1e-8:
			return
		np = cur + step
	elif _prof:
		_Opt.prof_add("mb_water", Time.get_ticks_usec() - _t)
	# СКАЛА (спринт 18): скользим вдоль обрыва, как в ядре (BatchMoveRows)
	if GameManager.cliff_cells > 0 and GameManager.is_cliff(np.x, np.z) 			and not GameManager.is_cliff(cur.x, cur.z):
		# По касательной с сохранением длины (см. ArmyCore.BatchMoveRows);
		# стоящий на скале вправе с неё уйти — блок только на вход
		var t := Vector3(-step.z, 0.0, step.x)
		if (get_instance_id() & 1) != 0:
			t = -t
		if not GameManager.is_cliff(cur.x + t.x, cur.z + t.z):
			step = t
		elif not GameManager.is_cliff(cur.x - t.x, cur.z - t.z):
			step = -t
		else:
			return
		np = cur + step
	# ── СТВОЛ ДЕРЕВА ОБХОДИМ ──────────────────────────────────────────────────
	# Сквозь дерево больше не ходят. Обход — скольжением по касательной, как и
	# вдоль берега: убираем из шага составляющую «в ствол», боковая остаётся,
	# и юнит аккуратно обтекает комель, не останавливаясь и не дёргаясь.
	# Радиус — только комель (ResourceNode.TRUNK_RADIUS): сквозь крону ходят
	# свободно, иначе лес стал бы сплошной стеной.
	#
	# Отходящему в замок можно всё (см. ниже про вражеский строй), но дерево —
	# не противник, а геометрия: его обходят и при отступлении
	#
	# ОТРЯД УЖЕ ОТВЕТИЛ ЗА ВСЕХ. Если коридор отряда чист от стволов
	# (GameManager._recalc_corridor), вызова наружу не делается вовсе
	#
	# ЗДЕСЬ ПРОБОВАЛСЯ ЕЩЁ ОДИН РУБЕЖ — личный ответ бойца по своей клетке 4×4 м
	# («деревья не ходят, пока не вышел из клетки — не спрашивай»). На 5000
	# бойцов он не дал НИЧЕГО: ветка mb_trunk 1.14 мкс с ним и 1.14 без. Причина
	# видна из замера — на карте с лесом блок 3×3 клеток почти всегда содержит
	# дерево, и кэш отвечал «не знаю» ровно там, где он был нужен. Убран вместе
	# с механикой сброса (поколение реестра стволов): держать взведённый
	# инвалидатор ради нулевой выгоды дороже, чем его нет
	if _prof: _t = Time.get_ticks_usec()
	var trunk: Vector3 = Vector3.ZERO
	# _trunk_ignore — боец признан наматывающим круги (см. STUCK_CHECK_SEC):
	# на несколько секунд стволы для него не существуют, и он выходит к строю
	if not _clear_trunk and _trunk_ignore <= 0.0:
		trunk = GameManager.trunk_block(np.x, np.z, TRUNK_CLEARANCE)
	if _prof: _Opt.prof_add("mb_trunk", Time.get_ticks_usec() - _t)
	if trunk.length_squared() > 1e-8:
		# ОБХОД, А НЕ УПОР. Простое выталкивание наружу (np += trunk) делает из
		# дерева СТЕНУ: юнит каждый кадр шагает в ствол, его выпихивает обратно,
		# и он навсегда замирает у комля — замер показал остановку ровно на
		# границе ствола. Поэтому сначала убираем из шага составляющую «внутрь»,
		# оставляя касательную: юнит продолжает движение, огибая комель
		var n := trunk.normalized()          # от центра ствола наружу
		var speed: float = step.length()
		var into: float = step.dot(-n)       # насколько шаг идёт В ствол
		if into > 0.0:
			step += n * into
		# ЛОБОВОЙ ПОДХОД НАДО ОТКЛОНИТЬ, А НЕ ОБНУЛИТЬ. Если идти точно в центр
		# ствола, вычитание составляющей «внутрь» съедает шаг ЦЕЛИКОМ — юнит
		# упирается в комель и стоит там вечно (замер: остановка на 0.60 м от
		# центра, приказ не выполнен). Поэтому вырожденный случай разворачиваем
		# по касательной: юнит соскальзывает вбок и огибает дерево.
		# Сторона выбирается детерминированно — по своему id, чтобы соседи
		# расходились в РАЗНЫЕ стороны и не собирались в одну очередь
		if step.length() < speed * 0.2:
			var tang := Vector3(-n.z, 0.0, n.x)
			var side: float = _side_sign
			step = tang * (side * speed)
		np = cur + step
		# Остаточное проникновение (вошли боком) выдавливаем наружу
		var again: Vector3 = GameManager.trunk_block(np.x, np.z, TRUNK_CLEARANCE)
		if again.length_squared() > 1e-8:
			np += again
			step = np - cur
		if step.length_squared() < 1e-8:
			return
	# ОТХОДЯЩИЙ ПРОХОДИТ НАСКВОЗЬ. Иначе отряд, которому перекрыли дорогу к
	# замку, вечно тёрся бы боком о вражескую шеренгу вместо отхода: блокировка
	# строем и есть та «застревающая в юнитах» помеха из задания
	#
	# И ЗДЕСЬ ОТРЯД ОТВЕТИЛ ЗА ВСЕХ: чужих в габаритах отряда нет — значит, нет
	# их и у каждого его бойца (см. GameManager._recalc_corridor)
	# ── БЕГУЩИЙ БОЛЬШЕ НЕ ПРОХОДИТ СКВОЗЬ ТЕЛА (жалоба владельца) ───────────
	# Здесь было `not sprinting` — то есть бегущий отряд игнорировал чужой строй
	# целиком. Для игрока это читалось как «пробежать мимо, не ввязываясь», а вот
	# у ИИ бегом обходят фланг мечники (EnemyAI ROLE_FLANK), и на экране они
	# просто проходили СКВОЗЬ шеренгу копейщиков, как сквозь пустое место.
	#
	# Разделяем два разных смысла, которые раньше были склеены в один флаг:
	#   • «не ввязываться в бой» — остаётся за бегом (авто-агро, перехват марша
	#     и ответный удар по-прежнему выключены, см. пять ворот с `not sprinting`);
	#   • «проходить сквозь людей» — снято. Бегущий упирается в строй и обтекает
	#     его вдоль, как любой другой.
	# ── СКВОЗНОГО ПРОХОДА У ОТХОДА БОЛЬШЕ НЕТ ──────────────────────────────
	# Он был последним, и он же был жалобой владельца: отряд ИИ, решивший уйти
	# в замок, шёл домой ПО ПРЯМОЙ и проходил сквозь фалангу копейщиков, как
	# призрак. Замер qa_mega_battle B2-3: 141 отходящий рыцарь из 151. Обычным
	# приказом сквозь строй не проходят вовсе (B2-1: 0 из 495) — дыра была
	# ровно одна. Разбор и довод «почему это не создаёт вечного трения» — у
	# того же места в csharp/ArmyCore.cs (горячий путь идёт ЧЕРЕЗ НЕГО, а здесь
	# запасная дорога, и правило обязано совпадать в обеих)
	if _prof: _t = Time.get_ticks_usec()
	var block: Vector3 = Vector3.ZERO
	# БИЛЕТ ПРОХОДА СУЖАЕТ ТЕЛО ДО ЯДРА, А НЕ СНИМАЕТ ЕГО (см. PASS_CORE_FRAC
	# и ArmyCore.PassCoreFrac — правило обязано совпадать в обеих дорогах)
	var brad: float = BLOCK_RADIUS
	var pass_on: bool = _forced_move_pass() or _retreat_pass()
	if pass_on:
		brad = BLOCK_RADIUS * PASS_CORE_FRAC
	if not _clear_enemy:
		block = GameManager.unit_grid.enemy_block(self, np, brad, pass_on)
	if _prof: _Opt.prof_add("mb_enemyblock", Time.get_ticks_usec() - _t)
	if block.length_squared() > 1e-8:
		# УПЁРЛИСЬ ВО ВРАЖЕСКИЙ СТРОЙ. Отмечаем это: идущий отряд обязан
		# ВСТУПИТЬ В БОЙ, а не обтекать чужую шеренгу боком (см. _process_move).
		# Раньше здесь было только скольжение вдоль строя, и марширующая колонна
		# честно просачивалась мимо дерущейся пехоты, ни разу не ударив
		_enemy_contact = true
		# ── БЕГУЩИЙ НАЛЕТЕЛ НА СТЕНУ КОПИЙ (спринт 18) ─────────────────────
		# Раз за забег: копейщик в «Защите» со «Стеной копий», стоящий лицом к
		# набегающему, встречает его так же, как конницу (spear_wall_strike)
		if sprinting and not _wall_struck and step.length_squared() > 1e-10:
			_wall_struck = true
			var wb: Node3D = GameManager.unit_grid.enemy_at(np, LOCK_BLOCKER_RANGE + BLOCK_RADIUS, faction)
			if wb != null and is_instance_valid(wb) and wb is Unit:
				var wu := wb as Unit
				if wu.spear_wall_active() and wu._faces_charge(step.normalized()):
					wu.spear_wall_strike(self)
					return
		# Скользим ВДОЛЬ вражеской шеренги: убираем составляющую «внутрь» строя
		var n := block.normalized()
		var full_len: float = step.length()
		if sprinting:
			# ── БЕГУЩИЙ ОБХОДИТ СТРОЙ, А НЕ УПИРАЕТСЯ В НЕГО ────────────────
			# Шаг РАЗВОРАЧИВАЕТСЯ по касательной с СОХРАНЕНИЕМ ДЛИНЫ, а не просто
			# теряет составляющую «внутрь». Разница решает: обрезка оставляет
			# бойцу, идущему почти в лоб, считанные сантиметры вбок, и он ползёт
			# вдоль шеренги со скоростью пары см/с — на стенде из четырёх бегущих
			# мимо одного тела за семь секунд проходили двое. С разворотом он
			# обходит на полной скорости и возвращается на курс, как только тело
			# перестаёт быть между ним и целью.
			#
			# Сторона — та, куда шаг И ТАК тянет; строго лобовой случай (боковой
			# составляющей почти нет) разводится по чётности id, чтобы двое
			# бегущих рядом расходились, а не толкались в одну сторону
			var tang := Vector3(-n.z, 0.0, n.x)
			var lat: float = tang.dot(step)
			var s: float
			if absf(lat) < full_len * 0.15:
				s = _side_sign
			else:
				s = 1.0 if lat > 0.0 else -1.0
			step = tang * (s * full_len)
			np = cur + step
			# Второго прохода ПОЛНЫМ радиусом здесь нет НАМЕРЕННО: скольжение
			# вдоль строя оставляет бойца на прежнем расстоянии от тел, и
			# проверка отменяла бы обход целиком. Но касательная считается от
			# СУММЫ нормалей и в рваной шеренге ведёт внутрь соседнего тела —
			# поэтому второй проход есть, по ЯДРУ тела (та же оговорка, что в
			# ArmyCore.BatchMoveRows)
			if GameManager.unit_grid.enemy_block(self, np,
					BLOCK_RADIUS * PASS_CORE_FRAC).length_squared() > 1e-8:
				return
		else:
			# Скользим ВДОЛЬ вражеской шеренги: убираем составляющую «внутрь».
			# n смотрит ОТ тела наружу, поэтому «внутрь» — это into < 0; ветка
			# для всех остальных снимает НАРУЖНУЮ (into > 0) и шаг внутрь
			# оставляет, отчего второй проход его блокирует и боец встаёт —
			# для идущего пехотинца это и есть «упёрся — дерись», не трогать.
			# Под билетом прохода снимается внутренняя: билет заведён, чтобы
			# ВЫБРАТЬСЯ, и обход одного тела ему обязан удаваться (то же
			# правило в ArmyCore.BatchMoveRows, горячий путь)
			var into := step.dot(n)
			if pass_on:
				# В лоб — выбираем сторону, как бегущий: иначе касательная нулевая
				# и боец топчется на границе ядра (см. ArmyCore.BatchMoveRows)
				var tang_p := Vector3(-n.z, 0.0, n.x)
				var lat_p: float = step.dot(tang_p)
				if absf(lat_p) < full_len * 0.15:
					var sgn: float = 1.0 if (get_instance_id() & 1) == 0 else -1.0
					step = tang_p * (sgn * full_len)
					into = 0.0
				if into < 0.0:
					step -= n * into
				# И чуть наружу: нормаль считана в новой точке, касательная
				# через неё проходит на миллиметры ближе к телу, чем стоит боец
				# (см. ArmyCore.PassSlideOut)
				step += n * (full_len * PASS_SLIDE_OUT)
			elif into > 0.0:
				step -= n * into
			# Шаг обнулился целиком — идём строго в лоб. Для шагающего это
			# правильный ответ «встань»: контакт со строем и означает «дерись»,
			# _enemy_contact выше уже взведён, перехват сделает остальное
			if step.length_squared() < 1e-8:
				return
			np = cur + step
			# Второй проход: если и боковой шаг упирается — стоим вплотную
			if GameManager.unit_grid.enemy_block(self, np, brad, pass_on).length_squared() > 1e-8:
				return
	# КРАЙ МИРА НЕПРОХОДИМ: за бортик карты не выходит никто.
	# Зажим считаем ЗДЕСЬ, по готовым пределам (GameManager.map_lim_x/z), а не
	# вызовом clamp_to_map: тот возвращает Vector2, то есть на каждый шаг
	# каждого бойца приходился межобъектный вызов ради двух clampf
	if _prof: _t = Time.get_ticks_usec()
	if GameManager.world_bounds_enabled:
		var lx: float = GameManager.map_lim_x
		var lz: float = GameManager.map_lim_z
		np.x = clampf(np.x, -lx, lx)
		np.z = clampf(np.z, -lz, lz)
	# ── ВЫСОТА РЕЛЬЕФА — НЕ КАЖДЫЙ КАДР ──────────────────────────────────────
	# Main.get_terrain_height — это два вызова наружу и ТРИ синуса. При этом
	# рельеф пологий: самая короткая гармоника имеет длину волны около 13 м,
	# и на четверти метра пути высота меняется меньше чем на сантиметр —
	# незаметно даже вплотную. Боец на марше проходит четверть метра примерно
	# за десяток кадров, то есть девять пересчётов из десяти были лишними.
	# Кэш привязан к ТОЧКЕ замера, поэтому телепортация (выход из гарнизона,
	# отладочный перенос) сбрасывает его сама — расстояние сразу больше порога
	var tdx: float = np.x - _th_x
	var tdz: float = np.z - _th_z
	if tdx * tdx + tdz * tdz > TERRAIN_RECHECK_SQ:
		_th_x = np.x
		_th_z = np.z
		_th_y = GameManager.get_terrain_height(np.x, np.z)
	np.y = _th_y
	# ── ЗАПИСЬ ЛОКАЛЬНОГО ТРАНСФОРМА, А НЕ МИРОВОГО ────────────────────────
	# Замер (qa_soa_floor F3/F4, 15000): `position` — 0.10 мкс на бойца,
	# `global_position` — 0.23 мкс. Разница в 1.9 мс кадра берётся из того, что
	# мировая запись сначала переводит точку в систему родителя.
	# Числа при этом ОДИНАКОВЫ: весь контент карты живёт под узлом World с
	# нулевой и никогда не меняющейся трансформацией (см. Main._ready), то есть
	# локальные координаты бойца и есть мировые. Предпосылка не принимается на
	# веру — _local_xform проверяет её у своего родителя (см. _check_local_xform)
	if _local_xform:
		position = np
	else:
		global_position = np
	# Точку сдвинул GDScript — отправляем её в колонку немедленно, не дожидаясь,
	# пока сравнение координат в tick_physics заметит расхождение
	_pose_force = true
	if _prof: _Opt.prof_add("mb_commit", Time.get_ticks_usec() - _t)

## Шаг по земле, после которого высота рельефа пересчитывается заново.
## (0.25 м)²; на этой дистанции ошибка высоты — меньше сантиметра
const TERRAIN_RECHECK_SQ := 0.0625

# ── ШАГ ТЫЛОВОГО БОЙЦА ───────────────────────────────────────────────────────
# Глубина одного ряда в свалке. Меньше PHALANX_GAP тыл не поджимается — иначе
# задние вдавливаются в спины передних и разбор наложения гоняет их обратно
const REAR_RANK_DEPTH := 0.85
## Допуск: пока я не дальше своего места больше чем на это, я просто стою
const REAR_SLACK := 0.35
## Как часто тыловой боец всё-таки смотрит, не оказался ли враг под носом.
## Вчетверо реже «горячего» интервала агро: тыл никуда не спешит, а полная
## цена этого скана — как раз то, ради чего он и уходил с обычного пути
const REAR_SCAN_SEC := 0.4
var _rear_scan_t: float = 0.0

## Тыловой боец: подпирает фронт и НИЧЕГО не сканирует.
##
## Чего здесь намеренно нет по сравнению с обычным шагом: воды, стволов, чужого
## строя, флангового обхода, подтягивания рядов и выбора цели. Всё это либо
## бессмысленно (передо мной свои — в чужой строй я упереться не могу), либо
## уже решено отрядом. Остаётся арифметика, зажим по карте и запись координаты.
##
## СТОЯЩИЙ ТЫЛ НЕ ПИШЕТ КООРДИНАТУ ВОВСЕ — в плотной свалке фронт почти не
## двигается, и это самый частый случай: ветка выходит на первом же сравнении.
func _rear_step(delta: float) -> void:
	# ── ВЫХОД ИЗ ТЫЛА, КОГДА БОЯ БОЛЬШЕ НЕТ ─────────────────────────────────
	# Тыловой боец не заходит в боевой автомат вовсе — в этом вся экономия, — и
	# ровно поэтому он не замечает, что цель погибла: приказ на марш, ждавший
	# конца боя, не подхватывается, смыкание не запускается, из боя никто не
	# выходит. Боец остаётся стоять в ATTACKING навсегда. Замер поймал это в
	# лоб: qa_disengage A4 «отряд реально ушёл» дал 0 из 6.
	# Пустая цель — единственный признак, который тут нужен, и стоит он одно
	# сравнение; дальше боец в том же кадре возвращается на полный путь
	if attack_target == null:
		_rear_line = false
		_process_attack(delta)
		return
	# ФАЙЛ УПЁРСЯ ВО ВРАГА — СТОЮ. Ровно два состояния, и второго механизма тут
	# не нужно: замена павшего получается сама. Выбьют переднего в моей колонне —
	# колонна перестанет числиться в контакте, отряд на ближайшей разметке снимет
	# _rear_hold, и вся колонна шагнёт вперёд, пока новый передний не достанет до
	# противника. Отдельная очередь «ряд × глубина» была лишней: ряд считался из
	# того же зазора, к которому подтягивал, и условие выходило самосбывающимся
	var step: float = _effective_speed() * delta
	# ── ФАЙЛ УПЁРСЯ ВО ВРАГА: ПОДЖАТЬСЯ К СВОЕЙ ШЕРЕНГЕ И СТОЯТЬ ────────────
	# Просто замереть на месте нельзя, и это стоило отдельного замера: боец
	# останавливался там, где его застала разметка, строй оставался рыхлым, и в
	# зону удара попадала одна первая шеренга — контакт падал с 33 % до 15 %.
	# Место в глубине задаёт РЯД (порядковый номер в своей колонне, считает
	# отряд), и поджавшийся блок сам вводит в бой вторую и третью шеренги.
	#
	# Проверять при этом «нет ли врага под носом» НЕ НАДО — проверено и
	# отброшено: у бойца с чужим в пределах удара разметка и так не поставит
	# признак тыла, а редкий скан на всякий случай не нашёл ничего (контакт те
	# же 13 %) и стоил 2 мс кадра
	if _rear_hold:
		var want: float = float(_live_rank) * REAR_RANK_DEPTH
		if _line_gap <= want + REAR_SLACK:
			velocity = Vector3.ZERO
			return
		var room: float = _line_gap - want
		if step > room:
			step = room
	velocity = _line_course * (step / maxf(delta, 1e-6))
	_facing = _line_course
	var np: Vector3 = global_position + _line_course * step
	# ── ЧУЖОЕ ТЕЛО НЕПРОХОДИМО И ДЛЯ ТЫЛА ───────────────────────────────────
	# ЭТО И БЫЛО «МЕЧНИКИ ПРОНИКАЮТ В ЦЕНТР ФАЛАНГИ СКВОЗЬ ПИКИ». Дешёвый шаг
	# тыла считался как «иду вперёд по курсу колонны, пока не упрусь в СВОЕГО»
	# (_rear_hold ограничивает глубину относительно своего же передового) — и не
	# спрашивал про чужих ВООБЩЕ. Пока свалка редкая, это незаметно: тыл далеко
	# от чужой шеренги. Но в плотном бою строи перемешаны, и боец, размеченный
	# как тыловой своим отрядом, честно шёл сквозь чужие тела — то есть внутрь
	# вражеской фаланги, мимо всех пик.
	#
	# Ответ отряда используется как бесплатный отсев: если коридор сказал «чужих
	# рядом нет», скан не нужен вовсе. В самой свалке он сказать этого не может,
	# и там скан идёт — ровно тот же, что делает обычный шаг. Экономия дешёвого
	# шага от этого никуда не девается: он по-прежнему пропускает и воду, и
	# стволы, и весь боевой автомат
	if not _clear_enemy and not retreating:
		if GameManager.unit_grid.enemy_block(self, np, BLOCK_RADIUS).length_squared() > 1e-8:
			velocity = Vector3.ZERO
			return
	if GameManager.world_bounds_enabled:
		var lx: float = GameManager.map_lim_x
		var lz: float = GameManager.map_lim_z
		np.x = clampf(np.x, -lx, lx)
		np.z = clampf(np.z, -lz, lz)
	# Тот же кэш высоты, что и в обычном шаге, — второго заводить незачем
	var tdx: float = np.x - _th_x
	var tdz: float = np.z - _th_z
	if tdx * tdx + tdz * tdz > TERRAIN_RECHECK_SQ:
		_th_x = np.x
		_th_z = np.z
		_th_y = GameManager.get_terrain_height(np.x, np.z)
	np.y = _th_y
	if _local_xform:
		position = np
	else:
		global_position = np
	# Точку сдвинул GDScript — отправляем её в колонку (см. tick_physics)
	_pose_force = true
	# Я сдвинулся — на столько же сократился и мой отрыв от фронта. Пересчитывать
	# его сканом незачем: до следующей разметки отряда это верно с точностью до
	# движения самого фронта, а он в свалке почти стоит
	_line_gap -= step
var _th_x: float = 1e9
var _th_z: float = 1e9
var _th_y: float = 0.0

## Радиус перехвата на марше: враг ближе этого останавливает движение.
## Чуть больше дальности удара — чтобы боец встал ВПЛОТНУЮ к чужой шеренге,
## а не замирал ровно на грани и топтался
const INTERCEPT_MARGIN := 0.8
## ── ШИРОКАЯ ЛИНИЯ БОЯ НА МАРШЕ (заказ владельца, спринт 15) ─────────────────
## «Пехота на марше должна вступать в бой не только с врагами строго перед
## собой, но и цеплять юнитов с флангов / по касательной в радиусе агро».
## Перехват на марше искал помеху в attack_range + INTERCEPT_MARGIN — у пехоты
## это 2.4-2.8 м, то есть буквально «упёрся телом». Отряд, идущий мимо чужого
## фланга в четырёх метрах, честно проходил мимо: авто-агро с его десятью
## метрами работает только в ПОКОЕ, а марш — это MOVING.
##
## Теперь у РУКОПАШНОЙ пехоты радиус перехвата на марше не меньше AGGRO_RADIUS.
## Только у рукопашной: у стрелка attack_range и так 20 м, и ему это правило
## ничего не добавляет. И только у СВОБОДНОГО перехвата (см. free_to_intercept):
## замок приказа игрока (три секунды) и выход из боя по-прежнему глушат его —
## иначе приказ «уйти оттуда» снова тонул бы в первой же стычке
const MARCH_INTERCEPT_MELEE := true
## Порог «рукопашный» — тот же, что у HUD и башни (MELEE_RANGE_MAX 5.0):
## дальше него дальность оружия означает стрелка
const MARCH_INTERCEPT_MELEE_MAX := 5.0

## ── СЦЕПКА В БЛИЖНЕМ БОЮ (лечит «челнок») ───────────────────────────────────
## Взводится, когда цель взята ПО ФИЗИЧЕСКОМУ КОНТАКТУ: заслон, в который отряд
## упёрся телом, или тот, кто только что ударил. Пока признак стоит, боец не
## бросает такую цель на границе дальности оружия, а доступает к ней.
##
## ЧТО БЫЛО. Заслон выбирался в полосе attack_range + INTERCEPT_MARGIN, а
## приказ на него шёл НЕПРИНУДИТЕЛЬНЫЙ (forced = false) — и уже на следующем
## тике _process_attack видел «цель дальше дальности удара, приказа не было»,
## обнулял её и уходил в IDLE. Дальше возобновлялся исходный приказ, боец делал
## шаг, снова упирался в тот же заслон, снова его брал и снова бросал. Со
## стороны это ровно «юнит циклично бегает назад-вперёд у строя противника»,
## причём в рубку он так и не входит.
##
## Полоса сцепки — те же 0.8 м, что и полоса перехвата: это не погоня, это
## «доступить до того, обо кого уже упёрся».
var _melee_grip: bool = false

## Шаг упёрся во вражеский строй прямо сейчас (ставит _move_blocked).
## По этому признаку марш немедленно перебивается боем, не дожидаясь
## очередного опроса агро
var _enemy_contact: bool = false

## ── ОТВЕТЫ, ПОЛУЧЕННЫЕ ОТ ОТРЯДА, А НЕ ДОБЫТЫЕ САМИМ ────────────────────────
## «В габаритах отряда нет ни одного ствола / ни одного чужого». Раздаёт
## GameManager._push_corridor раз в CORRIDOR_TTL_MS на весь отряд; боец только
## читает поле (см. _move_blocked). По умолчанию false — то есть НЕ ЗНАЕМ и
## проверяем сами: одиночка вне отряда и любой боец до первой раздачи идут
## прежним, полным путём
var _clear_trunk: bool = false
var _clear_enemy: bool = false

## ── СЕКТОР У ЗДАНИЯ УЖЕ ОТРАБОТАН ──────────────────────────────────────────
## Взводится, когда боец дошёл до точки своего сектора (см. RING_ARRIVE), и
## снимается новым приказом. Разбор — у самой ветки подхода к постройке
var _ring_done: bool = false

# ── «ЮНИТ-МУХА»: ЗАЦИКЛИВАНИЕ ВОКРУГ СТВОЛА ──────────────────────────────────
# Обход дерева (см. mb_trunk выше) снимает из шага составляющую «внутрь» и
# оставляет касательную. Для одиночного ствола этого хватает, но геометрия
# бывает злее: два ствола рядом, ствол ровно между бойцом и его слотом, задетое
# боком дерево у самой точки прихода. Тогда касательная уводит вбок, следующий
# кадр разворачивает обратно к цели, и боец наматывает круги вокруг комля,
# никогда не подходя ближе — те самые «1-2 юнита кружат вокруг дерева».
#
# Лечится не подбором углов, а ПРИЗНАКОМ БЕЗРЕЗУЛЬТАТНОСТИ: раз в
# STUCK_CHECK_SEC смотрим, стало ли до цели ближе хотя бы на STUCK_PROGRESS.
# Не стало — на TRUNK_IGNORE_SEC стволы для этого бойца перестают существовать,
# и он выходит к строю напрямую. Проходить сквозь дерево несколько секунд —
# несравнимо меньшее зло, чем боец, который не выполнил приказ вообще.
#
# Ствол — единственное, что снимается. Вода и чужой строй остаются: там причина
# застревания другая и обходится она честно.
## Как часто проверять, есть ли продвижение к цели
const STUCK_CHECK_SEC := 0.5
## Насколько метров надо приблизиться за это время, чтобы считаться идущим
const STUCK_PROGRESS := 0.35
## На сколько секунд боец перестаёт замечать стволы, когда признан застрявшим
const TRUNK_IGNORE_SEC := 1.5

var _sep_timer: float      = 0.0
var _stuck_timer: float    = 0.0
var _stuck_ref_dist: float = INF
var _trunk_ignore: float   = 0.0
## Сколько проверок подряд боец признан не продвигающимся. По нему решают, что
## одного выключения стволов мало и пора менять саму точку (см. Worker)
var _stuck_streak: int     = 0

## ── ДЕТЕКТОР ЗАЦИКЛИВАНИЯ — ОДИН НА ВСЕ ПУТИ ДВИЖЕНИЯ ─────────────────────
## ЗДЕСЬ ОН ЖИЛ ПРЯМО В `_process_move`, И ЭТО ЗНАЧИЛО, ЧТО У РАБОЧЕГО ЕГО НЕТ
## ВОВСЕ. `Worker.tick_physics` переопределён, и в трёх своих состояниях
## (BUILDING / GATHERING / RETURNING) он до базового тика НЕ ДОХОДИТ — выходит
## раньше. Двигается рабочий там сам, через `_move_blocked`, то есть обход
## стволов у него работает, а признать себя наматывающим круги ему нечем: он
## может обходить один и тот же комель по дороге на стройку сколько угодно.
## Ровно так это и выглядит на экране — «встал у дерева и дёргается».
## Та же форма ошибки, что уже ловилась дважды: переопределённый tick_physics
## не доходит до базового — значит, не тикает и всё, что там считается.
##
## Возвращает true в ТОТ ТАКТ, когда боец признан застрявшим: вызывающему это
## нужно, чтобы поменять саму точку, а не только выключить стволы
func _tick_stuck(delta: float, dist: float) -> bool:
	if _trunk_ignore > 0.0:
		_trunk_ignore -= delta
	_stuck_timer += delta
	if _stuck_timer < STUCK_CHECK_SEC:
		return false
	_stuck_timer = 0.0
	var stuck: bool = dist > _stuck_ref_dist - STUCK_PROGRESS
	_stuck_ref_dist = dist
	if not stuck:
		_stuck_streak = 0
		return false
	_trunk_ignore = TRUNK_IGNORE_SEC
	_stuck_streak += 1
	return true

## Новый приказ — новый отсчёт: иначе «не продвигаюсь» считалось бы от
## расстояния до ПРЕЖНЕЙ цели, и свежий приказ объявлялся бы застрявшим сразу
func _reset_stuck() -> void:
	_stuck_timer    = 0.0
	_stuck_ref_dist = INF
	_stuck_streak   = 0

## ЗДЕСЬ ПРОБОВАЛАСЬ ТРЕТЬЯ СТУПЕНЬ — отряд раздаёт не ответ «чисто/не чисто»,
## а САМ СПИСОК стволов своего коридора (плоские тройки x, z, r), и боец
## проверяет шаг пробегом по массиву чисел, без вызова наружу вовсе.
## Замер на 5000: mb_trunk 1.13 → 1.71 мкс, тик марша 16.4 → 18.8 мс. То есть
## ХУЖЕ, и по той же причине, что и у снятого раньше поклеточного кэша: в лесу
## в габариты отряда (радиус ~12 м) попадают ДЕСЯТКИ стволов, и пробег по ним у
## каждого бойца дороже поиска по клеткам 4 м, который почти всегда смотрит
## одну-две клетки. Понижать потолок списка бессмысленно — тогда он просто
## никогда не применяется. Механика удалена целиком.


func _process_move(delta: float) -> void:
	# ─── ПЕРЕХВАТ ВРАЖЕСКОЙ ШЕРЕНГОЙ ────────────────────────────────────────
	# Раньше авто-агро опрашивалось ТОЛЬКО в состоянии IDLE. Идущий по приказу
	# отряд не проверял вообще ничего: он утыкался в чужой строй, скользил
	# вдоль него (см. _move_blocked) и утекал за спину, ни разу не ударив —
	# ровно то, что выглядит как «проходят сквозь врага призраками».
	# Теперь марш ПЕРЕБИВАЕТСЯ: подошли на дистанцию удара — встали и деремся.
	# Приказ не «забывается» — после боя боец снова свободен и его можно послать
	# дальше; но пройти сквозь шеренгу без драки больше нельзя.
	# ОТХОД В ЗАМОК НЕ ПЕРЕБИВАЕТСЯ НИЧЕМ: отряд идёт лечиться, а не воевать.
	# ПРЯМОЙ ПРИКАЗ ВЫЙТИ ИЗ БОЯ (_disengaging) — тоже: иначе тот самый враг,
	# от которого только что отвели бойца, немедленно перехватывает марш снова
	var _prof: bool = _prof_on
	var _t: int
	if _prof: _t = Time.get_ticks_usec()
	if _move_lock > 0.0:
		_move_lock -= delta
	# ── ФИЗИЧЕСКИЙ УПОР ПЕРЕБИВАЕТ ЛЮБОЙ ЗАМОК ПРИКАЗА ──────────────────────
	# Заказ владельца: «если юнит в строю натыкается на коллизию врага, приказ
	# марша для него переключается в ATTACKING; юниты первой линии ОБЯЗАНЫ
	# вступать в бой, а не упираться в коллизию».
	#
	# Раньше перехват глушили ТРИ независимых запрета: замок приказа игрока
	# (_move_lock), выход из боя (_disengaging) и редкий такт опроса. Под ними
	# передняя шеренга, посланная за спину противнику, стояла вплотную к чужому
	# строю и не делала НИЧЕГО.
	#
	# Разделяем два разных случая. «Враг в дальности оружия» — это ещё не повод
	# бросать приказ: ровно от такого перехвата замок и заведён. А вот «мой шаг
	# УПЁРСЯ в чужое тело» (_enemy_contact ставит солвер в тот же кадр, когда
	# шаг реально не прошёл) — это не отвлечение, а тупик: пройти нельзя, и
	# единственное осмысленное действие — драться.
	#
	# ── ОКНО ПРОХОДА ПРИКАЗА БОЛЬШЕ НЕ ИСКЛЮЧЕНО (03.09.2026) ──────────────
	# Здесь стояло «в окне прохода чужие тела бойцу не преграда вовсе, упора
	# там не бывает» — и это было верно, пока билет СНИМАЛ проверку тел. Теперь
	# билет сужает тело до ядра (ArmyCore.PassCoreFrac), и упор под билетом —
	# обычное дело: ядро не пустило. С прежним исключением такой боец стоял
	# все три секунды замка под ударами, не отвечая, — qa_wall C1: «упёршиеся
	# в чужой строй вступают в бой» падал до 7 из 38. Третье условие ниже
	# (moved_recently) уже отличает того, кто под билетом РЕАЛЬНО выбирается,
	# от того, чей шаг никуда не привёл, — отдельного исключения не нужно
	# ── «УПЁРСЯ» — ЭТО НЕ «КОСНУЛСЯ», А «НИКУДА НЕ ЕДУ» ────────────────────
	# Одного _enemy_contact мало. Отряд, которому приказали ВЫЙТИ из боя,
	# касается чужих тел ровно первые секунды отхода: шаг назад пройдёт, а
	# отметка о касании уже стоит — и перехват разворачивал бы его обратно в
	# драку, отменяя приказ игрока (поймал qa_melee F2: одиннадцать из
	# двенадцати остались с целью).
	# Третье условие снимает противоречие: боец, который РЕАЛЬНО едет
	# (moved_recently — по фактическому смещению, а не по намерению), уходит;
	# боец, чей шаг никуда не привёл, дерётся. Тем же признаком отличается
	# «иду прочь» от «перебираю ногами» в ответе на удар (_may_answer_blow)
	var wall: bool = _enemy_contact and not moved_recently()
	# ── БЕГУЩИЙ УПЁРСЯ В СТЕНУ КОПИЙ (спринт 18) ────────────────────────────
	# Контакт бегущего ставит СОЛВЕР (пакетный шаг) — тот же признак, что и у
	# упора шага. Раз за забег: копейщик в «Защите» со «Стеной копий» лицом к
	# набегающему встречает его так же, как конницу (spear_wall_strike)
	if sprinting and _enemy_contact and not _wall_struck:
		_wall_struck = true
		var wdir: Vector3 = _mv_dir if _mv_dir.length_squared() > 1e-6 else velocity
		if wdir.length_squared() > 1e-6:
			var wb: Node3D = GameManager.unit_grid.enemy_at(global_position, LOCK_BLOCKER_RANGE + BLOCK_RADIUS, faction)
			if wb != null and is_instance_valid(wb) and wb is Unit:
				var wu := wb as Unit
				if wu.spear_wall_active() and wu._faces_charge(wdir.normalized()):
					wu.spear_wall_strike(self)
					return
	# Свободен ли перехват по обычному правилу — то есть без упора: замок
	# приказа игрока вышел и это не выход из боя
	var free_to_intercept: bool = not _disengaging and _move_lock <= 0.0
	if attack_damage > 0.0 and not retreating and not sprinting 			and (wall or free_to_intercept):
		# КАСАНИЕ ЧУЖОГО СТРОЯ ПЕРЕБИВАЕТ ТАЙМЕР. Обычный опрос идёт раз в
		# полсекунды, и за это время боец успевал соскользнуть вдоль вражеской
		# шеренги и уйти дальше по маршруту, так и не вступив в бой
		_aggro_timer -= delta
		if wall or _aggro_timer <= 0.0:
			_enemy_contact = false
			_aggro_timer = AGGRO_INTERVAL_HOT
			# Тот же ответ отряда, что и в авто-агро: в его габаритах плюс
			# дальность внимания чужих нет — перехватывать некого, скан не нужен.
			# При физическом упоре ответ отряда не спрашиваем вовсе: тело перед
			# нами есть по факту, каким бы ни был кэш коридора
			# ИЗМЕРИТЕЛЬ ПОТОЛКА (см. perf_config.march_blocker_scan): без
			# ручки скан по таймеру не идёт вовсе, остаётся перехват по
			# физическому упору. Режимом игры это не является
			# ── ФАЗА 1 ТРЁХТОЧЕЧНОГО РЛС: ВПЕРЕДИ ПУСТО — СКАНА НЕТ ─────
			# Отряд прощупал фронт из трёх точек на MARCH_RADAR_RANGE и
			# доложил «чисто»; значит, и личной проверки заслона не нужно
			# никому. Упор телом (`wall`) через этот гейт проходит всегда:
			# его ставит пакетный шаг ядра, и он и есть настоящий контакт
			var radar_clear: bool = not wall 				and GameManager.squad_march_clear(squad_id)
			if (wall or not _clear_enemy) and (wall or _Opt.march_blocker_scan) 					and not radar_clear:
				var reach_i: float = attack_range + INTERCEPT_MARGIN
				# Разбор — у MARCH_INTERCEPT_MELEE. При физическом упоре (wall)
				# радиус не расширяем: там помеха и так под рукой
				if MARCH_INTERCEPT_MELEE and not wall and pursues_target() \
						and attack_range <= MARCH_INTERCEPT_MELEE_MAX:
					reach_i = maxf(reach_i, AGGRO_RADIUS)
				var blocker := _find_nearest_enemy_in_range(reach_i, "blocker_reach")
				# ── РАЗДЕЛИТЕЛЯ «ИДУ ПРОЧЬ» ЗДЕСЬ НЕТ, И ЭТО ЗАМЕР ──────────
				# Снимать перехват тому, кто идёт прочь от помехи, пробовал в
				# трёх видах: по продвижению к точке приказа, по росту дистанции
				# до ближайшего чужого тела и по УГЛУ на помеху. Ни один не
				# разводит два требования владельца, а угол по `move_target` ещё
				# и портит то, ради чего перехват заведён: qa_wall C1 93% → 89%,
				# A1 ноль просочившихся → один. Числа и разбор — в
				# docs/ENGINEERING_LOG.md, раздел про qa_melee F2
				if blocker != null:
					velocity = Vector3.ZERO
					command_attack(blocker, false)
					# СЦЕПКА: взятый по физическому контакту заслон не
					# сбрасывается на границе дальности — иначе боец бегает
					# челноком у чужого строя и в рубку не входит
					if wall:
						_melee_grip = true
					if _prof: _Opt.prof_add("mv_intercept", Time.get_ticks_usec() - _t)
					return
	if _prof: _Opt.prof_add("mv_intercept", Time.get_ticks_usec() - _t)
	# ── СВОЯ ТОЧКА ЧИТАЕТСЯ ПО ДЕШЁВОМУ ПУТИ (правило 2) ───────────────────
	# Здесь стояло `move_target - global_position`. global_position у Node3D —
	# не поле, а свойство: каждое чтение проверяет актуальность мировой матрицы
	# и при нужде пересобирает её по цепочке родителей, а пересобирать её тут
	# есть что — пакетный шаг прошлого кадра записал координату напрямую.
	# И это САМАЯ ГОРЯЧАЯ ветка тика: на сближении process_move занимает 81 %
	# (замер qa_fx --prof, 3000 бойцов). Под неподвижным World локальная
	# position равна мировой, и предпосылка проверяется, а не принимается на
	# веру (см. _check_local_xform)
	var mypos: Vector3 = position if _local_xform else global_position
	var dir := Vector3(move_target.x - mypos.x, 0.0, move_target.z - mypos.z)
	var dist := dir.length()
	# ── ДЕТЕКТОР ЗАЦИКЛИВАНИЯ (см. STUCK_CHECK_SEC) ─────────────────────────
	# Раз в полсекунды сверяем расстояние до цели с прошлым замером. Не стало
	# ближе хотя бы на STUCK_PROGRESS — боец наматывает круги (почти всегда
	# вокруг ствола), и стволы для него на TRUNK_IGNORE_SEC выключаются.
	# Четыре арифметические операции в кадр: ни одного вызова наружу
	_tick_stuck(delta, dist)
	# ПРОСТАЯ ЖЁСТКАЯ ОСТАНОВКА: дошёл в пределах допуска — встал, и всё.
	# Никаких доводок, проб «а не занято ли место» и попыток подвинуться,
	# если задел сосед: именно они и превращались в бесконечное топтание.
	#
	# ХВОСТОВОЙ БОЕЦ СТРОЯ БОЛЬШЕ НЕ ОСОБЫЙ СЛУЧАЙ. Раньше его точка могла быть
	# занята соседом, идеально встать он не мог никогда и топтался там до конца
	# боя — для этого и заводился срок давности. Теперь занятых точек не бывает:
	# союзники свободно перекрываются, и в свой слот попадает кто угодно
	# ── ПРОМЕЖУТОЧНАЯ ТОЧКА МАРШРУТА — ЭТО ПОВОРОТ, А НЕ ПРИБЫТИЕ ─────────
	# Отряду о таком не докладывают и на месте не встают: приказ исполнен
	# не будет, пока боец не дойдёт до конечной точки. Допуск шире ARRIVE:
	# в колонне у угла точно в точку не встать. Раз в ROUTE_LOS_SEC — не
	# видна ли уже СЛЕДУЮЩАЯ точка: тогда текущий угол пропускается
	if _route_i < _route.size():
		if dist < ROUTE_WP_RADIUS:
			_route_advance()
			return
		_route_los_t -= delta
		if _route_los_t <= 0.0:
			_route_los_t = ROUTE_LOS_SEC
			var nxt: Vector3 = _route[_route_i + 1] if _route_i + 1 < _route.size() else _route_goal
			if not GameManager.nav_blocked(mypos, nxt):
				_route_advance()
				return
	if dist < ARRIVE_RADIUS:
		# ── ОХОТА НА ОВЦУ: дошли — бьём, ушла — идём за ней ─────────────
		if _hunt_sheep != null and _hunt_arrival():
			return
		velocity = Vector3.ZERO
		state    = State.IDLE
		_march_pending = false      # дошли — возобновлять больше нечего
		_march_run     = false
		_disengaging   = false      # дошли — снова можно ввязываться в бой
		_move_lock     = 0.0        # приказ выполнен, держать замок больше незачем
		# ПРИБЕЖАЛИ — БЕГ ВЫКЛЮЧАЕТСЯ САМ. Отряд возвращается в обычный режим:
		# копейщики снова опускают копья и строят фалангу, авто-агро оживает
		if sprinting:
			_set_sprinting(false)
		# ЯКОРЬ. С этого мгновения расталкивание бойца не двигает: подошедшие
		# соседи встают впритык, перекрываясь, и тоже замирают
		_settled = true
		# ДОЛОЖИТЬ ОТРЯДУ. Когда доложит достаточная доля, отставшие получат
		# прибавку к скорости и быстро запечатают квадрат (см. squad_note_arrival)
		if squad_id > 0:
			GameManager.squad_note_arrival(squad_id)
		# ПРИШЛИ В СВОЙ СЛОТ — доворачиваемся в направление строя.
		# Ракурс спрайта у стоящего юнита заморожен (см. _update_sprite_flip),
		# поэтому явно просим один пересчёт зеркала
		# ── ВСЕ В СТРОЮ СМОТРЯТ В ОДНУ СТОРОНУ ────────────────────────
		# Жалоба владельца со скриншотом: «лучники после построения
		# смотрят в разные стороны». Курс прихода есть НЕ У КАЖДОГО
		# ПРИКАЗА: смыкание рядов, подзыв сплочённости, возврат на пост и
		# возврат из гарнизона зовут command_move БЕЗ курса. Такой боец
		# оставался с тем взглядом, что был у него до того, — а был он, как
		# правило, на чужого или на точку, откуда он шёл. Оттого строй и
		# смотрел вразнобой: кто пришёл по приказу игрока — по курсу, кто
		# дошёл смыканием — куда придётся.
		# Запасной ответ — КУРС ОТРЯДА (направление последнего приказа,
		# по нему же считаются шеренги фаланги), а не свой скан и не
		# второе хранилище направлений: он уже есть и он отрядный
		var face_now: Vector3 = face_on_arrive
		if face_now.length_squared() <= 1e-6 and squad_id > 0:
			face_now = GameManager.squad_course(squad_id)
		if face_now.length_squared() > 1e-6:
			_facing = face_now
			_flip_dirty = true
	else:
		dir /= dist
		_facing  = dir
		if _prof: _t = Time.get_ticks_usec()
		velocity = dir * _effective_speed()
		if _prof: _Opt.prof_add("mv_speed", Time.get_ticks_usec() - _t)
		# ── ШАГ НЕ ПРОВОДИТСЯ ЗДЕСЬ, А ЗАЯВЛЯЕТСЯ (см. ArmySoA.batch_move) ───
		# Замер по фазам (qa_fx --prof, 3000 бойцов): на сближении process_move
		# занимает 81 % тика при 23.4 мкс на вызов, и из них НАЗВАНЫ только
		# десять — остальные тринадцать это цена самого вызова _move_blocked,
		# чтения global_position (свойство, а не поле) и полутора десятков
		# чтений полей объекта, повторяемых на каждого бойца каждый кадр.
		# Решение («куда и с какой скоростью») остаётся здесь, геометрия шага
		# уходит в один проход по столбцам после обхода армии.
		#
		# Запасной путь обязателен: строки может не быть (боец вне ядра армии —
		# так бывает в стендах и до первого тика), и тогда шаг проводится
		# по-старому, поштучно
		# collision_mask = 0 — физических коллизий нет, интегрируем напрямую
		# (дешевле move_and_slide), но сквозь чужой строй не пускаем
		_commit_step(velocity * delta)

## Пауза между повторными попытками найти замену погибшей цели (см. ниже).
## БЫЛО: полный скан сетки (до FORCED_RETARGET_RANGE/attack_range, у лучника
## это ~1600 ячеек) звался КАЖДЫЙ физ. тик БЕЗ единого троттля, пока замена
## не находилась — единственный вызов _find_nearest_enemy_in_range во всём
## файле, не прикрытый ни таймером, ни squad-кэшем. В обычной смерти это один
## тик и юнит уходит в IDLE/резюме марша, но в свалке, где цели гибнут
## валом, а замены гибнут следом, заметная доля бойцов зависает в этой ветке
## на несколько тиков подряд ОДНОВРЕМЕННО — то есть цена растёт именно со
## вспышкой боя, а не с числом юнитов линейно. 0.2 с — тот же порядок, что и
## у остальных троттлей скана в файле (AGGRO_INTERVAL_HOT, RANK_RECHECK)
const RETARGET_RETRY_SEC := 0.2
var _retarget_timer: float = 0.0

func _process_attack(delta: float) -> void:
	# is_dead()/is_instance_valid не нужны: цель обнуляется сигналом died (см. set_attack_target)
	if attack_target == null:
		_melee_grip = false      # сцепка живёт ровно один контакт (см. поле)
		# ── СТЕНА ДОХОДИТ ДО ТОЧКИ ПРИКАЗА, ДАЖЕ ЕСЛИ ЦЕЛЬ УЖЕ ПАЛА ─────────
		# Иначе строй, снёсший заслон на полдороге, вставал бы там, где кончилась
		# рубка, — ровно та же болезнь, от которой в марше лечит _resume_march.
		#
		# ── И ТОЛЬКО В ОБОРОНЕ. ЭТО ЗАМЕР, А НЕ ОСТОРОЖНОСТЬ ────────────────
		# Ниже по этой ветке живёт ВСЯ работа с замком цели: перенацеливание на
		# тот же вражеский отряд и снятие замка, когда отряд выбит целиком.
		# Ход стены отсюда делает `return`, то есть в атаке пропускал её
		# полностью. Замер A/B: qa_target_lock B1 «отряд остался на том же
		# вражеском отряде» 0 из 6 против 6 из 6, E2 «замок снят сам» 0 из 4
		# против 4 из 4. В обороне это безвредно — там точка И ЕСТЬ приказ, и
		# дойти до неё важнее, чем сменить цель
		if _attack_is_forced and _hold_goal_set and _stance_holds_ground():
			if _phalanx_march(delta):
				return
		_retarget_timer -= delta
		if _retarget_timer > 0.0:
			return
		_retarget_timer = RETARGET_RETRY_SEC
		# ── ПРИОРИТЕТ №1: ЗАМОК ЦЕЛИ ─────────────────────────────────────────
		# Приказ игрока держится за ВРАЖЕСКИЙ ОТРЯД, а не за модель. Пала жертва —
		# берём следующую ИЗ ТОГО ЖЕ ОТРЯДА, независимо от того, кто в этот момент
		# оказался ближе. Без этого ветка ниже искала замену через
		# _find_nearest_enemy_in_range, то есть каждый боец сам выбирал ближайшего
		# противника на карте, и отряд растекался по всем окрестным целям
		if target_lock:
			var locked := _lock_next_victim()
			if locked != null:
				set_attack_target(locked)
				_attack_is_forced = true
				return
			# Назначенный отряд выбит целиком — приказ выполнен. Замок снимается,
			# и дальше боец живёт по приоритету №3 (авто-агро) как обычно.
			# ПОСТ ПЕРЕНОСИТСЯ СЮДА: иначе и авто-агро, и возврат на пост
			# потянут бойца туда, откуда отряд вышел (см. _hold_where_i_stand)
			release_target_lock()
			_hold_where_i_stand()
			_atk_pending = false
		# После смерти цели добираем СЛЕДУЮЩУЮ в своём радиусе атаки
		# (раньше — 20 м, из-за чего юниты убегали через полкарты за новой целью).
		# ИСКЛЮЧЕНИЕ для тех, кто шёл в бой ПО ПРЯМОМУ ПРИКАЗУ и ещё не доехал
		# до контакта: им радиус расширен до FORCED_RETARGET_RANGE. Без этого
		# задние ряды, обходящие свалку по флангу, замирали в IDLE в паре метров
		# от живого врага — стоило погибнуть общей цели отряда, и охват обрывался.
		#
		# maxf с attack_range, А НЕ голый FORCED_RETARGET_RANGE: 6 м — запас
		# ИМЕННО для ближнего боя (спешит расширить крошечную дальность копья/
		# меча). У лучника attack_range уже 18-20 м — голая замена на 6 м резала
		# его обычный радиус обстрела втрое, и стрелок, чья общая с соседями
		# цель только что умерла, не видел следующего врага в 7-8 м, хотя тот
		# прекрасно простреливался. Отряд лучников замолкал, не выбив и половины
		# вражеского строя (жалоба игрока, см. qa_archer_retarget)
		var was_forced := _attack_is_forced
		var seek: float = maxf(attack_range, FORCED_RETARGET_RANGE) if was_forced else attack_range
		# ── СНАЧАЛА СПРАШИВАЕМ ОТРЯД, ПОТОМ ИЩЕМ САМИ (слой B) ───────────────
		# Отряд знает, с кем он дерётся (GameManager._sweep_melee), и выдаёт
		# наименее атакованного из ТОГО ЖЕ вражеского отряда. Это ровно то, что
		# при приказе игрока делает замок цели, — только здесь без приказа.
		# Смысл не в скорости (поиск целей это 4.7 % кадра), а в связности: без
		# подсказки каждый потерявший цель боец искал нового противника сам, и
		# отряд растекался по всем окрестным целям вместо того, чтобы добивать
		# одного противника вместе. Ответ отряда ограничен тем же радиусом seek,
		# так что уйти из своего боя за дальней целью по нему нельзя
		var pick: Node3D = GameManager.squad_duel_target(squad_id, self, seek)
		if pick == null:
			pick = _find_nearest_enemy_in_range(seek, "retarget_lost")
		set_attack_target(pick)
		# Приказ остаётся в силе, только пока замена нашлась поблизости
		_attack_is_forced = was_forced and attack_target != null
		if attack_target == null:
			# ── МАРШ ПРОДОЛЖАЕТСЯ ПОСЛЕ БОЯ ──────────────────────────────────
			# Отряд, перехваченный по дороге вражеской шеренгой, раньше просто
			# вставал там, где закончилась рубка: приказ на марш терялся в
			# момент перехвата и никогда не возобновлялся. Игрок отправлял
			# отряд на другой конец карты, тот сносил заслон — и оставался
			# стоять посреди поля.
			# Теперь марш помнится (см. command_move) и подхватывается снова:
			# бойцы смыкают ряды и идут дальше своим ходом
			if _march_pending and _resume_march():
				return
			# ── ПРИКАЗ АТАКИ ТОЖЕ ПРОДОЛЖАЕТСЯ ПОСЛЕ ПОМЕХИ ──────────────────
			# Рядом уже никого нет (иначе retarget выше уже подхватил бы цель),
			# но исходный приказ атаки ещё не выполнен — вернуться к нему, а не
			# вставать посреди пути (см. _atk_pending, qa_approach_intercept)
			if _atk_pending and _resume_attack():
				return
			state = State.IDLE
			_charge_order = false   # бой окончен — копья вверх
			# ── ВЫШЛИ ИЗ БОЯ — СОБРАТЬ СТРОЙ ─────────────────────────────────
			# Свалка растаскивает бойцов с их мест ничуть не хуже потерь: после
			# рубки отряд стоит бесформенным пятном, даже если не потерял ни
			# одного человека. Порог по потерям здесь не годится (его может не
			# быть вовсе), поэтому просим смыкание принудительно — остыв в
			# GameManager всё равно не даст перестраиваться чаще раза в секунду.
			# Разметка сажает выживших на ПЕРВЫЕ места списка, то есть первая и
			# вторая шеренги заполняются раньше остальных.
			# ТОЛЬКО ЕСЛИ ОТРЯД ДЕЙСТВИТЕЛЬНО ВЫШЕЛ ИЗ БОЯ (см. squad_in_combat):
			# у ЭТОГО бойца цели больше нет, но сосед в паре метров ещё может
			# драться — смыкание не должно выдёргивать его приказом на марш,
			# иначе следующая же авто-агро проверка ведёт его обратно ("пляска")
			if squad_id > 0 and not GameManager.squad_in_combat(squad_id):
				GameManager.call_deferred("squad_close_ranks", squad_id, true)
		return
	# ── ДРЁМА ПЕРЕЗАРЯДКИ: ДЕРУЩИЙСЯ В УПОР НЕ ДУМАЕТ КАЖДЫЙ ТИК ────────────
	# process_attack — крупнейшая ветка тика свалки (25%, ~900 вызовов на кадр
	# по 4.5 мкс, замер qa_mass3k сент. 2026), и почти все эти вызовы — боец,
	# который СТОИТ В УПОР К ЦЕЛИ и ждёт остывания удара: ему нечего решать до
	# самого удара. Пока дрёма жива, тело функции сворачивается до тика таймера;
	# просыпается боец за ATK_SNOOZE_SPARE до готовности, и следующий тик
	# заново меряет дистанцию и ветвится штатно — бить по цели, ушедшей из
	# дальности за время дрёмы, по построению невозможно.
	# Снимают дрёму: смена цели (set_attack_target, включая её гибель через
	# сигнал died) и пробуждение из ядра. Приказы сюда не заглядывают —
	# любой приказ идёт через set_attack_target или уводит из State.ATTACKING.
	# Реакция на удар (take_damage) — событие, а не тик, дрёма её не глушит.
	# ── ТАЙМЕР ТИКАЕТ В ЯДРЕ (этап C) ───────────────────────────────────────
	# Пока дрёма жива, остывание и стражу цели ведёт ArmyCore.TickSnooze по
	# колонкам, а будит бойца GameManager (_atk_wake) — здесь НИЧЕГО не
	# считается. _attack_timer на время дрёмы заморожен и синхронизируется
	# при пробуждении/снятии; читатели снаружи (_sweep_volleys) видят
	# арм-значение больше нуля, то есть честное «ещё не готов»
	if _atk_snooze:
		return
	# ── ОБЕ ТОЧКИ ЧИТАЮТСЯ ПО ДЕШЁВОМУ ПУТИ ─────────────────────────────────
	# Здесь было два обращения к global_position — своему и ЧУЖОМУ. Каждое из
	# них не поле, а свойство: проверяет актуальность мировой матрицы и при
	# нужде пересобирает её по цепочке родителей, а пересобирать есть что —
	# пакетный шаг только что записал координаты обоим. Под неподвижным World
	# локальная position равна мировой (см. _local_xform), и у цели-бойца её
	# можно взять так же дёшево; зданию и прочим остаётся прежний путь
	var tu := attack_target as Unit
	var tp: Vector3
	if tu != null and tu._local_xform:
		tp = tu.position
	else:
		tp = attack_target.global_position
	var mp: Vector3 = position if _local_xform else global_position
	var dir  := tp - mp
	dir.y    = 0
	var dist := dir.length()
	# ДАЛЬНОСТЬ С ПОПРАВКОЙ НА ГАБАРИТ ЦЕЛИ (см. _target_pad): до здания
	# считаем до СТЕНЫ, иначе пехота лезет внутрь коробки, а стрелок жмётся
	# к ней вплотную
	var rng: float = attack_range + _target_pad
	# ── РАЗГОН УДАРНОЙ КОННИЦЫ (см. поля charge_*) ──────────────────────────
	# Одно сравнение с нулём для всей пехоты: у неё charge_range = 0, и дальше
	# этой строки ветка не идёт. Флаг взводится ровно на подходе к БОЙЦУ:
	# разгоняться на здание незачем (сминать там некого, а стена не отлетит),
	# и стойка «Защита» разгона не знает — «единый забор» не бросается вперёд
	if charge_range > 0.0 and tu != null:
		if dist > charge_range:
			# Оторвался от цели — натиск снова доступен. Это и есть
			# «разогнаться заново», и ровно это не даёт кабану снимать по
			# половине запаса с каждого встречного, не сходя с места
			_charge_ready = true
			is_charging = false
		elif _charge_ready and not _stance_holds_ground() 				and not retreating and not _disengaging:
			# Точка начала разгона запоминается ОДИН РАЗ, на взводе: по ней
			# считается, проехал ли всадник свои метры (см. charge_min_runup)
			if not is_charging:
				_charge_from = mp
				_charge_path = 0.0
				_charge_last = mp
			else:
				# Путь копится по тику: прямой разгон даёт путь ≈ смещению,
				# петля по свалке — путь много больше (см. CHARGE_STRAIGHT_FRAC)
				_charge_path += Vector2(mp.x - _charge_last.x, mp.z - _charge_last.z).length()
				_charge_last = mp
			is_charging = true
	if dist > rng:
		# ── УДАР С РАЗГОНА — В КАДР КОНТАКТА, А НЕ В КАДР ТИКА ──────────────
		# Жалоба владельца: «сначала залетают, а потом спустя время юниты
		# разлетаются». Причина в шардировании: тик бойца идёт раз в несколько
		# кадров, и «дистанция стала меньше дальности» замечалось с опозданием
		# — всадник успевал ВЪЕХАТЬ в строй, и только потом срабатывал разлёт.
		#
		# _enemy_contact ставится в тот же кадр, когда шаг РЕАЛЬНО упёрся в
		# чужое тело (Unit._move_blocked), то есть это и есть миллисекунда
		# первого касания. Ловим удар по нему, не дожидаясь, пока сойдётся
		# арифметика дистанций
		if is_charging and _enemy_contact and tu != null:
			_charge_impact(tu, dir / dist)
			return
		# ── СТЕНА ИДЁТ В ТОЧКУ ПРИКАЗА (см. _phalanx_march) ──────────────────
		# Стоит ПЕРВЫМ в ветке подхода: в обороне никакой другой способ сближения
		# не разрешён — ни подтягивание рядов, ни обход свалки, ни погоня.
		# Всё, что ниже, — способы сблизиться ПООДИНОЧКЕ, и они остаются для
		# тех, кому приказа не давали: авто-агро, подтягивание фланга, ответ на
		# удар. Условие по стойке снимали (перенос стены на атаку) и вернули —
		# разбор в command_attack и в docs/ENGINEERING_LOG.md
		if _attack_is_forced and _hold_goal_set and _stance_holds_ground():
			if _phalanx_march(delta):
				return
		# ── В ОБОРОНЕ БОЕЦ САМ К ЦЕЛИ НЕ ХОДИТ. НИКОГДА ────────────────────
		# Всё, что ниже, — способы сблизиться ПО СВОЕЙ ИНИЦИАТИВЕ: подтянуть
		# ряд, доступить по сцепке, обойти свалку, догнать. Копейщик фаланги
		# не вправе ни на один из них, и именно так фланговые и «выбегали»:
		# заметил врага, получил цель и пошёл.
		#
		# ПОРЯДОК ВАЖЕН: ворота стоят ПОСЛЕ хода стены, а не до него. Ход стены
		# — движение ОТРЯДА по приказу игрока, и он разрешён; сюда доходят
		# только те, у кого точки приказа нет, то есть кто собрался идти сам.
		# Поставь эти ворота выше — и фаланга перестанет ходить вовсе (так и
		# случилось при первой попытке закрыть выбег глухим замком позиции).
		#
		# Цель при этом НЕ бросаем: она вернётся в дальность сама, если
		# противник подойдёт, а бросок означал бы, что фаланга «забывает», с
		# кем дралась, каждый раз, когда враг отступил на шаг
		if _stance_holds_ground():
			velocity = Vector3.ZERO
			_facing = dir / dist
			# ── НО ЦЕЛЬ, ДО КОТОРОЙ НЕ ДОСТАЮ, МЕНЯ НЕ ЗАНИМАЕТ ─────────────
			# Жалоба владельца: «в момент схватки дерутся только два-три
			# крайних копейщика, остальные стоят и смотрят на врага».
			#
			# Так и было, и цепочка ровно такая. Цель бойцу нередко достаётся
			# ЧУЖАЯ — из общего ответа отряда (_squad_cached_enemy): её нашёл
			# сосед из первой шеренги, а стоящему за ним до неё семь метров.
			# Дальше боец в обороне с места не сходит и цель НЕ БРОСАЕТ — то
			# есть навсегда остаётся в State.ATTACKING. А авто-агро (единственный
			# способ заметить подошедшего вплотную противника) обслуживает
			# ТОЛЬКО State.IDLE. Враг встаёт напротив копья, а копейщик числится
			# занятым дракой с кем-то за спинами своих.
			#
			# Лечится здесь, а не отказом от общей цели: недостижимая цель у
			# стоящего строя — законное состояние (противник отступил на шаг),
			# и терять её нельзя. Нельзя только НЕ ЗАМЕЧАТЬ того, до кого
			# достаёшь. Проверка идёт тем же тактом, что и авто-агро, и по тому
			# же ответу отряда о пустой округе (_clear_enemy) — то есть в
			# спокойном строю не стоит ничего.
			#
			# ЗАМОК ПРИКАЗА ИГРОКА СИЛЬНЕЕ: ему подменять цель запрещено вовсе
			# (см. _check_auto_aggro, приоритет №1)
			_aggro_timer -= delta
			if _enemy_contact or _aggro_timer <= 0.0:
				_enemy_contact = false
				_aggro_timer = AGGRO_INTERVAL_HOT
				if not target_lock and not _clear_enemy:
					var at_reach := _find_nearest_enemy_in_range(attack_range, "hold_at_reach")
					if at_reach != null and at_reach != attack_target 							and _in_phalanx_front(at_reach):
						command_attack(at_reach, false)
			return
		# ПОДТЯГИВАНИЕ ЗАДНИХ РЯДОВ. Отряд стоит в несколько шеренг, и задние
		# физически не достают до врага: у стрелков это половина отряда, которая
		# просто стоит и смотрит. Такой боец делает шаги ВПЕРЁД, пока цель не
		# войдёт в зону поражения, — и тогда стреляет весь отряд, а не первый ряд.
		# Ограничение PULL_UP_MAX: подтягиваются именно РЯДЫ, а не бросок через
		# полкарты — за дальней целью без приказа никто не бежит
		# ПОД ЗАМКОМ ПРИКАЗА ПОДТЯГИВАНИЯ НЕТ — ИДЁМ БАЗОВОЙ СКОРОСТЬЮ.
		# Это и был «баг ползающих лучников»: _should_pull_up срабатывает на
		# любом бойце в отряде, у которого цель дальше дистанции удара но ближе
		# attack_range + PULL_UP_MAX. У лучника это до 34 м, то есть ВЕСЬ путь до
		# указанной цели он проходил на 55% скорости, приседая шажками. Ползание
		# рядов — механика для отряда, стоящего НА ПОЗИЦИИ без приказа (задние
		# шеренги подшагивают, чтобы достать); прямой приказ игрока — это марш,
		# и он идёт нормальным ходом (ветка forced ниже)
		# ── В ОБОРОНЕ ПОДТЯГИВАНИЯ К ВРАГУ НЕТ ВОВСЕ ────────────────────────
		# Подшагивание рядов ведёт бойца К ЦЕЛИ, и в стойке «Защита» это прямо
		# противоречит её смыслу: строй обязан стоять забором, а не подползать
		# за отходящим противником. Смыкание строя при этом никуда не делось —
		# им занимается _phalanx_advance, который двигает бойца к ДЫРЕ В СВОЁМ
		# СТРОЮ, а не к врагу
		if not target_lock and not _stance_holds_ground() and _should_pull_up(dist):
			dir /= dist
			_facing  = dir
			velocity = dir * (_effective_speed() * PULL_UP_SPEED)
			_commit_step(velocity * delta)
			return
		# Hold Position: без прямого приказа за целью НЕ гонимся — лучник
		# стреляет с места, пехота стоит на посту; ушла из радиуса — отбой.
		# Стойка ЗАЩИТА держит позицию всегда, даже по прямому приказу.
		#
		# ── ТРЕТИЙ СЛУЧАЙ: СТРЕЛОК УЖЕ ОТСТРЕЛЯЛСЯ ──────────────────────────
		# Дальнобойный боец подходит к указанной цели ТОЛЬКО на дистанцию
		# выстрела и на этом останавливается навсегда: цель побежала дальше —
		# он остаётся стоять и ищет новую в своём радиусе. Признак взводится в
		# тот момент, когда цель впервые оказалась в зоне поражения (ветка
		# ниже), и снимается только новым приказом. Без него лучники бежали за
		# отступающим в замок противником через полкарты
		# ── ЗДЕСЬ СТОЯЛ ЖЁСТКИЙ ЗАПРЕТ ДВИЖЕНИЯ ФАЛАНГИ, И ОН УДАЛЁН ───────────
		# Было `... or _stance_holds_ground() or ...` — то есть боец в обороне
		# бросал цель, едва она выходила за дальность оружия, ДАЖЕ ПО ПРЯМОМУ
		# ПРИКАЗУ. Это и делало «щит» синонимом «стою столбом»: клик по врагу в
		# двадцати метрах не сдвигал строй ни на шаг.
		# Теперь оборона выражена там, где ей и место, — в pursues_target() (см.
		# разбор там же): по приказу фаланга ИДЁТ, но за отступившим противником
		# лично никто не бежит. Условие ниже осталось из двух честных частей:
		# «приказа не было» и «уже подошёл, а гнаться не полагается»
		# СЦЕПКА ПЕРЕБИВАЕТ «HOLD POSITION» В УЗКОЙ ПОЛОСЕ. В обороне не
		# действует: «единый забор» не подшагивает даже на полметра
		if _melee_grip and not _stance_holds_ground() 				and dist <= rng + INTERCEPT_MARGIN:
			dir /= dist
			_facing  = dir
			velocity = dir * _effective_speed()
			_commit_step(velocity * delta)
			return
		# ── ПОВОДОК ПОГОНИ ──────────────────────────────────────────────────
		# Цель разбита не до конца и убегает, а приказ на неё жив — и боец шёл
		# за ней сколько угодно. Отряд растягивался в нитку через полкарты и
		# больше не возвращался. Теперь погоня ограничена расстоянием от точки
		# ПЕРВОГО КАСАНИЯ (см. PURSUIT_LIMIT): дальше боец забывает цель, снимает
		# замок и идёт обратно на свой пост, где его и оставил игрок.
		#
		# Это не отменяет приказ атаковать далёкую цель: якорь ставится только
		# после того, как до цели ОДИН РАЗ дотянулись
		# ── ПОВОДОК МЕРЯЕТСЯ ОТ ЯКОРЯ ОТРЯДА, А НЕ ОТ СВОЕГО ───────────────
		# Личный якорь и был причиной «растягивания на полкарты»: у переднего
		# бойца он ближе, у заднего дальше, и решение «гнать или вернуться»
		# каждый принимал своё (разбор — в GameManager._pursuit_anchor).
		#
		# ЯКОРЬ ОТРЯДА ЧИТАЕТСЯ ВНУТРИ УСЛОВИЯ, А НЕ ДО НЕГО. Это словарный
		# поиск в автозагрузке, а ветка подхода — самая горячая в тике: в
		# массовом бою через неё проходит почти вся армия каждый кадр. Первая
		# версия читала якорь безусловно, то есть платила этим поиском за
		# КАЖДОГО бойца ради проверки, которая касается только гонящихся
		# ── ЗДАНИЕ ПОВОДКОМ НЕ ОГРАНИЧИВАЕТСЯ ──────────────────────────────
		# ЗДЕСЬ И БЫЛА ПРИЧИНА «СНЕСЛИ ОДИН ДОМ — ОТРЯД РАЗБЕЖАЛСЯ». Поводок
		# погони придуман против РАСТЯГИВАНИЯ ОТРЯДА ЗА УБЕГАЮЩИМ: якорь
		# ставится в точке первого касания, и дальше семи метров боец цель
		# бросает. Дом не убегает никуда. Снеся первую хижину и перейдя на
		# соседнюю (см. _lock_next_victim), боец делал к ней те самые семь
		# метров — поводок рвался, СНИМАЛ ЗАМОК ПРИКАЗА и гнал бойца обратно на
		# пост, а пост остался там, откуда отряд вышел. Отсюда и «сносят одно
		# здание, после чего приказ слетает и они разбегаются», и цепочки
		# бойцов, уходящих из боя на базу.
		#
		# Отряд при этом не растягивается: цель НЕПОДВИЖНА, и все идут в одну
		# точку, а не за разбегающимися поодиночке
		if _pursuit_anchored and _attack_is_forced and not (attack_target is Building):
			var anch: Vector3 = _pursuit_from
			if squad_id > 0:
				var sa: Vector3 = GameManager.squad_pursuit_anchor(squad_id)
				if sa != Vector3.INF:
					anch = sa
			if Vector2(mp.x - anch.x, mp.z - anch.z).length() > pursuit_limit():
				set_attack_target(null)
				target_lock = false
				_pursuit_anchored = false
				_engaged_once = false
				velocity = Vector3.ZERO
				# Поводок сорван — снимаем якорь ВСЕМУ отряду: погоня кончилась
				# для всех сразу, иначе соседи продолжали бы мерить от неё
				GameManager.squad_pursuit_release(squad_id)
				# ВОЗВРАТ НА ПОСТ — приказом, а не силой: то же решение, что и
				# у сплочённости (GameManager._cohesion_guard)
				if _post_valid:
					command_move(post_pos)
				else:
					state = State.IDLE
				return
		# ── «ДОСТРЕЛИЛ» ЧИТАЕТСЯ И У ОТРЯДА, А НЕ ТОЛЬКО У СЕБЯ ────────────
		# Личный признак верен для того, кто уже дошёл; заказ спринта 14
		# требует, чтобы вставал ВЕСЬ отряд по первому дотянувшемуся
		# ── НО ТЕ, КОМУ ДО ЦЕЛИ ГЛУБИНА СТРОЯ, ПОДТЯГИВАЮТСЯ (15.09.2026) ──
		# «Первый дострелил — все встали» оставляло задние ряды и ВСЕХ, кто
		# короче первого (снайпер бьёт на 25, лук на 20), стоять столбом в
		# 3-6 м от своей дальности: отряд по ПКМ «тупил» — цель в 26 м,
		# половина не стреляет и не идёт. Отметка держит только тех, кому до
		# цели дальше SQUAD_SHOT_SLACK сверх своей дальности (это и есть
		# «нитка за отступающим»); задние ряды доходят и встают в зоне огня
		var squad_shot: bool = not pursues_target() and squad_id > 0 \
			and GameManager.squad_ranged_engaged(squad_id) \
			and dist > rng + SQUAD_SHOT_SLACK
		if not _attack_is_forced or ((_engaged_once or squad_shot) and not pursues_target()):
			set_attack_target(null)
			velocity = Vector3.ZERO
			# ЗДЕСЬ ТОЖЕ ПРОДОЛЖАЕМ МАРШ. Это ветка «цель ушла из зоны удара,
			# гнаться не буду»: боец бросает противника и раньше просто вставал
			# столбом — даже если его вообще-то послали на другой конец карты.
			# Замер (qa_world3, М4): одиночка, шедший через всю диагональ,
			# замечал по дороге вражеский замок, признавал его недосягаемым и
			# останавливался в трёх метрах от точки приказа
			if _march_pending and _resume_march():
				return
			state    = State.IDLE
			return
		# ── ПЕРЕХВАТ ЧУЖИМ СТРОЕМ НА ПОДХОДЕ К ПРИКАЗАННОЙ ЦЕЛИ ────────────────
		# Симметрично _process_move: раньше approach к forced-цели вообще не
		# читал _enemy_contact, и отряд, посланный на дальнюю цель, проходил
		# СКВОЗЬ любой другой вражеский отряд по пути, не нанеся и не получив ни
		# царапины (qa_approach_intercept, было НЕ ПРОШЛО). Контакт со строем
		# перебивает марш немедленно, обычный опрос — раз в AGGRO_INTERVAL_HOT.
		# forced = false у нового вызова: приказ на исходную цель не забывается
		# (см. _atk_pending), помеха — не он
		# ── ЗАСТРЯЛ НА ПОДХОДЕ — БЬЁМ ТОГО, КТО РЯДОМ (спринт 20, модуль 3.3) ─
		# Десять отрядов на одного тролля: кому места у туши не хватило, тот
		# упирался в спины своих и «бежал на месте». Детектор застревания
		# (тот же, что у марша и рабочих) через STUCK_RETARGET_STREAK проверок
		# без продвижения переводит бойца на ближайшего врага в
		# STUCK_RETARGET_RANGE — не на приказанного. forced = true: до соседа
		# ещё надо дойти, а неприказанную цель вне досягаемости боец бросает
		# (ветка «гнаться не буду» ниже). Замок приказа при этом цел: выбьют
		# соседа — _lock_next_victim вернёт бойца к назначенному отряду
		if not _stance_holds_ground() and not retreating and not sprinting:
			if _tick_stuck(delta, dist) and _stuck_streak >= STUCK_RETARGET_STREAK:
				var alt := _find_nearest_enemy_in_range(STUCK_RETARGET_RANGE, "stuck_retarget")
				if alt != null and alt != attack_target:
					_reset_stuck()
					stuck_retargets += 1
					velocity = Vector3.ZERO
					command_attack(alt, true)
					return
		if not retreating and not sprinting and not _disengaging:
			# ── ПРИОРИТЕТ №2: ЗАСЛОН ВПЛОТНУЮ ──────────────────────────────
			# Под замком приказа помеха обязана быть ФИЗИЧЕСКОЙ — телом «в лоб»,
			# а не любым силуэтом в дальности оружия. Радиус перехвата
			# attack_range + INTERCEPT_MARGIN у лучника равен его двадцати метрам:
			# отряд, посланный на конкретную цель, замирал на полпути и
			# расстреливал случайную мишень вместо назначенной (см. LOCK_BLOCKER_RANGE).
			# Контакт при этом ловится по-прежнему в тот же кадр (_enemy_contact
			# ставит _move_blocked, когда шаг реально упёрся в чужой строй)
			var blk_range: float = attack_range + INTERCEPT_MARGIN
			if target_lock:
				blk_range = minf(attack_range, LOCK_BLOCKER_RANGE) + INTERCEPT_MARGIN
			_aggro_timer -= delta
			if _enemy_contact or _aggro_timer <= 0.0:
				_enemy_contact = false
				_aggro_timer = AGGRO_INTERVAL_HOT
				var blocker := _find_nearest_enemy_in_range(blk_range, "blocker_march")
				if blocker != null and blocker != attack_target:
					velocity = Vector3.ZERO
					command_attack(blocker, false)
					_melee_grip = true      # см. разбор у поля: лечит «челнок»
					return
		dir /= dist
		_facing  = dir
		# Шаг может идти В ОБХОД (см. _flank_step), поэтому velocity считается
		# по фактическому направлению движения, а не по направлению на цель —
		# иначе вектор скорости и реальное перемещение расходятся.
		#
		# ── НО НЕ В ОБОРОНЕ ─────────────────────────────────────────────────
		# _flank_step — это индивидуальное обтекание свалки сбоку: боец, упёршийся
		# в спины своих, обходит их по дуге. Для фаланги это ровно то, чего быть
		# не должно: «единый забор» держится тем, что никто не выходит из
		# шеренги. Строй идёт в лоб, а дыры в нём закрывает смыкание рядов
		# (_phalanx_advance), а не самовольный обход
		# ── К ЗДАНИЮ ИДЁМ В СВОЙ СЕКТОР, А НЕ В ЕГО ЦЕНТР ──────────────────
		# Пять отрядов, посланных на одну постройку, шли к ОДНОЙ точке — её
		# центру — и слипались в кашу (замер qa_mass_siege: 1.3 м между
		# центрами отрядов). Приказ уже раздал каждому отряду свой сектор
		# кольца (SelectionManager._ring_squads_around); осталось, чтобы подход
		# его читал. Пока боец далеко — правим направление на сектор; вблизи
		# ведёт обычная логика, иначе он не смог бы ударить в стену.
		#
		# Словарный поиск в автозагрузке стоит ВНУТРИ узкого условия «цель —
		# здание», а не снаружи: ветка подхода самая горячая в тике, и платить
		# им за каждого бойца в свалке нельзя
		if squad_id > 0 and attack_target is Building and dist > rng:
			var anc: Vector3 = GameManager.squad_attack_anchor(squad_id)
			if anc != Vector3.INF:
				var adx: float = anc.x - mp.x
				var adz: float = anc.z - mp.z
				var ad: float = sqrt(adx * adx + adz * adz)
				# ── СЕКТОР ВЕДЁТ РОВНО ОДИН РАЗ ЗА ПОДХОД ───────────────
				# Здесь была КАЧЕЛЯ, и она объясняет жалобу «отряды дёргаются и
				# бесконечно перебегают с места на место» целиком. Боец шёл к
				# своей точке на кольце; дойдя (ad <= RING_ARRIVE), он получал
				# обычный путь и делал шаг К СТЕНЕ — и тем самым СНОВА уходил от
				# точки дальше RING_ARRIVE. Следующий же тик возвращал его на
				# кольцо. Замер qa_wall B3: сто пятьдесят бойцов встали в 4.97 м
				# от хижины при дистанции удара 4.0 и не сняли с неё НИ ОДНОГО
				# очка жизни за восемнадцать секунд.
				# Признак взводится в момент прихода и держится до нового
				# приказа: сектор — это способ ПОДОЙТИ, а не место, к которому
				# привязан боец
				var held: bool = GameManager.squad_attack_hold(squad_id)
				# ── ДЕРЖАЩИЙ ОТРЯД ПРИХОДИТ К ТОЧКЕ ЦЕНТРОМ ──────────────────
				# Сектор — ТОЧКА, а отряд — тридцать пять тел. Пока каждый шёл
				# к самой точке и вставал в RING_ARRIVE от неё, все тридцать
				# пять останавливались с той стороны, откуда пришли, и центр
				# отряда оказывался в трёх метрах СНАРУЖИ сектора (qa_mass_siege
				# S1: отставание 3.3-3.4 м у второго ряда при пороге 3.0, у
				# первого ряда ноль — он идёт дальше, к стене). Тот же перенос,
				# что у стены строя (_wall_goal): точка каждого смещена на
				# вектор «сектор минус центр отряда», и к сектору приходит
				# ЦЕНТР, а взаимное расположение тел не меняется
				if held:
					var anc_me: Vector3 = _wall_goal(anc)
					adx = anc_me.x - mp.x
					adz = anc_me.z - mp.z
					ad = sqrt(adx * adx + adz * adz)
				if ad > RING_ARRIVE and (held or not _ring_done):
					dir = Vector3(adx / ad, 0.0, adz / ad)
					_facing = dir
				elif ad <= RING_ARRIVE and not held:
					_ring_done = true
				elif held:
					# ── ВТОРАЯ ЛИНИЯ ОСАДЫ: ДОШЁЛ И ЖДУ ─────────────────────
					# Мест у стены ровно столько, сколько отрядов помещается на
					# рабочей дуге (см. _ring_squads_around). Кому не досталось —
					# стоит на своей точке, а не лезет в занятое: десять отрядов,
					# посланных на одну хижину, иначе сходятся в одну кучу,
					# расталкивание их разбрасывает, подход гонит обратно.
					# Признак сам гаснет по сроку, поэтому выбитую переднюю
					# линию вторая всё равно сменит
					velocity = Vector3.ZERO
					_facing = dir
					return
		# ── ПОДХОД В ОБХОД СКАЛ И ВОДЫ (спринт 19, письмо 11) ──────────────
		# Цель за обрывом: прямая упирается в стену, и раньше боец шёл в неё
		# лбом и дёргался у подножия. Теперь раз в NAV_RECHECK_SEC прямая
		# проверяется по сетке ядра, и упёршийся получает угол обхода — до
		# спуска, а оттуда к цели. Вплотную к цели обход не нужен
		var nav_detour := false
		if dist > rng + 1.0 and GameManager.nav_cells_blocked > 0 and GameManager.world_bounds_enabled:
			var wp: Vector3 = _atk_waypoint(mp, tp, delta)
			if wp.x != INF:
				var wdx: float = wp.x - mp.x
				var wdz: float = wp.z - mp.z
				var wl: float = sqrt(wdx * wdx + wdz * wdz)
				if wl > 0.05:
					dir = Vector3(wdx / wl, 0.0, wdz / wl)
					_facing = dir
					nav_detour = true
		var step_dir := dir if _stance_holds_ground() else _flank_step(dir, dist)
		velocity = step_dir * _effective_speed()
		# ── ВЗВОД АВТОПИЛОТА ПОДХОДА (этап D1) ──────────────────────────────
		# Боец УЖЕ решил идти по прямой к цели этим тиком (все перехваты выше
		# промолчали, обход свалки не понадобился — step_dir совпал с dir).
		# Дальше до сближения решать нечего: шаг кладёт ядро, направляясь на
		# ЖИВУЮ строку цели, а стражи (дистанция, контакт, враг в длине руки)
		# будят обратно. Конница не взводится (взвод разгона меряет свой
		# пробег по тикам), фаланга — тоже (её ведёт ход стены)
		# ...И ТОЛЬКО ПО ОБЪЯВЛЕННО ЧИСТОМУ ПУТИ (_clear_enemy от коридора
		# отряда): у чужой стены автопилот не включается вовсе — его цикл
		# «шаг-скольжение-пробуждение» прощупывал щели настойчивее полного
		# автомата, и qa_wall A1 уехал с 1-3 просочившихся на 5-8. Дорога в
		# чистом поле (марш-подход через полкарты) — его настоящая работа
		if _Opt.approach_autopilot and _soa >= 0 and tu != null \
				and tu._soa >= 0 and dist > rng + AUTOPILOT_ARM_SLACK \
				and _clear_enemy \
				and not _stance_holds_ground() and charge_range <= 0.0 \
				and not _melee_grip and not retreating and not sprinting \
				and not _disengaging and not _rear_press and not nav_detour \
				and step_dir.dot(dir) > 0.999:
			_auto_pilot = true
			GameManager.army.autopilot_arm(_soa, _effective_speed(), rng)
		# ── ПОДХОД К ЦЕЛИ ИДЁТ ТЕМ ЖЕ ПАКЕТНЫМ ПУТЁМ, ЧТО И МАРШ ────────────
		# Замер (qa_fx --prof, 3000, фаза «стоят»): process_attack — 68 % тика
		# при 11.6 мкс на вызов, и 6.5 из них это mb_enemyblock + mb_trunk +
		# mb_commit, то есть ровно тот поштучный шаг, который для марша уже
		# вынесен в пакет. Держать две разные дороги для одного и того же
		# перемещения незачем
		_commit_step(velocity * delta)
	else:
		velocity = Vector3.ZERO
		# ── СТОЛКНОВЕНИЕ С РАЗГОНА ──────────────────────────────────────────
		# ПЕРВЫМ ДЕЛОМ и с немедленным выходом. Немедленным — потому что удар
		# может убить цель прямо здесь, а ниже по функции ветка удара берёт
		# attack_target в локальную ссылку и бьёт по ней: сигнал died обнулил бы
		# её между этими двумя строками. Один кадр задержки обычному удару не
		# стоит ничего — всадник только что въехал в строй
		if is_charging:
			_charge_impact(tu, (dir / dist) if dist > 0.01 else _facing)
			return
		# ЦЕЛЬ В ЗОНЕ ПОРАЖЕНИЯ — приказ «дойти и стрелять» исполнен. Дальше
		# дальнобойный боец с места не сходит (см. pursues_target выше)
		if not _engaged_once:
			# ОТСЮДА СЧИТАЕТСЯ ПОГОНЯ (см. PURSUIT_LIMIT): цель достали здесь,
			# и если она побежит, преследовать её можно ровно до поводка.
			# ЯКОРЬ СТАВИТСЯ ОТРЯДУ, а не только себе: первый дотянувшийся
			# задаёт точку отсчёта всем — так весь отряд гонит и возвращается
			# одним решением (см. GameManager.squad_pursuit_anchor)
			_pursuit_from = mp
			_pursuit_anchored = true
			if squad_id > 0:
				GameManager.squad_pursuit_anchor_set(squad_id, mp)
				# ── ОТРЯД СТРЕЛКОВ ВСТАЁТ ЦЕЛИКОМ (заказ спринта 14) ────────
				# Первый дотянувшийся объявляет за всех: дальше ни один
				# стрелок отряда не подходит, все стоят и бьют то, до чего
				# достают. Разбор — GameManager.squad_ranged_engaged_set
				# Снайпер (дальность выше отрядной) за отряд не объявляет:
				# иначе отряд вставал за 25 м, а луки достают на 20
				if not pursues_target() and _announces_squad_shot():
					GameManager.squad_ranged_engaged_set(squad_id)
		_engaged_once = true
		_attack_timer -= delta
		# ── ГОТОВ, НО ЖДЁТ КОМАНДЫ ──────────────────────────────────────────
		# По умолчанию боец бьёт сразу, как перезарядился, и эта ветка ничего не
		# стоит (одно сравнение с true). Переопределяет её только лучник в режиме
		# залпа: отряд стреляет разом, а не по мере готовности каждого.
		# Таймер при этом ЗАЖИМАЕТСЯ В НОЛЬ, а не уходит в минус: «готов» —
		# состояние, и по нему отряд считает, сколько его бойцов уже ждут
		# (GameManager._sweep_volleys)
		if _attack_timer <= 0.0 and not _may_strike_now():
			_attack_timer = 0.0
		elif _attack_timer <= 0.0:
			# Счётчик atk_strike — САМ УДАР без списания урона: кулдаун, расчёт
			# силы, два звука, толчок шеренги, отметка на снаряде. Списание урона
			# считается отдельно (atk_damage, на стороне цели), иначе одно число
			# скрывало бы два разных ответа
			var _prof_s: bool = _prof_on
			var _t_s: int = Time.get_ticks_usec() if _prof_s else 0
			_attack_timer = _effective_cooldown()   # в обороне бьют на 25% чаще
			var dmg: float = _strike_damage() + _upgrade_damage_bonus()
			# Локальная ссылка: take_damage может убить цель, и сигнал died
			# обнулит attack_target ещё до вызова _on_attack_fired
			var tgt := attack_target
			var pdir := (dir / dist) if dist > 0.01 else _facing
			# СТРЕЛКИ урон здесь НЕ наносят: он уходит в снаряд и списывается
			# только при физическом касании стрелы (см. Archer / Arrow.gd)
			if _damage_on_strike():
				tgt.take_damage(dmg, self)
				# ЗВУК ПОПАДАНИЯ идёт отдельно от звука замаха: лязг по броне
				# должен совпадать с моментом урона, а свист — с движением
				AudioManager.play_3d(_sfx_hit(), global_position)
			AudioManager.play_3d(_sfx_swing(), global_position)
			_maybe_battle_shout()
			_strike_count += 1
			# Толкание — не на каждый удар, а раз в PUSH_EVERY ударов: шеренга
			# с превосходящим напором ПОСТЕПЕННО оттесняет чужую, а не
			# отбрасывает противника рывком с каждого тычка
			if attack_range <= 3.0 and _strike_count % maxi(push_every, 1) == 0 \
					and tgt is Unit and not (tgt as Unit).is_dead():
				_apply_push(tgt as Unit, pdir)
			_on_attack_fired(tgt, dmg)
			if _prof_s: _Opt.prof_add("atk_strike", Time.get_ticks_usec() - _t_s)
		# ── ВЗВОД ДРЁМЫ (см. ворота в начале функции) ───────────────────────
		# Цель в упоре, удар остывает — до пробуждения этому бойцу нечего
		# решать. Лучник, ждущий команды залпа, не дремлет по построению: его
		# таймер зажат в ноль, а ноль меньше запаса. Кулдаун и досягаемость
		# уезжают в ядро ОДНИМ вызовом — дальше до пробуждения ни одного
		# перехода границы (боец без строки в ядре не дремлет и идёт полным
		# автоматом, как раньше)
		if _Opt.atk_snooze and _attack_timer > ATK_SNOOZE_SPARE \
				and not is_charging and _soa >= 0:
			_atk_snooze = true
			# ЛЮФТ ДОСЯГАЕМОСТИ ОБЯЗАТЕЛЕН. Свалка качает пары на ±полметра
			# каждую пару кадров, и стража по ГОЛОЙ дальности будила дремлющих
			# почти сразу — замер qa_mass3k: с люфтом 0 выигрыша нет вовсе,
			# вызовы полного автомата не падают. Ложного удара люфт не даёт:
			# проснувшись, боец заново меряет дистанцию штатным тиком, и цель
			# за дальностью получает подход, а не выстрел
			GameManager.army.atk_snooze_arm(_soa, _attack_timer,
				attack_range + _target_pad + ATK_SNOOZE_REACH_SLACK)

## ── ПОГОНЯ ЗА ЦЕЛЬЮ, ВЫШЕДШЕЙ ИЗ ЗОНЫ ПОРАЖЕНИЯ ─────────────────────────────
## Ближний бой — да: без погони мечник вообще не может драться, его дистанция
## удара меньше двух метров. Стрелки — НЕТ (переопределяет Archer): дальность у
## них двадцать метров, и «догнать» для них означает бросить строй и убежать за
## отступающим противником прямо под его стены. Это правило игрока, а не
## оптимизация: «Лучники НИКОГДА не преследуют».
## Приказ игрока при этом работает: боец ПОДХОДИТ на дистанцию выстрела —
## запрет включается только после того, как цель первый раз оказалась в зоне
## поражения (_engaged_once)
##
## ── СТОЙКА «ЗАЩИТА» — ВТОРОЙ СЛУЧАЙ ЗАПРЕТА ПОГОНИ, И ОН ЖЕ СНЯЛ СТАРЫЙ ЗАПРЕТ
## ДВИЖЕНИЯ ЦЕЛИКОМ (заказ владельца, авг. 2026).
##
## Было так: в обороне _process_attack ОБНУЛЯЛ цель, едва та выходила за
## дальность оружия, — даже по прямому приказу. То есть «щит» означал «стою
## столбом»: фаланга, которой кликнули по врагу в двадцати метрах, не делала ни
## шагу. Требование теперь другое и делится ровно надвое:
##   • В ПОКОЕ (приказа нет) строй держится намертво — это по-прежнему так,
##     потому что авто-агро в обороне берёт только то, до чего достаёт копьё
##     (_check_auto_aggro), а ответный навал заблокирован (take_damage).
##   • ПО ПРИКАЗУ (клик по врагу, клик за спину, растянутый ПКМ) фаланга ИДЁТ
##     ВПЕРЁД единым забором с опущенными копьями и бьёт всё, до чего дотянется
##     по дороге.
## Разница между «идти по приказу» и «гнаться за убегающим» — это ровно
## _engaged_once: боец доходит до назначенного противника, а когда тот
## отступает — остаётся стоять и берёт следующего, кто окажется в досягаемости.
## Индивидуальной погони не возникает по построению, и для этого не нужен ни
## один новый флаг: механизм уже был написан для лучников.
func pursues_target() -> bool:
	return not _stance_holds_ground()

## Дострелившийся объявляет «встали всем отрядом» (см. squad_ranged_engaged_set).
## У снайпера дальность выше отрядной — он молчит (Archer)
func _announces_squad_shot() -> bool:
	return true

## На сколько метров сверх своей дальности стрелок ещё подтягивается к цели
## после отрядной отметки «встали» — глубина строя плюс шаг
const SQUAD_SHOT_SLACK := 6.0

## ── ДАЛЬНОБОЙНЫЙ ЛИ ЭТО РОД ВОЙСК ──────────────────────────────────────────
## Свойство РОДА, а не стойки и не состояния: у пехоты attack_range — это длина
## руки (2-3 м), у стрелка — выстрел (20 м и больше). Порог тот же, по которому
## интерфейс решает, показывать ли строку «Range» в карточке (HUD.MELEE_RANGE_MAX):
## два разных числа для одного вопроса однажды разошлись бы.
##
## Заведено ради хода стены (см. command_attack): подходить к цели строем надо
## тому, кто иначе не достанет, а стрелок достаёт с места
const RANGED_ATTACK_MIN := 5.0

func _is_ranged() -> bool:
	return attack_range > RANGED_ATTACK_MIN

## Цель хотя бы раз побывала в зоне поражения с момента последнего приказа
var _engaged_once: bool = false

## ── ПОВОДОК ПОГОНИ: ДОКУДА ГОНИМ ОТСТУПИВШЕГО ──────────────────────────────
## Точка, где боец ВПЕРВЫЕ достал приказанную цель. От неё считается погоня.
## AGGRO_LEASH — про другое: он ограничивает инициативу бойца от места, куда
## его поставили, и на прямой приказ игрока не действует вовсе. Здесь же приказ
## как раз есть, цель разбита не до конца и убегает, и без ограничения отряд
## уходил за ней хоть через всю карту, растягиваясь в нитку.
##
## Отсчёт начинается ровно с первого касания, а не с момента приказа: иначе
## сорвался бы законный приказ «атаковать вон тех, в сорока метрах»
var _pursuit_from: Vector3 = Vector3.ZERO
var _pursuit_anchored: bool = false

## Номер прохода пакетного боя, на котором этот боец попал в список «нужен
## полный автомат» (см. GameManager.atk_frame)
var _atk_frame: int = -1

# ═══════════════════════════════════════════════════════════════════════════
# ФАЛАНГА В ДВИЖЕНИИ: ИДЁМ В ТОЧКУ ПРИКАЗА, А НЕ ЗА ЦЕЛЬЮ
# ═══════════════════════════════════════════════════════════════════════════
# Требование владельца делит поведение обороны надвое, и вторая половина —
# именно эта: «Фаланга медленно идёт вперёд единым забором, выставив копья, и
# поражает всё на пути своего фронта. Никакого индивидуального преследования
# уходящих врагов».
#
# Оба слова важны и противоречат друг другу, если целиться в ЖИВУЮ цель: строй,
# идущий за отступающим противником, — это и есть преследование, только всем
# отрядом сразу. Поэтому в обороне приказ атаки запоминает ТОЧКУ, где враг стоял
# в момент приказа, и строй идёт туда. Что попадётся по дороге — будет побито
# (контакт со строем ловится тем же способом, что и на марше); противник, успевший
# убежать, просто перестаёт быть чьим-либо делом.
#
# В стойке АТАКА ничего этого нет: там преследование — штатное поведение пехоты.
var _hold_goal: Vector3 = Vector3.ZERO
var _hold_goal_set: bool = false

## Шаг стены к точке приказа. Возвращает false, когда идти больше некуда
func _phalanx_march(delta: float) -> bool:
	if not _hold_goal_set:
		return false
	# ── ЗАЛОЧЕННАЯ СТОЙКА НЕ ХОДИТ ДАЖЕ ПО ПРИКАЗУ ────────────────────────
	# Это и был второй законный путь, которым фаланга «уплывала» вперёд.
	# Точку приказа гасим здесь же, а не оставляем висеть: иначе она выстрелит
	# в тот кадр, когда игрок переключит стойку, — то есть отряд рванёт туда,
	# куда ему показывали ещё в обороне
	if _stance_locks_position():
		_hold_goal_set = false
		_attack_is_forced = false
		velocity = Vector3.ZERO
		return false
	# Своя точка — по дешёвому пути (правило 2): ходом стены идёт вся фаланга,
	# то есть эта строка проходится каждым копейщиком в каждом его тике
	var cur: Vector3 = position if _local_xform else global_position
	var gx: float = _hold_goal.x - cur.x
	var gz: float = _hold_goal.z - cur.z
	var gd: float = sqrt(gx * gx + gz * gz)
	if gd <= ARRIVE_RADIUS:
		# Пришли куда велели. Приказ исполнен: дальше боец живёт обычной
		# обороной — бьёт то, до чего достаёт, и с места не сходит
		_hold_goal_set = false
		_attack_is_forced = false
		_engaged_once = true
		velocity = Vector3.ZERO
		return false
	# ── ЧТО ПОПАЛОСЬ ПОД КОПЬЁ ПО ДОРОГЕ ────────────────────────────────────
	# Цель подменяется НАПРЯМУЮ, а не через command_attack: тот переписал бы
	# _attack_is_forced значением своего аргумента и стёр бы сам приказ, ради
	# которого строй и идёт. Здесь меняется только то, кого бьём сейчас
	_aggro_timer -= delta
	if _enemy_contact or _aggro_timer <= 0.0:
		_enemy_contact = false
		_aggro_timer = AGGRO_INTERVAL_HOT
		var at_hand := _find_nearest_enemy_in_range(attack_range, "march_at_hand")
		if at_hand != null and at_hand != attack_target:
			set_attack_target(at_hand)
			velocity = Vector3.ZERO
			return true
	var d := Vector3(gx / gd, 0.0, gz / gd)
	_facing = d
	velocity = d * _effective_speed()
	_commit_step(velocity * delta)
	return true

## МОЖНО ЛИ БИТЬ ПРЯМО СЕЙЧАС, когда перезарядка уже вышла.
## По умолчанию да — обычный боец ни у кого разрешения не спрашивает.
## Переопределяет только лучник в режиме залпового огня (см. Archer)
## ── ВО СКОЛЬКО РАЗ БОЛЬНЕЕ БЬЁТ ПО МНЕ СТРЕЛА ─────────────────────────────
## Свойство ЦЕЛИ, а не стрелка, и читается ОДИН раз — в момент попадания
## (`Arrow._strike`). В горячем пути рукопашной его нет вовсе: пехота за
## уязвимость крупных мишеней не платит ни одного сравнения.
## Единица у всех, кроме туш: крупная мишень — подарок для лучников
func ranged_damage_mult() -> float:
	return 1.0

## ── КРУПНАЯ ЦЕЛЬ ДЛЯ «ГРОЗЫ ВЕЛИКАНОВ» (ТЗ 14.09.2026) ─────────────────────
## Туша, тролль, конница: множитель урона стрелы bonus_giant. Конница — всё,
## что умеет разгон (charge_range > 0); туша переопределяет явно
func giant_class() -> bool:
	return charge_range > 0.0

## Снайперская стрела убивает С ОДНОГО попадания — всех, кроме крупных
## (туша, тролль: те переопределяют в false и получают обычный урон)
func snipe_one_shot() -> bool:
	return true

## Точка «в голове» для снайперской стрелы у бойца БЕЗ тела в общем слое
## (тролль рисует своё тело сам). Vector3.INF — брать по телу из CorpseRenderer
func snipe_head_spot() -> Vector3:
	return Vector3.INF

func _may_strike_now() -> bool:
	return true

# true — урон списывается сразу при ударе (ближний бой).
# Стрелки переопределяют на false: у них урон несёт летящая стрела.
func _damage_on_strike() -> bool:
	return true

# ── ФЛАНГОВЫЙ ОХВАТ ──────────────────────────────────────────────────────────
# Задний ряд, упёршийся в спины своих, идёт к цели не в лоб, а по дуге:
# к направлению на врага добавляется боковая составляющая, и боец обтекает
# свалку сбоку. Так в контакт входит вся линия, а не только первая шеренга.
# Сторона обхода детерминирована (по instance_id) — соседи расходятся
# в РАЗНЫЕ стороны и не толкутся друг за другом.
const FLANK_TRIGGER_DIST := 3.5    # ближе этого к цели уже идёт свалка
const FLANK_STRENGTH     := 0.85   # доля боковой составляющей в шаге
# Пересчёт «свободен ли проход» — раз в столько физ. кадров.
# ПОЧЕМУ НЕ КАЖДЫЙ КАДР: проверка идёт через unit_grid.query_radius(), а он
# АЛЛОЦИРУЕТ массив (в отличие от allies_ahead, намеренно написанного без
# аллокаций). Каждый кадр на каждого бойца в свалке — это тысячи аллокаций
# в кадр на самом горячем месте игры. Обстановка в свалке за 10 кадров
# (1/6 секунды) меняется мало, поэтому решение кэшируется.
const FLANK_RECHECK_FRAMES := 10

var _flank_blocked: bool = false   # закэшированный вердикт «проход занят»
## Сторона, в которую этот боец обходит помеху: +1 или −1. Считается один раз
## при рождении (см. _ready) — соседи по-прежнему расходятся в РАЗНЫЕ стороны,
## просто номер узла больше не спрашивается у движка в каждом тике
var _side_sign: float = 1.0

func _flank_step(dir: Vector3, dist: float) -> Vector3:
	if dist > FLANK_TRIGGER_DIST:
		_flank_blocked = false
		return dir              # далеко от свалки — идём прямо
	if (phys_frame + _sep_phase) % FLANK_RECHECK_FRAMES == 0:
		_flank_blocked = _own_units_ahead(dir)
	if not _flank_blocked:
		return dir              # проход свободен — в лоб
	# Сторона обхода детерминирована: соседи расходятся в РАЗНЫЕ стороны
	var side := Vector3(-dir.z, 0.0, dir.x) * (-_side_sign)
	return (dir + side * FLANK_STRENGTH).normalized()

# Стоят ли между нами и целью хотя бы двое своих.
# СЧЁТ БЕЗ АЛЛОКАЦИИ: раньше здесь звался query_radius(), отдающий новый Array
# на каждый вызов. В свалке на тысячу бойцов это сотни мусорных массивов в кадр
func _own_units_ahead(dir: Vector3) -> bool:
	return GameManager.unit_grid.allies_count_near(
		self, global_position + dir * 0.8, 0.9, 2) >= 2

# Урон конкретного удара; Warrior переопределяет для ротации 3×attack_1 + 1×attack_2
func _strike_damage() -> float:
	return attack_damage

## ── АУРЫ МОНАХА (спринт 19, письмо 12) ────────────────────────────────────
## Монах раз в MONK_AURA_TICK раздаёт соседям три числа с коротким сроком:
## броня (к общей защите), удар (только рукопашным) и темп стрельбы (только
## стрелкам, доля к перезарядке). Срок чуть дольше такта, поэтому под живым
## монахом аура непрерывна, а ушедший из круга теряет её за секунду
var _aura_armor: float = 0.0
var _aura_attack: float = 0.0
var _aura_rate: float = 0.0
var _aura_until_ms: int = 0

func aura_apply(armor_add: float, attack_add: float, rate_add: float, until_ms: int) -> void:
	if now_ms >= _aura_until_ms:
		_aura_armor = armor_add
		_aura_attack = attack_add
		_aura_rate = rate_add
	else:
		_aura_armor = maxf(_aura_armor, armor_add)
		_aura_attack = maxf(_aura_attack, attack_add)
		_aura_rate = maxf(_aura_rate, rate_add)
	_aura_until_ms = maxi(_aura_until_ms, until_ms)

func aura_active() -> bool:
	return now_ms < _aura_until_ms

## БОЕВОЙ ЛИ ЭТО БОЕЦ (спринт 19). Признак раньше читался как
## `attack_damage > 0`, и он был верен, пока безоружным был ровно рабочий.
## Теперь у рабочего есть топор (письмо 10), а солдатом он от этого не стал:
## клич, реплики приказов, голосовое «все», массовость выделения считают по
## ЭТОМУ методу, а не по урону. Рабочий переопределяет его в false
func is_combatant() -> bool:
	return attack_damage > 0.0

# Итоговые напор и мораль с бонусами кузницы (знамя/мечи/шлемы) и стойкой.
# ПАРИТЕТ ФРАКЦИЙ: формула одинакова для игрока и ИИ, фракция в неё не входит
# вообще — при равных характеристиках, апгрейдах и морали строи стоят вничью.
## ── МНОЖИТЕЛЬ ТОЛЧКА, ПРИМЕНЯЕМЫЙ ПОСЛЕ ПОТОЛКА ШАГА ──────────────────────
## Именно ПОСЛЕ, и в этом весь смысл (разбор — в _apply_push): потолок 0.4 м
## срабатывает уже при разнице напора в три единицы, и всё, что домножено до
## него, съедает тот же clampf. База — поле `charge_push_mult` (конница);
## приёмы, которым нужен временный навал, переопределяют этот метод
func _push_after_cap() -> float:
	# Остановленный стеной копий не давит вовсе (см. spear_wall_strike)
	if _counter_hit_until_ms > now_ms:
		return 0.0
	return charge_push_mult

func _push_power() -> float:
	_refresh_power()
	return _pw_attack

## Сила, с которой юнит УПИРАЕТСЯ. В отличие от _push_power() НЕ зависит от
## push_mult: фаланга сама не толкает, но стоит как вкопанная. Раньше упор
## считался тем же _push_power(), и обнулённый пуш обороны делал строй
## ЛЕГЧЕ обычного юнита — его отбрасывало сильнее всех.
## Мораль сюда входит с множителем стойки (+30% в обороне), так что фаланга
## упирается заведомо крепче той же пехоты в атаке.
func _stand_power() -> float:
	_refresh_power()
	return _pw_stand

## ── НАПОР И УПОР КЭШИРУЮТСЯ, КАК И БАЗОВАЯ СКОРОСТЬ ────────────────────────
## Приём тот же и по той же причине, что у _base_speed(): величина складывается
## из чтений в автозагрузке (два обращения к таблице бонусов кузницы) и двух
## поисков в таблице стоек, а меняется считанные разы за партию.
##
## РАНЬШЕ ЭТО БЫЛО НЕ ВАЖНО, А ТЕПЕРЬ ВАЖНО. Толчок срабатывал раз в десять
## ударов, и четыре словарных поиска на такое событие никого не волновали.
## С постоянным расчётом напора (см. PUSH_EVERY) он идёт НА КАЖДЫЙ УДАР, причём
## считается дважды — свой и чужой (_apply_push). Замер qa_mass_battle на 5000
## бойцов: свалка 15.14 → 16.05 мс при переходе на «каждый удар», то есть почти
## миллисекунда кадра ушла на пересчёт того, что не менялось.
##
## В КЛЮЧ ВХОДЯТ ВСЕ ВХОДНЫЕ ВЕЛИЧИНЫ, а не только версия таблицы бонусов:
## стойку игрок переключает кнопкой, мораль и push_force правит ветеранство
## отряда (GameManager._apply_bonus_to_unit пишет прямо в поля)
var _pw_ver: int = -1
var _pw_stance: String = ""
var _pw_morale: float = -1.0
var _pw_push: float = -1.0
var _pw_stand: float = 0.0
var _pw_attack: float = 0.0

func _refresh_power() -> void:
	var ver: int = GameManager.bonus_version
	if _pw_ver == ver and _pw_morale == morale and _pw_push == push_force \
			and _pw_stance == stance:
		return
	_pw_ver     = ver
	_pw_stance  = stance
	_pw_morale  = morale
	_pw_push    = push_force
	_pw_stand   = push_force + GameManager.unit_bonus(faction, stat_id, "bonus_push") 		+ _effective_morale() * 0.01
	# ── «ТАРАН»: ЛЕГЕНДАРНЫЙ ПЕРК НАПОРА ───────────────────────────────────
	# Здесь, а не в самом ударе: напор и упор кэшируются (см. шапку функции), и
	# перк, спрошенный в _apply_push, стоил бы словарного поиска в автозагрузке
	# на КАЖДЫЙ удар
	if squad_id > 0 and GameManager.squad_has_perk(squad_id, "legend_juggernaut"):
		_pw_stand *= _UStats.LEGEND_PUSH_MULT
	var mult: float = _UStats.stance_stat(stance, "push_mult", 1.0)
	# Оборона: СВОЕГО пуша у фаланги нет вовсе, но упирается она по-прежнему
	_pw_attack = 0.0 if mult <= 0.0 else _pw_stand * mult

# Мораль с бонусами кузницы и множителем стойки (+30% в обороне)
func _effective_morale() -> float:
	var m: float = morale + GameManager.unit_bonus(faction, stat_id, "bonus_morale")
	return m * _UStats.stance_stat(stance, "morale_mult", 1.0)

# Механика PUSH: шеренга с большей суммой (push_force + morale/100)
# оттесняет противника назад по направлению удара. Вызывается раз в
# PUSH_EVERY ударов — движение строя медленное и слитное, а не рывками.
func _apply_push(target: Unit, dirn: Vector3) -> void:
	var diff := _push_power() - target._stand_power()
	if diff <= 0.0:
		return
	# ОБЩЕЕ ОСЛАБЛЕНИЕ ТОЛЧКА: 35% от прежнего (см. PUSH_GLOBAL_SCALE).
	# СОПРОТИВЛЕНИЕ ФАЛАНГИ: строй в обороне упирается щитами и принимает
	# лишь половину входящего толчка (push_resist). Раньше он был неуязвим
	# для пуша вовсе — теперь его можно продавить, но очень тяжело
	var step: float = clampf(diff * 0.15, 0.04, 0.4) \
		* _UStats.PUSH_GLOBAL_SCALE \
		* _UStats.stance_stat(target.stance, "push_resist", 1.0)
	# ── УДАРНАЯ КОННИЦА: МНОЖИТЕЛЬ ПРИМЕНЯЕТСЯ ПОСЛЕ ПОТОЛКА ───────────────
	# Именно после, и в этом весь смысл. Потолок 0.4 м срабатывает уже при
	# разнице напора в три единицы, поэтому кабан с push_force 15 продавливал
	# строй ровно на столько же, на сколько мечник с тройкой: всю разницу
	# съедал clampf. Множитель, применённый ДО потолка, съел бы тот же clampf
	# ── МНОЖИТЕЛЬ ПОСЛЕ ПОТОЛКА — ВИРТУАЛЬНЫЙ, А НЕ ПОЛЕ ──────────────────
	# Полем его хватало, пока такой множитель был только у конницы и стоял
	# на всю её жизнь. У приёма он ВРЕМЕННЫЙ (девять секунд набега), и
	# гонять поле туда-обратно значило бы вести состояние в двух местах:
	# включил приём — не забудь выключить. Виртуал спрашивает СВОЙСТВО
	var after_cap: float = _push_after_cap()
	if after_cap != 1.0:
		step *= after_cap
	var np := target.global_position + dirn * step
	# ТОЛЧОК НЕ ВДАВЛИВАЕТ ЖЕРТВУ В ЧУЖОЕ ТЕЛО. Это второе движение, писавшее
	# координату мимо проверки тел (первое — разлёт, см. _tick_fling): в
	# окружении жертву толкают от одного врага прямо во второго. Проверка та
	# же, что у пакетного шага, — BLOCK_RADIUS от чужих ДЛЯ ЖЕРТВЫ (её
	# фракция, её строка); толкающий сам в её чужих не входит: он и так
	# стоит на длине руки, а не внутри 0.55
	# ЗАЖАТУЮ ЖЕРТВУ НЕ ТОЛКНУТЬ — И ВПЕРЁД НЕ ПРОЙТИ. Первая версия проверки
	# отклоняла только смещение жертвы, а шаг толкающего ниже оставался: рыцарь
	# полз вперёд по сантиметрам, пока копейщик стоял на месте, и qa_mega_battle
	# B2-1 «за линией» ушёл с 0 до 70 из 202. Выход здесь целиком: ни жертва,
	# ни вмятина разметки, ни шаг толкающего
	if GameManager.unit_grid.enemy_block(target, np, BLOCK_RADIUS).length_squared() > 1e-8:
		return
	if not GameManager.is_water(np.x, np.z):
		var lim: Vector2 = GameManager.clamp_to_map(np.x, np.z)
		np.x = lim.x
		np.z = lim.y
		np.y = GameManager.get_terrain_height(np.x, np.z)
		# ── ТЯЖЁЛЫЙ ТОЛЧОК ИДЁТ ТЕМ ЖЕ КАНАЛОМ, ЧТО И УДАР НАТИСКА ────────
		# Заказ владельца — «объединить удар и продавливание в единый плавный
		# процесс». Объединение буквальное: и то и другое кладёт своё в ОДНУ
		# скорость (см. _tick_fling), и разницы между «первым касанием» и
		# «продолжает давить» на экране больше нет — есть одно непрерывное
		# движение сквозь строй.
		#
		# НО ТОЛЬКО У КОННИЦЫ, И ЭТО НЕ ПОЛОВИНЧАТОСТЬ, А ЗАМЕР. Сначала через
		# скорость пошёл ЛЮБОЙ толчок — и свалка на 5000 подорожала с 15.4 до
		# 17.8 мс, то есть вышла за бюджет физкадра. Причина простая: толкают в
		# рубке всех и постоянно, а едущий по скорости боец платит КАЖДЫЙ КАДР
		# записью точки, sync_row и высотой рельефа — вместо одной записи на
		# удар. Пехотный шаг при этом четыре сантиметра: плавность там никто и
		# не увидит. У конницы шаг домножен (charge_push_mult) и виден, ради
		# него всё и делалось
		if after_cap > 1.0:
			target.push_smooth(dirn, step)
		else:
			target.global_position = np
		# ── СТРОКУ ЯДРА ЗДЕСЬ НЕ СВОДИМ ───────────────────────────────────
		# Соблазн понятен: разбор наложения читает КОЛОНКУ, а не узел
		# (ArmyCore.BatchSeparation), и до ближайшего тика цели он видит
		# отброшенного там, где тот стоял до толчка. Пробовали дописывать точку
		# в колонку прямо здесь (set_pos на цель и на себя) — и НЕ ОСТАВИЛИ:
		# подтвердить пользу замером не вышло, а qa_mass_battle на 5000 бойцов
		# в этой фазе разбрасывает от 14.5 до 16.5 мс на НЕИЗМЕННОМ коде, то
		# есть разброс прогонов шире любого наблюдавшегося эффекта (правило
		# проекта: правку меньше чем на миллисекунду этим замером не показать).
		#
		# А польза и не нужна: строка сходится сама на ближайшем тике цели —
		# дерущийся боец тикает каждый кадр или через кадр, — и толчок при этом
		# НАКАПЛИВАЕТСЯ. Замер qa_cavalry E1: 42 сдвинутых из 46 живых, самый
		# дальний на 7.9 м от своего места
	# ── СТРОЙ ПРОГИБАЕТСЯ, А НЕ ТОЛЬКО РАЗЪЕЗЖАЕТСЯ ────────────────────────
	# Отброшенный боец вернётся на своё место разметки при первом же смыкании
	# рядов, и от удара конницы не осталось бы и следа. Поэтому тяжёлый
	# всадник гнёт саму РАЗМЕТКУ отряда: места около точки удара уезжают
	# назад, и строй перестраивается уже прогнутым. Урона это не касается
	# вовсе — двигаются только точки построения
	# Признак тот же, что и у самого толчка (_push_after_cap): вмятина нужна
	# любому ТЯЖЁЛОМУ навалу, а не только конному — иначе смыкание рядов
	# вернуло бы строй на место, и от «Яростного Набега» не осталось следа
	if after_cap > 1.0 and target.squad_id > 0:
		GameManager.squad_dent(target.squad_id, np, dirn, step)
	# Победившая шеренга подаётся ВПЕРЁД на половину шага — строй наступает,
	# а не растягивается вслед за отброшенным противником.
	#
	# ТЯЖЁЛАЯ КОННИЦА ИДЁТ НА ПОЛНЫЙ ШАГ. Половина означает «пехота теснит и
	# подтягивается»; кабан не теснит, он проходит НАСКВОЗЬ, и отставая на
	# полшага от каждого отброшенного он до сих пор увязал в первой шеренге
	# (замер qa_cavalry, блок E)
	var forward: float = step if after_cap > 1.0 else step * 0.5
	var mine := global_position + dirn * forward
	if GameManager.is_water(mine.x, mine.z):
		return
	# ── НО НЕ ВНУТРЬ ЧУЖОГО СТРОЯ ───────────────────────────────────────────
	# Полшага вперёд — единственное перемещение во всей игре, которое шло мимо
	# проверки чужих тел. По одному разу это два сантиметра, но толчок идёт раз
	# в PUSH_EVERY ударов и не прекращается, пока шеренга побеждает: за минуту
	# рубки мечник, продавливающий копейщика, наступал такими полушагами прямо
	# в глубину фаланги. Это второй канал того же проникновения, что и у
	# тылового шага выше, и закрывается он так же — телом чужого бойца
	if GameManager.unit_grid.enemy_block(self, mine, BLOCK_RADIUS).length_squared() > 1e-8:
		return
	var mlim: Vector2 = GameManager.clamp_to_map(mine.x, mine.z)
	mine.x = mlim.x
	mine.z = mlim.y
	mine.y = GameManager.get_terrain_height(mine.x, mine.z)
	global_position = mine
	# Точку сдвинул GDScript — отправляем её в колонку (см. tick_physics)
	_pose_force = true

# ═════════════════════════════════════════════════════════════════════════════
# УДАР С РАЗГОНА: СМИНАЕТ ПЕРВЫЙ РЯД ИЛИ РАЗБИВАЕТСЯ О КОПЬЯ
# ═════════════════════════════════════════════════════════════════════════════
# Одно событие на один подход (см. _charge_ready). Развилок ровно две, и обе
# заказаны владельцем прямо:
#
#   • ЛОБОМ В КОПЕЙЩИКОВ — натиска нет вовсе. Ни урона, ни отбрасывания;
#     всадник теряет charge_counter_frac своего запаса на копьях. «Чардж по
#     копейщикам эффективен только с фланга или тыла» — а с фланга и с тыла
#     копья бесполезны, и работает обычная ветка ниже.
#
#   • ПО ВСЕМ ОСТАЛЬНЫМ — первый ряд контакта получает charge_impact_frac от
#     СВОЕГО максимального запаса и разлетается в стороны. Доля от максимума
#     жертвы, а не число урона: сминает вес и скорость, а не оружие седока,
#     поэтому и мечника, и лучника удар складывает одинаково — вполовину.
#
# «ПЕРВЫЙ РЯД» — это круг charge_splash вокруг точки касания, а не отряд и не
# шеренга. Отряд накрывать нельзя (удар пришёлся в одно место, а не по всей
# линии), одну модель — мало: заказано «разлетаются брызгами», то есть накрыть
# обязано соседей по месту удара.
#
# КОПЕЙЩИКА В БРЫЗГАХ УДАР ТОЖЕ НЕ БЕРЁТ, если он стоит лицом: иначе фаланга,
# устоявшая в точке навала, разлеталась бы в метре левее — стенка копий не
# бывает дырявой.
func _charge_impact(target: Unit, dirn: Vector3) -> void:
	# Натиск потрачен в любом случае: и удавшийся, и разбившийся о копья.
	# Разгон вернётся, только когда всадник снова оторвётся (см. _charge_ready)
	is_charging = false
	_charge_ready = false
	if target == null or not is_instance_valid(target) or target.is_dead():
		return
	# ── БЕЗ ПРОЙДЕННОГО РАЗГОНА УДАРА НЕТ ──────────────────────────────────
	# Взвод по одной лишь ДИСТАНЦИИ до цели срабатывал и в плотном бою: цель
	# там меняется каждые пару секунд, новая нередко оказывается за десять
	# метров, и условие выполнялось снова — стоя на месте. Отсюда и «разлёт
	# дважды за одно соприкосновение».
	#
	# Проверяем не намерение, а ФАКТ: сколько всадник реально проехал с
	# момента взвода. Натиск при этом уже потрачен (строки выше) — значит
	# «попытка без разгона» ещё и не повторится, пока он не оторвётся заново
	if charge_min_runup > 0.0:
		var ran: float = Vector2(global_position.x - _charge_from.x,
			global_position.z - _charge_from.z).length()
		if ran < charge_min_runup:
			return
		# ── И ПО ПРЯМОЙ: разгон вкруговую по свалке ударом не считается ─────
		# Это и есть «Double Charge Bug» из заказа: всадник, покрутившийся в
		# гуще, набирал нужные метры, не отъезжая от строя ни на шаг
		if _charge_path > 0.0 and ran < _charge_path * CHARGE_STRAIGHT_FRAC:
			return
	# ── СТЕНКА КОПИЙ ────────────────────────────────────────────────────────
	# ТОПЧУЩЕГО (тролль, _trample_count > 0) обычные копья НЕ ОСТАНАВЛИВАЮТ:
	# он получает их укол и идёт дальше — это босс, а не кабан. СТЕНА КОПИЙ
	# (spearman_1d, спринт 18) останавливает и его
	var trample: int = _trample_count()
	if target.repels_charge() and target._faces_charge(dirn):
		var back: float = max_health * charge_counter_frac
		if back > 0.0:
			# Через take_damage, а не вычитанием: там живут и защита, и вспышка
			# попадания, и смерть с телом на поле. Автор урона — сам копейщик:
			# фраг за сбитого всадника принадлежит тому, кто держал копьё
			take_damage(back, target)
		# ── СТЕНА КОПИЙ: 300 % урона, разгон и напор сняты, замедление ─────
		if target.spear_wall_active():
			target.spear_wall_strike(self)
			return
		if trample <= 0:
			return
	if charge_impact_frac <= 0.0:
		return
	var at: Vector3 = target.global_position
	# ── ТОПТАНИЕ: ПЕРВЫЕ N ПО ХОДУ ГИБНУТ НА МЕСТЕ (заказ 09.09.2026) ────────
	# «Первые» — ближайшие к точке контакта ВПЕРЕДИ по вектору удара: круг
	# брызг сортируется по проекции на dirn, и первые trample из тех, кто не
	# позади, раздавлены насмерть (take_damage сверх запаса — тело, фраг,
	# смыкание рядов идут штатным путём)
	var victims: Array = []
	var mp: Vector3 = position if _local_xform else global_position
	for n in GameManager.unit_grid.query_radius(at, charge_splash):
		var v := n as Unit
		if v == null or not is_instance_valid(v) or v.is_dead():
			continue
		if v.faction == faction:
			continue
		victims.append(v)
	if trample > 0 and not victims.is_empty():
		var ahead: Array = []
		for v2 in victims:
			var off: Vector3 = (v2 as Unit).global_position - mp
			var along: float = off.x * dirn.x + off.z * dirn.z
			if along >= -0.3:
				ahead.append([along, v2])
		ahead.sort_custom(func(a, b): return float(a[0]) < float(b[0]))
		for k in range(mini(trample, ahead.size())):
			var v3: Unit = ahead[k][1]
			if is_instance_valid(v3) and not v3.is_dead():
				_trample_kills += 1
				v3.take_damage(v3.max_health * 100.0, self)
	# ── УДАР ПО РЯДАМ (свиноконница, заказ спринта 15) ───────────────────
	if charge_row_kill > 0 and trample <= 0:
		_charge_rows(victims, mp, dirn, at)
		if charge_breakthrough > 0.0:
			push_smooth(dirn, charge_breakthrough, true)
		return
	for n2 in victims:
		var v := n2 as Unit
		if v == null or not is_instance_valid(v) or v.is_dead():
			continue
		# Копья держат навал и в брызгах (см. шапку) — но не против топчущего
		if trample <= 0 and v.repels_charge() and v._faces_charge(dirn):
			continue
		v.take_damage(v.max_health * charge_impact_frac, self)
		if is_instance_valid(v) and not v.is_dead():
			v.apply_knockback(dirn, charge_knockback, at)
	# ── ВСАДНИК НЕ ОСТАНАВЛИВАЕТСЯ О ПЕРВУЮ ШЕРЕНГУ ────────────────────────
	# Жалоба владельца: «кавалерия останавливается или резко теряет импульс
	# вместо того, чтобы вклиниваться и продавливать строй». Так и было: удар
	# был ОДНИМ СОБЫТИЕМ, после которого всадник переходил в обычную рубку и
	# вяз в первой же шеренге — вся его масса уходила в один кадр.
	#
	# Теперь та же скорость, которой разлетается пехота, выдаётся и ему самому,
	# только вперёд: он ВЪЕЗЖАЕТ в пробитую дыру и продолжает движение, пока
	# импульс не выдохнется. Это не новая ветка в автомате состояний и не
	# отдельный режим — тот же _tick_fling, и потому оно само собой складывается
	# с продавливанием, которое пойдёт следующими ударами
	if charge_breakthrough > 0.0:
		push_smooth(dirn, charge_breakthrough, true)

## ── УДАР ПО РЯДАМ ───────────────────────────────────────────────────────────
## Накрытые сортируются по проекции на вектор удара и режутся на ряды глубиной
## charge_row_depth от самого первого. Первая ячейка — гибель (charge_row_kill
## человек; кто в первом ряду сверх этого — как второй), второй ряд — отлёт,
## падение и charge_row2_frac запаса, дальше — плавный толчок назад. Стенка
## копий, глядящая навстречу, из рядов исключена: её держит проверка выше
func _charge_rows(victims: Array, mp: Vector3, dirn: Vector3, at: Vector3) -> void:
	var rows: Array = []
	for n in victims:
		var v := n as Unit
		if v == null or not is_instance_valid(v) or v.is_dead():
			continue
		if v.repels_charge() and v._faces_charge(dirn):
			continue
		var off: Vector3 = v.global_position - mp
		var along: float = off.x * dirn.x + off.z * dirn.z
		if along < -0.3:
			continue
		rows.append([along, v])
	if rows.is_empty():
		return
	rows.sort_custom(func(a, b): return float(a[0]) < float(b[0]))
	var first: float = float(rows[0][0])
	var killed: int = 0
	for e in rows:
		var v: Unit = e[1]
		if not is_instance_valid(v) or v.is_dead():
			continue
		# Округление, а не пол: ряд стенда с шагом charge_row_depth обязан лечь
		# в свой ряд механики и при небольшом веере проекций внутри шеренги
		var row: int = int(round((float(e[0]) - first) / maxf(charge_row_depth, 0.1)))
		if row <= 0 and killed < charge_row_kill:
			killed += 1
			_trample_kills += 1
			v.take_damage(v.max_health * 100.0, self)
		elif row <= 1:
			v.take_damage(v.max_health * charge_row2_frac, self)
			if is_instance_valid(v) and not v.is_dead():
				v.apply_knockback(dirn, charge_knockback, at)
				v.knock_down(CHARGE_ROW_KNOCKDOWN_SEC)
		else:
			v.push_smooth(dirn, charge_knockback * 0.5)

## Сколько бойцов впереди раздавливает удар с разгона. База — ноль (кабан
## сминает брызгами, но не топчет); тролль — goblin_config.TROLL_TRAMPLE_COUNT
func _trample_count() -> int:
	return 0

## Сколько раздавлено этим бойцом за жизнь (стенды)
var _trample_kills: int = 0

## ── СБИТ С НОГ (заказ 09.09.2026: удар дубины тролля) ──────────────────────
## Боец отлетает (apply_knockback) и ЛЕЖИТ: ни шага, ни удара, ни агро, пока
## не истечёт срок; потом встаёт и снова дерётся. Пока лежит — его слот в
## общей отрисовке снят, а на его месте лежит ЕГО ЖЕ тело из слоя тел
## (CorpseRenderer.spawn: та же лента, тот же квад плашмя, что у павшего) —
## «валяется как мёртвый» буквально. Урон лежащий получает как обычно; убит
## лёжа — временное тело снимается, а штатное кладёт _die
var _down_until_ms: int = 0
var _down_prop = null

func is_down() -> bool:
	return _down_until_ms > 0

func knock_down(sec: float) -> void:
	if is_dead() or sec <= 0.0:
		return
	var until: int = now_ms + int(sec * 1000.0)
	if _down_until_ms > 0:
		_down_until_ms = maxi(_down_until_ms, until)
		return
	_down_until_ms = until
	velocity = Vector3.ZERO
	if GameManager.main != null and _down_prop == null:
		var gp: Vector3 = global_position
		_down_prop = GameManager.corpses.spawn(self, GameManager.main.world_root(),
			GameManager.get_terrain_height(gp.x, gp.z))
	leave_render()
	if _active_sprite != null and is_instance_valid(_active_sprite):
		_active_sprite.visible = false
	set_draw(false)

func _stand_up() -> void:
	_down_until_ms = 0
	_drop_down_prop()
	set_draw(true)
	enter_render()
	# Полёт кончился вместе с лежанием: встал там, где упал
	_fling_vel = Vector3.ZERO
	_settled = false

func _drop_down_prop() -> void:
	if _down_prop != null:
		GameManager.corpses.remove_now(_down_prop)
		_down_prop = null

## ── РАЗЛЁТ ОТ УДАРА ────────────────────────────────────────────────────────
## Не «impulse velocity», а прямое смещение, и это не упрощение: во всей игре
## нет ни одного тела с физикой (collision_mask везде 0), скорость никем не
## интегрируется между кадрами, и толкание шеренги устроено ровно так же
## (см. _apply_push). Импульс пришлось бы затухать вручную отдельным полем и
## отдельной веткой в тике — ради эффекта, который длится доли секунды.
##
## НАПРАВЛЕНИЕ — ПРЕИМУЩЕСТВЕННО ВБОК. Заказ владельца — «разлетаются брызгами»,
## то есть строй должен РАЗОЙТИСЬ, открыв коннице проход, а не отъехать назад
## целиком: назад его двигает постоянное продавливание (_apply_push), и
## дублировать его здесь означало бы просто удвоить ту же силу.
## Сторона берётся из фактического положения бойца относительно оси удара —
## кто левее, летит левее. Стоящему ровно на оси сторону даёт номер узла:
## два прогона одного боя обязаны дать одну картину.
##
## РАЗМЕТКА ОТРЯДА ГНЁТСЯ ВМЕСТЕ С ТЕЛАМИ, иначе первое же смыкание рядов
## вернуло бы всех на места и от удара не осталось бы следа (тот же разбор,
## что у GameManager.squad_dent).
func apply_knockback(dirn: Vector3, dist: float, from: Vector3) -> void:
	if dist <= 0.0 or is_dead():
		return
	# ── НАПРАВЛЕНИЕ: ПО ВЕКТОРУ УДАРА, А НЕ ВБОК ───────────────────────────
	# Здесь было `side * 0.85 + dirn * 0.55` — то есть ПРЕИМУЩЕСТВЕННО ВБОК:
	# заказ был «разлетаются брызгами», чтобы строй разошёлся и открыл проход.
	# На экране это читалось не как удар, а как взрыв под ногами: пехота
	# разлеталась поперёк движения конницы. Владелец развернул требование —
	# «отбрасываться строго назад / по вектору удара».
	#
	# Боковая доля оставлена МАЛОЙ, и это не половинчатость: снеси её совсем, и
	# весь накрытый ряд поедет строго параллельно, оставаясь такой же плотной
	# стенкой на метр позади — проход не открывается, а просто отодвигается.
	# Малый разлёт вбок разводит тела ровно настолько, чтобы конница вклинилась
	var side := Vector3(dirn.z, 0.0, -dirn.x)
	var off: Vector3 = global_position - from
	var lat: float = off.x * side.x + off.z * side.z
	if absf(lat) < 0.05:
		lat = _side_sign
	var s: float = 1.0 if lat > 0.0 else -1.0
	var away := (dirn * CHARGE_FLING_BACK + side * s * CHARGE_FLING_SIDE).normalized()
	# ── СКОРОСТЬ, А НЕ ПЕРЕНОС ─────────────────────────────────────────────
	# Здесь стояло `global_position = np` — мгновенный прыжок на 2.2 м. Он был
	# осознанным («физтел в игре нет, скорость никем не интегрируется»), и
	# картинку ему подставляли догоняющим сглаживанием. Но догоняет она ПОЗУ, а
	# не движение: на экране боец всё равно исчезал из строя и появлялся в
	# стороне — то самое «брызги и телепортация».
	#
	# Теперь бойцу выдаётся ЗАТУХАЮЩАЯ СКОРОСТЬ, и её интегрирует тик
	# (см. _tick_fling). Это единственное поле скорости в проекте, и заведено
	# оно ровно под этот эффект: путь v0·τ·(1−e^(−T/τ)) подобран так, чтобы за
	# FLING_SEC боец прошёл заказанные `dist` метров — то есть дальность удара
	# осталась той же, изменилась только ПЛАВНОСТЬ.
	var reach: float = FLING_TAU * (1.0 - exp(-FLING_SEC / FLING_TAU))
	_fling_vel = away * (dist / maxf(reach, 0.001))
	fling_visual()
	# Отброшенный больше не «дошёл до места»: якорь снимается, иначе он
	# считался бы стоящим на посту там, где его уже нет
	_settled = false
	_wake_process()
	if squad_id > 0:
		# Вмятину в разметке гнём СРАЗУ по расчётной точке: она описывает, куда
		# бойца унесёт, и ждать конца полёта незачем — разметка не картинка
		GameManager.squad_dent(squad_id, global_position + away * dist, dirn, dist * 0.5)

## ── ПРОДАВЛИВАНИЕ ЧЕРЕЗ ТУ ЖЕ СКОРОСТЬ ─────────────────────────────────────
## `dist` — на сколько метров толчок обязан сдвинуть бойца. Скорость считается
## так, чтобы за FLING_SEC он прошёл ровно столько: дальность продавливания не
## меняется, меняется только плавность (та же арифметика, что в apply_knockback).
##
## СКОРОСТЬ НАКАПЛИВАЕТСЯ, НО С ПОТОЛКОМ. Толчок идёт на каждый удар
## (PUSH_EVERY = 1 у конницы), а прошлый ещё не выдохся — без потолка бойца
## разгоняло бы очередью ударов до скорости, которой в игре нет ни у кого.
## Потолок берётся от скорости самого быстрого хода с запасом
const PUSH_MAX_SPEED := 14.0

## solid — этот разлёт обязан УПИРАТЬСЯ в чужие тела (см. _tick_fling).
## Ставится только на прорыв всадника: отброшенного пехотинца несёт ПРОЧЬ от
## врага, там упираться не во что, а лишний скан сетки на каждого накрытого
## брызгами стоил бы дороже самого удара
func push_smooth(dirn: Vector3, dist: float, solid: bool = false) -> void:
	if dist <= 0.0 or is_dead():
		return
	if solid:
		_fling_solid = true
	var reach: float = FLING_TAU * (1.0 - exp(-FLING_SEC / FLING_TAU))
	_fling_vel += dirn * (dist / maxf(reach, 0.001))
	var sp: float = _fling_vel.length()
	if sp > PUSH_MAX_SPEED:
		_fling_vel *= PUSH_MAX_SPEED / sp
	fling_visual()
	_settled = false
	_wake_process()

## ── ТАКТ РАЗЛЁТА: ЕДИНСТВЕННОЕ ПОЛЕ СКОРОСТИ В ПРОЕКТЕ ─────────────────────
## Зовётся из tick_physics каждый кадр. Пока скорость не выдохлась, боец едет
## по ней и тормозит по экспоненте — это и делает отброс плавным вместо прыжка.
##
## ЗДЕСЬ ЖЕ СХОДЯТСЯ УДАР И ПРОДАВЛИВАНИЕ. Раньше это были две разные машины:
## натиск переносил тело мгновенно, а `_apply_push` двигал его маленькими
## шажками на каждый удар. Теперь обе кладут своё в ОДНУ И ТУ ЖЕ скорость, и
## на экране получается один непрерывный процесс: удар отбрасывает, а
## продавливание не даёт вернуться, пока конница идёт сквозь строй.
## Разлёт УПИРАЕТСЯ в чужие тела. Только у прорыва всадника (см. push_smooth)
var _fling_solid: bool = false

func _tick_fling(delta: float) -> void:
	if _fling_vel.x == 0.0 and _fling_vel.z == 0.0:
		return
	var step: Vector3 = _fling_vel * delta
	var np: Vector3 = global_position + step
	if GameManager.is_water(np.x, np.z):
		_fling_vel = Vector3.ZERO
		_fling_solid = false
		return
	# ── ПРОРЫВ ВСАДНИКА КОНЧАЕТСЯ У ЧУЖОГО ТЕЛА ────────────────────────────
	# Жалоба владельца (скриншот): «рыцари проникают сквозь строй копейщиков,
	# разворачиваются на 180° и бьют в спину».
	#
	# Дорога, по которой они туда попадали, здесь. Разлёт — ЕДИНСТВЕННОЕ
	# движение в проекте, которое пишет координату НАПРЯМУЮ, минуя пакетный шаг
	# (ArmyCore.BatchStep) со всей его геометрией: ни ствола, ни чужого строя он
	# не замечает вовсе. Пехоте это безразлично — её несёт ПРОЧЬ от врага. А
	# всаднику после удара выдаётся charge_breakthrough «вперёд, в пробитую
	# дыру», и он проезжал сквозь любое число шеренг, потому что спросить о них
	# было некому.
	#
	# Теперь прорыв упирается в первое же чужое тело и ГАСНЕТ: всадник
	# останавливается в контакте, дальше его ведёт обычная рубка. Скан идёт
	# ровно по тому же радиусу и тем же вызовом, что и шаг марша
	# (Unit.BLOCK_RADIUS), поэтому «упёрся» здесь и «упёрся» там — одно событие
	# ── РАЗЛЁТ КОНЧАЕТСЯ У ЧУЖОГО ТЕЛА У ВСЕХ, А НЕ ТОЛЬКО У ВСАДНИКА ──────
	# Здесь стояло `if _fling_solid`, то есть проверка только для прорыва
	# конницы; сбитый пехотинец летел 2.2 м без единой проверки и в остатках
	# боя (конница против разрозненных, враги со всех сторон) влетал ВНУТРЬ
	# тела другого всадника. Замер qa_full_game_4k: на последнем снимке 35 из
	# 96 контактных внутри ядра 0.30 м, из них с билетом прохода 0 и
	# отходящих 0 — единственное движение без проверки тел и было разлётом.
	# Разлёт это ЕДИНСТВЕННОЕ движение, пишущее координату мимо пакетного
	# шага, и правило у него теперь то же: в чужое тело не влетает никто.
	# _fling_solid остался признаком ПРОРЫВА (ставит _enemy_contact и будит
	# бой), сбитому пехотинцу контакт не ставится — он летит прочь
	if not retreating:
		if GameManager.unit_grid.enemy_block(self, np, BLOCK_RADIUS).length_squared() > 1e-8:
			_fling_vel = Vector3.ZERO
			if _fling_solid:
				_enemy_contact = true
			_fling_solid = false
			return
	var lim: Vector2 = GameManager.clamp_to_map(np.x, np.z)
	np.x = lim.x
	np.z = lim.y
	np.y = GameManager.get_terrain_height(np.x, np.z)
	global_position = np
	sync_row()
	# Экспоненциальное затухание: за FLING_TAU скорость падает в e раз.
	# Через pow(), а не вычитанием — иначе результат зависел бы от того, через
	# сколько кадров бойца опросили (тик шардирован)
	_fling_vel *= pow(FLING_DECAY_PER_SEC, delta)
	if _fling_vel.length_squared() < FLING_STOP_SQ:
		_fling_vel = Vector3.ZERO
		_fling_solid = false

# Интервалы опроса агро. Скан радиусом 10 м идёт через query_radius(), а он
# при cell = 1.0 просматривает ~441 ячейку и аллоцирует массив. Гарнизон из
# сотен стоящих юнитов не должен молотить этот скан дважды в секунду каждый,
# поэтому: нашли врага недавно — опрашиваем часто, вокруг тихо — редко.
const AGGRO_INTERVAL_HOT  := 0.5
const AGGRO_INTERVAL_CALM := 2.0

## ПОВОДОК: на сколько метров от своего поста боец готов уйти по СВОЕЙ
## инициативе. Прямой приказ игрока поводок не ограничивает — это только про
## авто-агро, из-за которого свежие отряды разбегались от зданий
const AGGRO_LEASH := 14.0

## ── ПОВОДОК ИНИЦИАТИВЫ — СВОЙСТВО РОДА ВОЙСК (спринт 13) ──────────────────
## Общая четырнадцатка подходит пехоте, но не метателю у логова: заказ на
## гноллов прямо требует «не агрятся всей толпой, когда бой далеко», а это и
## есть длина поводка. Виртуал, а не второе поле: число читается ОДИН раз в
## ветке авто-агро (и только когда рядом кто-то нашёлся), покадрового пути
## здесь нет
func aggro_leash() -> float:
	# У орды поводок не короче её обзора: иначе радиус агро, поднятый до
	# обзора (aggro_radius), упирался бы в поводок, и гоблин видел врага, но
	# сойти с места не мог — тот же «истукан», только с другого конца
	if faction == Constants.FACTION_GOBLIN:
		return maxf(AGGRO_LEASH, aggro_radius() + 2.0)
	return AGGRO_LEASH

## ── РАДИУС ИНИЦИАТИВЫ (спринт 17, «фикс залипания») ────────────────────────
## Заказ: «при обнаружении врага в Vision Range отряд мгновенно атакует».
## У людей прежние AGGRO_RADIUS 10 м (игрок сам решает, когда его отрядам
## срываться); у орды — её обзор (unit_stats_config.vision_radius: ×1.6 от
## дальности, не меньше 15): гоблины, гноллы и тролли не стоят истуканами,
## глядя на врага в пятнадцати метрах. Гнолл сверху сужает это поводком
func aggro_radius() -> float:
	if faction == Constants.FACTION_GOBLIN:
		return _UStats.vision_radius(attack_range)
	return AGGRO_RADIUS

## Отвечает ли боец на ОБСТРЕЛ из-за предела ответной атаки (COUNTER_CHARGE_
## RANGE): бежит к обидчику или, при малом запасе, отходит к лагерю. Только
## орда: у людей отряд под приказом игрока срываться за лучником не вправе.
## Гнолл и тролль ведут свой ответ сами (Gnoll.take_damage, TrollLair.on_guard_hit)
func answers_far_fire() -> bool:
	return faction == Constants.FACTION_GOBLIN

## Ниже этой доли запаса обстреливаемый издалека отходит к лагерю, а не бежит
## на стрелка (заказ: «либо сокращать дистанцию, либо отступать в укрытие»)
const FAR_FIRE_FLEE_HP := 0.3
## Стенды: сколько раз боец ответил на дальний обстрел (наскок / отход)
var far_fire_answers: int = 0
var far_fire_flees: int = 0

func _answer_far_fire(attacker: Node3D) -> void:
	if attack_target != null or retreating or _panicked or garrisoned:
		return
	if state != State.IDLE and state != State.MOVING:
		return
	if player_order_active():
		return
	var au := attacker as Unit
	if au == null or au.is_dead() or int(au.faction) == int(faction):
		return
	var d: float = global_position.distance_to(au.global_position)
	if d <= COUNTER_CHARGE_RANGE:
		return                          # это уже разобрал ответ на удар выше
	if current_health < max_health * FAR_FIRE_FLEE_HP:
		var camp: Vector3 = GameManager.goblin_camp_point(global_position)
		if camp != Vector3.INF:
			far_fire_flees += 1
			begin_retreat()
			command_move(GameManager.land_target(camp), false, Vector3.ZERO, true)
		return
	far_fire_answers += 1
	if squad_id > 0:
		GameManager.squad_counter_charge(squad_id, au)
	else:
		command_attack(au, true)

## ДАЛЬНОСТЬ ОТВЕТНОЙ АТАКИ НА ОБСТРЕЛ. Стрелок, бьющий по нам с этой
## дистанции, поднимает весь отряд в контратаку (см. take_damage).
## 12 м — это те самые «два-три шага» из задания с запасом: враг, которого
## видно и до которого можно добежать за пару секунд, а не цель на полкарты
const COUNTER_CHARGE_RANGE := 12.0

## ДОКУДА ГНАТЬСЯ ЗА ОТСТУПИВШИМ, метры от точки первого касания. Заказ
## владельца — «десять шагов, 5-8 м». Семь посередине вилки.
## Больше этого боец бросает цель, забывает её и возвращается на свой пост
const PURSUIT_LIMIT := 7.0

## Поводок — СВОЙСТВО РОДА ВОЙСК: большой гоблин на охоте (BigGoblin) гонит
## кайтящего стрелка дальше пехотных семи метров (ТЗ 14.09.2026, п. 6)
func pursuit_limit() -> float:
	return PURSUIT_LIMIT

## ГЕЙТ ВЫНЕСЕН В ВЫЗЫВАЮЩИЙ tick_physics (см. State.IDLE): раньше эта функция
## звалась КАЖДЫЙ кадр на КАЖДОМ простаивающем бойце и тут же выходила по
## таймеру — сам вызов (не работа внутри) и был главной статьёй расхода.
## Профиль на боевой нагрузке из отчёта (qa_perf, 1150 моделей): check_auto_aggro
## съедала 88% времени физ. тика, из них подавляющее большинство — пустые
## вызовы, ничего не делающие, кроме декремента таймера. Функция вызывается
## ТОЛЬКО когда таймер уже истёк и боец действительно вооружён и не отходит —
## своей работы это не меняет ни на строку, меняется только КОГДА её зовут
## ── ДОКУДА ДЕЙСТВУЕТ ПРИКАЗ ИГРОКА ПО ЦЕЛИ ─────────────────────────────────
## «Пока назначенный отряд не истреблён ИЛИ не ушёл из виду» — заказ владельца.
## «Из виду» считается от дальности ОРУЖИЯ, а не числом на все рода войск: у
## лучника это сорок метров (вдвое дальше выстрела), у пехоты — двадцать
## (вдвое дальше радиуса внимания). Ближе этого замок держится, и авто-агро
## не имеет права подсунуть бойцу другую цель, как бы близко она ни стояла
## ── УДАР В УПОР ОТВЕТ ПОЛУЧАЕТ ВСЕГДА ──────────────────────────────────────
## Замок приказа игрока (_move_lock) и выход из боя (_disengaging) глушили
## ответный удар БЕЗУСЛОВНО. Смысл у обоих один: «не отвлекайся на дальнюю
## стычку, иди куда послали». Но у бойца, которого рубят с длины руки, никакого
## «иди дальше» нет — впереди чужое тело, и он всё равно стоит. Ровно это и
## видно на скриншоте владельца: передние шеренги упёрлись, перебирают ногами
## и умирают, ни разу не отмахнувшись.
##
## Порог — та же ДЛИНА РУКИ (LOCK_BLOCKER_RANGE), по которой считается помеха
## под замком цели: это не «в меня попали чем угодно с двадцати метров», а
## «меня достали вплотную».
##
## Окно прохода приказа (_forced_move_pass) исключено: в нём боец НАМЕРЕННО
## идёт сквозь тела, и отвечать там значило бы отменить сам приказ
func _may_answer_blow(attacker: Node3D) -> bool:
	if not _disengaging and _move_lock <= 0.0:
		# ── ПОЧЕМУ ЗДЕСЬ НЕТ РАЗДЕЛИТЕЛЯ «ИДУ ПРОЧЬ» ──────────────────────
		# Замок приказа живёт FORCED_MOVE_SEC, а марш на тридцать метров —
		# втрое дольше, и дальше каждый прилетевший удар зовёт
		# command_attack(attacker, true), то есть переводит бойца в ATTACKING
		# насовсем: помеха жива, вернуть его в марш некому. Правку «идущий
		# прочь не разворачивается» я сделал и снял — она не помогает, разбор
		# и три замера в docs/ENGINEERING_LOG.md, раздел про qa_melee F2.
		return true
	if _forced_move_pass():
		return false
	# ── ИДУЩИЙ НЕ ОТВЕЧАЕТ, УПЁРШИЙСЯ ОТВЕЧАЕТ ─────────────────────────────
	# Один лишь порог дистанции здесь не годится: отходящий лучник получает
	# удары ВПЛОТНУЮ ровно в первые секунды отхода, и по одной дистанции он
	# развернулся бы драться — то есть приказ игрока «выйди из боя» отменялся
	# бы сам собой (поймал qa_disengage A4).
	# Разделитель — ФАКТ ДВИЖЕНИЯ: moved_recently() отвечает по РЕАЛЬНОМУ
	# смещению за окно замера, а не по намерению, и потому знает разницу между
	# «иду прочь» и «перебираю ногами, упёршись в чужой строй»
	if moved_recently():
		return false
	if attacker == null or not is_instance_valid(attacker):
		return false
	var dx: float = attacker.global_position.x - global_position.x
	var dz: float = attacker.global_position.z - global_position.z
	return dx * dx + dz * dz <= LOCK_BLOCKER_RANGE * LOCK_BLOCKER_RANGE

func _lock_sight_range() -> float:
	return maxf(attack_range * 2.0, AGGRO_RADIUS * 2.0)

func _check_auto_aggro() -> void:
	_aggro_timer = AGGRO_INTERVAL_CALM
	if _panicked:
		return
	# ── ПРИОРИТЕТ №1 ДЕЙСТВУЕТ И В ПОКОЕ ───────────────────────────────────
	# Здесь этой ветки не было, и в ней весь баг «лучники бьют не туда».
	# Порядок событий: игрок приказал стрелять по вражеским лучникам; те отошли
	# за двадцать метров; стрелок бросает цель и встаёт (_process_attack, ветка
	# «_engaged_once и гнаться не полагается»), но ЗАМОК ПРИКАЗА при этом
	# остаётся взведённым. Дальше боец попадает сюда, в покой, и авто-агро
	# честно выдаёт ему ближайшего противника — то есть чужих копейщиков,
	# стоящих в десяти метрах. Приказ игрока подменялся молча и мгновенно.
	#
	# Теперь замок читается ПЕРВЫМ и до стойки: он приоритет №1, а стойка
	# только выбирает, как исполнять приказ, а не по кому стрелять.
	if target_lock:
		var locked := _lock_next_victim()
		if locked != null:
			# Обе точки — по дешёвому пути (правило 2); у постройки локальной нет
			var lku := locked as Unit
			var lkp: Vector3 = lku.position if (lku != null and lku._local_xform) \
				else locked.global_position
			var myp: Vector3 = position if _local_xform else global_position
			var ld: float = myp.distance_to(lkp)
			if ld <= _lock_sight_range():
				# В дальности — бьём назначенного. Дальше — НЕ БЕРЁМ НИКОГО и
				# ждём: подменять цель приказа тем, кто ближе, и есть запрет.
				# forced = false намеренно: это не новый приказ, а исполнение
				# старого, и переписывать им _atk_pending нельзя
				# Дальность с поправкой на габарит запертой цели: у здания она
				# меряется до стены (см. _target_pad). Без этого замок на
				# крупной постройке никогда не доходил до вызова — центр
				# коробки лежит дальше дистанции удара, чем бы боец в неё ни упёрся
				if ld <= attack_range + _pad_of(locked):
					_aggro_timer = AGGRO_INTERVAL_HOT
					command_attack(locked, false)
				return
		# Отряд истреблён или ушёл из виду — приказ исчерпан, живём как обычно.
		# Пост при этом переносится СЮДА (см. _hold_where_i_stand): без этого
		# боец разворачивался и уходил на старое место — за полкарты
		release_target_lock()
		_hold_where_i_stand()
		_atk_pending = false
	# В стойке ЗАЩИТА боец не сходит с места ради врага: замечает только то,
	# до чего дотягивается копьём. Направление на строй противника и смыкание
	# рядов считаются отдельно — в _update_live_rank()/_phalanx_advance()
	# ОТРЯД В БОЮ ЦЕЛИКОМ, А НЕ ТОЛЬКО ТОТ, КТО ДОТЯНУЛСЯ.
	# Признак отрядный и уже готовый (боевая бухгалтерия ведёт его по
	# событиям) — своего скана здесь не требуется
	var in_fight: bool = squad_id > 0 and GameManager.squad_in_combat(squad_id)
	if _stance_holds_ground():
		var at_hand := _squad_cached_enemy(attack_range)
		# ── ПОДТЯГИВАНИЕ ФЛАНГА К НАЧАВШЕМУСЯ БОЮ ────────────────────────────
		# РАЗВОРОТ ТРЕБОВАНИЯ (заказ владельца по скриншоту): «в бой вступает
		# только та часть отряда, что соприкоснулась с врагом; правый фланг
		# стоит без движения и не видит противника. Если хотя бы один боец
		# отряда вступил в контакт — весь отряд обязан подтягиваться».
		# До этого правило было ОБРАТНЫМ и тоже по заказу: «индивидуальной
		# инициативы у фаланги нет вовсе» (см. CLAUDE.md).
		#
		# ПРИМИРЯЮТ ИХ ТРИ ОГРАНИЧЕНИЯ, и убрать нельзя ни одно:
		#   1. только пока ОТРЯД В БОЮ — вне боя фаланга по-прежнему не сходит
		#      с места ни за кем, и жалоба про выбегающие фланги не вернётся;
		#   2. только в ЛОБОВОМ СЕКТОРЕ строя — иначе фланговый боец
		#      разворачивается на соседа по свалке, за ним уезжает курс подсчёта
		#      рядов, и «единый забор» распадается с краёв;
		#   3. только в пределах PULL_UP_RANGE — это ШАГ В КОНТАКТ, а не
		#      разрешение бежать за целью через полкарты.
		# ── СПРИНТ 20 (модуль 4.3): ОДИНОЧНОГО ПОДТЯГИВАНИЯ БОЛЬШЕ НЕТ ────
		# Заказ: «солдаты не выбегают из фаланги за пехотой, держат свои две
		# ячейки впереди». Ветка подтягивания фланга (PULL_UP_RANGE, заказ авг.
		# 2026) снята: к бою в пяти метрах подаётся ВСЯ фаланга разом
		# (GameManager._sweep_phalanx_press раз в PHALANX_PRESS_SEC), а не
		# отдельный боец. Константа оставлена — её читает радиус наблюдения
		if PHALANX_PULL_UP_SINGLE and at_hand == null and in_fight:
			var step_up := _find_nearest_enemy_in_range(PULL_UP_RANGE, "pull_up")
			if step_up != null and _in_phalanx_front(step_up):
				_aggro_timer = AGGRO_INTERVAL_HOT
				command_attack(step_up, true)
				return
		# ── ТОЛЬКО ТО, ЧТО ПЕРЕД КОПЬЁМ ─────────────────────────────────────
		# Заказ владельца: крайние копейщики фаланги не имеют права выламываться
		# из строя ради противника, зашедшего сбоку или в тыл. Раньше проверка
		# была одна — «дотянусь ли», — и фланговый боец разворачивался на
		# соседа по свалке: _facing уезжал, вслед за ним уезжал курс подсчёта
		# рядов (_phalanx_dir), и «единый забор» распадался с краёв.
		# Теперь цель обязана быть В ЛОБОВОМ СЕКТОРЕ строя. Стоять при этом
		# боец не перестаёт — стоять и есть его задача до приказа отряду.
		if at_hand != null and _in_phalanx_front(at_hand):
			command_attack(at_hand, false)
		return
	# АГРО-РАДИУС 10 м: простаивающий боец сам видит бой рядом и вступает в него.
	# СТРЕЛКИ СМОТРЯТ НА ВСЮ СВОЮ ДАЛЬНОСТЬ. У лучника attack_range = 20 м, а
	# скан шёл на 10 — стоящий отряд молчал, пока противник не подойдёт вдвое
	# ближе дистанции стрельбы. Теперь радиус наблюдения не меньше дальности
	# оружия: заняв позицию, лучники сами открывают огонь по всему, до чего
	# достают стрелой
	var watch: float = maxf(aggro_radius(), attack_range)
	# forced = true, если враг ДАЛЬШЕ радиуса удара — иначе юнит «заметит» бой,
	# но так и продолжит стоять, не сделав к нему ни шага (ровно этим и болели
	# отряды, выходящие из барака рядом со свалкой)
	# ── ПОВОДОК ОТ ПОСТА ────────────────────────────────────────────────────
	# Авто-агро выдавало ПОГОНЮ (forced = враг дальше удара), и отряд, только
	# что вышедший из замка или барака, срывался за первым замеченным
	# противником через полкарты. Именно это выглядит как «они всё время
	# куда-то уходят». Теперь боец гонится только в пределах AGGRO_LEASH от
	# места, куда его поставили; дальше — бьёт лишь то, до чего дотягивается
	# В бою отряд смотрит ШИРЕ: стоящий фланг обязан увидеть свалку, в которую
	# уже втянут его собственный отряд (тот же заказ, что и у подтягивания
	# фаланги выше)
	if in_fight:
		watch = maxf(watch, PULL_UP_RANGE)
	# ── ЦЕНТРОВОЙ НОД ОТРЯДА ОТВЕЧАЕТ ЗА ВЕСЬ ОТРЯД ────────────────────────
	# У стрелкового отряда скан ведёт GameManager._sweep_squad_radar — ровно
	# 2 Гц, один на отряд, и с УПРЕЖДЕНИЕМ (радиус обнаружения больше
	# дальности оружия). Боец здесь не сканирует вовсе: он читает готовый
	# ответ. Пока цель в фазе прицеливания (дальше дистанции огня), ответ
	# пустой — отряд развёрнут на врага, но не стреляет, и это требование,
	# а не экономия. Без ручки — прежний путь: личный опрос с отрядным кэшем
	var nearby: Node3D = null
	if _Opt.squad_radar and squad_id > 0 and _is_ranged() \
			and GameManager.squad_radar_active(squad_id):
		nearby = GameManager.squad_radar_foe(squad_id)
	else:
		nearby = _squad_cached_enemy(watch)
	# ПОВОДОК ДЕЙСТВУЕТ, ПОКА ОТРЯД НЕ В БОЮ. Он придуман против ИНИЦИАТИВЫ —
	# чтобы свежий отряд не срывался за первым замеченным через полкарты. Но
	# отряд, КОТОРЫЙ УЖЕ ДЕРЁТСЯ, никакой инициативы не проявляет: он уже
	# ввязан. Поводок при этом держал половину его состава вдали от свалки —
	# отряд пришёл издалека, и пост у него остался там, ОТКУДА он вышел
	# ── ТОЧКА НАЙДЕННОГО ЧИТАЕТСЯ ОДИН РАЗ НА ВСЮ ВЕТКУ ────────────────────
	# Ниже она нужна дважды (поводок от поста и «далеко ли до него идти»), а
	# читалась ЧЕТЫРЕ раза, и каждое чтение global_position — это свойство с
	# проверкой мировой матрицы. У бойца под неподвижным World она равна
	# локальной (правило 2); у постройки локальной нет — берём как было
	var nb_pos := Vector3.ZERO
	if nearby != null:
		var nbu := nearby as Unit
		nb_pos = nbu.position if (nbu != null and nbu._local_xform) \
			else nearby.global_position
	if nearby != null and _post_valid and not in_fight:
		# ── ПОВОДОК МЕРЯЕТСЯ ОТ ЗНАМЕНОСЦА, А НЕ ОТ ЛИЧНОГО ПОСТА ──────────
		# ЗАКАЗ ВЛАДЕЛЬЦА: отряд сканирует врагов «в радиусе двух-трёх шагов ОТ
		# ЗНАМЕНОСЦА» и ходит только целиком.
		#
		# Личный пост у каждого свой, и посты растаскивает вся история отряда:
		# подзыв сплочённости, возврат из гарнизона, «встать где стою» после
		# исчерпанного приказа. У растянутого отряда крайние бойцы получали
		# поводок вокруг СВОИХ точек — то есть каждый мерил инициативу от своего
		# места, и отряд расползался веером за разными целями. От знаменосца
		# начало отсчёта одно на всех, и «отряд не разбегается» получается само.
		#
		# Пост остаётся запасным ответом: у отряда без знамени (новобранцы вне
		# боя, рабочие) знаменосца нет вовсе
		var anchor: Vector3 = post_pos
		var bearer2 = GameManager.squad_bearer(squad_id)
		if bearer2 != null and is_instance_valid(bearer2):
			var b2 := bearer2 as Unit
			if b2 != null and not b2.is_dead():
				anchor = b2.position if b2._local_xform else b2.global_position
		var away: float = Vector2(nb_pos.x - anchor.x,
			nb_pos.z - anchor.z).length()
		if away > aggro_leash():
			# Далеко от поста: гнаться нельзя, но если враг уже вплотную —
			# отвечаем, не сходя с места
			var at_hand2 := _find_nearest_enemy_in_range(attack_range, "leash_at_hand")
			if at_hand2 != null:
				command_attack(at_hand2, false)
			return
	if nearby:
		_aggro_timer = AGGRO_INTERVAL_HOT     # рядом бой — следим внимательно
		var mypos: Vector3 = position if _local_xform else global_position
		var far: bool = mypos.distance_to(nb_pos) > attack_range
		# ── ЦЕЛЬ ЗА ОБРЫВОМ — ИНИЦИАТИВЫ НЕТ (спринт 19, письмо 11) ────────
		# Замеченный наверху плато враг раньше вёл отряд лбом в стену
		# (скриншот владельца: орки сгрудились у обрыва и дёргаются). Идти к
		# нему можно только по прямой без скал/воды, либо обходом не длиннее
		# поводка. Стрелку, до которого дострелить и так, это не мешает:
		# правило только для тех, кому надо СОЙТИ С МЕСТА
		if far and GameManager.nav_unreachable(mypos, nb_pos, aggro_leash()):
			var at_hand5 := _find_nearest_enemy_in_range(attack_range, "nav_at_hand")
			if at_hand5 != null:
				command_attack(at_hand5, false)
			return
		# ── ЗА БЕГУЩИМИ НЕ ГОНИМСЯ ─────────────────────────────────────────
		# ЗАКАЗ ВЛАДЕЛЬЦА: «если вражеский отряд разбит и бежит, наш отряд НЕ
		# разбегается за беглецами».
		#
		# Догнать бегущего можно только погоней врассыпную: он уходит веером
		# (см. GameManager._start_panic), и каждый преследователь выбирает
		# своего. Именно так строй и рассыпался в конце каждой выигранной
		# схватки — а собрать его обратно потом нечем, пока игрок не отдаст
		# приказ. Поэтому бегущий остаётся ЗАКОННОЙ целью для того, кто до него
		# ДОТЯГИВАЕТСЯ (добить бегущего — святое дело), но поводом СОЙТИ С МЕСТА
		# он не является.
		#
		# Признак берём готовый: паника и отход — единственные два режима, в
		# которых боец уходит от нас не по приказу своего игрока
		if far:
			var fu := nearby as Unit
			if fu != null and (fu.is_panicked() or fu.retreating):
				var at_hand3 := _find_nearest_enemy_in_range(attack_range, "fleeing_at_hand")
				if at_hand3 != null:
					command_attack(at_hand3, false)
				return
		# ── ОТРЯД УШЁЛ С ПОСТА ПО СВОЕЙ ИНИЦИАТИВЕ ──────────────────────────
		# far = true означает «врага бью не с места, а иду к нему»: сосед идёт
		# ПОМОГАТЬ. Помечаем это на отряде — по окончании боя он вернётся на
		# СВОЙ пост, а не встанет там, где закончилась рубка (заказ владельца:
		# «соседний отряд помогает, а после победы полностью восстанавливает
		# исходную позицию и шеренгу»). Отряд, которого игрок сам послал в бой,
		# метку не получает и строится по месту — см. GameManager.squad_close_ranks
		if far and squad_id > 0:
			GameManager.squad_mark_helped(squad_id)
		command_attack(nearby, far)

## НА СКОЛЬКО МЕТРОВ ОТРЯД ПОДТЯГИВАЕТСЯ К СВОЕЙ ЖЕ СВАЛКЕ.
## Заметно больше длины руки (чтобы вторая-третья шеренга и фланг дотянулись)
## и заметно меньше поводка AGGRO_LEASH (чтобы это осталось шагом в контакт, а
## не погоней). Отряд в шестьдесят человек стоит пятном метров в шесть — семи
## хватает, чтобы дальний край увидел ближний
const PULL_UP_RANGE := 7.0
## Застрявший на подходе к цели после стольких проверок подряд (STUCK_CHECK_SEC
## каждая) берёт ближайшего врага в этом радиусе (спринт 20)
## Ручка прежнего одиночного подтягивания фланга в обороне (спринт 20: false)
const PHALANX_PULL_UP_SINGLE := false
const STUCK_RETARGET_STREAK := 2
const STUCK_RETARGET_RANGE := 5.0
var stuck_retargets: int = 0

## Косинус границы лобового сектора фаланги. 0.34 ≈ ±70°: строй достаёт копьём
## всё, что стоит перед ним и чуть в стороны, но не разворачивается назад
const PHALANX_FRONT_COS := 0.34

## Цель стоит перед фронтом строя? Курс берётся тот же, по которому считаются
## ряды (_phalanx_dir), — иначе «перед» у подсчёта рядов и у выбора цели были бы
## разными направлениями
func _in_phalanx_front(target: Node3D) -> bool:
	var f := _phalanx_dir()
	if f.length_squared() < 1e-6:
		return true                      # курса нет — брать что дотянется
	# Обе точки — по дешёвому пути (правило 2). Проверку проходит каждый
	# копейщик обороны на каждой смене цели, а у постройки локальной точки нет
	var tu := target as Unit
	var tp: Vector3 = tu.position if (tu != null and tu._local_xform) \
		else target.global_position
	var mp: Vector3 = position if _local_xform else global_position
	var to := Vector3(tp.x - mp.x, 0.0, tp.z - mp.z)
	var l: float = to.length()
	if l < 0.01:
		return true                      # вплотную, стороны не определить
	return f.dot(to / l) >= PHALANX_FRONT_COS

# ── ФАЛАНГА: ФАКТИЧЕСКИЙ РЯД И СМЫКАНИЕ ──────────────────────────────────────

## Куда смотрит строй: на последнего замеченного врага, иначе — по _facing
## КУРС ФАЛАНГИ. Порядок источников важен.
##
## Сначала — КУРС СТРОЯ отряда, если игрок его задал. У отряда с разметкой
## фронт задан приказом, и он ОДИН НА ВСЕХ. Направление «на ближайшего врага»
## у каждого бойца своё: крайние колонны смотрят на противника под углом, и
## расхождение в 15–20° разворачивает полосу подсчёта наискось. Тогда сосед
## СБОКУ попадает в неё как «стоящий впереди» (замер qa_formation: _live_rank
## до 6 у отряда глубиной в четыре шеренги), строй перестаёт понимать, где у
## него перёд, и копья опускает вся глубина отряда.
##
## И только если разметки нет (одиночка, стенд, отряд без приказа) — прежнее
## поведение: направление на замеченного врага, а затем просто взгляд
func _phalanx_dir() -> Vector3:
	if squad_id > 0:
		# ── В БОЮ «ВПЕРЁД» — ЭТО НА ЛИНИЮ СОПРИКОСНОВЕНИЯ, А НЕ ПО КУРСУ ────
		# Курс отряда (squad_course) — это направление ПОСЛЕДНЕГО ПРИКАЗА, и вне
		# боя он и есть «вперёд»: по нему считаются ряды и по нему смыкается
		# строй. Но как только фаланга сцепилась, курс становится вчерашним:
		# противник почти никогда не стоит ровно на нём. Незанятые бойцы задних
		# рядов и флангов честно шагали ПО КУРСУ — то есть мимо драки, в пустое
		# поле, — и со стороны это выглядело как «фаланга разбредается вперёд,
		# вместо того чтобы повернуться к бою».
		#
		# Пока отряд в бою, направление берётся от общего врага отряда
		# (squad_enemy_dir — один вектор на всех, снятый одним сканом). Тогда и
		# «кто впереди меня», и шаг на закрытие бреши считаются относительно
		# линии соприкосновения, а не относительно старого приказа
		var shared: Vector3 = GameManager.squad_enemy_dir(squad_id)
		if shared.length_squared() > 1e-6 and GameManager.squad_in_combat(squad_id):
			return shared
		var course: Vector3 = GameManager.squad_course(squad_id)
		if course.length_squared() > 1e-6:
			return course
		# Разметки нет — берём общий курс отряда «на противника», снятый один
		# раз на весь отряд. Это тот же источник, что и у своего
		# _enemy_seen_dir, но ОДИН вектор на всех
		if shared.length_squared() > 1e-6:
			return shared
	if _enemy_seen_dir.length_squared() > 1e-6:
		return _enemy_seen_dir
	if _facing.length_squared() > 1e-6:
		return _facing.normalized()
	return Vector3.ZERO

## Пересчёт ряда: сколько своих стоит прямо передо мной, столько и ряд.
## Заодно обновляет направление и дистанцию до врага — по ГЕОМЕТРИЧЕСКИ
## ближайшему, чтобы вся шеренга смотрела в одну сторону
func _update_live_rank() -> void:
	# ОДИН СКАН НА ОТРЯД, А НЕ НА БОЙЦА. Ближайшего врага ищет первый спросивший
	# из отряда, остальные берут его мировую точку из кэша и считают от неё своё
	# направление. Вся шеренга и так обязана смотреть в одну сторону, а скан
	# радиусом 10 м обходит 441 ячейку сетки — на отряд в 50 человек это была
	# двадцать одна тысяча лишних обращений четырежды в секунду
	var _rp: bool = _prof_on
	var _rt: int = Time.get_ticks_usec() if _rp else 0
	# ── ОТВЕТ БЕРЁТСЯ ЗНАЧЕНИЕМ, А НЕ ПАРОЙ В МАССИВЕ ──────────────────────
	# Здесь стоял squad_enemy_pos(), отвечавший `[точка, нашли ли]`: НОВЫЙ
	# Godot-массив на каждый вызов плюс словарь-умолчание внутри самого кэша.
	# Эта функция — четыре раза в секунду у КАЖДОГО копейщика в обороне, то
	# есть две сотни вызовов в кадре на трёх тысячах, а нужны из ответа ровно
	# три float. Vector3.INF означает «врага нет» (см. squad_enemy_point)
	var ep: Vector3 = GameManager.squad_enemy_point(squad_id, self, AGGRO_RADIUS)
	if _rp: _Opt.prof_add("rank_enemypos", Time.get_ticks_usec() - _rt)
	var off := Vector3.ZERO
	if ep != Vector3.INF:
		# СВОЯ ТОЧКА — ПО ДЕШЁВОМУ ПУТИ (правило 2): global_position у Node3D
		# это свойство с пересборкой мировой матрицы, а под неподвижным World
		# локальная position равна ей же (см. _local_xform)
		var mp: Vector3 = position if _local_xform else global_position
		off = Vector3(ep.x - mp.x, 0.0, ep.z - mp.z)
	var d := off.length()
	if d > 1e-3:
		_enemy_seen_dir  = off / d
		_enemy_seen_dist = d
	else:
		_enemy_seen_dir  = Vector3.ZERO
		_enemy_seen_dist = INF
	# РЯД УЖЕ ИЗВЕСТЕН ОТ ОТРЯДА — СКАН СОСЕДЕЙ НЕ НУЖЕН. Разметка линии
	# (GameManager._sweep_battle_lines) считает его как глубину, делённую на
	# глубину ряда, то есть арифметикой внутри уже идущего прохода по составу.
	# Скан allies_ahead обходит полосу перед бойцом и стоит на порядок дороже.
	# Направление и дистанцию до врага выше пересчитать всё равно надо: их
	# читают _phalanx_advance и выбор позы копейщика
	if _line_valid:
		return
	# ── РЯД УЖЕ ПРИШЁЛ ОТ ОТРЯДА ───────────────────────────────────────────
	# Пакетный проход (GameManager._push_squad_ranks) считает всю шеренгу одним
	# сканом. Личный allies_ahead был самой дорогой строкой тика — не работой,
	# а дорогой наружу: два прыжка по GDScript плюс переход границы на бойца
	if _rank_fresh:
		_rank_fresh = false
		return
	var dir := _phalanx_dir()
	if dir.length_squared() < 1e-6:
		_live_rank = 0
		return
	if _rp: _rt = Time.get_ticks_usec()
	_live_rank = GameManager.unit_grid.allies_ahead(
		self, dir, FILE_LOOK_AHEAD, FILE_HALF_WIDTH)
	if _rp: _Opt.prof_add("rank_allies", Time.get_ticks_usec() - _rt)

## ЗАКРЫТЬ БРЕШЬ В СТРОЮ — и только это.
##
## Стойка ЗАЩИТА означает «стоять на месте и удерживать позицию»: отряд не
## агрится и НЕ ИДЁТ на врага. Раньше эта функция подтягивала бойца к любому
## замеченному противнику в радиусе агро, и шеренга в обороне сама уползала
## навстречу врагу (замер: +1.48 м за 4 секунды при противнике в 8 м).
##
## Теперь шаг вперёд разрешён ТОЛЬКО когда бой уже идёт вплотную: враг ближе
## ADVANCE_MAX_DIST, то есть перед бойцом действительно выбили соседа и надо
## сомкнуть строй. Дальний противник оставляет фалангу стоять.
const ADVANCE_MAX_DIST := 1.5   # м сверх дальности атаки
## Подаётся ли фаланга вперёд на близкого врага сама, без приказа.
## false — стойка «Защита» держит место намертво (см. _phalanx_advance)
const PHALANX_ADVANCE_ON_ENEMY := false

func _phalanx_advance(delta: float) -> void:
	if _enemy_seen_dist == INF:
		return                       # врага вокруг нет — стоим
	var dir := _phalanx_dir()
	if dir.length_squared() < 1e-6:
		return
	# Кто-то из своих стоит вплотную впереди — держим своё место в глубине строя.
	#
	# Полоса та же, что у подсчёта ряда: перекос курса лечится в _phalanx_dir()
	# (отряд с разметкой берёт ОДИН курс на всех), а не расширением полосы —
	# широкая полоса засчитывала соседа СБОКУ как стоящего впереди, и смыкание
	# замирало на интервале 1.0 м вместо номинальных 0.7
	var g: SpatialGrid = GameManager.unit_grid
	if g.allies_ahead(self, dir, PHALANX_GAP, FILE_HALF_WIDTH) > 0:
		_closing_gap = false      # дошли вплотную — смыкание закончено
		return
	# ── КТО Я: ЗАКРЫВАЮ БРЕШЬ ИЛИ НАСТУПАЮ ──────────────────────────────────
	# Впереди пусто в пределах зазора. Но если ДАЛЬШЕ зазора, в пределах
	# видимости шеренги, свои всё-таки есть — значит передо мной ДЫРА в строю,
	# и шаг вперёд её закрывает, а не ведёт отряд на врага.
	#
	# ЗАЧЕМ ЭТО РАЗДЕЛЕНИЕ. Раньше шаг гасился общим ограничением «враг ближе
	# attack_range + ADVANCE_MAX_DIST», и глубокие шеренги закрыть брешь не
	# могли ФИЗИЧЕСКИ: они стоят в 4–5 м от противника, то есть заведомо за
	# порогом. Передние смыкались, задние стояли — и «кирпич» растягивался в
	# гармошку с интервалом до 1.6 м вместо 0.7 (замер qa_ph2, 1.3). Дальше
	# рушилось и всё остальное: при интервале больше FILE_LOOK_AHEAD боец
	# переставал видеть шеренгу перед собой, считал себя передовым и опускал
	# копьё — щетина пик появлялась по всей глубине отряда (замер qa_ph2, 1.2).
	#
	# Ограничение по врагу остаётся ровно там, где оно и задумано: у ПЕРЕДОВОГО
	# бойца, перед которым нет вообще никого. Только он может увести фалангу
	# вперёд, и только ему нельзя наступать на дальнего противника.
	#
	# ЧТО ИМЕННО ОСЛАБЛЯЕТСЯ ДЛЯ ЗАКРЫВАЮЩЕГО БРЕШЬ. Только дальний порог.
	# Запрет «сам достаёшь копьём — стой» остаётся БЕЗУСЛОВНЫМ: без него
	# смыкание превращается в общий навал, задние толкают передних, и весь
	# кирпич переползает вражескую линию насквозь (замер: передний край
	# оказывался на 0.46 м ЗА противником вместо зазора в длину копья)
	if _enemy_seen_dist <= attack_range + 0.1:
		return                       # уже достаём копьём — на месте
	#
	# Брешь засчитывается, только если ближайший свой впереди дальше
	# PHALANX_HOLE_GAP, но всё ещё в пределах видимости шеренги. Между
	# PHALANX_GAP и PHALANX_HOLE_GAP — мёртвая зона: строй уже сомкнут,
	# трогаться незачем
	#
	# ЗАЩЁЛКА, А НЕ ПРОВЕРКА КАЖДЫЙ КАДР. Порог начала (PHALANX_HOLE_GAP = 0.9)
	# и порог конца (PHALANX_GAP = 0.7) — РАЗНЫЕ, и это принципиально. Если
	# спрашивать «есть ли брешь» каждый кадр, боец прекращает шаг ровно в тот
	# миг, когда просвет стал чуть меньше 0.9, — то есть строй смыкается не до
	# номинальных 0.7, а замирает на 0.99 (замер qa_ph2, 1.3). Поэтому решение
	# ЗАЩЁЛКИВАЕТСЯ: начали закрывать брешь — идём, пока не встанем вплотную,
	# и только тогда защёлка снимается (в проверке выше)
	if not _closing_gap:
		_closing_gap = \
			g.allies_ahead(self, dir, FILE_LOOK_AHEAD, FILE_HALF_WIDTH) > 0 \
			and g.allies_ahead(self, dir, PHALANX_HOLE_GAP, FILE_HALF_WIDTH) == 0
	var closing_gap: bool = _closing_gap
	# ── ФАЛАНГА БОЛЬШЕ НЕ НАСТУПАЕТ САМА (заказ владельца, авг. 2026) ────────
	# Передовой боец, перед которым нет никого, раньше подавался ВПЕРЁД к врагу,
	# если тот был в пределах attack_range + ADVANCE_MAX_DIST. Требование теперь
	# прямо противоположное: «копейщики стоят на месте как забор, враг отбежал —
	# бойцы стоят». Шаг остаётся ровно один — в ДЫРУ СВОЕГО СТРОЯ (closing_gap),
	# то есть смыкание рядов после гибели переднего, чего владелец просил
	# отдельно и явно.
	# Ветка сохранена под константой, а не вырезана: это правило боя, и его
	# захотят вернуть одним словом, а не восстанавливать по истории
	if not closing_gap:
		if not PHALANX_ADVANCE_ON_ENEMY:
			return
		if _enemy_seen_dist > attack_range + ADVANCE_MAX_DIST:
			return                   # враг далеко — держим позицию, не наступаем
	var spd: float = _effective_speed() * PHALANX_FILL_SPEED
	_settled = false             # тронулся закрывать брешь — не якорь
	_facing  = dir
	velocity = dir * spd
	var step := dir * (spd * delta)
	_move_blocked(step)
	# Дистанция обновляется скану раз в 0.5 сек — подкручиваем её сами,
	# чтобы боец не проскочил передовую между опросами
	_enemy_seen_dist = maxf(_enemy_seen_dist - spd * delta, 0.0)

func _on_attack_fired(_target: Node3D, _damage: float) -> void:
	pass  # override in ranged units

# ── ЗВУК БОЯ ─────────────────────────────────────────────────────────────────
# Категории задаёт БАЗОВЫЙ класс, подклассы их переопределяют. Так добавление
# нового рода войск не требует правок в общем цикле удара.
# Копейщик бьёт древком — свист (WHSH); мечник рубит — звон стали.

## Звук замаха
func _sfx_swing() -> String:
	return "spear_hit"

## Звук попадания
func _sfx_hit() -> String:
	return "sword_hit"

## Вероятность боевого клича на один удар. Клич — редкая приправа: при сотнях
## бойцов даже 3% дают ровный гул, а не хор. Ограничитель в AudioManager
## дополнительно держит паузу между кличами
const SHOUT_CHANCE := 0.03
## Кем добит (спринт 18): пишется в take_damage перед _die
var _slain_by: Node = null

## Категория выкрика в бою и её вероятность на удар — СВОЙСТВА РОДА ВОЙСК
## (спринт 18): орда кричит своими голосами и чаще, тролль рычит редко
func _sfx_shout() -> String:
	return "vox_action"

func _shout_chance() -> float:
	return SHOUT_CHANCE

## Категория предсмертного крика (орда — свой, см. GoblinSpearman)
func _sfx_death() -> String:
	return "vox_death"

func _maybe_battle_shout() -> void:
	if randf() < _shout_chance():
		AudioManager.play_3d(_sfx_shout(), global_position)

func _upgrade_damage_bonus() -> float:
	# vet_attack — награда «+Атака» за ветеранство отряда. Читается ЗДЕСЬ, вживую
	# на каждом ударе, как и бонусы кузницы: иначе выбранная игроком награда
	# оставалась бы только числом в панели и на урон не влияла вовсе
	# «Боевой клич» монаха — рукопашным (письмо 12)
	var aura: float = _aura_attack if (now_ms < _aura_until_ms and attack_range <= 3.0) else 0.0
	return GameManager.get_upgrade(faction, "damage") \
		+ GameManager.unit_bonus(faction, stat_id, "bonus_attack") \
		+ vet_attack + aura

# Выбор цели с РАСПРЕДЕЛЕНИЕМ по шеренге: к дистанции добавляется штраф за
# каждого бойца, уже бьющего эту цель. 40 копейщиков против 30 больше не
# сваливаются толпой на одного — линия разбирает противников почти 1 в 1.
## ОБЩИЙ ПОИСК ЦЕЛИ НА ОТРЯД. Тяжёлую часть (скан сетки радиусом до 20 м с
## аллокацией массива) делает ПЕРВЫЙ спросивший боец отряда, остальные за
## SQUAD_TARGET_TTL секунд забирают готовый ответ. Для 20 моделей это 1 скан
## вместо 20. Ровно то, что в задании названо «считает лидер, остальные идут
## за ним»: дорогая работа делается на отряд, а не на модель.
##
## ПОЧЕМУ ЭТО НЕ ЛОМАЕТ БОЙ: цель всё равно берётся не «ближайшая к бойцу», а
## с учётом штрафа за уже атакующих (CROWD_PENALTY), то есть отряд и так
## разбирает противника сообща. Кэш просто перестаёт пересчитывать одно и то же
## двадцать раз за кадр.
## ── ОБЩИЙ ОТВЕТ ГОДИТСЯ, ТОЛЬКО ЕСЛИ ОН ГОДИТСЯ И МНЕ ──────────────────────
## Кэш нашёл врага ОТ ЧУЖОГО ИМЕНИ — от того бойца отряда, который спросил
## первым. Пока радиус велик (лучник смотрит на двадцать метров, марш — на
## десять), отряд помещается внутрь этой разницы целиком и ответ честен для
## всех. В РУКОПАШНОЙ он честен ровно для одного человека: у копейщика радиус
## полтора метра, а отряд стоит пятном в пять-шесть, и боец из второй шеренги
## получал цель, до которой ему семь метров.
##
## Дальше начиналось самое плохое. В стойке «Защита» такой боец сходить с места
## не вправе (см. _process_attack), цель не бросает — и НАВСЕГДА остаётся в
## State.ATTACKING с недостижимым противником. А авто-агро обслуживает только
## State.IDLE: подошедшего вплотную врага он уже не увидит НИКОГДА. Это и есть
## жалоба «дерутся два-три крайних копейщика, остальные стоят и смотрят».
##
## Проверка стоит ОДНО вычитание и одно сравнение и делается по КВАДРАТАМ.
## Промах кэша означает свой скан — ровно как до кэша; частота этих сканов
## задана таймером авто-агро (0.5–2 с), а не кадром
func _squad_cached_enemy(range_limit: float) -> Node3D:
	if not _Opt.squad_target_cache or squad_id == 0:
		return _find_nearest_enemy_in_range(range_limit, "cache_off")
	# ЧАСЫ АРМИИ ВМЕСТО ВЫЗОВА В ДВИЖОК. Time.get_ticks_msec() стоял здесь на
	# каждого спросившего, а now_ms снимается один раз за тик на всю армию
	# (см. GameManager._physics_process). Запасной путь — для стендов, которые
	# зовут бой до первого кадра
	var nms: int = now_ms
	if nms == 0:
		nms = Time.get_ticks_msec()
	var now: float = float(nms) * 0.001
	var hit: Node3D = GameManager.squad_target_get(squad_id, range_limit, now)
	if hit != null:
		var hu := hit as Unit
		var hp: Vector3 = hu.position if (hu != null and hu._local_xform) \
			else hit.global_position
		var mp2: Vector3 = position if _local_xform else global_position
		var hx: float = hp.x - mp2.x
		var hz: float = hp.z - mp2.z
		var lim: float = range_limit + _pad_of(hit)
		if hx * hx + hz * hz <= lim * lim:
			return hit
		# Ответ отряда мне не подходит — ищу сам. Кэш при этом НЕ перетираем:
		# для того, кто его положил, он верен, и обнулять чужой верный ответ
		# ради своего промаха значило бы гонять скан по всему отряду по кругу
		return _find_nearest_enemy_in_range(range_limit, "cache_miss_range")
	# ── ОТВЕТ ОТРЯДА ИЩЕТ ЗНАМЕНОСЕЦ, А НЕ ПЕРВЫЙ СПРОСИВШИЙ ────────────────
	# ЗАКАЗ ВЛАДЕЛЬЦА: «все расчёты агро и выбора цели отряда производить
	# СТРОГО от позиции знаменосца; куда агрится знаменосец, туда фокусирует
	# атаку весь отряд».
	#
	# Было: ответ клал ПЕРВЫЙ СПРОСИВШИЙ, а спрашивают в порядке обхода армии,
	# то есть по сути случайный боец. У отряда, растянутого боем, крайний левый
	# и крайний правый видят РАЗНЫХ ближайших врагов — и общий ответ отряда
	# зависел от того, чей тик пришёл первым в этом кадре. Отсюда «юниты на
	# флангах утягивают цели в противоположные стороны».
	#
	# Знаменосец — единственная точка отряда, у которой есть смысл «центр
	# строя» и которая при этом ЖИВОЕ ТЕЛО, а не производная величина: медиана
	# у расколотого отряда садится в пустое поле между кучами (см.
	# GameManager._centroid_of), и агро от неё смотрело бы в никуда.
	#
	# ЛИЧНЫЙ СКАН ПРИ ЭТОМ НЕ ОТМЕНЯЕТСЯ: если ответ знаменосца этому бойцу не
	# по руке, он ищет сам (ветка выше). Без этого возвращается «пассивная
	# фаланга» — второй ряд с недостижимой целью, который не дерётся вовсе
	var scout: Unit = self
	var bearer = GameManager.squad_bearer(squad_id)
	if bearer != null and is_instance_valid(bearer):
		var bu := bearer as Unit
		if bu != null and not bu.is_dead():
			scout = bu
	var found: Node3D = scout._find_nearest_enemy_in_range(range_limit, "squad_cache_fill")
	GameManager.squad_target_put(squad_id, range_limit, found, now)
	return found

## Развернуться на точку и пометить позу грязной. Фаза прицеливания
## центрового нода отряда: отряд смотрит на врага, но огня ещё не открывает.
## Поза метится здесь же — иначе разворот доедет до картинки только со
## следующим полным разбором позы, то есть через такт (правило E3)
func face_towards(p: Vector3) -> void:
	var mp: Vector3 = position if _local_xform else global_position
	var v := Vector3(p.x - mp.x, 0.0, p.z - mp.z)
	if v.length_squared() < 1e-4:
		return
	_facing = v.normalized()
	_pose_dirty = true

## ── СКАН ПО ЗАКАЗУ ЦЕНТРОВОГО НОДА ОТРЯДА ─────────────────────────────────
## Публичная обёртка над единственным сканом в проекте: её зовёт
## GameManager._sweep_squad_radar у ОДНОГО бойца отряда (знаменосца) вместо
## того, чтобы тридцать лучников спрашивали каждый за себя. Своего скана здесь
## нет намеренно — учёт поиска цели обязан оставаться одной точкой
func radar_scan(range_limit: float) -> Node3D:
	return _find_nearest_enemy_in_range(range_limit, "radar")

## Дистанция, с которой этот боец открывает огонь по цели: дальность оружия
## плюс поправка на габарит (у здания меряется до стены, см. _target_pad)
func fire_range_to(target: Node3D) -> float:
	return attack_range + _pad_of(target)

## Счётчик atk_find_enemy — ЕДИНАЯ точка учёта поиска цели. Сюда сходятся все
## поводы искать: добор цели после гибели прежней, проверка заслона на подходе
## и промах общего кэша отряда. Именно этот счётчик отвечает на вопрос «сколько
## стоит поиск целей», и он намеренно один: разделять его по поводам было бы
## честно, но поводы сходятся в один и тот же скан сетки
func _find_nearest_enemy_in_range(range_limit: float, site: String = "?") -> Node3D:
	var _prof: bool = _prof_on
	var _t: int = Time.get_ticks_usec() if _prof else 0
	# Счёт сканов для бенчмарка: одно сравнение bool, когда выключен
	if _Opt.scan_meter:
		_Opt.scan_hit(site)
	# Юниты — одним проходом по сетке, БЕЗ сборки промежуточного массива
	# (см. SpatialGrid.best_enemy: раньше query_radius() оставлял здесь
	# мусорный Array на каждый вызов, а вызовов в свалке сотни в секунду)
	var best: Node3D = GameManager.unit_grid.best_enemy(self, range_limit, CROWD_PENALTY)
	# ── СВОЯ ТОЧКА ЧИТАЕТСЯ ПО ДЕШЁВОМУ ПУТИ И ОДИН РАЗ ────────────────────
	# global_position у Node3D — свойство с проверкой мировой матрицы, а здесь
	# оно читалось заново на КАЖДОЕ здание. Под неподвижным World локальная
	# position равна мировой (см. _local_xform)
	var mp: Vector3 = position if _local_xform else global_position
	var best_dist := range_limit
	if best != null:
		var bu := best as Unit
		var bp: Vector3 = bu.position if (bu != null and bu._local_xform) \
			else best.global_position
		best_dist = mp.distance_to(bp)
	# ── ЗДАНИЯ БЕРУТСЯ ГОТОВЫМ СНИМКОМ ────────────────────────────────────
	# Их мало и они НЕПОДВИЖНЫ, а прежний перебор читал у каждого свойство
	# global_position на каждый вызов поиска цели — то есть сотни обращений к
	# мировой матрице в кадр ради координат, которые не меняются вовсе.
	# Снимок (координаты плоским массивом) собирается раз в кадр и на всю
	# фракцию сразу, см. GameManager.enemy_buildings_snapshot
	var snap: Array = GameManager.enemy_buildings_snapshot(faction)
	var bnodes: Array = snap[0]
	var bxz: PackedFloat32Array = snap[1]
	for i in range(bnodes.size()):
		var dx: float = bxz[i * 2] - mp.x
		var dz: float = bxz[i * 2 + 1] - mp.z
		var d: float = sqrt(dx * dx + dz * dz)
		if d < best_dist:
			var node = bnodes[i]
			if not is_instance_valid(node):
				continue
			if node.has_method("is_dead") and node.is_dead():
				continue
			# Крепость ИИ орде не цель (may_attack_building): у пехоты — одно
			# сравнение фракции, платит только орда у самой цитадели
			if node is Building and not may_attack_building(node as Building):
				continue
			best_dist = d
			best = node
	if _prof: _Opt.prof_add("atk_find_enemy", Time.get_ticks_usec() - _t)
	return best

## Счётчик atk_damage — списание урона целиком: снятие здоровья, отметка отряда,
## ответная реакция, гибель. Считается на СТОРОНЕ ЦЕЛИ, поэтому попадает в общий
## тик через того, кого бьют, а не через бьющего
func take_damage(amount: float, attacker: Node3D = null) -> void:
	if state == State.DEAD:
		return
	# ── УКРЫТЫЙ В ЗДАНИИ УРОНА НЕ ПОЛУЧАЕТ — ЕГО ПОЛУЧАЕТ ЗДАНИЕ ────────────
	# Заказ владельца (09.09.2026): лучники в башне неуязвимы, пока башня
	# стоит; всё, что прилетело по ним, списывается с её запаса. Из сетки
	# соседей укрытый снят (set_off_map), так что сюда доходит редкое: снаряд,
	# нацеленный до входа, брызги, прямой вызов. Хозяина нет (осиротевшая
	# запись) — удар просто пропадает: бить того, кого нет на карте, нельзя
	if garrisoned:
		var host := garrison_host
		if host != null and is_instance_valid(host) and host.has_method("absorb_damage_for"):
			host.absorb_damage_for(self, amount, attacker)
		return
	# Тыловой напор и автопилот кончаются первым же ударом ПО МНЕ: ответ,
	# мораль и выбор цели — дела полного автомата (этап D1)
	if _rear_press:
		_rear_press = false
		if _soa >= 0:
			GameManager.army.rear_press_clear(_soa)
	if _auto_pilot:
		_auto_pilot = false
		if _soa >= 0:
			GameManager.army.autopilot_clear(_soa)
	var _prof_d: bool = _prof_on
	var _t_d: int = Time.get_ticks_usec() if _prof_d else 0
	# ЗАЩИТА ОТ «PREVIOUSLY FREED». Стрелок/атакующий мог быть освобождён между
	# тем, как урон был поставлен в очередь (стрела в полёте, отложенный вызов),
	# и этим самым вызовом. Сравнение с null тут не спасает — объект остаётся
	# формально «не null», просто уже невалиден, поэтому только is_instance_valid.
	# Дальше по функции attacker читается многократно (global_position,
	# command_attack, credit_kill, squad_counter_charge) — обнуляем один раз здесь,
	# а не проверяем перед каждым обращением
	if attacker != null and not is_instance_valid(attacker):
		attacker = null
	_wake_process()
	# Отряд отмечает "меня недавно задели" — держит squad_in_combat() истинным
	# даже когда враг бьёт издали и никто в отряде не вступает в ближний бой
	if squad_id > 0:
		GameManager.squad_mark_hit(squad_id)
	var total_defense: float = defense + armor \
		+ GameManager.get_upgrade(faction, "defense") \
		+ GameManager.unit_bonus(faction, stat_id, "bonus_armor") \
		+ GameManager.unit_bonus(faction, stat_id, "bonus_defense") \
		+ vet_armor + vet_defense \
		+ (_aura_armor if now_ms < _aura_until_ms else 0.0) \
		+ _UStats.stance_stat(stance, "defense_bonus", 0.0)   # +5 в обороне
	# ── ПАНИКА СРЕЗАЕТ ЗАЩИТУ ──────────────────────────────────────────────
	# Отряд под белым флагом бежит врассыпную и не прикрывается: его добивают
	# безнаказанно (заказ владельца). Множитель — в конфиге
	if _panicked:
		total_defense *= _UStats.PANIC_ARMOR_MULT
	# ── ПРОБИТИЕ БРОНИ ─────────────────────────────────────────────────────
	# Легендарный перк «Пробитие брони» игнорирует долю чужой защиты. Читается
	# у ОТРЯДА нападающего, а не у бойца: перк выдаётся отряду целиком
	var pen: float = GameManager.squad_armor_pierce(attacker)
	if pen > 0.0:
		total_defense *= (1.0 - pen)
	# ── СНИЖЕНИЕ УРОНА БРОНЁЙ: ДОЛЯ, А НЕ ВЫЧИТАНИЕ ────────────────────────
	# Формула и разбор — в unit_stats_config.damage_after_armor. Коротко:
	# вычитание сверхлинейно (каждое следующее очко брони дороже предыдущего)
	# и зависит от величины удара, поэтому и давало «терминаторов» при
	# перекачке. Долевое снижение с затуханием не даёт нуля никогда и стоит
	# одинаково против любого оружия.
	#
	# ПОРОГ ПРОБИТИЯ ОСТАВЛЕН СТРАХОВКОЙ. Сама формула до нуля не доходит, но
	# порог стоит копейку и защищает от отрицательных чисел в конфиге
	var actual: float = maxf(amount * MIN_DAMAGE_FRACTION,
		_UStats.damage_after_armor(amount, total_defense))
	# ЩИТ И ПРОЧИЕ ДОЛЕВЫЕ СНИЖЕНИЯ. Считаются ПОСЛЕ вычета плоской защиты и
	# порога пробития: щит режет то, что уже прошло сквозь броню. Множитель
	# никогда не равен нулю (см. Warrior), поэтому бессмертия по-прежнему нет
	var factor: float = _incoming_damage_factor(attacker)
	if factor < 1.0:
		actual *= factor
	# ЦЕНА БЕГА (см. SPRINT_DAMAGE_MULT). Последним множителем, уже поверх щита:
	# бегущий не прикрыт, и снижения, которые он МОГ БЫ получить стоя, ему
	# всё равно не полагаются
	if sprinting:
		actual *= SPRINT_DAMAGE_MULT
	current_health -= actual
	# Здоровье в строку ядра армии — здесь, а не в тике: урон приходит редко,
	# а тик идёт по всей армии каждый кадр (см. scripts/army/ArmySoA.gd)
	_soa_push_stats()
	_update_hp_bar()
	# ── ОТКЛИК НА ПОПАДАНИЕ — В ТОМ ЖЕ КАДРЕ, ЧТО И САМ УДАР ────────────────
	# Ждать ближайшего визуального тика нельзя: он шардирован, и на большой
	# армии боец получает его раз в три-четыре кадра — то есть вспышка длиной в
	# 0.07 с успела бы догореть до того, как её впервые нарисуют. Запись стоит
	# двух float в теневой буфер бакета, наружу (в RenderingServer) ничего не
	# уходит: буфер подаётся одним flush() в конце кадра, как и всегда.
	# Мёртвому не мигаем: слот у него снимается в этом же кадре, а на поле
	# остаётся труп — отдельный слой со своим шейдером
	if current_health > 0.0:
		_hit_flash = HIT_FLASH_SEC
		_dmg_dirty = true
		_push_damage_shade()
	if current_health <= 0.0:
		# Фраг записывается на ОТРЯД убийцы (см. GameManager.credit_kill):
		# опыт копится отрядом целиком, а не отдельным бойцом
		var _dt: int = Time.get_ticks_usec() if _prof_d else 0
		GameManager.credit_kill(attacker, self)
		if _prof_d: _Opt.prof_add("die_credit", Time.get_ticks_usec() - _dt); _dt = Time.get_ticks_usec()
		# Кто добил — читает GameManager._on_squad_wiped (клич тролля,
		# хор орды над выбитым отрядом). Сырая ссылка, живость там (правило 5)
		_slain_by = attacker
		_die()
		if _prof_d: _Opt.prof_add("die_rest", Time.get_ticks_usec() - _dt)
	elif (state == State.IDLE or state == State.MOVING) and attacker and attack_damage > 0.0 and not retreating and not sprinting and _may_answer_blow(attacker):
		var atk_dist: float = global_position.distance_to(attacker.global_position)
		# ── «ВПЛОТНУЮ» ПОД ЗАМКОМ — ЭТО ДЛИНА РУКИ, А НЕ ДАЛЬНОСТЬ ОРУЖИЯ ───
		# Ветка ниже отвечает на удар СВОЕЙ целью, то есть перебивает приказ
		# игрока. Для пехоты это честно: ударить могли только вплотную. Но у
		# лучника attack_range = 20 м, и «ударил в пределах дальности оружия»
		# означало «в меня попали чем угодно с двадцати метров» — то есть
		# первый же чужой копейщик, добежавший на пятнадцать метров, забирал
		# себе весь залп, назначенный игроком другому отряду.
		#
		# Порог тот же, что у перехвата заслона под замком (LOCK_BLOCKER_RANGE):
		# помеха обязана быть ФИЗИЧЕСКОЙ. Удар в упор ответ по-прежнему получает
		var hit_close: float = attack_range
		if target_lock:
			hit_close = minf(attack_range, LOCK_BLOCKER_RANGE)
		# ── СТРЕЛОК НА МАРШЕ ОТВЕЧАЕТ ТОЛЬКО НА УДАР В УПОР (ТЗ 14.09.2026, п. 10)
		# У лучника attack_range 20 м, и «ударили вплотную» на марше читалось
		# как «в меня попали с двадцати метров»: кость гнолла разворачивала весь
		# идущий отряд (squad_counter_charge). Приказ движения обязан дойти
		# до точки; отвечает стрелок, встав (IDLE — ветка ниже, как была)
		if state == State.MOVING and not pursues_target():
			hit_close = minf(attack_range, LOCK_BLOCKER_RANGE)
		if atk_dist <= hit_close:
			# КОНТАКТНЫЙ УДАР НА МАРШЕ — РАЗВОРАЧИВАЕТСЯ ВЕСЬ ОТРЯД, а не только
			# задетый боец. Раньше здесь всегда стоял только персональный ответ
			# (держит позицию, бьёт в ответ САМ) — колонна, у которой фланг
			# зацепило в ближнем бою, продолжала маршировать мимо готовой
			# завязаться драки: тот самый "слепой марш" из отчёта, только для
			# контактного удара, а не для обстрела (см. ветку COUNTER_CHARGE_RANGE
			# ниже — она уже решала это для стрел). squad_counter_charge сама
			# снимает _march_pending, восстанавливает его после боя и пропускает
			# бойцов, которых игрок прямо сейчас выводит из боя (_disengaging);
			# у неё свой откат (COUNTER_CHARGE_COOLDOWN_MS), так что вызывать её
			# на каждый удар безопасно
			if state == State.MOVING and squad_id > 0:
				GameManager.squad_counter_charge(squad_id, attacker)
			else:
				# Достаём оружием — отвечаем, не сходя с места
				command_attack(attacker, false)
		elif atk_dist <= COUNTER_CHARGE_RANGE and not _stance_holds_ground() and not target_lock:
			# ЗАМОК ПРИКАЗА ГЛУШИТ ОТВЕТ НА ОБСТРЕЛ (приоритет №1 против №3).
			# Отряд, посланный игроком на конкретную цель, обязан до неё дойти:
			# без этого гейта первый же вражеский лучник, кольнувший колонну с
			# десяти метров, разворачивал весь отряд на себя (squad_counter_charge
			# зовёт command_attack(forced) и перезаписывает _atk_pending), и приказ
			# игрока тихо подменялся стихийной стычкой. Удар ВПЛОТНУЮ (ветка выше)
			# по-прежнему получает ответ — это приоритет №2, помеха на пути
			# ── ОТВЕТ НА ОБСТРЕЛ ─────────────────────────────────────────────
			# Здесь не было НИЧЕГО. Отвечали только на удар в упор, и пехота,
			# которую расстреливали лучники с десяти метров, честно стояла и
			# умирала: «до меня не дотягиваются — значит, меня и не трогают».
			# Ровно та картина из задания, когда отряд добил врага, а рядом
			# стоят вражеские стрелки и в упор его расстреливают.
			#
			# Теперь стреляющий в нас противник поднимает ВЕСЬ ОТРЯД: бойцы
			# разворачиваются и идут на стрелков вместе, а не поодиночке.
			# Ограничения намеренно узкие, чтобы не сломать прежнее поведение:
			#   • только вне стойки ЗАЩИТА — фаланга держит рубеж как держала;
			#   • только вблизи (COUNTER_CHARGE_RANGE) — за стрелком через
			#     полкарты по-прежнему никто не бежит
			#
			# МАРШ ТЕПЕРЬ ТОЖЕ ПРЕРЫВАЕТСЯ, но только у ближнего боя. Раньше
			# это правило целиком глушилось на марше: колонна копейщиков через
			# полкарты получала стрелы и шла дальше как зомби, пока передний
			# отряд дрался, а следующие проходили мимо («слепота в бою» из
			# отчёта). Лучников это не касается — сами стрелки, должны дойти
			# до точки, а не срываться в погоню на марше
			if state == State.MOVING and self is Archer:
				pass
			elif state == State.IDLE and _march_pending:
				pass                # переходный кадр перед _resume_march — не дёргаем
			else:
				if squad_id > 0:
					GameManager.squad_counter_charge(squad_id, attacker)
				else:
					command_attack(attacker, true)
	# Ранний выход здесь ровно один (уже мёртв) и он ДО начала отсчёта, поэтому
	# счётчик закрывается в единственной точке
	# ── ОБСТРЕЛ ИЗДАЛЕКА (спринт 17): орда не стоит под стрелами ───────────
	if current_health > 0.0 and attacker != null and answers_far_fire():
		_answer_far_fire(attacker)
	if _prof_d: _Opt.prof_add("atk_damage", Time.get_ticks_usec() - _t_d)

## Долевой множитель входящего урона: 1.0 — без изменений, 0.3 — минус 70%.
## База ничего не режет; переопределяет Мечник (щит), см. Warrior._guard_active
func _incoming_damage_factor(_attacker: Node3D) -> float:
	return 1.0

## «В тебя стреляют»: лучник зовёт это на цели В МОМЕНТ ВЫСТРЕЛА, а не когда
## стрела долетит. Иначе щит поднимался бы уже после попадания. База — пустышка;
## смысл появляется у юнитов со щитом
func notify_incoming_fire(_from: Vector3) -> void:
	pass

func is_dead() -> bool:
	return state == State.DEAD

func _die() -> void:
	state = State.DEAD
	# Временное тело лежащего снимается: штатное положит _leave_corpse ниже
	if _down_until_ms > 0:
		_down_until_ms = 0
		_drop_down_prop()
	# Состояние в строку СРАЗУ, не дожидаясь очередного тика: пакетные обходы
	# отбирают живых именно по нему, а до следующего опроса бойца может пройти
	# до трёх кадров (чередование шардов)
	if _soa >= 0:
		GameManager.army.set_state(_soa, State.DEAD)
		_soa_state = State.DEAD
	# СМЫКАНИЕ РЯДОВ. Выбило бойца — отряд подтягивает выживших на первые места
	# разметки, и задняя шеренга переходит вперёд на место павшего.
	# Отложенно: сейчас идёт обход бойцов, и переиздавать приказы посреди него
	# нельзя. GameManager сам решит, набралось ли потерь на перестроение.
	# И ТОЛЬКО если отряд не в бою (см. squad_in_combat) — иначе смыкание
	# выдёргивает ещё дерущихся соседей погибшего прямо посреди свалки
	if squad_id > 0 and not GameManager.squad_in_combat(squad_id):
		GameManager.call_deferred("squad_close_ranks", squad_id)
	# ПРЕДСМЕРТНЫЙ СТОН. Строго при гибели: если вешать его на каждый заметный
	# урон, в свалке стон превращается в непрерывный вой. Ограничитель держит
	# не больше трёх голосов сразу — крики выходят россыпью, а не хором
	AudioManager.play_3d(_sfx_death(), global_position)
	# ── УБИЛ ТРОЛЛЬ — ЕГО ГЛУХОЙ РЫК (спринт 20) ────────────────────────────
	# Не только над выбитым отрядом (_on_squad_wiped), а на каждое убийство;
	# окно категории (gap 2.5 с) держит его от пулемёта в свалке
	var sb: Variant = _slain_by
	if sb != null and is_instance_valid(sb) and sb is Unit \
			and (sb as Unit).stat_id == "troll" and not (sb as Unit).is_dead():
		AudioManager.play_3d("troll_victory", (sb as Unit).global_position)
	# ── ТЕЛО ОСТАЁТСЯ НА ПОЛЕ ──────────────────────────────────────────────
	# Слотом в общем MultiMesh, а не узлом (см. CorpseRenderer): труп — это
	# декорация без состояния, физики и тика. Ставится ЗДЕСЬ, пока спрайт ещё
	# жив: сразу за этим идёт queue_free(), и после него ленту уже не спросить.
	# Ленту, кадр и масштаб труп берёт из самого бойца, поэтому работает для
	# всех фракций и родов войск без единой развилки
	var _ct: int = Time.get_ticks_usec() if _Opt.profile_physics else 0
	_leave_corpse()
	if _Opt.profile_physics: _Opt.prof_add("die_corpse", Time.get_ticks_usec() - _ct); _ct = Time.get_ticks_usec()
	# Снять свою «бронь» с цели, иначе её счётчик атакующих останется завышен
	# и живые бойцы будут считать её занятой (см. _find_nearest_enemy_in_range)
	set_attack_target(null)
	died.emit(self)
	if _Opt.profile_physics: _Opt.prof_add("die_signal", Time.get_ticks_usec() - _ct)
	queue_free()

## Положить тело на грунт. Отдельным методом, а не строкой в _die(): гарнизон
## и стенды поглощают бойцов своим путём, и им труп не полагается
func _leave_corpse() -> void:
	if GameManager.main == null:
		return
	var gp: Vector3 = global_position
	_corpse = GameManager.corpses.spawn(self, GameManager.main.world_root(),
		GameManager.get_terrain_height(gp.x, gp.z))

## Тело, оставшееся от этого бойца, или null. Спрашивает стрела, добившая его:
## ей надо воткнуться именно в это тело и растаять вместе с ним. Живёт ровно
## до конца кадра смерти — сам боец уходит следующим же queue_free
func corpse_ref():
	return _corpse

# ─────────────────────────────────────────────────────────────────────────────
# ПОЛОСКА ЗДОРОВЬЯ НАД ГОЛОВОЙ (ассеты SmallBar_Base / SmallBar_Fill)
# Создаётся ЛЕНИВО — только когда юнит впервые получил урон. У полного отряда
# на марше лишних узлов нет.
# ─────────────────────────────────────────────────────────────────────────────
func _update_hp_bar() -> void:
	var frac: float = 0.0
	if max_health > 0.0:
		frac = clampf(current_health / max_health, 0.0, 1.0)
	# ТУМБЛЕР ALT — ЕДИНСТВЕННЫЙ ХОЗЯИН ПОЛОСОК.
	#
	# Раньше полоска вылезала сама при любом уроне, и тумблер её лишь дополнял.
	# Получалось, что игрок гасит полоски по Alt, начинается перестрелка — и над
	# каждым задетым бойцом снова загорается красная черта: погасить поле боя
	# было невозможно в принципе.
	#
	# Теперь правило одно и без исключений: Alt опущен — полосок нет НИ У КОГО,
	# независимо от урона, спавна и смерти. Alt поднят — полоски у всех живых.
	# ── ПОЛОСКА — СЛОТ В ОБЩЕМ MultiMesh, А НЕ ДВА УЗЛА НА БОЙЦА ────────────
	# Здесь строились корень + заливка со своим QuadMesh, и при каждом уроне
	# переписывались его size и center_offset. Замер (qa_hotspot, 600 бойцов,
	# Alt поднят): +2.8 мс кадра и +720 вызовов отрисовки. Теперь боец только
	# числится в общем слое (см. HpBarRenderer), а долю жизни слой читает сам
	var forced: bool = GameManager.hp_bars_forced
	if not forced:
		GameManager.hp_bars.unregister(self)
		return
	if state == State.DEAD or garrisoned:
		GameManager.hp_bars.unregister(self)
		return
	if GameManager.main != null:
		GameManager.hp_bars.register(self, GameManager.main.world_root())

## Пересобрать полоску под текущее состояние тумблера Alt.
## Зовётся из GameManager._refresh_all_hp_bars() при переключении и самим юнитом
## в _ready(), чтобы подкрепление сразу выходило с тем же режимом, что и поле
func refresh_hp_bar() -> void:
	if state == State.DEAD:
		return
	_update_hp_bar()

# ── УЗЛОВ ПОЛОСКИ БОЛЬШЕ НЕТ ────────────────────────────────────────────────
# Здесь жили _build_hp_bar() и _apply_hp_bar_fraction(): корень + заливка со
# своим QuadMesh, у которого при каждом уроне переписывались size и
# center_offset (менять приходилось именно МЕШ, потому что билборд подменяет
# базис MODELVIEW и теряет масштаб узла — см. шапку mm_hp_bar.gdshader, там та
# же оговорка объясняет, почему доля жизни едет цветом).
#
# Оба узла и вся эта возня заменены слотом в общем MultiMesh
# (scripts/HpBarRenderer.gd): замер qa_hotspot на 600 бойцах с поднятым Alt
# показал +2.8 мс кадра и +720 вызовов отрисовки — самая дорогая мелочь в
# интерфейсе, и включается она одной клавишей посреди боя.
