## ── КАК БОЕЦ ВЫГЛЯДИТ ПАВШИМ ───────────────────────────────────────────────
## Возвращает то же, что sheet_frame (лента, кадр, число кадров, размер пикселя,
## высота центра), но ПОЗУ ПОКОЯ и нулевой кадр.
##
## Разница не косметическая. sheet_frame отдаёт ту ленту, на которой бойца
## застала смерть, — а умирают чаще всего в бою, то есть на замахе, выпаде или
## под щитом. Поле выходило заваленным телами, застывшими в атаке; у гоблина в
## кадре «Attack Strong» нарисован ещё и белый след удара, и на завале эти
## следы читались как клочья тумана.
##
## База умеет это сама, пока ленты разобраны в _look_table (все, кроме
## копейщика: у него направленные листы и своя ветка — см. Spearman)
func corpse_frame() -> Array:
	if not _look_ok:
		_look_bind()
	var row: Variant = _look_table.get("idle")
	if row != null:
		var r: Array = row
		return [r[0], 0, int(r[1]), _look_px, _sprite_base_y]
	# Лент нет вовсе (процедурный примитив) — отдаём что есть, но с нулевого
	# кадра: даже в чужой ленте нулевой кадр спокойнее середины замаха
	var sf: Array = sheet_frame()
	if sf.size() >= 2:
		sf[1] = 0
	return sf

