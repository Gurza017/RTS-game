extends RefCounted
## ═══════════════════════════════════════════════════════════════════════════
## ШАГ ИГРОВЫХ ЧАСОВ ДЛЯ УЗЛА, КОТОРЫЙ ВЕДЁТ СВОИ ЧАСЫ В _process
## (аудит партии 22.10.2026)
## ═══════════════════════════════════════════════════════════════════════════
## Единственный источник игрового времени — Unit.game_ms() (сумма delta
## физических тактов, наращивает GameManager). Часы партии Main, ИИ людей и
## орды, штурма базы, гноллов, конницы, охраны прежде копили delta ОТРИСОВКИ:
## на паузе её закрывала проверка paused, а при просадке FPS
## (max_physics_steps_per_frame = 1) мир замедлялся, delta отрисовки — нет, и
## перемирие, волны и штурм уходили вперёд сроков бойцов.
##
## step() отдаёт, сколько игровых секунд прошло с прошлого вызова: разность
## целых мс телескопируется, сумма шагов РАВНА пройденным Unit.game_ms().
## Первый вызов только снимает отметку (0).
##
## Разрыв больше max_sec ОТБРАСЫВАЕТСЯ (шаг 0), а не урезается. В игре за
## кадр отрисовки проходит не больше max_physics_steps_per_frame тактов (17 мс,
## на ×4 зондов — 67 мс), так что такой разрыв бывает только у узла, которому
## гасили _process (стенд, set_process(false)): прежде замороженное время
## терялось целиком, и включение не должно выдать ни минуты, ни полсекунды
## (qa_tz1020 F1/F2: урезанные 0.5 с легли на кадр паузы).
## Стенд, гоняющий _process руками, двигает часы сам: Unit.advance_game_clock
const STEP_MAX_SEC := 0.5

var _seen_ms: int = -1

func step(max_sec: float = STEP_MAX_SEC) -> float:
	var g: int = Unit.game_ms()
	if _seen_ms < 0:
		_seen_ms = g
		return 0.0
	var d: float = float(g - _seen_ms) * 0.001
	_seen_ms = g
	return d if d <= max_sec else 0.0
