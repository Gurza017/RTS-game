// ═══════════════════════════════════════════════════════════════════════════
// ТЕЛО НА ЗЕМЛЕ В ОБЩЕМ MultiMesh: КАДР, ЗЕРКАЛО И РАСТВОРЕНИЕ ИЗ INSTANCE-ЦВЕТА
// ═══════════════════════════════════════════════════════════════════════════
// Родня mm_unit_sprite.gdshader, и отличие ровно одно, зато принципиальное:
// БИЛБОРДА ЗДЕСЬ НЕТ. Живой боец всегда повёрнут к камере, а лежащий — нет:
// он лежит там, где упал, и поворот вокруг вертикали у него свой (см.
// CorpseRenderer). Поэтому трансформ экземпляра используется как есть, и
// vertex() не переписывается вовсе.
//
// Раскладка COLOR (та же логика, что у mm_unit_sprite — через use_colors, а не
// custom_data: у GL Compatibility с ним открытый баг godot/godot#96503):
//   r — номер кадра в ленте, закодирован как frame/255
//   g — зеркало по горизонтали: >0.5 — отражать
//   b — сколько тела осталось: 1 — лежит целым, 0 — растаяло
//   a — ЯРКОСТЬ ТЕЛА: 1 — свежее, сверху кучи; меньше — лежит под другими
//
// ── ЗАТЕМНЕНИЕ НИЖНИХ СЛОЁВ ────────────────────────────────────────────────
// Завал из одинаково ярких тел читается плоским ковром: глазу не за что
// зацепиться, чтобы понять, что тут куча, а не рисунок на траве. Тела внизу
// притеняются — ровно как притенило бы их то, что лежит сверху. Множитель
// приходит готовым числом в альфе instance-цвета, потому что считается он
// один раз при укладке тела и больше никогда не меняется (CorpseRenderer).
//
// ── ПОЧЕМУ ТЕЛО НЕПРОЗРАЧНОЕ, А РАСТВОРЕНИЕ — ДИЗЕРОМ ──────────────────────
// Первая версия рисовала трупы полупрозрачными (blend_mix + depth_draw_never),
// и это давало МЕРЦАНИЕ на завалах. Причина не в глубине, а в сортировке:
// прозрачные объекты движок упорядочивает по расстоянию до камеры, у каждой
// ленты свой MultiMeshInstance3D, и при движении камеры два таких узла меняются
// местами целиком — весь пласт тел одной ленты разом ныряет под другой пласт и
// обратно. На перемешанном завале это выглядит как моргание.
//
// Непрозрачное тело такой сортировки не знает вовсе: порядок решает буфер
// глубины, попиксельно и стабильно. Плата — растворение нельзя сделать
// прозрачностью, и оно сделано ДИЗЕРОМ: с падением COLOR.b выбрасывается всё
// большая доля пикселей, псевдослучайно, но по устойчивому шаблону от UV.
// На пиксель-арте это читается как истаивание, а не как дыры.
shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_opaque;

uniform sampler2D albedo_tex : source_color, filter_nearest;
uniform float frame_count = 1.0;
// ── ПОРОГ СРЕЗА ВЫШЕ, ЧЕМ У ЖИВОГО, И ЭТО ГЛАВНОЕ ОТЛИЧИЕ ──────────────────
// Здесь стояло 0.15 «как у живых бойцов». На лежащем это дало ту самую чёрную
// кляксу у головы, из-за которой труп выглядел обезглавленным.
//
// Разбор. В листе юнита под ступнями впечатан овал полупрозрачной краской
// (альфа 69-80 из 255 — единственные частичные значения во всех 361 листах
// assets/factions). У СТОЯЩЕГО он хотя бы лежит там, где ему положено, — под
// ногами; у лежащего квад повёрнут плашмя и вокруг вертикали, и «под ногами»
// оказывается СБОКУ ОТ ГОЛОВЫ. А поскольку материал непрозрачный, срез 0.15
// пропускал эту краску и печатал её ПЛОТНЫМ пятном (15,18,26).
//
// Живому пятно вернули дизером (см. mm_unit_sprite): у него это честная тень
// под ступнями. Лежащему оно не нужно вовсе — его тень рисует отдельный слой
// CorpseRenderer.ShadowLayer, аккуратным пятном ПОД ТУЛОВИЩЕМ. Поэтому здесь
// краска просто срезается: 0.5 выше любой её альфы и ниже единицы, которой
// нарисовано всё остальное, включая древко копья
uniform float alpha_scissor : hint_range(0.0, 1.0) = 0.5;

void fragment() {
	float fidx = floor(COLOR.r * 255.0 + 0.5);
	fidx = clamp(fidx, 0.0, max(frame_count - 1.0, 0.0));
	// Зеркалим ВНУТРИ кадра, а не по всей ленте: отражать надо картинку бойца,
	// а не выбор кадра
	float u = (COLOR.g > 0.5) ? (1.0 - UV.x) : UV.x;
	vec2 uv = vec2((u + fidx) / max(frame_count, 1.0), UV.y);

	float left = COLOR.b;
	if (left < 0.999) {
		// Шаблон дизера привязан к UV, а не к экрану: истаивающее тело не
		// «ползёт» узором, когда камера едет над полем
		vec2 cell = floor(UV * 96.0);
		float h = fract(sin(dot(cell, vec2(12.9898, 78.233))) * 43758.5453);
		if (h > left) {
			discard;
		}
	}

	vec4 col = texture(albedo_tex, uv);
	// Яркость слоя. Умножение, а не смешивание с чёрным: пиксель-арт держит
	// собственную палитру, и подмес постороннего цвета выглядел бы грязью
	ALBEDO = col.rgb * COLOR.a;
	ALPHA = col.a;
	ALPHA_SCISSOR_THRESHOLD = alpha_scissor;
}
