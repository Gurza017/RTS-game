// ═══════════════════════════════════════════════════════════════════════════
// РАСТИТЕЛЬНОСТЬ В ОБЩЕМ MultiMesh: ВЕТЕР ИЗ INSTANCE-ЦВЕТА
// ═══════════════════════════════════════════════════════════════════════════
// То же самое, что cyl_billboard.gdshader, но пригодное для MultiMesh.
//
// Зачем понадобилось. У каждого растения СВОЯ фаза колыхания и СВОЯ длительность
// цикла (см. BillboardUtil.make_wind_material) — без разброса лес машет одним
// куском и читается как «ползающие кусты». Раз параметры свои, то и материал
// был свой: две тысячи ShaderMaterial на две тысячи растений, то есть две
// тысячи отдельных вызовов отрисовки. Замер (qa_veg, вся карта в кадре, армии
// нет): 1762 вызова и 75 кадров в секунду на RTX 4070 — потолок ДО появления
// первого бойца.
//
// Здесь разброс переехал в instance-цвет, и весь лес одного сорта рисуется
// одним вызовом, сохраняя прежний вид до кадра.
//
// Раскладка COLOR (как и у бойцов — через use_colors, а НЕ custom_data:
// у GL Compatibility с ним открытый баг godot/godot#96503):
//   r — фаза колыхания, доля цикла [0..1)
//   g — длительность цикла, нормированная в [0..1] между cycle_min и cycle_max
//   b — ПОДСВЕТКА ПРИ НАВЕДЕНИИ, 0..1 (см. VegetationRenderer.set_highlight)
//   a — свободен
//
// Почему подсветка едет ИМЕННО В INSTANCE-ЦВЕТЕ, а не отдельным материалом или
// вторым квадом поверх. Весь лес одного сорта — это ОДИН бакет с одним
// материалом: подсветить одно дерево уникальным материалом значит выбить его из
// бакета и вернуть тот самый вызов отрисовки на растение, ради устранения
// которого весь этот файл и написан. Свободный канал цвета же меняет ровно один
// float в теневом буфере и не трогает ни бакет, ни число вызовов.
shader_type spatial;
render_mode unshaded, cull_disabled;

// По текселям, как и у cyl_billboard: арт пиксельный, линейная фильтрация его
// размазывает. Мипмапы оставлены — без них дальний лес мерцает на движении
uniform sampler2D albedo_tex : source_color, filter_nearest_mipmap;
uniform vec4 modulate : source_color = vec4(1.0, 1.0, 1.0, 1.0);
uniform float alpha_scissor : hint_range(0.0, 1.0) = 0.5;
uniform float frame_count = 1.0;
// Границы разброса длительности цикла — те же числа, что в BillboardUtil
uniform float cycle_min = 2.4;
uniform float cycle_max = 4.0;
// Вертикальная компенсация наклона камеры (см. BillboardUtil.V_STRETCH)
uniform float v_stretch = 1.0;
// Цвет и сила подсветки наведения. Оттенок тот же зелёный, что у кольца под
// комлем (Main.HOVER_RES_COLOR) — рука игрока и дерево должны отвечать одним
// цветом на одно и то же наведение
uniform vec4 highlight_tint : source_color = vec4(0.35, 1.0, 0.40, 1.0);
// СИЛА ПОДМЕСА СНИЖЕНА НА 20% (0.45 → 0.36, заказ владельца: «сделать подсветку
// мягче»). Ровно на столько же убавлено и осветление ниже: прибавка к яркости
// была 1.20, стала 1.16 — то есть 0.20 → 0.16. Уменьшать одно, не трогая
// второе, бессмысленно: зелень читается как их произведение
uniform float highlight_gain : hint_range(0.0, 1.0) = 0.288;
uniform float highlight_lift : hint_range(1.0, 2.0) = 1.128;

// ── КАЧАНИЕ ОСТАНАВЛИВАЕТСЯ В ТУМАНЕ ────────────────────────────────────────
// Маска тумана (R = «видно сейчас») и полуразмеры карты — те же самые, что у
// fog_of_war.gdshader. Растение вне освещённой зоны замирает.
//
// Зачем: под дымкой «разведано, но не видно» игрок смотрит на ПАМЯТЬ о местности,
// а движущийся лес читается как «там что-то происходит прямо сейчас». Заодно это
// экономия — половина леса на карте перестаёт пересчитывать кадр анимации.
//
// Решение принимается ОДИН РАЗ НА РАСТЕНИЕ (в vertex, по началу координат
// экземпляра), а не на пиксель: иначе крона одного дерева могла бы качаться, а
// комель — стоять, если кромка тумана проходит через него.
// fog_half = 0 означает «тумана нет» (стенды, меню) — качаются все.
uniform sampler2D fog_mask : filter_linear, source_color, hint_default_white;
uniform vec2 fog_half = vec2(0.0, 0.0);

varying float anim_on;

void vertex() {
	// Тянем ОТ НИЖНЕЙ КРОМКИ КВАДА: низ растения лежит на грунте, растяжение
	// от центра увело бы его в землю на четверть высоты (см. cyl_billboard)
	VERTEX.y = VERTEX.y * v_stretch + abs(VERTEX.y) * (v_stretch - 1.0);
	// Цилиндрический билборд: квад доворачивается к позиции камеры вокруг
	// СВОЕЙ оси. Для MultiMesh MODEL_MATRIX уже содержит трансформ экземпляра,
	// поэтому origin — это позиция конкретного растения, а не всего бакета
	vec3 origin = MODEL_MATRIX[3].xyz;
	// Видно ли это растение прямо сейчас — по маске тумана, из вершинного
	// шейдера через textureLod (обычный texture() в vertex требует производных,
	// которых там нет)
	anim_on = 1.0;
	if (fog_half.x > 0.0) {
		vec2 fuv = (origin.xz + fog_half) / (2.0 * fog_half);
		anim_on = textureLod(fog_mask, clamp(fuv, vec2(0.0), vec2(1.0)), 0.0).r;
	}
	vec3 to_cam = CAMERA_POSITION_WORLD - origin;
	to_cam.y = 0.0;
	float len = length(to_cam);
	vec3 fwd = (len > 0.001) ? to_cam / len : vec3(0.0, 0.0, 1.0);
	vec3 right = normalize(cross(vec3(0.0, 1.0, 0.0), fwd));
	// Масштаб экземпляра сохраняем: им задаётся размер конкретного куста
	// (у бакета один меш на всех) и усыхание вырубаемого дерева
	vec3 scl = vec3(
		length(MODEL_MATRIX[0].xyz),
		length(MODEL_MATRIX[1].xyz),
		length(MODEL_MATRIX[2].xyz));
	mat4 world = mat4(
		vec4(right * scl.x, 0.0),
		vec4(0.0, scl.y, 0.0, 0.0),
		vec4(fwd * scl.z, 0.0),
		MODEL_MATRIX[3]);
	MODELVIEW_MATRIX = VIEW_MATRIX * world;
}

void fragment() {
	float fidx = 0.0;
	if (frame_count > 1.0) {
		if (anim_on > 0.5) {
			float cyc = cycle_min + COLOR.g * (cycle_max - cycle_min);
			// Скорость задаётся ЦИКЛОМ, а не кадрами в секунду: ленты в 6 и в 8
			// кадров обязаны качаться одинаково долго (см. BillboardUtil)
			float fps = frame_count / max(cyc, 0.01);
			fidx = floor(mod(TIME * fps + COLOR.r * frame_count, frame_count));
		} else {
			// ЗАМЕРЛО НА СВОЁМ КАДРЕ ФАЗЫ, а не на нулевом: нулевой у всех один,
			// и застывший лес выглядел бы неестественно ровным — все деревья в
			// одинаковом наклоне. Фаза у каждого своя, значит и поза своя
			fidx = floor(COLOR.r * frame_count);
		}
	}
	vec2 uv = vec2((UV.x + fidx) / max(frame_count, 1.0), UV.y);
	vec4 col = texture(albedo_tex, uv) * modulate;
	// ПОДСВЕТКА — ПОДМЕС ОТТЕНКА, А НЕ ЗАЛИВКА. Дерево обязано остаться собой:
	// сплошная заливка превратила бы его в зелёное пятно и скрыла и крону, и
	// ствол — то есть ровно то, на что игрок навёлся
	ALBEDO = mix(col.rgb, mix(col.rgb, highlight_tint.rgb, highlight_gain) * highlight_lift,
		clamp(COLOR.b, 0.0, 1.0));
	ALPHA = col.a;
	// Scissor: пишем глубину, нет мерцания сортировки при перекрытии крон
	ALPHA_SCISSOR_THRESHOLD = alpha_scissor;
}
