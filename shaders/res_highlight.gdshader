// ═══════════════════════════════════════════════════════════════════════════
// ТОНКОЕ КОЛЬЦО ПОДСВЕТКИ ПОД ЖИЛОЙ/КУЧЕЙ
// ═══════════════════════════════════════════════════════════════════════════
// Один плоский квад, лежащий в плоскости XZ. Рисует ОБВОДКУ — окружность у
// комля дерева или овал по габариту кучи руды. Это один и тот же меш и один и
// тот же материал; форму задают полуоси.
//
// ── ЗАЛИВКА УБРАНА ЦЕЛИКОМ (заказ владельца) ────────────────────────────────
// Раньше у кучи поверх обода рисовалось мягкое пятно к центру (uniform `fill`).
// На траве оно читалось как «яркая заплывающая клякса», а не как разметка, и
// перекрывало сами самородки — то есть скрывало ровно то, на что игрок навёл.
// Осталась только линия, и это уже не режим, а единственное поведение: ветку
// заливки удалять безопаснее, чем оставлять выключенной.
//
// ── ТОЛЩИНА ЗАДАЁТСЯ В МЕТРАХ, А НЕ В ДОЛЯХ РАДИУСА ─────────────────────────
// Прежний обод был «долей радиуса» (uniform `inner`). У круга это работало, у
// ОВАЛА — нет: куча вытянута, и одна и та же доля давала по длинной оси вдвое
// более толстую линию, чем по короткой, — обводка получалась «сплюснутой».
// Поэтому здесь считается настоящее расстояние до границы эллипса в метрах, и
// линия выходит одинаковой по всему периметру.
//
// ГЛУБИНА ЧИТАЕТСЯ, НО НЕ ПИШЕТСЯ. Подсветка обязана честно уходить за бойца,
// который стоит перед жилой (иначе кольцо «наклеено на экран»), но сама
// прозрачна и в буфер глубины лезть не должна — иначе спрайты за ней
// исчезают. Ровно поэтому здесь depth_draw_never, а НЕ depth_test_disabled,
// которым сделана пелена тумана: у той задача прямо противоположная.
shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never, shadows_disabled;

// Светлый, почти белый: линия обязана читаться и на траве, и на камне, и на
// золоте (см. Main.HOVER_RES_COLOR — цвет приходит оттуда)
uniform vec4 tint : source_color = vec4(0.90, 0.94, 0.92, 1.0);
// Полуоси кольца В МЕТРАХ — те же, которыми отмасштабирован квад
uniform vec2 half_size = vec2(1.0, 1.0);
// Толщина линии В МЕТРАХ
uniform float ring_width = 0.05;
// Полупрозрачность держит светлую линию от превращения в жирную белую черту
uniform float alpha_max : hint_range(0.0, 1.0) = 0.78;

void fragment() {
	vec2 h = max(half_size, vec2(0.001));
	// Смещение от центра в метрах
	vec2 p = (UV - vec2(0.5)) * 2.0 * h;
	// Расстояние до границы эллипса, в метрах. Точная формула требует решения
	// квартики; это стандартное приближение первого порядка, и на линии
	// толщиной в несколько сантиметров его ошибка невидима
	float k1 = length(p / h);
	float k2 = length(p / (h * h));
	float sd = (k1 - 1.0) / max(k2, 1e-5);
	// СГЛАЖИВАНИЕ РОВНО В ОДИН ПИКСЕЛЬ ЭКРАНА. fwidth говорит, сколько метров
	// приходится на пиксель здесь и сейчас, поэтому линия не рвётся при
	// приближении камеры и не исчезает при отдалении: полуширина не может
	// оказаться тоньше пикселя
	float aa = max(fwidth(sd), 0.0005);
	float w = max(ring_width * 0.5, aa);
	ALBEDO = tint.rgb;
	ALPHA = (1.0 - smoothstep(w - aa, w + aa, abs(sd))) * alpha_max;
}
