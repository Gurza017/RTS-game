// Цилиндрический билборд: квад поворачивается К ПОЗИЦИИ КАМЕРЫ вокруг
// СВОЕЙ СОБСТВЕННОЙ оси Y (стоящей в точке объекта).
//
// Отличие от BILLBOARD_FIXED_Y у StandardMaterial3D: тот выравнивает все
// спрайты ПАРАЛЛЕЛЬНО плоскости экрана, из-за чего ряд деревьев крутится
// при орбите камеры как единая линейка/«пропеллер». Здесь каждый объект
// имеет свой угол — лес выглядит объёмным, деревья «стоят на месте».
shader_type spatial;
render_mode unshaded, cull_disabled;

// ФИЛЬТРАЦИЯ — ПО ТЕКСЕЛЯМ, А НЕ СГЛАЖЕННАЯ. Здесь стояло filter_linear_mipmap,
// и это было прямой причиной жалобы «пиксели плывут и мылятся»: весь арт
// проекта — пиксельный, а линейная фильтрация размазывает его тем сильнее, чем
// крупнее спрайт на экране. Бойцы всё это время рисовались через
// filter_nearest (см. mm_unit_sprite.gdshader) и выглядели резко — камни и
// жилы через этот шейдер выглядели мыльными рядом с ними.
// Мипмапы ОСТАВЛЕНЫ (nearest_mipmap, а не голый nearest): без них дальний лес
// на отдалённой камере начинает мерцать на движении
uniform sampler2D albedo_tex : source_color, filter_nearest_mipmap;
uniform vec4 modulate : source_color = vec4(1.0, 1.0, 1.0, 1.0);
uniform float alpha_scissor : hint_range(0.0, 1.0) = 0.5;
// Спрайт-шит: текстуры деревьев/кустов — ГОРИЗОНТАЛЬНЫЕ ленты кадров
// (Tree1 = 6 кадров, кусты = 8 и т.д.). Рисуем ОДИН кадр и листаем по TIME.
// Без этого на квад ложился весь шит целиком — «забор из деревьев».
uniform float frame_count = 1.0;
uniform float frame_fps = 0.0;    // 0 = статичный первый кадр
uniform float frame_phase = 0.0;  // случайный сдвиг, чтобы лес не махал синхронно
// 1.0 — квад НЕ доворачивается к камере вообще и стоит ровно так, как его
// поставили в мире. Нужно ЗДАНИЯМ: у постройки есть выраженный фасад, и
// доворот к камере читался как вращение замка на месте при орбите.
// Деревьям/кустам оставлен 0.0 — им доворот идёт на пользу.
uniform float world_fixed = 0.0;
// ── ПРОГРАММНОЕ ПОКАЧИВАНИЕ НА ВЕТРУ ────────────────────────────────────────
// Запасной путь для растительности БЕЗ кадров колыхания (одиночный спрайт):
// верх квада уводится вбок по синусу, низ остаётся на месте — получается
// изгиб кроны, а не сдвиг всего куста. Доля смещения от высоты квада.
// 0.0 — покачивания нет (так у всего, у чего есть свои кадры, и у зданий).
uniform float sway_amount = 0.0;
uniform float sway_speed  = 1.0;
uniform float sway_phase  = 0.0;
// ВЕРТИКАЛЬНАЯ КОМПЕНСАЦИЯ НАКЛОНА КАМЕРЫ (подробности — BillboardUtil.V_STRETCH).
// Ось Y у билборда мировая, поэтому при ортографии под 45° высота на экране
// сжимается в cos(45°) раз. Здесь она домножается обратно. 1.0 — без коррекции.
uniform float v_stretch = 1.0;

void vertex() {
	// Тянем ОТ НИЖНЕЙ КРОМКИ КВАДА, а не от его центра: у всех, кто рисуется
	// этим шейдером (деревья, кусты, пни, постройки), низ квада лежит ровно на
	// грунте (position.y = size.y * 0.5). Растяжение от центра увело бы объект
	// в землю на четверть высоты.
	// Квад — четыре вершины на ±size.y/2, поэтому половина высоты равна
	// abs(VERTEX.y) в любой из них, и передавать её отдельно не нужно
	VERTEX.y = VERTEX.y * v_stretch + abs(VERTEX.y) * (v_stretch - 1.0);
	// Изгиб применяем ДО билборда: смещение живёт в локальных осях квада,
	// поэтому крона всегда клонится «вбок по экрану», как её ни поверни.
	// UV.y = 0 наверху квада, 1 внизу — вес изгиба берём как (1 - UV.y),
	// чтобы низ (комель/корни) стоял неподвижно
	if (sway_amount > 0.0) {
		float w = 1.0 - UV.y;
		VERTEX.x += sin(TIME * sway_speed + sway_phase) * sway_amount * w * w;
	}
	// world_fixed = 1.0 — MODELVIEW_MATRIX не трогаем вовсе: узел стоит
	// ровно так, как его поставили в мире (ветку `return` шейдерный
	// компилятор Godot в vertex() не допускает, поэтому обычное условие)
	if (world_fixed <= 0.5) {
		// Мировая позиция объекта (включая локальный сдвиг спрайта, напр. y=2.5)
		vec3 origin = MODEL_MATRIX[3].xyz;
		// Горизонтальное направление на камеру — вращение только вокруг Y
		vec3 to_cam = CAMERA_POSITION_WORLD - origin;
		to_cam.y = 0.0;
		float len = length(to_cam);
		vec3 fwd = (len > 0.001) ? to_cam / len : vec3(0.0, 0.0, 1.0);
		vec3 right = normalize(cross(vec3(0.0, 1.0, 0.0), fwd));
		// Сохранить масштаб узла (деревья уменьшаются при вырубке)
		vec3 scl = vec3(
			length(MODEL_MATRIX[0].xyz),
			length(MODEL_MATRIX[1].xyz),
			length(MODEL_MATRIX[2].xyz));
		mat4 world = mat4(
			vec4(right * scl.x, 0.0),
			vec4(0.0, scl.y, 0.0, 0.0),
			vec4(fwd * scl.z, 0.0),
			MODEL_MATRIX[3]);
		MODELVIEW_MATRIX = VIEW_MATRIX * world;
	}
}

void fragment() {
	float fidx = (frame_fps > 0.0 && frame_count > 1.0)
		? floor(mod(TIME * frame_fps + frame_phase, frame_count))
		: 0.0;
	vec2 uv = vec2((UV.x + fidx) / frame_count, UV.y);
	vec4 col = texture(albedo_tex, uv) * modulate;
	ALBEDO = col.rgb;
	ALPHA = col.a;
	// Scissor: пишем глубину, нет мерцания сортировки при перекрытии крон
	ALPHA_SCISSOR_THRESHOLD = alpha_scissor;
}
