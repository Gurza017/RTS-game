// ═══════════════════════════════════════════════════════════════════════════
// СПРАЙТ БОЙЦА В ОБЩЕМ MultiMesh: КАДР И ЗЕРКАЛО ИЗ INSTANCE-ЦВЕТА
// ═══════════════════════════════════════════════════════════════════════════
// Задача: рисовать тысячи бойцов немногими вызовами отрисовки, СОХРАНИВ
// покадровую анимацию и разворот спрайта влево/вправо. У каждого экземпляра
// MultiMesh свои — только трансформ и цвет; кадр и зеркало едут во втором.
//
// ПОЧЕМУ НЕ custom_data (штатный способ передать в шейдер четыре числа на
// экземпляр): у GL Compatibility — рендерера этого проекта — открытый
// непочиненный баг с его надёжностью (godot/godot#96503). Поэтому та же
// четвёрка чисел передаётся через use_colors, который в проекте уже проверен
// (см. FarUnitRenderer). Тон фракции сюда не нужен вовсе: стороны отличаются
// РАЗНЫМИ PNG (game_settings.unit_folder), а не подкраской, так что все четыре
// канала цвета свободны.
//
// Раскладка COLOR:
//   r — номер кадра в ленте, закодирован как frame/255 (см. INV_255 ниже)
//   g — зеркало по горизонтали: >0.5 — отражать
//   b — сила вспышки от удара, 0..1 (см. Unit.HIT_FLASH_SEC)
//   a — доля жизни, 0..1 (1.0 — цел). Отсюда окровавленность, см. низ файла
//
// Лист кадров ГОРИЗОНТАЛЬНЫЙ (frame_count кадров в ряд) — ровно тот формат,
// который уже разбирает SpriteSheetParser, новый арт не нужен.
shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_opaque;

uniform sampler2D albedo_tex : source_color, filter_nearest;
uniform float frame_count = 1.0;
uniform float alpha_scissor : hint_range(0.0, 1.0) = 0.5;

// Кадр едет в цвете целым числом, поделённым на 255: канал цвета в
// GL Compatibility может оказаться восьмибитным, и дробная доля потерялась бы.
// 255 кадров — потолок заведомо недостижимый (самая длинная лента в проекте
// восьмикадровая)
const float INV_255 = 1.0 / 255.0;

// ФАЗА ПУЛЬСАЦИИ У КАЖДОГО БОЙЦА СВОЯ. Ровно по той же причине, по которой
// своя фаза есть у зацикленной анимации (Unit._anim_offset): общая на всех
// фаза заставила бы весь раненый строй темнеть и светлеть в один такт, и это
// читалось бы как мигание всего экрана, а не как состояние отдельных бойцов.
// Считается из МИРОВОЙ ТОЧКИ экземпляра — свободного канала instance-цвета под
// неё уже нет (все четыре заняты, см. шапку), а точка и так под рукой
varying float v_pulse_phase;

void vertex() {
	v_pulse_phase = MODEL_MATRIX[3].x * 0.7 + MODEL_MATRIX[3].z * 1.3;
	// БИЛБОРД С СОХРАНЕНИЕМ МАСШТАБА, ось Y мировая — то же, что
	// BILLBOARD_FIXED_Y у StandardMaterial3D, которым нарисованы ближние бойцы
	// сейчас. Собственный код нужен потому, что штатный билборд нельзя
	// совместить с выбором кадра по instance-цвету.
	//
	// Масштаб берётся ДЛИНОЙ базисных векторов, то есть БЕЗ ЗНАКА. Отсюда и
	// зеркало через цвет, а не через Basis.scaled(-1,1,1), как у дальних
	// бойцов: отрицательный масштаб здесь просто потерялся бы
	vec3 scl = vec3(
		length(MODEL_MATRIX[0].xyz),
		length(MODEL_MATRIX[1].xyz),
		length(MODEL_MATRIX[2].xyz));
	vec3 cam_right = normalize(INV_VIEW_MATRIX[0].xyz);
	// Ось «вправо по экрану» кладём горизонтально: боец не должен заваливаться
	// при наклоне камеры
	cam_right.y = 0.0;
	cam_right = normalize(cam_right);
	vec3 fwd = normalize(cross(cam_right, vec3(0.0, 1.0, 0.0)));
	mat4 world = mat4(
		vec4(cam_right * scl.x, 0.0),
		vec4(0.0, scl.y, 0.0, 0.0),
		vec4(fwd * scl.z, 0.0),
		MODEL_MATRIX[3]);
	MODELVIEW_MATRIX = VIEW_MATRIX * world;
}

// ── ВПЕЧАТАННАЯ В АРТ ТЕНЬ ПОД НОГАМИ СМЕШИВАЕТСЯ С ЦВЕТОМ ЗЕМЛИ ────────────
// В каждом листе юнита под ступнями нарисован овал ПОЛУПРОЗРАЧНОЙ краской:
// замер по всем 361 листам assets/factions даёт ровно три частичных значения
// альфы — 69, 79 и 80 из 255 (то есть 0.27-0.31), и все они лежат узкой
// полосой у ног. Всё остальное в листах строго 0 или 255.
//
// Материал НЕПРОЗРАЧНЫЙ: срез по альфе либо оставляет пиксель целиком, либо
// выбрасывает целиком. Возвращать его в прозрачный проход нельзя — он
// перестанет писать глубину, и вернётся мерцание сортировки в плотном строю
// (ради чего срез и заводили). Значит, полупрозрачность надо чем-то заменить.
//
// ЧТО ПРОБОВАЛИ И ПОЧЕМУ НЕ ПОДОШЛО:
//   • печатать как есть — овал уходил на экран ПЛОТНЫМ пятном (15,18,26),
//     то есть чёрной лужей под каждым бойцом («жирные чёрные кляксы»);
//   • дизер (доля пикселей, равная альфе) — честно, дёшево и работает, но на
//     рабочем зуме тень из четверти пикселей просто НЕ ВИДНА: владелец
//     справедливо сказал, что тень пропала совсем.
//
// ЧТО СТОИТ СЕЙЧАС: смешивание с ЦВЕТОМ ЗЕМЛИ прямо в шейдере. Пиксель тени
// выводится как mix(земля, краска, альфа) и печатается непрозрачным — на
// экране это ровно тот мягкий овал, который нарисовал художник, ценой одного
// mix на пиксель тени. Ни лишних вызовов отрисовки, ни перерисовки.
//
// ЧЕМ ПЛАТИМ: тон земли — ОДНО число на всю карту (ground_tone, его ставит
// Main из albedo рельефа). Поле в этой игре сплошь травяное, поэтому ошибка
// незаметна; на пёстром грунте овал был бы слегка не в тон.
const float BAKED_SHADOW_MAX = 0.5;
uniform vec3 ground_tone : source_color = vec3(0.30, 0.49, 0.24);

// ── УРОН ВИДЕН НА САМОМ СПРАЙТЕ, БЕЗ ЕДИНОГО НОВОГО ЛИСТА ──────────────────
// Арт у нас один на все состояния бойца: раненого копейщика никто не рисовал и
// рисовать не будет. Поэтому и вспышка от удара, и «подбитость» делаются
// подкраской ТОЙ ЖЕ текстуры — это ноль дополнительных вызовов отрисовки, ноль
// узлов и ноль новых бакетов (лента-то не меняется, боец остаётся в своём).
//
// ПОЧЕМУ КРОВЬ — МНОЖИТЕЛЬ, А НЕ ПОДМЕС ЦВЕТА. Ровно та же причина, что у
// притенения слоёв в завале (см. mm_corpse): пиксель-арт держит свою палитру, и
// подмешанный посторонний цвет выглядит грязью, а не кровью. Умножение на
// wound_mul гасит зелёный и синий, оставляя красный — рисунок остаётся собой,
// но становится тёмно-бурым, будто по нему прошлись.
//
// ПОЧЕМУ СИЛЬНЕЕ В ТЁМНЫХ УЧАСТКАХ (wound_bright_keep). Кровь и грязь садятся в
// складки и тени, а не на блик шлема; вдобавок ровный множитель по всему
// силуэту читается как «бойца перекрасили», то есть как другая фракция, — а
// стороны у нас отличаются именно цветом листа.
uniform vec3  wound_mul : source_color = vec3(0.95, 0.38, 0.32);
// Выше wound_hi — спрайт чистый, ни одной операции сверх прежних
uniform float wound_hi : hint_range(0.0, 1.0) = 0.85;
// Ниже wound_lo — тяжёлое состояние: подмес сильнее плюс пульсация
uniform float wound_lo : hint_range(0.0, 1.0) = 0.40;
uniform float wound_light : hint_range(0.0, 1.0) = 0.55;
uniform float wound_heavy : hint_range(0.0, 1.0) = 1.00;
// Доля подмеса, достающаяся самым светлым пикселям силуэта
uniform float wound_bright_keep : hint_range(0.0, 1.0) = 0.35;
// ── ЕДИНСТВЕННОЕ, ЧТО ЗДЕСЬ ПРИБАВЛЯЕТСЯ, А НЕ УМНОЖАЕТСЯ ─────────────────
// Одним умножением крови не добиться в принципе: у копейщика синий плащ, в
// котором красного канала почти нет, и любой множитель может сделать его
// только ТЕМНЕЕ. На снимке это и вышло — не «окровавлен», а «посерел».
// Поэтому поверх множителя идёт КРОХОТНАЯ добавка бурого, и ровно в тех же
// тёмных участках. Число мало намеренно: больше — и силуэт светлеет, теряя
// рисунок, то есть возвращается ровно та «грязь», от которой уводит множитель
uniform vec3  wound_blood : source_color = vec3(0.17, 0.02, 0.02);
// Пульсация ТОЛЬКО у тяжёлых: дыхание на последнем издыхании. Амплитуда
// намеренно мала — это подрагивание тона, а не мигающая лампочка
uniform float pulse_amp : hint_range(0.0, 1.0) = 0.12;
uniform float pulse_hz = 4.0;

void fragment() {
	float fidx = floor(COLOR.r * 255.0 + 0.5);
	fidx = clamp(fidx, 0.0, max(frame_count - 1.0, 0.0));
	// Зеркалим ВНУТРИ кадра, а не по всей ленте: отражать надо картинку бойца,
	// а не выбор кадра
	float u = (COLOR.g > 0.5) ? (1.0 - UV.x) : UV.x;
	vec2 uv = vec2((u + fidx) / max(frame_count, 1.0), UV.y);
	vec4 col = texture(albedo_tex, uv);
	// Тень отбирается по альфе. `return` в fragment() язык шейдеров Godot не
	// принимает, поэтому ветка одна на два исхода
	if (col.a > 0.001 && col.a < BAKED_SHADOW_MAX) {
		// Пустоту (альфа 0) сюда не пускаем условием выше — иначе весь квад
		// закрасился бы цветом земли и боец ездил бы на зелёной плитке
		ALBEDO = mix(ground_tone, col.rgb, col.a);
		ALPHA = 1.0;
		ALPHA_SCISSOR_THRESHOLD = 0.0;
	} else {
		vec3 rgb = col.rgb;
		// ── ОКРОВАВЛЕННОСТЬ ПО ДОЛЕ ЖИЗНИ ─────────────────────────────────
		// Целый боец не платит ничего, кроме одного сравнения: ветка целиком
		// пропускается, а в строю целых большинство
		float hp = COLOR.a;
		if (hp < wound_hi) {
			// Лёгкое ранение растёт от нуля на wound_hi до полной силы на
			// wound_lo — иначе на границе порога боец менялся бы скачком
			float t = clamp((wound_hi - hp) / max(wound_hi - wound_lo, 0.001),
				0.0, 1.0);
			float k = wound_light * t;
			if (hp < wound_lo) {
				float h = clamp((wound_lo - hp) / max(wound_lo, 0.001),
					0.0, 1.0);
				k = mix(wound_light, wound_heavy, h);
				// Потолок обязателен: без него сильная амплитуда выносит долю
				// за единицу, а mix за пределами отрезка ЭКСТРАПОЛИРУЕТ — то
				// есть уводит каналы в минус. У самого края (k уже на единице)
				// от пульсации остаются одни провалы вниз, и это ровно то
				// «микро-затемнение», которое здесь и нужно
				k = clamp(k * (1.0 + pulse_amp
					* sin(TIME * pulse_hz + v_pulse_phase)), 0.0, 1.0);
			}
			float lum = dot(rgb, vec3(0.299, 0.587, 0.114));
			float w = k * mix(1.0, wound_bright_keep, lum);
			rgb = rgb * mix(vec3(1.0), wound_mul, w) + wound_blood * w;
		}
		// ── ВСПЫШКА ОТ УДАРА ──────────────────────────────────────────────
		// ПОСЛЕДНЕЙ и поверх всего: это засветка попадания, а не состояние
		// бойца, и на тяжелораненом она обязана быть такой же яркой, как на
		// целом. Гасит её сам боец, за HIT_FLASH_SEC (см. Unit.tick_visual)
		ALBEDO = mix(rgb, vec3(1.0), COLOR.b);
		ALPHA = col.a;
		// Scissor: спрайт пишет глубину — в плотном строю нет мерцания сортировки
		ALPHA_SCISSOR_THRESHOLD = alpha_scissor;
	}
}
